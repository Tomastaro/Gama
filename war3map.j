//马超一技能
function Trig_movingkiller1xu_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0HX'
endfunction

// ====================================
// 周期伤害回调
// ====================================
function MovingKiller_Periodic takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_MovingKiller, id, 0)
    local integer rounds = LoadInteger(udg_HT_MovingKiller, id, 1)
    local location p
    local group g
    local unit u           // 提前声明

    if caster == null or not IsUnitAliveBJ(caster) or rounds >= 7 then
        call PauseTimer(t)
        call FlushChildHashtable(udg_HT_MovingKiller, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        return
    endif

    call SaveInteger(udg_HT_MovingKiller, id, 1, rounds + 1)

    set p = GetUnitLoc(caster)
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\IceNova-b.mdl", caster, "head"))

    set g = CreateGroup()
    call GroupEnumUnitsInRangeOfLoc(g, p, 320.0, null)
    loop
        set u = FirstOfGroup(g)    // 直接赋值，不再声明
        exitwhen u == null
        if IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call UnitDamageTarget(caster, u, (1.2 + 0.2 * GetUnitAbilityLevel(caster, 'A0HX')) * GetHeroStr(caster, false), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    call RemoveLocation(p)

    set caster = null
    set p = null
    set g = null
endfunction

// ====================================
// 技能结束回调（3秒后执行）
// ====================================
function MovingKiller_End takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_MovingKiller, id, 0)
    local timer periodTimer

    if caster != null then
        call UnitRemoveAbility(caster, 'A0H8')
        if GetUnitAbilityLevel(caster, 'A0HL') > 0 and IsUnitAliveBJ(caster) then
            call UnitAddAbility(caster, 'A0T6')
            call SetUnitAbilityLevel(caster, 'A0T6', GetUnitAbilityLevel(caster, 'A0HL'))
            call SetPlayerAbilityAvailable(GetOwningPlayer(caster), 'A0T6', false)
        endif

        // 只清理周期计时器的哈希残留，不重复销毁计时器（它会自行销毁）
        set periodTimer = LoadTimerHandle(udg_HT_MovingKiller, GetHandleId(caster), 1)
        if periodTimer != null then
            call FlushChildHashtable(udg_HT_MovingKiller, GetHandleId(periodTimer))
            call RemoveSavedHandle(udg_HT_MovingKiller, GetHandleId(caster), 1)
        endif
    endif

    call FlushChildHashtable(udg_HT_MovingKiller, id)
    call DestroyTimer(t)
    set caster = null
    set t = null
    set periodTimer = null
endfunction

// ====================================
// 主技能动作
// ====================================
function Trig_movingkiller1xu_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local timer periodTimer
    local timer endTimer
    local integer casterId

    if caster == null then
        return
    endif

    call UnitAddAbility(caster, 'A0H8')

    // 创建周期计时器（0.4秒）
    set periodTimer = CreateTimer()
    call SaveUnitHandle(udg_HT_MovingKiller, GetHandleId(periodTimer), 0, caster)
    call SaveInteger(udg_HT_MovingKiller, GetHandleId(periodTimer), 1, 0)
    call TimerStart(periodTimer, 0.40, true, function MovingKiller_Periodic)

    // 将 periodTimer 存储在施法者单位下，以便结束回调时能销毁它
    set casterId = GetHandleId(caster)
    call SaveTimerHandle(udg_HT_MovingKiller, casterId, 1, periodTimer)  // 如果地图支持
    // 如果不支持，可以存 integer: call SaveInteger(udg_HT_MovingKiller, casterId, 1, GetHandleId(periodTimer))

    // 创建结束计时器（3秒后）
    set endTimer = CreateTimer()
    call SaveUnitHandle(udg_HT_MovingKiller, GetHandleId(endTimer), 0, caster)
    call TimerStart(endTimer, 3.00, false, function MovingKiller_End)

    set caster = null
    set periodTimer = null
    set endTimer = null
endfunction

// ====================================
// 初始化
// ====================================
function InitTrig_movingkiller takes nothing returns nothing
    local trigger t

    if udg_HT_MovingKiller == null then
        set udg_HT_MovingKiller = InitHashtable()
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_movingkiller1xu_Conditions))
    call TriggerAddAction(t, function Trig_movingkiller1xu_Actions)
    set t = null

    // 死亡触发器已不需要，可不创建；若保留则确保不引用缺失变量
endfunction

