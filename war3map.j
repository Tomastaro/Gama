            endif
            
            set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e09Z', tarX, tarY, GetRandomDirectionDeg())
            if effectUnit != null then
                call SetUnitScale(effectUnit, 1.30, 1.30, 1.30)
                call SetUnitFlyHeight(effectUnit, 300.00, 0.00)
                call SetUnitAnimationByIndex(effectUnit, R2I(90.00 * 0.69))
                set eff = AddSpecialEffectTarget("war3mapImported\\zhanji-blue-shu.mdx", effectUnit, "origin")
                if eff != null then
                    call DestroyEffect(eff)
                    set eff = null
                endif
