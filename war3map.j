function InitTrig_Axs takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_Axs_Conditions))
    call TriggerAddAction(t, function Trig_Axs_Actions)
    set t = null
endfunction
//孙策
function xMajz takes nothing returns boolean
    return GetSpellAbilityId() == 'A0X7'
endfunction

function cMajz takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer lvl
    
    // 防崩
    if u == null then
        set u = null
        return
    endif
    
    set lvl = GetUnitAbilityLevel(u, 'A0X7')
    
    call UnitAddAbility(u, 'A0Q9')
    call UnitAddAbility(u, 'A0RB')
    call SetUnitMoveSpeed(u, 392.0)
    
    call PolledWait(lvl + 2.0)
    
    // 等待结束后必须判断单位还活着
    if u != null and IsUnitAliveBJ(u) then
        call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u))
        call UnitRemoveAbility(u, 'A0RB')
        call UnitRemoveAbility(u, 'A0Q9')
    endif
    
    set u = null
endfunction

function InitMajzTrigger takes nothing returns nothing
    local trigger mmajz = CreateTrigger() // 这里也改成局部更安全
    call TriggerRegisterAnyUnitEventBJ(mmajz, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(mmajz, Condition(function xMajz))
    call TriggerAddAction(mmajz, function cMajz)
    set mmajz = null
endfunction
//孙策2
// ====================================
// 位移计时器回调（每0.03秒执行一次）
// ====================================
function Charge_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_Charge, id, 1)
    local location startLoc = LoadLocationHandle(udg_HT_Charge, id, 2)
    local location targetLoc = LoadLocationHandle(udg_HT_Charge, id, 3)
    local real angle = LoadReal(udg_HT_Charge, id, 4)
    local real totalDist = LoadReal(udg_HT_Charge, id, 5)
    local real currentDist = LoadReal(udg_HT_Charge, id, 6)
    local location newLoc
    local real step = totalDist / 25.0

    // 防崩
    if caster == null or IsUnitAliveBJ(caster) == false then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_Charge, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 到达终点
    if currentDist >= totalDist then
        call xn(350.00, targetLoc, function NA)
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_Charge, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_Charge, id, 6, currentDist)

        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)
        call RemoveLocation(newLoc)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 移除技能计时器回调（1秒后触发）
// ====================================
function Charge_RemoveAbilityCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_Charge, id, 7)

    if caster != null and IsUnitAliveBJ(caster) then
        call UnitRemoveAbility(caster, 'A07G')
    endif

    call FlushChildHashtable(udg_HT_Charge, id)
    call DestroyTimer(t)

    set t = null
    set caster = null
endfunction

// ====================================
// 施法动作
// ====================================
function AA takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real totalDist
    local timer moveTimer
    local timer removeTimer
    local integer moveId
    local integer removeId
    local unit dummy

    if caster == null then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)
    set totalDist = DistanceBetweenPoints(startLoc, targetLoc)

    if totalDist <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    call SetUnitAnimationWithRarity(caster, "Attack Throw", RARITY_RARE)
    call UnitAddAbility(caster, 'A07G')

    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'e00P', targetLoc, 0)
    call SetUnitAbilityLevel(dummy, 'A1DQ', GetUnitAbilityLevel(caster, 'A0X6'))
    call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
    call IssueImmediateOrderById(dummy, 852127)
    set dummy = null

    // 位移计时器
    set moveTimer = CreateTimer()
    set moveId = GetHandleId(moveTimer)
    call SaveUnitHandle(udg_HT_Charge, moveId, 1, caster)
    call SaveLocationHandle(udg_HT_Charge, moveId, 2, startLoc)
    call SaveLocationHandle(udg_HT_Charge, moveId, 3, targetLoc)
    call SaveReal(udg_HT_Charge, moveId, 4, angle)
    call SaveReal(udg_HT_Charge, moveId, 5, totalDist)
    call SaveReal(udg_HT_Charge, moveId, 6, 0.0)
    call TimerStart(moveTimer, 0.03, true, function Charge_MoveCallback)

    // 移除技能计时器
    set removeTimer = CreateTimer()
    set removeId = GetHandleId(removeTimer)
    call SaveUnitHandle(udg_HT_Charge, removeId, 7, caster)
    call TimerStart(removeTimer, 1.0, false, function Charge_RemoveAbilityCallback)

    set caster = null
    set startLoc = null
    set targetLoc = null
    set moveTimer = null
    set removeTimer = null
endfunction

// ====================================
// 条件
// ====================================
function RA takes nothing returns boolean
    return GetSpellAbilityId() == 'A0X6'
endfunction

// ====================================
// 初始化（包含哈希表初始化）
// ====================================
function InitChargeTrigger takes nothing returns nothing
    local trigger t

    // 只在第一次调用时初始化哈希表
    if udg_HT_Charge == null then
        set udg_HT_Charge = InitHashtable()
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function RA))
    call TriggerAddAction(t, function AA)
    set t = null
endfunction


//孙策3
// 计时器回调（不变）
function CheckHealthTimer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit u = LoadUnitHandle(udg_HT_HealthCheck, id, 0)

    if u == null then
        // 单位已被永久删除（如移除单位），清理计时器
        call FlushChildHashtable(udg_HT_HealthCheck, id)
        call DestroyTimer(t)
        set t = null
        set u = null
        return
    endif

    if not IsUnitAliveBJ(u) then
        // ★ 单位死亡：移除增益，但保留计时器等待复活
        call UnitRemoveAbility(u, 'A0Z9')
        call UnitRemoveAbility(u, 'A1KT')
        set t = null
        set u = null
        return
    endif

    // 单位存活：正常管理增益
    if GetUnitLifePercent(u) > 80.0 then
        call UnitRemoveAbility(u, 'A0Z9')
        call UnitRemoveAbility(u, 'A1KT')
    else
        call UnitAddAbility(u, 'A0Z9')
        call SetUnitAbilityLevel(u, 'A0Z9', GetUnitAbilityLevel(u, 'A0JC'))
        call UnitAddAbility(u, 'A1KT')
    endif

    set t = null
    set u = null
endfunction

function Trig_che1Conditions takes nothing returns boolean
    return GetLearnedSkill() == 'A0JC' and not IsUnitIllusionBJ(GetTriggerUnit())
endfunction

function Trig_che1Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer unitId = GetHandleId(u)
    local timer oldTimer = LoadTimerHandle(udg_HT_HealthCheck, unitId, 1)  // 键1存旧计时器
    local timer newTimer
    local integer newId

    if u == null then
        set u = null
        return
    endif

    // 存在旧计时器：先销毁并清理
    if oldTimer != null then
        call FlushChildHashtable(udg_HT_HealthCheck, GetHandleId(oldTimer))
        call DestroyTimer(oldTimer)
    endif

    // 创建新计时器
    set newTimer = CreateTimer()
    set newId = GetHandleId(newTimer)
    call SaveUnitHandle(udg_HT_HealthCheck, newId, 0, u)               // 计时器→单位
    call SaveTimerHandle(udg_HT_HealthCheck, unitId, 1, newTimer)      // 单位→计时器
    call TimerStart(newTimer, 0.5, true, function CheckHealthTimer)

    set u = null
    set oldTimer = null
    set newTimer = null
endfunction

function InitTrigger_SUN3 takes nothing returns nothing
    local trigger t
    if udg_HT_HealthCheck == null then
        set udg_HT_HealthCheck = InitHashtable()
    endif
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(t, Condition(function Trig_che1Conditions))
    call TriggerAddAction(t, function Trig_che1Actions)
    set t = null
endfunction

//孙策4
function MA takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local real x = GetUnitX(caster)
    local real y = GetUnitY(caster)
    local location casterLoc = GetUnitLoc(caster)   // 提前获取一次
    local integer i = 0
    local real angle
    local location loc
    local unit dummy
    local group g
    local group hitGroup
    local unit u
    local integer lvl = GetUnitAbilityLevel(caster, 'A0JK')
    local real str = GetHeroStr(caster, true)
    local real dmg = str * 4.0
    local real centerDmg = str * 8.0

    // 冷却重置
    if GetUnitLifePercent(caster) <= 50.0 and GetUnitManaPercent(caster) >= 50.0 then
        call UnitResetCooldown(caster)
    endif

    // 中心烈焰风暴
    set dummy = CreateUnit(GetOwningPlayer(caster), 'e00N', x, y, 0)
    call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
    call IssuePointOrder(dummy, "flamestrike", x, y)

    // 中心范围伤害
    set g = CreateGroup()
    call GroupEnumUnitsInRange(g, x, y, 700.0, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if u != caster and IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call UnitDamageTarget(caster, u, centerDmg, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_FIRE, null)
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null

    // 8方向冲击
    set i = 0
    loop
        exitwhen i > 7
        set angle = i * 45.0
        set loc = Ya(casterLoc, 700.0, angle)   // 使用外部点，不再泄漏
        if loc != null then
            set dummy = CreateUnit(GetOwningPlayer(caster), 'e00N', x, y, angle)
            call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
            call SetUnitAbilityLevel(dummy, 'A1DN', lvl)
            call IssuePointOrderByIdLoc(dummy, 852555, loc)

            set hitGroup = CreateGroup()
            call GroupEnumUnitsInRange(hitGroup, GetLocationX(loc), GetLocationY(loc), 200.0, null)
            loop
                set u = FirstOfGroup(hitGroup)
                exitwhen u == null
                if IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    call UnitDamageTarget(caster, u, dmg, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_FIRE, null)
                endif
                call GroupRemoveUnit(hitGroup, u)
            endloop
            call DestroyGroup(hitGroup)

            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl", GetLocationX(loc), GetLocationY(loc)))
            call RemoveLocation(loc)
        endif
        set i = i + 1
    endloop

    call RemoveLocation(casterLoc)   // 用完销毁
    set casterLoc = null
    set caster = null
    set dummy = null
endfunction

function mA_Cond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0JK'
endfunction

function InitTrig_ActiveSkill takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function mA_Cond))
    call TriggerAddAction(t, function MA)
    set t = null
endfunction
//夏侯1技能
// ====================================
// 冲锋位移回调（每 0.03 秒）
// ====================================
function ChargeStun_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_ChargeStun, id, 1)
    local location startLoc = LoadLocationHandle(udg_HT_ChargeStun, id, 2)
    local location targetLoc = LoadLocationHandle(udg_HT_ChargeStun, id, 3)
    local real angle = LoadReal(udg_HT_ChargeStun, id, 4)
    local real chargeDist = LoadReal(udg_HT_ChargeStun, id, 5)   // 固定冲锋距离
    local real currentDist = LoadReal(udg_HT_ChargeStun, id, 6)
    local real step = chargeDist / 25.0
    local location newLoc
    local real x
    local real y
    local group g
    local unit u
    local unit stunner
    local integer lvl

    // 防崩检查
    if caster == null or IsUnitAliveBJ(caster) == false then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_ChargeStun, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 终点判定（固定距离）
    if currentDist >= chargeDist then
        call SetUnitAnimationWithRarity(caster, "Stand", RARITY_RARE)
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_ChargeStun, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_ChargeStun, id, 6, currentDist)

        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)
        call xn(200.00, newLoc, function NA1)

        // 沿途眩晕马甲
        set lvl = GetUnitAbilityLevel(caster, 'A0HT')
        set x = GetLocationX(newLoc)
        set y = GetLocationY(newLoc)
        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, x, y, 200.0, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            if IsUnitEnemy(u, GetOwningPlayer(caster)) and IsUnitAliveBJ(u) then
                set stunner = CreateUnit(GetOwningPlayer(caster), 'h00A', x, y, 0.00)
                call UnitAddAbility(stunner, 'A0Q2')
                call SetUnitAbilityLevel(stunner, 'A0Q2', lvl)
                call IssueTargetOrder(stunner, "thunderbolt", u)
                call UnitApplyTimedLife(stunner, 'BTLF', 0.50)
                set stunner = null
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g = null

        call RemoveLocation(newLoc)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 主技能施法动作（合并原 A3xa 与 cMmc3）
// ====================================
function A0HT_SpellActions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real chargeDist = 1000.0
    local timer moveTimer
    local integer moveId
    local unit waveDummy
    local location waveStart
    local location waveTarget

    if caster == null then
        set caster = null
        return
    endif

    // 原版伤害基础值设置（力量+敏捷）
    set udg_hurt[3] = GetHeroStr(caster, true) + GetHeroAgi(caster, true)

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)

    if DistanceBetweenPoints(startLoc, targetLoc) <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    call SetUnitAnimationWithRarity(caster, "Attack Throw", RARITY_RARE)

    set moveTimer = CreateTimer()
    set moveId = GetHandleId(moveTimer)
    call SaveUnitHandle(udg_HT_ChargeStun, moveId, 1, caster)
    call SaveLocationHandle(udg_HT_ChargeStun, moveId, 2, startLoc)
    call SaveLocationHandle(udg_HT_ChargeStun, moveId, 3, targetLoc)
    call SaveReal(udg_HT_ChargeStun, moveId, 4, angle)
    call SaveReal(udg_HT_ChargeStun, moveId, 5, chargeDist)
    call SaveReal(udg_HT_ChargeStun, moveId, 6, 0.0)
    call TimerStart(moveTimer, 0.03, true, function ChargeStun_MoveCallback)

    // 震荡波马甲
    set waveStart = GetUnitLoc(caster)
    set waveTarget = GetSpellTargetLoc()
    set waveDummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'h01M', waveStart, AngleBetweenPoints(waveStart, waveTarget))
    call SetUnitAbilityLevel(waveDummy, 'A0Q8', GetUnitAbilityLevel(caster, 'A0HT'))
    call IssuePointOrderLoc(waveDummy, "shockwave", waveTarget)
    call RemoveLocation(waveStart)
    call RemoveLocation(waveTarget)
    set waveDummy = null
    set waveStart = null
    set waveTarget = null

    set caster = null
    set startLoc = null
    set targetLoc = null
    set moveTimer = null
endfunction

