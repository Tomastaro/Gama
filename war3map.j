endfunction

// 大招主逻辑（已修复马甲生命周期、点泄漏，并添加力量×5范围伤害）
function Trig_wxwx2_Conditions takes nothing returns boolean
    return (GetSpellAbilityId()=='A0NZ')and(IsUnitIllusionBJ(GetSpellTargetUnit())==false)
endfunction
function Trig_wxwx2_Actions takes nothing returns nothing
    local location pos
    local group g
    local unit u
    local real extraDamage
    local integer lvl
    set jv[12]=GetSpellTargetUnit()
    set jv[16]=GetTriggerUnit()
    set jc[29]=GetUnitLoc(jv[12])
    set jc[30]=GetUnitLoc(jv[16])
    call CreateNUnitsAtLoc(1,'h02P',GetTriggerPlayer(),jc[29],bj_UNIT_FACING)
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0)
    call SetUnitAbilityLevelSwapped('A0NN',GetLastCreatedUnit(),GetUnitAbilityLevelSwapped('A0NZ',jv[16]))
    call IssueTargetOrderBJ(GetLastCreatedUnit(),"attack",jv[12])
    call CreateNUnitsAtLoc(1,'h02X',GetOwningPlayer(jv[16]),jc[29],bj_UNIT_FACING)
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0)
    call SetUnitManaBJ(GetLastCreatedUnit(),GetHeroStatBJ(bj_HEROSTAT_STR,jv[16],true)*10+(GetUnitAbilityLevelSwapped('A0NZ',jv[16])+1)*80)
    call IssueImmediateOrderById(bj_lastCreatedUnit,852127)
    call SetUnitPositionLocFacingBJ(jv[16],PolarProjectionBJ(jc[29],90.00,AngleBetweenPoints(jc[29],jc[30])),GetUnitFacing(jv[16]))
    call RemoveLocation(jc[30])
    set jc[30]=null
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
        set pos = PolarProjectionBJ(jc[29],400.00,45.00 * bj_forLoopAIndex)
        call CreateNUnitsAtLocFacingLocBJ(1,'h02S',GetOwningPlayer(jv[16]),pos,jc[29])
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0)
        call IssueTargetOrderBJ(GetLastCreatedUnit(),"attack",jv[12])
        call RemoveLocation(pos)
        set pos = null
        set bj_forLoopAIndex=bj_forLoopAIndex+1
    endloop
    call PauseUnitBJ(true,jv[12])
    call PauseUnitBJ(true,jv[16])
    call SetUnitInvulnerable(jv[16],true)
    call SetUnitAnimation(jv[16],"throw")
    call UnitAddAbility(jv[16],'A0OB')
    call CreateNUnitsAtLoc(1,'h02Q',GetOwningPlayer(jv[16]),jc[29],bj_UNIT_FACING)
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0)
    call SetUnitManaBJ(GetLastCreatedUnit(),GetHeroStatBJ(bj_HEROSTAT_STR,jv[16],true)*10+(GetUnitAbilityLevelSwapped('A0NZ',jv[16])+1)*80)
    call IssueImmediateOrderById(bj_lastCreatedUnit,852127)

    // ========== 固定系数3.5的范围伤害 ==========
    set extraDamage = GetHeroStatBJ(bj_HEROSTAT_STR, jv[16], true) * 3.0
    set g = CreateGroup()
    call GroupEnumUnitsInRangeOfLoc(g, jc[29], 350.0, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if IsUnitEnemy(u, GetOwningPlayer(jv[16])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call UnitDamageTargetBJ(jv[16], u, extraDamage, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
        endif
    endloop
    call DestroyGroup(g)
    // =========================================

    call RemoveLocation(jc[29])
    set jc[29]=null
    call PolledWait(2.70)
    call UnitRemoveAbility(jv[16],'A0OB')
    call SetUnitInvulnerable(jv[16],false)
    call PauseUnitBJ(false,jv[16])
    call PauseUnitBJ(false,jv[12])
    set jv[12]=null
    set jv[16]=null
endfunction

