// 条件：A0MQ 且 魔法 ≥ 25%（马甲嚎叫）
// ====================================
function Maxmaxzf_Cond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0MQ' and GetUnitManaPercent(GetTriggerUnit()) >= 25.0
endfunction

// ====================================
// 马甲嚎叫动作（无全局变量冲突）
// ====================================
function maxmaxzf takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location loc
    local unit dummy

    if caster == null then
        set caster = null
        return
    endif

    set loc = GetUnitLoc(caster)
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'e02W', loc, 0)
    call SetUnitAbilityLevel(dummy, 'A0M5', GetUnitAbilityLevel(caster, 'A0MQ'))
    call IssueImmediateOrder(dummy, "howlofterror")
    set dummy = null

    call RemoveLocation(loc)
    set loc = null
    set caster = null
endfunction

