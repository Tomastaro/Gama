endfunction
function O01OII takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function O01O1I takes nothing returns nothing
    local location tempLoc
    local integer hitCount = 0
    set OIO0O = II0IOO()

    if OOI0O[OIO0O] > 0.00 then
        set OO10O[OIO0O] = GetUnitX(O0IIO[OIO0O]) + OOI0O[OIO0O] * Cos(OOIIO[OIO0O])
        set OO1IO[OIO0O] = GetUnitY(O0IIO[OIO0O]) + OOI0O[OIO0O] * Sin(OOIIO[OIO0O])
        call SetUnitPosition(O0IIO[OIO0O], OO10O[OIO0O], OO1IO[OIO0O])

        set OO1OO[OIO0O] = OO1OO[OIO0O] + 1
        if OO1OO[OIO0O] == 1 and GetUnitFlyHeight(O0IIO[OIO0O]) < 50.00 then
            if IsTerrainPathable(OO10O[OIO0O], OO1IO[OIO0O], PATHING_TYPE_FLOATABILITY) then
                call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", OO10O[OIO0O], OO1IO[OIO0O]))
            else
                call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl", OO10O[OIO0O], OO1IO[OIO0O]))
            endif
        endif

        if OO1OO[OIO0O] == 3 then
            set OO1OO[OIO0O] = 0
        endif

        set OOI0O[OIO0O] = OOI0O[OIO0O] - O0I1O[OIO0O]

        if O01OO[OIO0O] == true then
            set tempLoc = GetUnitLoc(OO0IO[OIO0O])
            call EnumDestructablesInCircleBJ(150.00, tempLoc, function O01OII)
            call RemoveLocation(tempLoc)
            set tempLoc = null
        endif

        // ✅ 二次命中：100范围 + 最多3个有效目标（纯新版变量名）
        if O010O[OIO0O] == true and GetUnitState(O0IIO[OIO0O], UNIT_STATE_LIFE) > 0.34 then
            set O0OOO = CreateGroup()
            call GroupEnumUnitsInRange(O0OOO, OO10O[OIO0O], OO1IO[OIO0O], 200., null)

            set O011O = OOI0O[OIO0O] / OIOOO
            set O01IO = O0I1O[OIO0O] / (OIOOO * OIOOO)

            loop
                set O0O0O = FirstOfGroup(O0OOO)
                exitwhen O0O0O == null or hitCount >= 3

                if GetUnitState(O0O0O, UNIT_STATE_LIFE) > 0.34 and O0O0O != O0IIO[OIO0O] and IsUnitInGroup(O0O0O, OOI1O[OIO0O]) == false and IsUnitEnemy(O0O0O, GetOwningPlayer(OO0IO[OIO0O])) == true and IsUnitType(O0O0O, UNIT_TYPE_GROUND) == true and IsUnitType(O0O0O, UNIT_TYPE_MECHANICAL) == false and IsUnitType(O0O0O, UNIT_TYPE_STRUCTURE) == false then
                    set O0OIO = OO0IO[OIO0O]
                    set O0O1O = O0O0O
                    set O00OO = Atan2(GetUnitY(O0O1O) - GetUnitY(O0IIO[OIO0O]), GetUnitX(O0O1O) - GetUnitX(O0IIO[OIO0O]))
                    set O000O = O011O
                    set O00IO = O01IO
                    set O001O = O01OO[OIO0O]
                    set O0IOO = O010O[OIO0O]
                    call TriggerExecute(I101I)
                    set OOI0O[OIO0O] = OOI0O[OIO0O] * 0.80
                    set hitCount = hitCount + 1
                endif

                call GroupAddUnit(OOI1O[OIO0O], O0IIO[OIO0O])
                call GroupAddUnit(OOI1O[OIO0O], O0O0O)
                call GroupRemoveUnit(O0OOO, O0O0O)
                set O0O0O = null
            endloop

            call GroupClear(O0OOO)
            call DestroyGroup(O0OOO)
            set O0OOO = null
        endif
    else
        if O0IIO[OIO0O] != null then
            call PauseUnit(O0IIO[OIO0O], false)
            call SetUnitTimeScale(O0IIO[OIO0O], 1.00)
        endif

        set OO0IO[OIO0O] = null
        set O0IIO[OIO0O] = null
        call GroupClear(OOI1O[OIO0O])
        call DestroyGroup(OOI1O[OIO0O])
        call II001O(OIO0O)
    endif
    set tempLoc = null
endfunction

