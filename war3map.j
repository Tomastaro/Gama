// ========== 主技能条件 ==========
function Maxmax takes nothing returns boolean
    return GetSpellAbilityId() == 'A0TK'
endfunction

// ========== 主技能动作 ==========
function maxmax takes nothing returns nothing
    local unit caster
    local location casterLoc
    local integer lvl
    local real agi
    local location tempLoc
    local unit dummy

    set caster = GetTriggerUnit()
    set casterLoc = GetUnitLoc(caster)
    set lvl = GetUnitAbilityLevel(caster, 'A0TK')
    set agi = GetHeroStatBJ(bj_HEROSTAT_AGI, caster, true)

    // 防重复施放
    if jv[67] != null then
        call RemoveLocation(casterLoc)
        set caster = null
        set casterLoc = null
        return
    endif

    set udg_hurt[5] = agi * 0.4 * (lvl + 1)
    set jv[67] = caster
    set jc[50] = casterLoc

    // 幻影马甲
    set tempLoc = PolarProjectionBJ(casterLoc, 100.00, GetUnitFacing(caster))
    call CreateNUnitsAtLoc(1, 'e02H', GetOwningPlayer(caster), tempLoc, bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        set dummy = null
    endif
    call RemoveLocation(tempLoc)

    set tempLoc = PolarProjectionBJ(casterLoc, 200.00, GetUnitFacing(caster))
    call CreateNUnitsAtLoc(1, 'e02H', GetOwningPlayer(caster), tempLoc, bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        set dummy = null
    endif
    call RemoveLocation(tempLoc)

    set tempLoc = PolarProjectionBJ(casterLoc, 300.00, GetUnitFacing(caster))
    call CreateNUnitsAtLoc(1, 'e02H', GetOwningPlayer(caster), tempLoc, bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        set dummy = null
    endif
    call RemoveLocation(tempLoc)

    // 战争践踏马甲
    call CreateNUnitsAtLoc(1, 'h03G', GetOwningPlayer(caster), casterLoc, bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        call SetUnitAbilityLevelSwapped('A0Q6', dummy, lvl)
        call IssueImmediateOrderBJ(dummy, "stomp")
        set dummy = null
    endif

    call SetUnitInvulnerable(caster, true)
    call TriggerSleepAction(0.01)
    call UnitAddAbility(caster, 'A0TH')
    call SetUnitAnimation(caster, "throw")
    call SetUnitTimeScalePercent(caster, 200.00)

    // 投射马甲
    call CreateNUnitsAtLoc(1, 'h014', GetOwningPlayer(caster), casterLoc, GetUnitFacing(caster))
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        set dummy = null
    endif

    call PolledWait(0.7)
    call CreateNUnitsAtLoc(1, 'h014', GetOwningPlayer(caster), casterLoc, GetUnitFacing(caster))
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        set dummy = null
    endif

    call PolledWait(0.8)
    call SetUnitTimeScalePercent(caster, 100.00)
    call SetUnitAnimation(caster, "spell throw")

    // 终结践踏马甲
    call CreateNUnitsAtLoc(1, 'h030', GetOwningPlayer(caster), casterLoc, bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        call IssueImmediateOrderBJ(dummy, "stomp")
        set dummy = null
    endif

    call PolledWait(1.5)
    call UnitRemoveAbility(caster, 'A0TH')
    call SetUnitInvulnerable(caster, false)

    call RemoveLocation(casterLoc)
    set jc[50] = null
    set jv[67] = null
    set caster = null
    set tempLoc = null
    set dummy = null
endfunction

