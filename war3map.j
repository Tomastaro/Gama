//周瑜大招
// ================================
// 雷霆一击技能（最终修复版 - 可直接编译）
// ================================
function Thunder2_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0H6' and UnitHasBuffBJ(GetTriggerUnit(), 'B05L') == false
endfunction

function Thunder2_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local unit target = GetSpellTargetUnit()
    local real intBonus
    if u == null or target == null then
        set u = null
        set target = null
        return
    endif
    set intBonus = GetHeroInt(u, true) * 5.0
    set jc[228] = GetUnitLoc(u)
    set udg_spysight = GetOwningPlayer(u)
    call CreateNUnitsAtLoc(1, 'e02K', udg_spysight, jc[228], bj_UNIT_FACING)
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
    call SetUnitAbilityLevelSwapped('A0P5', bj_lastCreatedUnit, GetUnitAbilityLevelSwapped('A0H6', u))
    call SetUnitAbilityLevelSwapped('A0M2', bj_lastCreatedUnit, GetUnitAbilityLevelSwapped('A0H6', u))
    call IssueTargetOrderById(bj_lastCreatedUnit, 852119, target)
    if intBonus > 0 and IsUnitEnemy(target, GetOwningPlayer(u)) then
        call UnitDamageTargetBJ(u, target, intBonus, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    endif
    call RemoveLocation(jc[228])
    set jc[228] = null
    set u = null
    set target = null
endfunction

function sBx takes nothing returns boolean
    return GetSpellAbilityId() == 'A0H6' and UnitHasBuffBJ(GetTriggerUnit(), 'B05L') == true
endfunction

function SBx takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local unit target = GetSpellTargetUnit()
    local real intBonus
    if u == null or target == null then
        set u = null
        set target = null
        return
    endif
    set intBonus = GetHeroInt(u, true) * 5.0
    set jc[228] = GetUnitLoc(u)
    set udg_spysight = GetOwningPlayer(u)
    call CreateNUnitsAtLoc(1, 'e02K', udg_spysight, jc[228], bj_UNIT_FACING)
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
    call SetUnitAbilityLevelSwapped('A0P5', bj_lastCreatedUnit, GetUnitAbilityLevelSwapped('A0H6', u))
    call SetUnitAbilityLevelSwapped('A0M2', bj_lastCreatedUnit, 1 + GetUnitAbilityLevelSwapped('A0H6', u))
    call IssueTargetOrderById(bj_lastCreatedUnit, 852119, target)
    if intBonus > 0 and IsUnitEnemy(target, GetOwningPlayer(u)) then
        call UnitDamageTargetBJ(u, target, intBonus, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    endif
    call RemoveLocation(jc[228])
    set jc[228] = null
    set u = null
    set target = null
endfunction

function QBzxg6 takes nothing returns nothing
    local unit source = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local location loc
    if source == null or target == null then
        set source = null
        set target = null
        return
    endif
    if GetUnitTypeId(source) == 'e02K' then
        set loc = GetUnitLoc(target)
        call CreateNUnitsAtLoc(1, 'e02L', udg_spysight, loc, bj_UNIT_FACING)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        call SetUnitAbilityLevelSwapped('A0P4', bj_lastCreatedUnit, GetUnitAbilityLevelSwapped('A0M2', source))
        call IssueImmediateOrderBJ(bj_lastCreatedUnit, "thunderclap")
        call RemoveLocation(loc)
        set loc = null
    endif
    set source = null
    set target = null
endfunction

function RegisterDamageEventForZhouYu takes nothing returns nothing
    local unit u = GetTriggerUnit()
    if u != null then
        call TriggerRegisterUnitEvent(udg_ZhouYuDamageTrig, u, EVENT_UNIT_DAMAGED)
    endif
    set u = null
endfunction

function InitDamageEventZhouYu takes nothing returns nothing
    local group g = CreateGroup()
    local unit u
    local trigger enterTrig = CreateTrigger()
    
    set udg_ZhouYuDamageTrig = CreateTrigger()
    call TriggerAddAction(udg_ZhouYuDamageTrig, function QBzxg6)
    
    call GroupEnumUnitsInRect(g, bj_mapInitialPlayableArea, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if u != null then
            call TriggerRegisterUnitEvent(udg_ZhouYuDamageTrig, u, EVENT_UNIT_DAMAGED)
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
    
    call TriggerRegisterEnterRectSimple(enterTrig, bj_mapInitialPlayableArea)
    call TriggerAddAction(enterTrig, function RegisterDamageEventForZhouYu)
    set enterTrig = null
endfunction

function InitTrig_ZHOUYUSKILL takes nothing returns nothing
    local trigger t1 = CreateTrigger()
    local trigger t2 = CreateTrigger()
    
    call TriggerRegisterAnyUnitEventBJ(t1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t1, Condition(function Thunder2_Conditions))
    call TriggerAddAction(t1, function Thunder2_Actions)
    
    call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t2, Condition(function sBx))
    call TriggerAddAction(t2, function SBx)
    
    call InitDamageEventZhouYu()
    
    set t1 = null
    set t2 = null
endfunction
