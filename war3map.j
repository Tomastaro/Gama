    set t = null
endfunction

//夏侯2技能
// ====================================
// A0NP 技能（howlofterror 马甲施放）
// ====================================
function Maxmaxz_Cond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0NP'
endfunction

function Maxmaxz_Act takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local location loc
    local unit dummy
    if u == null then
        set u = null
        return
    endif
    set loc = GetUnitLoc(u)
    set dummy = CreateUnitAtLoc(GetOwningPlayer(u), 'e021', loc, 0)
    call IssueImmediateOrder(dummy, "howlofterror")
    call RemoveLocation(loc)
    set loc = null
    set dummy = null
    set u = null
endfunction

function Axzg4_Cond takes nothing returns boolean
    local integer id = GetSpellAbilityId()
    return id == 'A0HT' or id == 'A0AN' or id == 'A0MP'
endfunction

// ====================================
// 条件过滤：存活敌人
// ====================================
function Axzg4_Filter takes nothing returns boolean
    return not IsUnitDeadBJ(GetFilterUnit()) and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_tempUnit))
endfunction

// ====================================
// 牵引目标过滤：特定Buff组合
// ====================================
function Axzg4_PullFilter takes nothing returns boolean
    local unit f = GetFilterUnit()
    local boolean b1 = UnitHasBuffBJ(f, 'B09U') and UnitHasBuffBJ(f, 'B05C')
    local boolean b2 = UnitHasBuffBJ(f, 'B030') and UnitHasBuffBJ(f, 'B05B')
    local boolean b3 = UnitHasBuffBJ(f, 'B039')
    set f = null
    return IsUnitEnemy(GetFilterUnit(), udg_tempPlayer) and (b1 or b2 or b3)
endfunction

// ====================================
// 计时器回调：每0.06秒执行牵引
// ====================================
function Axzg4_TimerCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_Pull, id, 1)
    local unit center = LoadUnitHandle(udg_HT_Pull, id, 2)
    local location targetPoint = LoadLocationHandle(udg_HT_Pull, id, 3)
    local group initialGroup = LoadGroupHandle(udg_HT_Pull, id, 4)
    local integer pullCount = LoadInteger(udg_HT_Pull, id, 5)
    local boolean firstRun = LoadBoolean(udg_HT_Pull, id, 6)
    local location centerLoc
    local location enemyLoc
    local location newLoc
    local real angle
    local group pullGroup
    local unit u

    // 检查施法者是否有效（存在且存活）
    if caster == null or center == null or IsUnitAliveBJ(caster) == false then
        // 清理前关闭无敌
        if caster != null then
            call SetUnitInvulnerable(caster, false)
        endif
        call DestroyGroup(initialGroup)
        call RemoveLocation(targetPoint)
        call RemoveUnit(center)
        call FlushChildHashtable(udg_HT_Pull, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set center = null
        set targetPoint = null
        set initialGroup = null
        return
    endif

    if firstRun then
        call SaveBoolean(udg_HT_Pull, id, 6, false)
    else
        set centerLoc = GetUnitLoc(center)
        set udg_tempPlayer = GetOwningPlayer(caster)
        set pullGroup = GetUnitsInRangeOfLocMatching(1200.00, centerLoc, Condition(function Axzg4_PullFilter))
        set udg_tempPlayer = null

        loop
            set u = FirstOfGroup(pullGroup)
            exitwhen u == null
            call GroupRemoveUnit(pullGroup, u)

            set enemyLoc = GetUnitLoc(u)
            set angle = AngleBetweenPoints(centerLoc, targetPoint)
            set newLoc = PolarProjectionBJ(enemyLoc, 80.00, angle)

            call xn(192.00, enemyLoc, function cBxz)
            call SetUnitPositionLoc(u, newLoc)

            if pullCount == 1 or pullCount == 4 or pullCount == 7 or pullCount == 10 or pullCount == 13 or pullCount == 16 or pullCount == 19 or pullCount == 22 then
                call UnitDamageTarget(caster, u, udg_hurt[3] * 3.5, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, null)
            endif

            call DestroyEffect(AddSpecialEffectLoc("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", enemyLoc))
            call RemoveLocation(enemyLoc)
            call RemoveLocation(newLoc)
            set enemyLoc = null
            set newLoc = null
        endloop

        call DestroyGroup(pullGroup)
        call RemoveLocation(centerLoc)
        set pullGroup = null
        set centerLoc = null

        set pullCount = pullCount + 1
        call SaveInteger(udg_HT_Pull, id, 5, pullCount)

        if pullCount > 15 then
            // 牵引结束，关闭无敌
            call SetUnitInvulnerable(caster, false)
            call DestroyGroup(initialGroup)
            call RemoveLocation(targetPoint)
            call RemoveUnit(center)
            call FlushChildHashtable(udg_HT_Pull, id)
            call DestroyTimer(t)
            set t = null
            set caster = null
            set center = null
            set initialGroup = null
            return
        endif
    endif

    set t = null
    set caster = null
    set center = null
    set initialGroup = null
endfunction
// ====================================
// 主技能施法动作
// ====================================
function Axzg4_Act takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location casterLoc
    local location targetLoc
    local group initialGroup
    local unit centerDummy
    local unit visualDummy
    local timer t
    local integer id
    local real hurt = 0

    if caster == null then
        set caster = null
        return
    endif

    // 获取 udg_hurt[3] 的值
    set hurt = udg_hurt[3]

    set casterLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()

    // 选取初始200范围内的存活敌人
    set udg_tempUnit = caster
    set initialGroup = GetUnitsInRangeOfLocMatching(200.00, casterLoc, Condition(function Axzg4_Filter))
    set udg_tempUnit = null

    // 创建引力中心马甲
    set centerDummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'ewsp', casterLoc, 0)
    call ShowUnitHide(centerDummy)

    // 创建一次性的视觉马甲
    set visualDummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'ewsp', casterLoc, 0)
    call ShowUnitHide(visualDummy)
    call UnitApplyTimedLife(visualDummy, 'BTLF', 1.0)
    set visualDummy = null

    // ===== 开启无敌 =====
    call SetUnitInvulnerable(caster, true)

    // 创建独立计时器
    set t = CreateTimer()
    set id = GetHandleId(t)
    call SaveUnitHandle(udg_HT_Pull, id, 1, caster)
    call SaveUnitHandle(udg_HT_Pull, id, 2, centerDummy)
    call SaveLocationHandle(udg_HT_Pull, id, 3, targetLoc)
    call SaveGroupHandle(udg_HT_Pull, id, 4, initialGroup)
    call SaveInteger(udg_HT_Pull, id, 5, 0)
    call SaveBoolean(udg_HT_Pull, id, 6, true)
    call TimerStart(t, 0.06, true, function Axzg4_TimerCallback)

    // 清理局部
    call RemoveLocation(casterLoc)
    set caster = null
    set casterLoc = null
    set targetLoc = null
    set initialGroup = null
    set centerDummy = null
    set t = null
endfunction
// ====================================
// 统一初始化所有触发器
// ====================================
function InitTrig_AllPulls takes nothing returns nothing
    local trigger trg

    // 确保哈希表存在
    if udg_HT_Pull == null then
        set udg_HT_Pull = InitHashtable()
    endif

    // A0NP 技能
    set trg = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trg, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trg, Condition(function Maxmaxz_Cond))
    call TriggerAddAction(trg, function Maxmaxz_Act)

    // 主拉人技能
    set trg = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trg, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trg, Condition(function Axzg4_Cond))
    call TriggerAddAction(trg, function Axzg4_Act)

    set trg = null
endfunction


//夏侯3技能
// ====================================
function BNx takes nothing returns boolean
    return GetUnitTypeId(GetAttacker()) == 'N00W' and GetHeroStatBJ(bj_HEROSTAT_STR, GetAttacker(), false) < 130 and IsUnitIllusionBJ(GetAttacker()) == false and IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker()))
endfunction

// ====================================
// 攻击动作：独立计数器，阈值 174 时增加属性
// ====================================
function FNx takes nothing returns nothing
    local unit attacker = GetAttacker()
    local integer id = GetHandleId(attacker)
    local integer currentStack = LoadInteger(udg_HT_AttackStack, id, 0)
    local integer abilityLevel = GetUnitAbilityLevel(attacker, 'A0B9')
    local integer increment = 0

    // 根据技能等级决定增量（原版逻辑）
    if abilityLevel == 1 then
        set increment = 3
    elseif abilityLevel == 2 then
        set increment = 4
    elseif abilityLevel == 3 then
        set increment = 5
    elseif abilityLevel == 4 then
        set increment = 6
    endif

    set currentStack = currentStack + increment

    if currentStack > 173 then
        call ModifyHeroStat(0, attacker, 0, 2)   // 力量 +2
        call ModifyHeroStat(1, attacker, 0, 1)   // 敏捷 +1
        call SaveInteger(udg_HT_AttackStack, id, 0, 0)   // 重置计数器
    else
        call SaveInteger(udg_HT_AttackStack, id, 0, currentStack)
    endif

    set attacker = null
endfunction

// ====================================
// 单位死亡清理（可选，防止哈希表残余）
// ====================================
function AttackStack_Cleanup takes nothing returns nothing
    local unit u = GetDyingUnit()
    if GetUnitTypeId(u) == 'N00W' then
        call FlushChildHashtable(udg_HT_AttackStack, GetHandleId(u))
    endif
    set u = null
endfunction

// ====================================
// 初始化所有触发器
// ====================================
function Init_AOX_Trigger takes nothing returns nothing
    local trigger t

    // 确保哈希表存在
    if udg_HT_AttackStack == null then
        set udg_HT_AttackStack = InitHashtable()
    endif

    // 攻击事件
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(t, Condition(function BNx))
    call TriggerAddAction(t, function FNx)

    // 死亡清理（可选）
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(t, function AttackStack_Cleanup)

    set t = null
endfunction
//水里
// ========== 哈希表存取层 ==========
function InitHT_Water takes nothing returns nothing
    if udg_HT == null then
        set udg_HT = InitHashtable()
    endif
endfunction

function SetHero_Water takes unit u returns nothing
    call SaveUnitHandle(udg_HT, 3341, 0, u)
endfunction

function GetHero_Water takes nothing returns unit
    return LoadUnitHandle(udg_HT, 3341, 0)
endfunction

function SetMercenary_Water takes unit u returns nothing
    call SaveUnitHandle(udg_HT, 3342, 0, u)
endfunction

function GetMercenary_Water takes nothing returns unit
    return LoadUnitHandle(udg_HT, 3342, 0)
endfunction

function SetBuffId_Water takes integer id returns nothing
    call SaveInteger(udg_HT, 3071, 0, id)
endfunction

function GetBuffId_Water takes nothing returns integer
    return LoadInteger(udg_HT, 3071, 0)
endfunction

// ========== 核心维护主循环（0.5秒一次，业务逻辑完全不变） ==========
function MaintainActions_Water takes nothing returns nothing
    local unit hero = GetHero_Water()
    local unit merc = GetMercenary_Water()
    local location loc
    local boolean keep = false

    if hero == null or not IsUnitAliveBJ(hero) then
        set hero = null
        set merc = null
        set loc = null
        return
    endif

    set loc = GetUnitLoc(hero)
    set keep = (IsTerrainPathableBJ(loc, PATHING_TYPE_FLOATABILITY) == false) or (UnitHasBuffBJ(hero, GetBuffId_Water()) == true)
    
    // 魔法书控制（水上添加，陆地移除）
    if keep then
        if GetUnitAbilityLevel(hero, 'A0J8') == 0 then
            call UnitAddAbility(hero, 'A0J8')
        endif
    else
        if GetUnitAbilityLevel(hero, 'A0J8') > 0 then
            call UnitRemoveAbility(hero, 'A0J8')
        endif
    endif
    
    // 马甲维护逻辑
    if keep then
        if merc == null or not IsUnitAliveBJ(merc) then
            set merc = CreateUnitAtLoc(GetOwningPlayer(hero), 'n033', loc, 0.00)
            call ShowUnitHide(merc)
            call SetMercenary_Water(merc)
        endif
    else
        if merc != null and IsUnitAliveBJ(merc) then
            call KillUnit(merc)
        endif
    endif
    
    call RemoveLocation(loc)
    set hero = null
    set merc = null
    set loc = null
endfunction

// ========== 启动维护计时器 ==========
function StartMaintainTimer_Water takes nothing returns nothing
    local timer t
    set t = CreateTimer()
    call TimerStart(t, 0.50, true, function MaintainActions_Water)
    set t = null
endfunction

// ========== 事件监听：英雄创建匹配 ==========
function HeroFind_Cond_Water takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'E00X'
endfunction

function HeroFind_Act_Water takes nothing returns nothing
    local trigger trg
    set trg = GetTriggeringTrigger()
    
    call SetHero_Water(GetTriggerUnit())
    call SetBuffId_Water('B06H')
    set udg_SystemActive = true
    call StartMaintainTimer_Water()
    
    call DestroyTrigger(trg)
    set trg = null
endfunction

// ========== 注册监听事件 ==========
function StartHeroListen_Water takes nothing returns nothing
    local trigger trg
    set trg = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trg, EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(trg, Condition(function HeroFind_Cond_Water))
    call TriggerAddAction(trg, function HeroFind_Act_Water)
    set trg = null
endfunction

// ========== 系统总入口 ==========
function StartSystem_Water takes nothing returns nothing
    if udg_SystemActive == true then
        return
    endif

    call InitHT_Water()
    set udg_ScanRetry = 0
    call StartHeroListen_Water()
endfunction


//暴走虎痴
function MovingKiller_TimerCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_MovingKiller, id, 1)
    local integer lvl = LoadInteger(udg_HT_MovingKiller, id, 2)
    local real agi = LoadReal(udg_HT_MovingKiller, id, 3)
    local integer count = LoadInteger(udg_HT_MovingKiller, id, 4)
    local effect sfx1 = LoadEffectHandle(udg_HT_MovingKiller, id, 5)
    local effect sfx2 = LoadEffectHandle(udg_HT_MovingKiller, id, 6)

    local real casterX
    local real casterY
    local real faceRad
    local real x
    local real y
    local location loc  // 新增：仅创建1个坐标点，彻底修复双重泄漏
    local group g
    local unit u
    local real dmg
    local real angleRad

    // 防崩：英雄无效则清理
    if caster == null or GetUnitState(caster, UNIT_STATE_LIFE) <= 0.05 then
        call DestroyEffect(sfx1)
        call DestroyEffect(sfx2)
        call FlushChildHashtable(udg_HT_MovingKiller, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set sfx1 = null
        set sfx2 = null
        return
    endif

    set count = count + 1

    // 超过8次（4秒）则结束
    if count > 8 then
        call DestroyEffect(sfx1)
        call DestroyEffect(sfx2)
        call FlushChildHashtable(udg_HT_MovingKiller, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set sfx1 = null
        set sfx2 = null
        return
    endif

    call SaveInteger(udg_HT_MovingKiller, id, 4, count)

    // 原生坐标计算，仅生成1个location（修复原代码双重泄漏）
    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)
    set faceRad = GetUnitFacing(caster) * bj_DEGTORAD
    set x = casterX + 130.0 * Cos(faceRad)
    set y = casterY + 130.0 * Sin(faceRad)
    set loc = Location(x, y)

    // 创建马甲
    call CreateUnit(GetOwningPlayer(caster), 'h02Z', x, y, GetUnitFacing(caster))
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.00)
    call IssueImmediateOrder(bj_lastCreatedUnit, "stomp")

    // 范围伤害+击退（完全兼容你原有的Xn函数）
    set g = Xn(250.00, loc)
    if g != null then
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            call GroupRemoveUnit(g, u)

            if IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and GetUnitState(u, UNIT_STATE_LIFE) > 0.05 then
                set dmg = 0.85 * lvl * agi
                call UnitDamageTarget(caster, u, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)

                // 击退调用
                set O0OIO = caster
                set O0O1O = u
                set angleRad = Atan2(GetUnitY(u) - casterY, GetUnitX(u) - casterX)
                set O00OO = angleRad
                set O000O = 350.0
                set O00IO = 1150.0
                set O001O = false
                set O0IOO = false
                call TriggerExecute(I101I)
            endif
        endloop
        call DestroyGroup(g)
    endif

    // 周期特效
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\FreezingRing5.mdl", caster, "origin"))
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\IceNova-b.mdl", caster, "chest"))

    // 统一清理资源
    call RemoveLocation(loc)
    set loc = null
    set g = null
    set u = null
    set t = null
    set caster = null
    set sfx1 = null
    set sfx2 = null
endfunction
// ====================================
// 施法动作
// ====================================
function Trig_movingkiller1x_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local integer lvl = GetUnitAbilityLevel(caster, 'A0XZ')
    local real agi = GetHeroAgi(caster, true)
    local timer t = CreateTimer()
    local integer id = GetHandleId(t)
    local effect sfx1
    local effect sfx2

    // 恢复默认移速
    call SetUnitMoveSpeed(caster, GetUnitDefaultMoveSpeed(caster))

    // 持续特效（附着在英雄身上，技能结束时移除）
    set sfx1 = AddSpecialEffectTarget("war3mapImported\\FreezingRing5.mdl", caster, "origin")
    set sfx2 = AddSpecialEffectTarget("war3mapImported\\IceNova-b.mdl", caster, "chest")

    // 存储数据
    call SaveUnitHandle(udg_HT_MovingKiller, id, 1, caster)
    call SaveInteger(udg_HT_MovingKiller, id, 2, lvl)
    call SaveReal(udg_HT_MovingKiller, id, 3, agi)
    call SaveInteger(udg_HT_MovingKiller, id, 4, 0)
    call SaveEffectHandle(udg_HT_MovingKiller, id, 5, sfx1)
    call SaveEffectHandle(udg_HT_MovingKiller, id, 6, sfx2)

    call TimerStart(t, 0.50, true, function MovingKiller_TimerCallback)

    set caster = null
    set t = null
    set sfx1 = null
    set sfx2 = null
endfunction

// ====================================
// 条件
// ====================================
function Trig_movingkiller1x_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0XZ'
endfunction

// ====================================
// 初始化
// ====================================
function InitMovingKillerSystem takes nothing returns nothing
    local trigger t
    if udg_HT_MovingKiller == null then
        set udg_HT_MovingKiller = InitHashtable()
    endif
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_movingkiller1x_Conditions))
    call TriggerAddAction(t, function Trig_movingkiller1x_Actions)
    set t = null
endfunction
//马超1
// ====================================
// 范围伤害回调（修复版）
// ====================================
function sRxzhgx9 takes nothing returns nothing
    local unit target = GetEnumUnit()
    local unit caster = udg_tempCaster
    local integer lv
    local real agi
    local real dmg

    if caster == null or target == null then
        set target = null
        set caster = null
        return
    endif

    set lv = GetUnitAbilityLevel(caster, 'A0MQ')
    set agi = GetHeroAgi(caster, true)

    if IsUnitEnemy(target, GetOwningPlayer(caster)) and IsUnitAliveBJ(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
        // 固定部分
        set dmg = 50.0 * lv
        // 57 + 额外攻击力部分
        set dmg = dmg + (0.3 + 0.3 * lv) * (57.0 + udg_LubuAttack3)
        // 敏捷部分
        set dmg = dmg + lv * agi

        call UnitDamageTarget(caster, target, dmg, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, null)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target, "origin"))
    endif

    set target = null
    set caster = null
endfunction

// ====================================
// 主技能动作：范围伤害
// ====================================
function cMtzsr8 takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location loc
    local group g

    if caster == null then
        set caster = null
        return
    endif

    set loc = GetUnitLoc(caster)
    set g = Xn(360.00, loc)    // 地图原有单位组获取函数

    // 将施法者传入临时全局变量，供回调使用
    set udg_tempCaster = caster
    call ForGroup(g, function sRxzhgx9)
    set udg_tempCaster = null

    call DestroyGroup(g)
    call RemoveLocation(loc)
    set caster = null
    set loc = null
    set g = null
endfunction

