                    call UnitApplyTimedLife(effectUnit, 'BHwe', 0.20)
                    call SaveUnitHandle(ght_temp, id, 0x1CDCF900, effectUnit)
                endif
                set ydul_i = ydul_i + 1
            endloop
            
            call SetUnitX(caster, tarX + offsetX)
            call SetUnitY(caster, tarY + offsetY)
            
            if LoadInteger(ght_temp, id, 0xB6484A0B) <= 0 then
                call SaveInteger(ght_temp, id, 0xB6484A0B, 205)
            else
                call SaveInteger(ght_temp, id, 0xB6484A0B, LoadInteger(ght_temp, id, 0xB6484A0B) - 35)
            endif
            
            set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e09I', tarX + randDist * Cos(randAng), tarY + randDist * Sin(randAng), AngleBetweenUnits(caster, target))
