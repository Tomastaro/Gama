// ================================
// 技能 A0RS（冲锋 + 飞将锁定）
// ================================
function RAt3 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0RS'
endfunction

function AAt3 takes nothing returns nothing
    set cvt[3] = 0.0
    set Cvt[3] = GetSpellAbilityUnit()
    set dvt[3] = GetUnitLoc(Cvt[3])
    set Dvt[3] = GetSpellTargetLoc()
    set fvt[3] = AngleBetweenPoints(dvt[3], Dvt[3])
    set Fvt[3] = DistanceBetweenPoints(dvt[3], Dvt[3])
    if Fvt[3] <= 1.0 then
        call UnitRemoveAbility(Cvt[3], 'A07G')
        set Cvt[3] = null
        call RemoveLocation(dvt[3])
        call RemoveLocation(Dvt[3])
        set dvt[3] = null
        set Dvt[3] = null
    else
        call PauseUnit(Cvt[3], true)
        call SetUnitAnimationWithRarity(Cvt[3], "Spell Throw", RARITY_RARE)
        call UnitAddAbility(Cvt[3], 'A07G')
        call CreateNUnitsAtLoc(1, 'e02A', GetOwningPlayer(Cvt[3]), Dvt[3], bj_UNIT_FACING)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
        call SetUnitAbilityLevelSwapped('A0H9', GetLastCreatedUnit(), 2)
        call IssueImmediateOrderById(GetLastCreatedUnit(), 852127)
        call EnableTrigger(txt3)
        call PolledWait(1.8)
        if Cvt[3] != null then
            call PauseUnit(Cvt[3], false)
            call UnitRemoveAbility(Cvt[3], 'A07G')
        endif
        set Cvt[3] = null
        call RemoveLocation(dvt[3])
        call RemoveLocation(Dvt[3])
        set dvt[3] = null
        set Dvt[3] = null
    endif
endfunction

// 过滤器函数
function Trig_flyhit01Func002002001003 takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) and IsUnitAliveBJ(GetFilterUnit()) and GetUnitAbilityLevelSwapped('Avul', GetFilterUnit()) == 0 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(Cvt[3]))
endfunction

function Trig_flyhit01Func003Func001002001003 takes nothing returns boolean
    return not IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) and IsUnitAliveBJ(GetFilterUnit()) and GetUnitAbilityLevelSwapped('Avul', GetFilterUnit()) == 0 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(Cvt[3]))
endfunction

function BAt3 takes nothing returns nothing
    if Cvt[3] == null then
        call DisableTrigger(GetTriggeringTrigger())
        return
    endif
    if cvt[3] >= Fvt[3] then
        call xn(450., Dvt[3], function NA)
        call DisableTrigger(GetTriggeringTrigger())

        set jc[554] = GetUnitLoc(Cvt[3])

        set udg_tmpGroup = GetUnitsInRangeOfLocMatching(250.00, jc[554], Condition(function Trig_flyhit01Func002002001003))
        set udg_feijiang = GroupPickRandomUnit(udg_tmpGroup)
        call DestroyGroup(udg_tmpGroup)
        set udg_tmpGroup = null

        if udg_feijiang == null then
            set udg_tmpGroup = GetUnitsInRangeOfLocMatching(250.00, jc[554], Condition(function Trig_flyhit01Func003Func001002001003))
            set udg_feijiang = GroupPickRandomUnit(udg_tmpGroup)
            call DestroyGroup(udg_tmpGroup)
            set udg_tmpGroup = null
        endif

        if udg_feijiang == null then
            call PolledWait(0.1)
            if Cvt[3] != null then
                call PauseUnit(Cvt[3], false)
                call SetUnitAnimationWithRarity(Cvt[3], "Stand", RARITY_RARE)
                call UnitRemoveAbility(Cvt[3], 'A07G')
                set jv[600] = Cvt[3]
                call UnitAddAbilityBJ('A0QQ', jv[600])
                call UnitAddAbilityBJ('A0V5', jv[600])
                call PolledWait(2.00 + 2.00 * I2R(GetUnitAbilityLevelSwapped('A0RS', jv[600])))
                call UnitRemoveAbilityBJ('A0V5', jv[600])
                call UnitRemoveAbilityBJ('A0QQ', jv[600])
                set jv[600] = null
            endif
        endif

        if udg_feijiang != null then
            set jc[555] = GetUnitLoc(udg_feijiang)
            call CreateNUnitsAtLoc(1, 'e034', GetOwningPlayer(Cvt[3]), jc[554], GetUnitFacing(Cvt[3]))
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "carrionswarm", jc[555])
            call SetUnitFacingTimed(Cvt[3], AngleBetweenPoints(jc[554], jc[555]), 0)
            call AddSpecialEffectTargetUnitBJ("origin", Cvt[3], "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl")
            call DestroyEffect(GetLastCreatedEffectBJ())
        endif

        call RemoveLocation(jc[554])
        call RemoveLocation(jc[555])
        set jc[554] = null
        set jc[555] = null
    else
        set cvt[3] = cvt[3] + (Fvt[3] / 25)
        call SetUnitPositionLocFacingBJ(Cvt[3], Ya(dvt[3], cvt[3], fvt[3]), fvt[3])
    endif
endfunction

