function Init_A041 takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function xMmc8))
    call TriggerAddAction(t, function cMmc8)
    set t = null
endfunction
// ====================================
// 冰晶系列技能：冰镜环绕 + 闪电伤害 + 爆炸收尾
// 依赖全局哈希表：udg_IceHT
// ====================================

// ========== 哈希表工具函数 ==========
function IceStoreUnit takes timer t, integer key, unit u returns nothing
    local integer id = GetHandleId(t)
    call SaveUnitHandle(udg_IceHT, id, key, u)
endfunction

function IceLoadUnit takes timer t, integer key returns unit
    return LoadUnitHandle(udg_IceHT, GetHandleId(t), key)
endfunction

function IceFlush takes timer t returns nothing
    call FlushChildHashtable(udg_IceHT, GetHandleId(t))
endfunction

// ========== 统一恢复施法者状态 ==========
function IceRestoreCasterState takes unit caster returns nothing
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        return
    endif
    call SetUnitFlyHeight(caster, 0.0, 8000.0)
    call PauseUnit(caster, false)
    call SetUnitInvulnerable(caster, false)
    call UnitRemoveAbility(caster, 'Amrf')
    call SetUnitTimeScalePercent(caster, 100.0)
    call ResetUnitAnimation(caster)
    call UnitRemoveAbility(caster, 'A0L9')
endfunction

// ========== 周期环绕与攻击逻辑 ==========
function IceMirrorPeriodic takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = IceLoadUnit(t, 0)
    local unit target = IceLoadUnit(t, 1)
    local unit dummy = IceLoadUnit(t, 2)
    local real angle
    local real x
    local real y
    
    // 异常兜底：提前终止，写标记，不销毁计时器、不清空哈希表
    if caster == null or target == null or dummy == null or GetWidgetLife(target) <= 0.405 or GetWidgetLife(caster) <= 0.405 then
        call IceRestoreCasterState(caster)
        call PauseTimer(t)
        // 写入提前结束标记：7号key存1表示已提前终止
        call SaveInteger(udg_IceHT, id, 7, 1)
        set t = null
        set caster = null
        set target = null
        set dummy = null
        return
    endif
    
    set angle = GetRandomReal(0, 2 * bj_PI)
    set x = GetUnitX(target) + 300 * Cos(angle)
    set y = GetUnitY(target) + 300 * Sin(angle)
    
    call SetUnitX(caster, x)
    call SetUnitY(caster, y)
    call SetUnitFacing(caster, angle * bj_RADTODEG)
    call SetUnitAnimation(caster, "Attack")
    call SetUnitX(dummy, x)
    call SetUnitY(dummy, y)
    call IssueTargetOrder(dummy, "thunderbolt", target)
    
    set caster = null
    set target = null
    set dummy = null
    set t = null
endfunction

// ========== 主技能条件 ==========
function IceMirrorCond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0L5'
endfunction

// ========== 装饰马甲清理回调 ==========
function IceDecoCleanup takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local group g = LoadGroupHandle(udg_IceHT, id, 0)
    local unit u
    
    call PauseTimer(t)
    if g != null then
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            call GroupRemoveUnit(g, u)
            if GetWidgetLife(u) > 0.405 then
                call RemoveUnit(u)
            endif
        endloop
        call DestroyGroup(g)
    endif
    call FlushChildHashtable(udg_IceHT, id)
    call DestroyTimer(t)
    
    set t = null
    set g = null
    set u = null
endfunction

// ========== 主技能施法逻辑 ==========
function IceMirrorAct takes nothing returns nothing
    local unit caster = GetSpellAbilityUnit()
    local unit target = GetSpellTargetUnit()
    local player p
    local integer lvl
    local real casterX
    local real casterY
    local real targetX
    local real targetY
    local real targetAngle // 弧度
    local integer i
    local real posX
    local real posY
    local real angle
    local real faceAngle
    local unit dummy1
    local unit tempUnit
    local group decoGroup
    local unit u
    local timer t
    local timer decoTimer
    local integer decoId
    local integer timerId
    local real duration
    local integer earlyEnd

    // 前置校验：目标无效直接终止
    if target == null or GetWidgetLife(target) <= 0.405 then
        set caster = null
        set target = null
        return
    endif

    set p = GetOwningPlayer(caster)
    set lvl = GetUnitAbilityLevel(caster, 'A0L5')
    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)
    set targetX = GetUnitX(target)
    set targetY = GetUnitY(target)
    set targetAngle = Atan2(targetY - casterY, targetX - casterX) // 弧度
    set decoGroup = CreateGroup()
    set decoTimer = CreateTimer()
    set decoId = GetHandleId(decoTimer)
    set duration = 1.97 + 0.75 * lvl
    
    if GetUnitAbilityLevel(target, 'B041') > 0 then
        set duration = duration + 2.0
    endif
    
    // 目标点特效马甲
    set tempUnit = CreateUnit(p, 'e02D', targetX, targetY, bj_UNIT_FACING)
    if tempUnit != null then
        call SetUnitScalePercent(tempUnit, 350.0, 100.0, 100.0)
        call UnitApplyTimedLife(tempUnit, 'BTLF', 8.0)
        set tempUnit = null
    endif
    
    // 主攻击马甲，创建失败直接终止
    set dummy1 = CreateUnit(p, 'e03D', casterX, casterY, targetAngle * bj_RADTODEG)
    if dummy1 == null then
        call DestroyGroup(decoGroup)
        call DestroyTimer(decoTimer)
        set caster = null
        set target = null
        set p = null
        return
    endif
    call UnitAddAbility(dummy1, 'A0L6')
    call UnitApplyTimedLife(dummy1, 'BTLF', 8.0)
    // 哈希表存储马甲→英雄映射
    call SaveUnitHandle(udg_IceHT, GetHandleId(dummy1), 0, caster)
    
    // 施法者状态设置
    call SetUnitTimeScalePercent(caster, 500.0)
    call PauseUnit(caster, true)
    call SetUnitInvulnerable(caster, true)
    call UnitAddAbility(caster, 'Amrf')
    call SetUnitFlyHeight(caster, 400.0, 8000.0)
    call UnitAddAbility(caster, 'A0L9')
    call UnitAddAbility(dummy1, 'Amrf')
    call SetUnitFlyHeight(dummy1, 400.0, 8000.0)
    call IssueTargetOrder(dummy1, "thunderbolt", target)
    
    // 生成6组装饰马甲（角度统一弧度计算）
    set i = 1
    loop
        exitwhen i > 6
        set angle = targetAngle + (60.0 * i) * bj_DEGTORAD
        set posX = targetX + 300.0 * Cos(angle)
        set posY = targetY + 300.0 * Sin(angle)
        set faceAngle = Atan2(targetY - posY, targetX - posX) * bj_RADTODEG
        
        set u = CreateUnit(p, 'e04D', posX, posY, faceAngle)
        if u != null then
            call PauseUnit(u, true)
            call UnitApplyTimedLife(u, 'BTLF', 8.0)
            call GroupAddUnit(decoGroup, u)
        endif
        
        set u = CreateUnit(p, 'e05D', posX, posY, faceAngle)
        if u != null then
            call PauseUnit(u, true)
            call UnitApplyTimedLife(u, 'BTLF', 8.0)
            call GroupAddUnit(decoGroup, u)
        endif
        
        set i = i + 1
    endloop
    
    // 8秒兜底清理装饰组
    call SaveGroupHandle(udg_IceHT, decoId, 0, decoGroup)
    call TimerStart(decoTimer, 8.0, false, function IceDecoCleanup)

    // 启动周期计时器
    set t = CreateTimer()
    set timerId = GetHandleId(t)
    call IceStoreUnit(t, 0, caster)
    call IceStoreUnit(t, 1, target)
    call IceStoreUnit(t, 2, dummy1)
    // 初始化提前结束标记为0
    call SaveInteger(udg_IceHT, timerId, 7, 0)
    call TimerStart(t, 0.30, true, function IceMirrorPeriodic)
    
    // 持续等待
    call TriggerSleepAction(duration)
    
    // ==============================================
    // 等待结束：判断是正常结束还是提前终止
    // ==============================================
    set earlyEnd = LoadInteger(udg_IceHT, timerId, 7)
    
    if earlyEnd == 0 then
        // 正常结束：恢复状态 + 复位到施法点
        call IceRestoreCasterState(caster)
        if caster != null and GetWidgetLife(caster) > 0.405 then
            call SetUnitPosition(caster, casterX, casterY)
        endif
    endif
    // 无论是否提前结束，统一清理计时器与哈希表
    call PauseTimer(t)
    call IceFlush(t)
    call DestroyTimer(t)
    
    // 清理主马甲与映射
    if dummy1 != null and GetWidgetLife(dummy1) > 0.405 then
        call SetUnitFlyHeight(dummy1, 0.0, 8000.0)
        call RemoveUnit(dummy1)
    endif
    call FlushChildHashtable(udg_IceHT, GetHandleId(dummy1))
    
    // 正常结束直接清理装饰组，同步销毁兜底计时器
    loop
        set u = FirstOfGroup(decoGroup)
        exitwhen u == null
        call GroupRemoveUnit(decoGroup, u)
        if u != null and GetWidgetLife(u) > 0.405 then
            call RemoveUnit(u)
        endif
    endloop
    call DestroyGroup(decoGroup)
    
    call PauseTimer(decoTimer)
    call FlushChildHashtable(udg_IceHT, decoId)
    call DestroyTimer(decoTimer)
    
    set caster = null
    set target = null
    set p = null
    set dummy1 = null
    set t = null
    set decoTimer = null
    set decoGroup = null
    set tempUnit = null
    set u = null
endfunction

// ========== 闪电伤害触发 ==========
function IceLightningCond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0L6'
endfunction

function IceLightningAct takes nothing returns nothing
    local unit dummy = GetSpellAbilityUnit()
    local unit target = GetSpellTargetUnit()
    local unit hero
    local integer dummyId

    set dummyId = GetHandleId(dummy)
    set hero = LoadUnitHandle(udg_IceHT, dummyId, 0)
    
    if hero != null and GetWidgetLife(hero) > 0.405 and target != null and GetWidgetLife(target) > 0.405 then
        call UnitDamageTarget(hero, target, I2R(GetHeroStr(hero, true)) * 6.0, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
    endif
    
    set dummy = null
    set target = null
    set hero = null
endfunction

// ========== 冰晶爆炸技能 ==========
function IceBombCond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0L7'
endfunction

function IceBombAct takes nothing returns nothing
    local unit caster = GetSpellAbilityUnit()
    local unit target = GetSpellTargetUnit()
    local real targetX
    local real targetY
    local unit dummy
    local unit bombFx
    local integer i

    if target == null or GetWidgetLife(target) <= 0.405 then
        set caster = null
        set target = null
        return
    endif

    set targetX = GetUnitX(target)
    set targetY = GetUnitY(target)

    set dummy = CreateUnit(GetOwningPlayer(caster), 'e03D', targetX, targetY, bj_UNIT_FACING)
    if dummy == null then
        set caster = null
        set target = null
        return
    endif
    call UnitAddAbility(dummy, 'A0L8')
    call UnitApplyTimedLife(dummy, 'BTLF', 5.0)

    set bombFx = CreateUnit(GetOwningPlayer(caster), 'e06D', targetX, targetY, bj_UNIT_FACING)
    if bombFx != null then
        call UnitApplyTimedLife(bombFx, 'BTLF', 3.0)
        set bombFx = null
    endif

    set i = 0
    loop
        exitwhen i >= 10
        if dummy != null and GetWidgetLife(dummy) > 0.405 then
            call IssueImmediateOrder(dummy, "fanofknives")
        endif
        call TriggerSleepAction(0.30)
        set i = i + 1
    endloop

    if target != null and GetWidgetLife(target) > 0.405 then
        call UnitDamageTarget(caster, target, 1500.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
    endif

    set caster = null
    set target = null
    set dummy = null
endfunction

// ========== 触发器初始化 ==========
function Init_IceCrystalSkills takes nothing returns nothing
    local trigger t
    
    set udg_IceHT = InitHashtable()
    
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function IceMirrorCond))
    call TriggerAddAction(t, function IceMirrorAct)
    
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function IceLightningCond))
    call TriggerAddAction(t, function IceLightningAct)
    
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function IceBombCond))
    call TriggerAddAction(t, function IceBombAct)
    
    set t = null
endfunction
//张辽
// ========== 学习技能条件 ==========
function NRxsft takes nothing returns boolean
    // 条件层过滤目标技能 + 非幻象，减少无效动作调用
    local unit u = GetTriggerUnit()
    if u == null then
        return false
    endif
    return (GetLearnedSkill() == 'A00U' or GetLearnedSkill() == 'A022') and not IsUnitIllusionBJ(u)
endfunction

// ========== 技能升级补发物品 ==========
function bRxsft takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer abilityId
    local integer newLevel
    local integer lastLevel
    local integer unitId
    local integer i

    // 前置兜底：单位无效直接退出
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif

    set abilityId = GetLearnedSkill()
    set unitId = GetHandleId(u)
    set newLevel = GetUnitAbilityLevel(u, abilityId)
    set lastLevel = LoadInteger(udg_HT, unitId, abilityId)

    // 仅升级时补发物品
    if newLevel > lastLevel then
        set i = lastLevel + 1
        loop
            exitwhen i > newLevel
            call UnitAddItemByIdSwapped('I09F', u)
            set i = i + 1
        endloop
        // 更新历史等级记录
        call SaveInteger(udg_HT, unitId, abilityId, newLevel)
    endif

    set u = null
endfunction

// ========== 触发器初始化 ==========
function Init_A00U takes nothing returns nothing
    set Vxxsft = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(Vxxsft, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(Vxxsft, Condition(function NRxsft))
    call TriggerAddAction(Vxxsft, function bRxsft)
endfunction
