// ================================
// 受伤事件（无泄漏、无崩溃）
// ================================
function QBzxpczd takes nothing returns nothing
    local unit source = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local location tempLoc
    local unit dummy

    if source == null or target == null then
        set source = null
        set target = null
        return
    endif

    if GetUnitTypeId(source) == 'h04O' and GetUnitUserData(source) == 0 then
        call SetUnitUserData(source, 1)
        if jv[809] != null then
            if UnitHasBuffBJ(jv[809], 'B013') == false then
                call UnitDamageTarget(jv[809], target, 30 * GetUnitAbilityLevel(jv[809], 'A0RV') + 0.5 * (60 + GetHeroStr(jv[809], true) + udg_LubuAttack2), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            else
                call UnitDamageTarget(jv[809], target, 40 * GetUnitAbilityLevel(jv[809], 'A0RV') + 0.7 * (60 + GetHeroStr(jv[809], true) + udg_LubuAttack2), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            endif
        endif

        set tempLoc = GetUnitLoc(target)
        set dummy = CreateUnitAtLoc(GetOwningPlayer(source), 'h04P', tempLoc, bj_UNIT_FACING)
        call UnitApplyTimedLife(dummy, 'BTLF', 1.5)
        call IssueImmediateOrder(dummy, "fanofknives")
        call RemoveLocation(tempLoc)
        set tempLoc = null
        set dummy = null

        call TriggerSleepAction(1.50)
        set jv[809] = null
    endif

    if GetUnitTypeId(source) == 'h04P' then
        if jv[809] != null then
            if UnitHasBuffBJ(jv[809], 'B013') == false then
                call UnitDamageTarget(jv[809], target, 30 * GetUnitAbilityLevel(jv[809], 'A0RV') + 0.5 * (60 + GetHeroStr(jv[809], true) + udg_LubuAttack2), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            else
                call UnitDamageTarget(jv[809], target, 40 * GetUnitAbilityLevel(jv[809], 'A0RV') + 0.7 * (60 + GetHeroStr(jv[809], true) + udg_LubuAttack2), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            endif
        endif
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\ExplosionBig.mdl", target, "origin"))
    endif

    if GetUnitTypeId(source) == 'h04Q' then
        if jv[809] != null and jv[339] != null then
            if UnitHasBuffBJ(jv[809], 'B013') == false then
                call UnitDamageTarget(jv[809], jv[339], 60 * GetUnitAbilityLevel(jv[809], 'A0RV') + 0.8 * (60 + GetHeroStr(jv[809], true) + udg_LubuAttack2), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            else
                call UnitDamageTarget(jv[809], jv[339], 80 * GetUnitAbilityLevel(jv[809], 'A0RV') + 1.2 * (60 + GetHeroStr(jv[809], true) + udg_LubuAttack2), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            endif
            call SetUnitFlyHeight(jv[339], 0.00, 2000.00)
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\EnergyBurst.mdl", jv[339], "chest"))
        endif
    endif

    set source = null
    set target = null
endfunction

