//甘宁3
function bRxk takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer id = GetHandleId(u)
    local integer skillId = GetLearnedSkill()
    local integer currentLevel = GetUnitAbilityLevel(u, skillId)
    local integer lastRecordedLevel = LoadInteger(udg_HT_LearnBonus_Str, id, skillId)

    if skillId == 'A0TP' then
        // 只给新增的等级加属性
        if currentLevel > lastRecordedLevel then
            call ModifyHeroStat(0, u, 0, 5 * (currentLevel - lastRecordedLevel))
            call SaveInteger(udg_HT_LearnBonus_Str, id, skillId, currentLevel)
        endif
    endif

    set u = null
endfunction

