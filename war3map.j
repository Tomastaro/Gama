        set ydl_group = null
        set ydl_unit = null
        set caster = null
        set target = null
        set effectGroup = null
        set effectUnit = null
        set eff = null
        return
    endif
    
    call SaveInteger(ght_temp, id, 0x25DAB820, LoadInteger(ght_temp, id, 0x25DAB820) + 1)
    set count = LoadInteger(ght_temp, id, 0x25DAB820)
    set tarX = GetUnitX(target)
    set tarY = GetUnitY(target)
    set slashAng = LoadReal(ght_temp, id, 0xC1B0964C)
    
    if count > 38 then
        set effectGroup = LoadGroupHandle(ght_temp, id, 0x214C62CC)
