                        call UnitDamageTarget(caster, ydl_unit, 7.00 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    else
                        call UnitDamageTarget(caster, ydl_unit, 5.00 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    endif
                endif
            endloop
            call DestroyGroup(ydl_group)
            
            call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster), 12.00)
            
            set ydl_timer = CreateTimer()
            call SaveUnitHandle(ght_temp, GetHandleId(ydl_timer), 0xC303079D, caster)
            call TimerStart(ydl_timer, 0.15, false, function CameraClear2)
            
            call SetUnitTimeScale(caster, 1.00)
            call PauseUnit(caster, false)
            call DestroyGroup(effectGroup)
            set udg_m_unit[27] = null
            call PauseTimer(GetExpiredTimer())
            call FlushChildHashtable(ght_temp, id)
            call DestroyTimer(GetExpiredTimer())
            
            set effectUnit = null
            set eff = null
            return
        endif
    else
        if count == 35 then
            call SetUnitBlendTime(caster, 0)
            call SetUnitAnimationByIndex(caster, 1)
        endif
        
        if count == 2 or count == 6 or count == 10 or count == 14 or count == 18 or count == 22 or count == 26 or count == 30 or count == 34 then
            if ModuloInteger(count / 4, 2) == 0 then
                call SetUnitBlendTime(caster, 0)
                if ModuloInteger(count / 8, 2) == 0 then
                    call SetUnitAnimation(caster, "Attack")
                else
                    call SetUnitAnimation(caster, "Attack 2")
                endif
            endif
            
            call adsound("Hit-3.mp3", udg_m_unit[27])
            
            set slashAng = I2R(count) * 20.00
            call SaveReal(ght_temp, id, 0xC1B0964C, slashAng)
            
            if GetUnitTypeId(caster) == 'H01X' then
                set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e0C7', casterX, casterY, slashAng)
                if effectUnit != null then
                    call SetUnitAnimationByIndex(effectUnit, 5)
                    call SaveUnitHandle(ght_temp, id, 0x2B0A6845, effectUnit)
                endif
            else
                set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e09I', casterX, casterY, slashAng)
                if effectUnit != null then
                    call SetUnitTimeScale(effectUnit, LoadReal(ght_temp, id, 0x5D04C6C8))
                    call SaveUnitHandle(ght_temp, id, 0x2B0A6845, effectUnit)
                endif
                call SaveReal(ght_temp, id, 0x5D04C6C8, LoadReal(ght_temp, id, 0x5D04C6C8) + 0.30)
            endif
            
            if effectUnit != null then
                call SetUnitBlendTime(effectUnit, 0.00)
                call SetUnitVertexColor(effectUnit, 255, 255, 255, 100)
                call SetUnitAnimationByIndex(effectUnit, 13)
                
                set effectGroup = LoadGroupHandle(ght_temp, id, 0x214C62CC)
                call GroupAddUnit(effectGroup, effectUnit)
                call SaveGroupHandle(ght_temp, id, 0x214C62CC, effectGroup)
            endif
            
            set offsetX = 100.00 * Cos(slashAng * bj_DEGTORAD)
            set offsetY = 100.00 * Sin(slashAng * bj_DEGTORAD)
            if GetRandomInt(1, 2) == 1 then
                set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e09Q', casterX + offsetX, casterY + offsetY, slashAng)
            else
                set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e09R', casterX + offsetX, casterY + offsetY, slashAng)
            endif
            if effectUnit != null then
                call SetUnitScale(effectUnit, 0.48, 0.48, 0.48)
                call SetUnitFlyHeight(effectUnit, 150.00, 0.00)
                call SetUnitTimeScale(effectUnit, 1.20)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
                call SaveUnitHandle(ght_temp, id, 0x1CDCF900, effectUnit)
            endif
            
            set effectUnit = CreateUnit(GetOwningPlayer(caster), 'e09Z', casterX + offsetX, casterY + offsetY, slashAng)
            if effectUnit != null then
                call SetUnitScale(effectUnit, 0.90, 0.90, 0.90)
                call SetUnitBlendTime(effectUnit, 0.00)
                call SetUnitAnimationByIndex(effectUnit, R2I(GetRandomReal(0.00, 360.00) * 0.69))
                call SetUnitFlyHeight(effectUnit, 160.00, 0.00)
                set eff = AddSpecialEffectTarget("war3mapImported\\[Effect]909.mdx", effectUnit, "origin")
                if eff != null then
                    call DestroyEffect(eff)
                    set eff = null
                endif
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
                call SaveUnitHandle(ght_temp, id, 0x0A066285, effectUnit)
            endif
            
            set ydl_group = CreateGroup()
            call GroupEnumUnitsInRange(ydl_group, casterX, casterY, 320.00, null)
            loop
                set ydl_unit = FirstOfGroup(ydl_group)
                exitwhen ydl_unit == null
                call GroupRemoveUnit(ydl_group, ydl_unit)
                if ydl_unit != null and IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false and IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false and IsUnitAliveBJ(ydl_unit) == true and IsUnitEnemy(ydl_unit, GetOwningPlayer(caster)) == true then
                    set eff = AddSpecialEffectTarget("war3mapImported\\e556.mdx", ydl_unit, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    set eff = AddSpecialEffectTarget("war3mapImported\\az-blood-hit.mdx", ydl_unit, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    set eff = AddSpecialEffectTarget("Abilities\\Weapons\\Blood\\BloodImpact.mdl", ydl_unit, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    set eff = AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", ydl_unit, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    set eff = AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdx", ydl_unit, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    // 地面斩过程伤害（统一为英雄攻击+魔法伤害）
                    if GetUnitAbilityLevel(caster, 'A0XF') == 1 then
                        call UnitDamageTarget(caster, ydl_unit, 15.00, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                        call UnitDamageTarget(caster, ydl_unit, 1 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    else
                        call UnitDamageTarget(caster, ydl_unit, 30.00, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                        call UnitDamageTarget(caster, ydl_unit, 0.60 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    endif
                endif
            endloop
            call DestroyGroup(ydl_group)
            
            call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster), 10.00)
            
            set ydl_timer = CreateTimer()
            call SaveGroupHandle(ght_temp, GetHandleId(ydl_timer), 0x214C62CC, LoadGroupHandle(ght_temp, id, 0x214C62CC))
            call SaveUnitHandle(ght_temp, GetHandleId(ydl_timer), 0x2B0A6845, LoadUnitHandle(ght_temp, id, 0x2B0A6845))
            call SaveUnitHandle(ght_temp, GetHandleId(ydl_timer), 0xC303079D, caster)
            call TimerStart(ydl_timer, 0.10, false, function EffectFadeStart)
            
            set effectUnit = null
        endif
    endif
    
    set effectGroup = LoadGroupHandle(ght_temp, id, 0x214C62CC)
    if effectGroup != null and FirstOfGroup(effectGroup) != null then
        call ForGroupBJ(effectGroup, function GroupExpandEffect)
    endif
    
    set ydl_group = null
    set ydl_unit = null
    set ydl_timer = null
    set caster = null
    set effectGroup = null
    set effectUnit = null
    set eff = null
endfunction

function Trig_jx_rFunc004Func004T takes nothing returns nothing
    local timer ydl_timer
    local integer id
    local integer newId
    local unit caster
    
    set id = GetHandleId(GetExpiredTimer())
    set caster = LoadUnitHandle(ght_temp, id, 0xC303079D)
    
    if caster == null then
        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(ght_temp, id)
        call DestroyTimer(GetExpiredTimer())
        set ydl_timer = null
        set caster = null
        return
    endif
    
    call SetUnitBlendTime(caster, 0)
    call SetUnitTimeScale(caster, 1.40)
    call SetUnitAnimation(caster, "Attack")
    call QueueUnitAnimation(caster, "Attack")
    
    call PlaySoundOnUnitBJ(gg_snd_jx_r2, 100, caster)
    
    call PauseUnit(caster, true)
    
    call SaveGroupHandle(ght_temp, id, 0x214C62CC, CreateGroup())
    set ydl_timer = CreateTimer()
    set newId = GetHandleId(ydl_timer)
    
    call SaveInteger(ght_temp, newId, 0x25DAB820, 0)
    call SaveReal(ght_temp, newId, 0x5D04C6C8, 0.00)
    call SaveReal(ght_temp, newId, 0xC1B0964C, LoadReal(ght_temp, id, 0xC1B0964C))
    call SaveGroupHandle(ght_temp, newId, 0x214C62CC, LoadGroupHandle(ght_temp, id, 0x214C62CC))
    call SaveUnitHandle(ght_temp, newId, 0x2B0A6845, LoadUnitHandle(ght_temp, id, 0x2B0A6845))
    call SaveUnitHandle(ght_temp, newId, 0xB38FF03F, LoadUnitHandle(ght_temp, id, 0xB38FF03F))
    call SaveUnitHandle(ght_temp, newId, 0xC4623CD3, LoadUnitHandle(ght_temp, id, 0xC4623CD3))
    call SaveUnitHandle(ght_temp, newId, 0x1CDCF900, LoadUnitHandle(ght_temp, id, 0x1CDCF900))
    call SaveUnitHandle(ght_temp, newId, 0x0A066285, LoadUnitHandle(ght_temp, id, 0x0A066285))
    call SaveUnitHandle(ght_temp, newId, 0xB215FA06, LoadUnitHandle(ght_temp, id, 0xB215FA06))
    call SaveUnitHandle(ght_temp, newId, 0x058C799C, LoadUnitHandle(ght_temp, id, 0x058C799C))
    call SaveUnitHandle(ght_temp, newId, 0x6DB300FF, LoadUnitHandle(ght_temp, id, 0x6DB300FF))
    call SaveUnitHandle(ght_temp, newId, 0xC303079D, caster)
    
    call TimerStart(ydl_timer, 0.03, true, function Trig_jx_rFunc004Func006T)
    call PauseTimer(GetExpiredTimer())
    call FlushChildHashtable(ght_temp, id)
    call DestroyTimer(GetExpiredTimer())
    
    set ydl_timer = null
    set caster = null
endfunction

function Trig_jx_rActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step
    local integer triggerId
    local integer parentKey
    local integer timerId
    local unit caster
    
    set ydl_localvar_step = LoadInteger(ght_temp, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
    set ydl_localvar_step = ydl_localvar_step + 3
    set triggerId = GetHandleId(GetTriggeringTrigger())
    call SaveInteger(ght_temp, triggerId, 0xCFDE6C76, ydl_localvar_step)
    call SaveInteger(ght_temp, triggerId, 0xECE825E7, ydl_localvar_step)
    set parentKey = triggerId * ydl_localvar_step
    
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif
    
    call SaveUnitHandle(ght_temp, parentKey, 0xC303079D, caster)
    set udg_m_unit[27] = caster
    
    if udg_m_unit[26] == null then
        set ydl_timer = CreateTimer()
        set timerId = GetHandleId(ydl_timer)
        call SaveReal(ght_temp, timerId, 0xC1B0964C, LoadReal(ght_temp, parentKey, 0xC1B0964C))
        call SaveGroupHandle(ght_temp, timerId, 0x214C62CC, LoadGroupHandle(ght_temp, parentKey, 0x214C62CC))
        call SaveUnitHandle(ght_temp, timerId, 0x2B0A6845, LoadUnitHandle(ght_temp, parentKey, 0x2B0A6845))
        call SaveUnitHandle(ght_temp, timerId, 0xB38FF03F, LoadUnitHandle(ght_temp, parentKey, 0xB38FF03F))
        call SaveUnitHandle(ght_temp, timerId, 0xC4623CD3, LoadUnitHandle(ght_temp, parentKey, 0xC4623CD3))
        call SaveUnitHandle(ght_temp, timerId, 0x1CDCF900, LoadUnitHandle(ght_temp, parentKey, 0x1CDCF900))
        call SaveUnitHandle(ght_temp, timerId, 0x0A066285, LoadUnitHandle(ght_temp, parentKey, 0x0A066285))
        call SaveUnitHandle(ght_temp, timerId, 0xB215FA06, LoadUnitHandle(ght_temp, parentKey, 0xB215FA06))
        call SaveUnitHandle(ght_temp, timerId, 0x058C799C, LoadUnitHandle(ght_temp, parentKey, 0x058C799C))
        call SaveUnitHandle(ght_temp, timerId, 0x6DB300FF, LoadUnitHandle(ght_temp, parentKey, 0x6DB300FF))
        call SaveUnitHandle(ght_temp, timerId, 0xC303079D, caster)
        call TimerStart(ydl_timer, 0.15, false, function Trig_jx_rFunc004Func004T)
    else
        set udg_m_true[0] = true
        call SaveUnitHandle(ght_temp, parentKey, 0x2D5DEA42, udg_m_unit[26])
        set ydl_timer = CreateTimer()
        set timerId = GetHandleId(ydl_timer)
        call SaveReal(ght_temp, timerId, 0xC1B0964C, LoadReal(ght_temp, parentKey, 0xC1B0964C))
        call SaveGroupHandle(ght_temp, timerId, 0x214C62CC, LoadGroupHandle(ght_temp, parentKey, 0x214C62CC))
        call SaveUnitHandle(ght_temp, timerId, 0x2B0A6845, LoadUnitHandle(ght_temp, parentKey, 0x2B0A6845))
        call SaveUnitHandle(ght_temp, timerId, 0x1CDCF900, LoadUnitHandle(ght_temp, parentKey, 0x1CDCF900))
        call SaveUnitHandle(ght_temp, timerId, 0x5E7B9BEB, LoadUnitHandle(ght_temp, parentKey, 0x5E7B9BEB))
        call SaveUnitHandle(ght_temp, timerId, 0x0A066285, LoadUnitHandle(ght_temp, parentKey, 0x0A066285))
        call SaveUnitHandle(ght_temp, timerId, 0x1043C8CE, LoadUnitHandle(ght_temp, parentKey, 0x1043C8CE))
        call SaveUnitHandle(ght_temp, timerId, 0xB215FA06, LoadUnitHandle(ght_temp, parentKey, 0xB215FA06))
        call SaveUnitHandle(ght_temp, timerId, 0x058C799C, LoadUnitHandle(ght_temp, parentKey, 0x058C799C))
        call SaveUnitHandle(ght_temp, timerId, 0x6DB300FF, LoadUnitHandle(ght_temp, parentKey, 0x6DB300FF))
        call SaveUnitHandle(ght_temp, timerId, 0xC303079D, caster)
        call SaveUnitHandle(ght_temp, timerId, 0x2D5DEA42, udg_m_unit[26])
        call TimerStart(ydl_timer, 0.15, false, function Trig_jx_rFunc004Func003T)
    endif
    
    call FlushChildHashtable(ght_temp, parentKey)
    set ydl_timer = null
    set caster = null
endfunction

function InitTrig_jx_r takes nothing returns nothing
    if ght_temp == null then
        set ght_temp = InitHashtable()
    endif
    if ght_unit == null then
        set ght_unit = InitHashtable()
    endif
    if udg_FlyP2_Group == null then
        set udg_FlyP2_Group = CreateGroup()
    endif

    set gg_trg_jx_r = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_jx_r, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_jx_r, Condition(function Trig_jx_rConditions))
    call TriggerAddAction(gg_trg_jx_r, function Trig_jx_rActions)
endfunction










//周泰专属
//===========================================================================
// 工具：相机震动清除回调1
//===========================================================================
//===========================================================================
// 工具：相机震动清除回调1（0.12秒）
//===========================================================================

//全英雄专属板块
//===========================================================================
// 注册一个英雄-物品-技能映射
//===========================================================================
function RegisterItemSkill takes integer heroId, integer itemId, integer skillId returns nothing
    if ItemSkillCount >= MAX_ITEM_SKILLS then
        call BJDebugMsg("错误：物品技能映射数量超出上限！")
        return
    endif
    set HeroIDs[ItemSkillCount] = heroId
    set ItemIDs[ItemSkillCount] = itemId
    set SkillIDs[ItemSkillCount] = skillId
    set ItemSkillCount = ItemSkillCount + 1
endfunction

//===========================================================================
// 根据英雄ID和物品ID查找对应技能ID，未找到返回 0
//===========================================================================
function GetSkillFromItem takes integer heroId, integer itemId returns integer
    local integer i = 0
    loop
        exitwhen i >= ItemSkillCount
        if HeroIDs[i] == heroId and ItemIDs[i] == itemId then
            return SkillIDs[i]
        endif
        set i = i + 1
    endloop
    return 0
endfunction

//===========================================================================
// 拾取物品事件
//===========================================================================
function PickUpItem takes nothing returns nothing
    local unit u       = GetTriggerUnit()
    local item it      = GetManipulatedItem()
    local integer heroId = GetUnitTypeId(u)
    local integer itemId = GetItemTypeId(it)
    local integer skillId = GetSkillFromItem(heroId, itemId)

    if skillId != 0 and GetUnitAbilityLevel(u, skillId) == 0 then
        call UnitAddAbility(u, skillId)
        call UnitMakeAbilityPermanent(u, true, skillId)
    endif

    set u  = null
    set it = null
endfunction

//===========================================================================
// 丢弃物品事件
//===========================================================================
function DropItem takes nothing returns nothing
    local unit u       = GetTriggerUnit()
    local item it      = GetManipulatedItem()
    local integer heroId = GetUnitTypeId(u)
    local integer itemId = GetItemTypeId(it)
    local integer skillId = GetSkillFromItem(heroId, itemId)

    if skillId != 0 and GetUnitAbilityLevel(u, skillId) > 0 then
        call UnitRemoveAbility(u, skillId)
    endif

    set u  = null
    set it = null
endfunction

//===========================================================================
// 初始化触发器并注册所有英雄映射
//===========================================================================
function InitTrig_Item_GiveSkill takes nothing returns nothing
    local trigger tPick = CreateTrigger()
    local trigger tDrop = CreateTrigger()
    local integer i = 0

    // ==================== 在此注册英雄-物品-技能映射 ====================
    call RegisterItemSkill('U002', 'I04L', 'A0XS')   // 示例：英雄U002 + 物品I001 → 技能A0XS
    call RegisterItemSkill('O00X', 'I06D', 'A0XF')   // 英雄H002 + 物品I002 → 技能A0XT
    call RegisterItemSkill('H008', 'I043', 'A0ZB')   // 英雄H002 + 物品I002 → 技能A0XT
    call RegisterItemSkill('H02O', 'I04Q', 'A0KO')
    // 后续新英雄只需在此继续添加：
    // call RegisterItemSkill('英雄ID', '物品ID', '技能ID')
    // ====================================================================

    loop
        exitwhen i > 11
        call TriggerRegisterPlayerUnitEvent(tPick, Player(i), EVENT_PLAYER_UNIT_PICKUP_ITEM, null)
        call TriggerRegisterPlayerUnitEvent(tDrop, Player(i), EVENT_PLAYER_UNIT_DROP_ITEM, null)
        set i = i + 1
    endloop

    call TriggerAddAction(tPick, function PickUpItem)
    call TriggerAddAction(tDrop, function DropItem)

    set tPick = null
    set tDrop = null
endfunction
//霜雨云
//===========================================================================
// 技能触发条件
//===========================================================================
function Trig_1_0__________uConditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ZB'
endfunction

//===========================================================================
// 跟踪：单位筛选条件
//===========================================================================
function Trig_1_0__________uFunc008Func001Func003003003 takes nothing returns boolean
    local unit caster = LoadUnitHandle(ght_temp, GetHandleId(GetExpiredTimer()), 0x458B7DE9)
    local unit filterUnit = GetFilterUnit()
    local boolean result = false

    if filterUnit == null then
        set caster = null
        set filterUnit = null
        return false
    endif

    if caster != null then
        set result = IsUnitAliveBJ(filterUnit) and IsUnitEnemy(filterUnit, GetOwningPlayer(caster)) and not IsUnitType(filterUnit, UNIT_TYPE_STRUCTURE)
    endif
    set caster = null
    set filterUnit = null
    return result
endfunction

//===========================================================================
// 跟踪：最近目标比较回调
//===========================================================================
function Trig_1_0__________uFunc008Func001Func004Func002A takes nothing returns nothing
    local integer timerId = GetHandleId(GetExpiredTimer())
    local unit cloud = LoadUnitHandle(ght_temp, timerId, 0xC303079D)
    local unit nearest = LoadUnitHandle(ght_temp, timerId, 0x1BF14788)
    local unit enumUnit = GetEnumUnit()
    local real cloudX
    local real cloudY
    local real nearestDistSq
    local real enumDistSq

    if cloud != null and nearest != null and enumUnit != null and GetWidgetLife(enumUnit) > 0.405 then
        set cloudX = GetUnitX(cloud)
        set cloudY = GetUnitY(cloud)
        set nearestDistSq = (GetUnitX(nearest) - cloudX) * (GetUnitX(nearest) - cloudX) + (GetUnitY(nearest) - cloudY) * (GetUnitY(nearest) - cloudY)
        set enumDistSq = (GetUnitX(enumUnit) - cloudX) * (GetUnitX(enumUnit) - cloudX) + (GetUnitY(enumUnit) - cloudY) * (GetUnitY(enumUnit) - cloudY)

        if enumDistSq < nearestDistSq then
            call SaveUnitHandle(ght_temp, timerId, 0x1BF14788, enumUnit)
        endif
    endif

    set cloud = null
    set nearest = null
    set enumUnit = null
endfunction

//===========================================================================
// 跟踪主循环计时器
//===========================================================================
function Trig_1_0__________uFunc008T takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit cloud = LoadUnitHandle(ght_temp, id, 0xC303079D)
    local unit caster = LoadUnitHandle(ght_temp, id, 0x458B7DE9)
    local group enumGroup
    local unit nearestTarget
    local real cloudX
    local real cloudY
    local real angleRad
    local real moveDist = 20.00
    local real targetX
    local real targetY

    // ========== 空单位安全防护 ==========
    if cloud == null or not IsUnitAliveBJ(cloud) or caster == null then
        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(ght_temp, id)
        call DestroyTimer(GetExpiredTimer())
        set cloud = null
        set caster = null
        return
    endif

    set cloudX = GetUnitX(cloud)
    set cloudY = GetUnitY(cloud)
    set enumGroup = CreateGroup()

    call GroupEnumUnitsInRange(enumGroup, cloudX, cloudY, 1000.00, cond_cloud_track)

    if IsUnitGroupEmptyBJ(enumGroup) then
        set angleRad = Atan2(GetUnitY(caster) - cloudY, GetUnitX(caster) - cloudX)
    else
        set nearestTarget = FirstOfGroup(enumGroup)
        call SaveUnitHandle(ght_temp, id, 0x1BF14788, nearestTarget)
        call ForGroupBJ(enumGroup, function Trig_1_0__________uFunc008Func001Func004Func002A)

        set nearestTarget = LoadUnitHandle(ght_temp, id, 0x1BF14788)
        if nearestTarget != null and GetWidgetLife(nearestTarget) > 0.405 then
            set angleRad = Atan2(GetUnitY(nearestTarget) - cloudY, GetUnitX(nearestTarget) - cloudX)
        else
            set angleRad = Atan2(GetUnitY(caster) - cloudY, GetUnitX(caster) - cloudX)
        endif
    endif

    set targetX = cloudX + moveDist * Cos(angleRad)
    set targetY = cloudY + moveDist * Sin(angleRad)
    call SetUnitPosition(cloud, targetX, targetY)

    call DestroyGroup(enumGroup)
    set enumGroup = null
    set nearestTarget = null
    set cloud = null
    set caster = null
endfunction

//===========================================================================
// 持续伤害：单位筛选条件
//===========================================================================
function Trig_1_0__________uFunc010Func001Func003003003 takes nothing returns boolean
    local unit caster = LoadUnitHandle(ght_temp, GetHandleId(GetExpiredTimer()), 0x458B7DE9)
    local unit filterUnit = GetFilterUnit()
    local boolean result = false

    if filterUnit == null then
        set caster = null
        set filterUnit = null
        return false
    endif

    if caster != null then
        set result = IsUnitAliveBJ(filterUnit) and IsUnitEnemy(filterUnit, GetOwningPlayer(caster)) and not IsUnitType(filterUnit, UNIT_TYPE_STRUCTURE)
    endif
    set caster = null
    set filterUnit = null
    return result
endfunction

