//------------------------------------------- 乱舞
function sRxzh takes nothing returns nothing
    local unit target = GetEnumUnit()
    local unit caster = LoadUnitHandle(udg_HT_MovingKiller2, 0, 0)
    local integer lvl
    local real str
    local real agi
    local real dmg

    if caster != null and target != null and IsUnitEnemy(target, GetOwningPlayer(caster)) then
        set lvl = GetUnitAbilityLevel(caster, 'A0NI')
        set str = GetHeroStr(caster, true)
        set agi = GetHeroAgi(caster, true)
        set dmg = (0.4 + lvl * 0.1) * (str + agi)
        call UnitDamageTarget(caster, target, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
    endif
    set target = null
    set caster = null
endfunction

// ====================================
// 周期伤害回调（每0.5秒）
// ====================================
function MovingKiller2_Periodic takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_MovingKiller2, id, 0)
    local integer rounds = LoadInteger(udg_HT_MovingKiller2, id, 1)
    local timer endTimer = LoadTimerHandle(udg_HT_MovingKiller2, id, 2)
    local location loc
    local group g

    // 异常兜底：施法者无效立刻全量清理
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        // 单位存活则先恢复状态
        if caster != null then
            call SetUnitMoveSpeed(caster, GetUnitDefaultMoveSpeed(caster))
            call UnitRemoveAbility(caster, 'A0GN')
        endif
        // 同步销毁结束计时器，避免后续无效操作闪退
        if endTimer != null then
            call FlushChildHashtable(udg_HT_MovingKiller2, GetHandleId(endTimer))
            call DestroyTimer(endTimer)
        endif
        // 清理当前周期计时器
        call PauseTimer(t)
        call FlushChildHashtable(udg_HT_MovingKiller2, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set endTimer = null
        return
    endif

    // 达到最大次数：正常结束，同步销毁结束计时器
    if rounds >= 12 then
        call SetUnitMoveSpeed(caster, GetUnitDefaultMoveSpeed(caster))
        call UnitRemoveAbility(caster, 'A0GN')
        if endTimer != null then
            call FlushChildHashtable(udg_HT_MovingKiller2, GetHandleId(endTimer))
            call DestroyTimer(endTimer)
        endif
        call PauseTimer(t)
        call FlushChildHashtable(udg_HT_MovingKiller2, id)
        call DestroyTimer(t)
    else
        call SaveInteger(udg_HT_MovingKiller2, id, 1, rounds + 1)

        // 获取单位位置
        set loc = Location(GetUnitX(caster), GetUnitY(caster))

        // 周围320码范围伤害
        set g = CreateGroup()
        call GroupEnumUnitsInRangeOfLoc(g, loc, 320.0, null)
        call SaveUnitHandle(udg_HT_MovingKiller2, 0, 0, caster)
        call ForGroup(g, function sRxzh)
        call RemoveSavedHandle(udg_HT_MovingKiller2, 0, 0)
        call DestroyGroup(g)

        // 特效
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\FreezingRing5.mdl", caster, "origin"))
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\IceNova-b.mdl", caster, "chest"))

        call RemoveLocation(loc)
        set loc = null
        set g = null
    endif

    set t = null
    set caster = null
    set endTimer = null
endfunction

// ====================================
// 技能结束回调
// ====================================
function MovingKiller2_End takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_MovingKiller2, id, 0)
    local timer periodicTimer = LoadTimerHandle(udg_HT_MovingKiller2, id, 1)

    // 单位存活才恢复状态
    if caster != null and GetWidgetLife(caster) > 0.405 then
        call SetUnitMoveSpeed(caster, GetUnitDefaultMoveSpeed(caster))
        call UnitRemoveAbility(caster, 'A0GN')
    endif

    // 停止并销毁周期计时器
    if periodicTimer != null then
        call PauseTimer(periodicTimer)
        call FlushChildHashtable(udg_HT_MovingKiller2, GetHandleId(periodicTimer))
        call DestroyTimer(periodicTimer)
    endif

    call FlushChildHashtable(udg_HT_MovingKiller2, id)
    call DestroyTimer(t)
    set caster = null
    set t = null
    set periodicTimer = null
endfunction

// ====================================
// 技能主动作
// ====================================
function Trig_movingkiller1xzs_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local timer periodicTimer
    local timer endTimer
    local integer pid

    // 入口兜底：单位无效直接退出
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    call UnitAddAbility(caster, 'A0GN')
    call SetUnitMoveSpeed(caster, 412.0)

    // 创建周期计时器（每0.5秒）
    set periodicTimer = CreateTimer()
    set pid = GetHandleId(periodicTimer)
    call SaveUnitHandle(udg_HT_MovingKiller2, pid, 0, caster)
    call SaveInteger(udg_HT_MovingKiller2, pid, 1, 0)

    // 创建结束计时器（5.8秒后单次触发）
    set endTimer = CreateTimer()
    call SaveUnitHandle(udg_HT_MovingKiller2, GetHandleId(endTimer), 0, caster)
    call SaveTimerHandle(udg_HT_MovingKiller2, GetHandleId(endTimer), 1, periodicTimer)
    call TimerStart(endTimer, 5.80, false, function MovingKiller2_End)

    // 给周期计时器存入结束计时器引用，异常时可联动销毁
    call SaveTimerHandle(udg_HT_MovingKiller2, pid, 2, endTimer)
    call TimerStart(periodicTimer, 0.50, true, function MovingKiller2_Periodic)

    set caster = null
    set periodicTimer = null
    set endTimer = null
endfunction

// ====================================
// 技能条件
// ====================================
function Trig_movingkiller1xzs_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0JG'
endfunction

// ====================================
// 初始化
// ====================================
function InitTrig_MovingKiller takes nothing returns nothing
    local trigger t

    if udg_HT_MovingKiller2 == null then
        set udg_HT_MovingKiller2 = InitHashtable()
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_movingkiller1xzs_Conditions))
    call TriggerAddAction(t, function Trig_movingkiller1xzs_Actions)
    set t = null
endfunction


