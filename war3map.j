function QBzxpcze takes nothing returns nothing
    if GetUnitTypeId(GetEventDamageSource()) == 'e033' and IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false then
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "war3mapImported\\ExplosionBig.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
    endif
    if GetUnitTypeId(GetEventDamageSource()) == 'e02A' and GetUnitAbilityLevelSwapped('A0H9', GetEventDamageSource()) == 2 and Cvt[3] != null then
        // 第一段伤害系数 2
        call UnitDamageTargetBJ(Cvt[3], GetTriggerUnit(), 60 + 60 * GetUnitAbilityLevelSwapped('A0RS', Cvt[3]) + 2 * (60 + GetHeroStatBJ(bj_HEROSTAT_STR, Cvt[3], true) + udg_LubuAttack2), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    endif
endfunction

function InitTrig_LubuDZ takes nothing returns nothing
    set Sozxpczde = CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(Sozxpczde)
    call TriggerAddAction(Sozxpczde, function QBzxpcze)
endfunction
//周瑜3
function cMynr takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location locCaster = GetUnitLoc(caster)
    local location locTarget = GetSpellTargetLoc()
    local real angle = AngleBetweenPoints(locCaster, locTarget)
    local unit dummy
    local real damage
    local integer curLv = GetUnitAbilityLevel(caster, 'A0HM')
    local real delay = 11.0 - 2.0 * curLv
    local integer newLv

    if GetSpellAbilityId() == 'A0HM' then
        set damage = GetHeroInt(caster, true) * (curLv * 1.25)
        call CreateNUnitsAtLoc(1, 'h05C', GetOwningPlayer(caster), locCaster, angle)
        set dummy = bj_lastCreatedUnit
        
        call UnitApplyTimedLife(dummy, 'BTLF', 5.00)
        
        call SetUnitUserData(dummy, R2I(damage))
        call SetUnitAbilityLevelSwapped('A0VM', dummy, curLv)
        call IssuePointOrderLocBJ(dummy, "shockwave", locTarget)

        call RemoveLocation(locCaster)
        call RemoveLocation(locTarget)

        if GetUnitManaPercent(caster) >= 70 and GetUnitUserData(caster) == 0 then
            call SetUnitUserData(caster, 1)
            call AddSpecialEffectTargetUnitBJ("origin", caster, "Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl")
            call DestroyEffect(bj_lastCreatedEffect)
            call PolledWait(delay)
            
            if caster != null and IsUnitAliveBJ(caster) then
                set newLv = GetUnitAbilityLevel(caster, 'A0HM')
                call UnitRemoveAbility(caster, 'A0HM')
                call UnitAddAbility(caster, 'A0HM')
                if newLv > 0 then
                    call SetUnitAbilityLevel(caster, 'A0HM', newLv)
                endif
            endif
            call SetUnitUserData(caster, 0)
        endif
    endif
    set caster = null
    set dummy = null
    set locCaster = null
    set locTarget = null
endfunction

function cMynr_Init takes nothing returns nothing
    set mmynr = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(mmynr, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddAction(mmynr, function cMynr)
endfunction

function QBz takes nothing returns nothing
    local unit dummy = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local integer damageInt
    local location loc

    if udg_NoRecurse then
        return
    endif

    if GetUnitTypeId(dummy) == 'h05C' and IsUnitEnemy(target, GetOwningPlayer(dummy)) then
        set damageInt = GetUnitUserData(dummy)
        if damageInt > 0 then
            set udg_NoRecurse = true
            
            call UnitDamageTargetBJ(dummy, target, I2R(damageInt), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
            
            set udg_NoRecurse = false
        endif
        set loc = GetUnitLoc(target)
        call AddSpecialEffectLocBJ(loc, "war3mapImported\\ExplosionBig.mdl")
        call DestroyEffect(bj_lastCreatedEffect)
        call RemoveLocation(loc)
        set loc = null
    endif
    set dummy = null
    set target = null
endfunction

function QBz_Init takes nothing returns nothing
    set Soz = CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(Soz)
    call TriggerAddAction(Soz, function QBz)
endfunction
