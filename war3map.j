function adsound takes string s,unit u returns nothing
    set bj_lastPlayedSound=CreateSound("war3mapImported\\" + s, false, true, false, 10, 10, "DefaultEAXON")
    call SetSoundDistances(bj_lastPlayedSound, 1000.0, 3000.0)
    call SetSoundDistanceCutoff(bj_lastPlayedSound, 3000.0)
    call SetSoundPosition(bj_lastPlayedSound, GetUnitX(u), GetUnitY(u), 0)
    call StartSound(bj_lastPlayedSound)
    call KillSoundWhenDone(bj_lastPlayedSound)
endfunction
//甘宁特效
// ====================================
// 技能施法条件
// ====================================
function Trig_Hero326_04_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0G5'
endfunction

// ====================================
// 周期计数判断（20次对应0.8秒总时长，原版视觉）
// ====================================
function Trig_Hero326_04_Effect_Func001C takes nothing returns boolean
    return udg__Int0[3264] <= 20
endfunction

// ====================================
// 马甲死亡清理条件
// ====================================
function Trig_Hero326_04_End_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'h06Y'
endfunction

// ====================================
// 马甲死亡清理动作
// ====================================
function Trig_Hero326_04_End_Actions takes nothing returns nothing
    call RemoveUnit(GetTriggerUnit())
endfunction

// ====================================
// 统一清理技能状态（死亡/结束/重施法共用）
// ====================================
function ClearHero326SkillState takes nothing returns nothing
    if udg__Tim0[3264] != null then
        call PauseTimer(udg__Tim0[3264])
    endif
    call DisableTrigger(gg_trg_Hero326_04_Effect_2)
    set udg__Uni0[3264] = null
    set udg__Int0[3264] = 0
    set udg__Rea0[3264] = 0
endfunction

// ====================================
// 周期效果主逻辑（0.04秒原版周期）
// ====================================
function Trig_Hero326_04_Effect_Actions takes nothing returns nothing
    local integer lvl
    local unit dummy
    local group g
    local unit target
    local effect fx
    local unit caster = udg__Uni0[3264]
    local player casterOwner
    local real casterX
    local real casterY
    local real projX
    local real projY
    local real angle
    local integer i
    local real dist
    local real faceAngle

    // 异常兜底：施法者无效，彻底清理状态
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        call ClearHero326SkillState()
        set caster = null
        return
    endif

    if Trig_Hero326_04_Effect_Func001C() then
        set udg__Int0[3264] = udg__Int0[3264] + 1
        set casterOwner = GetOwningPlayer(caster)
        set casterX = GetUnitX(caster)
        set casterY = GetUnitY(caster)
        set angle = udg__Rea0[3264]
        // 恢复原版单次扩散45距离，20次总距离900
        set dist = 45.00 * I2R(udg__Int0[3264])
        set lvl = GetUnitAbilityLevel(caster, 'A0G5')

        // 局部循环变量，消除全局覆盖风险
        set i = 1
        loop
            exitwhen i > 2
            // 原生坐标计算弹道位置，无location泄漏
            set projX = casterX + dist * Cos((angle + GetRandomReal(-40.00, 40.00)) * bj_DEGTORAD)
            set projY = casterY + dist * Sin((angle + GetRandomReal(-40.00, 40.00)) * bj_DEGTORAD)
            set faceAngle = Atan2(projY - casterY, projX - casterX) * bj_RADTODEG
            
            // 创建水箭马甲 + 限时生命周期，解决永久堆积
            set dummy = CreateUnit(casterOwner, 'h06Y', projX, projY, faceAngle)
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 1.50)
                call SetUnitAnimation(dummy, udg__Str0[(3260 + GetRandomInt(0, 2))])
                // 透明度渐变同步适配20次计数
                call SetUnitVertexColor(dummy, 255, 255, 255, 255 - R2I(255 * (I2R(udg__Int0[3264]) / 20.0)))
                
                // 范围内索敌，补充建筑过滤
                set g = CreateGroup()
                call GroupEnumUnitsInRange(g, projX, projY, 450.0, null)
                set target = FirstOfGroup(g)
                loop
                    exitwhen target == null
                    if IsUnitEnemy(target, casterOwner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) and GetWidgetLife(target) > 0.405 then
                        exitwhen true
                    endif
                    call GroupRemoveUnit(g, target)
                    set target = FirstOfGroup(g)
                endloop
                
                if target != null then
                    call UnitAddAbility(dummy, 'A0QC')
                    call SetUnitAbilityLevel(dummy, 'A0QC', lvl)
                    call IssueTargetOrder(dummy, "thunderbolt", target)
                endif
                call DestroyGroup(g)
                set dummy = null
            endif
            
            // 特效创建判空
            set fx = AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", projX, projY)
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
            
            set i = i + 1
        endloop
    else
        // 技能周期结束，完整清理状态
        call ClearHero326SkillState()
    endif

    set caster = null
    set casterOwner = null
    set dummy = null
    set g = null
    set target = null
    set fx = null
endfunction

// ====================================
// 透明渐变逻辑（已合并入主周期，空实现兼容）
// ====================================
function Trig_Hero326_04_Effect_2_Actions takes nothing returns nothing
endfunction

// ====================================
// 技能施法主动作
// ====================================
function Trig_Hero326_04_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local unit targetDummy
    local unit startDummy
    local real castX
    local real castY
    local real targetX
    local real targetY
    local real angle
    local integer lvl
    local player owner
    local location soundLoc

    // 前置兜底
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set owner = GetOwningPlayer(caster)
    set castX = GetUnitX(caster)
    set castY = GetUnitY(caster)
    set targetX = GetSpellTargetX()
    set targetY = GetSpellTargetY()
    set angle = Atan2(targetY - castY, targetX - castX) * bj_RADTODEG

    // 施法前重置旧状态，避免二次施法数据混杂
    call ClearHero326SkillState()

    set udg__Uni0[3264] = caster
    set udg__Rea0[3264] = angle
    set lvl = GetUnitAbilityLevel(caster, 'A0G5')

    // 起手水箭马甲 + 限时生命
    set startDummy = CreateUnit(owner, 'h06Y', castX, castY, angle)
    if startDummy != null then
        call UnitApplyTimedLife(startDummy, 'BTLF', 1.50)
        call SetUnitAnimation(startDummy, udg__Str0[(3260 + GetRandomInt(0, 2))])
        set startDummy = null
    endif

    // 音效坐标局部化，用完即销毁，消除泄漏
    set soundLoc = GetUnitLoc(caster)
    call PlaySoundAtPointBJ(gg_snd_Effect003, 80.00, soundLoc, 0)
    call SetSoundDistances(gg_snd_Effect003, 1000.00, 3000.00)
    call RemoveLocation(soundLoc)
    set soundLoc = null

    // 目标点特效马甲
    set targetDummy = CreateUnit(owner, 'e03E', targetX, targetY, bj_UNIT_FACING)
    if targetDummy != null then
        call UnitApplyTimedLife(targetDummy, 'BTLF', 5.00 + I2R(lvl))
        call UnitAddAbility(targetDummy, udg___Skill[3264])
        set targetDummy = null
    endif

    // 恢复原版0.04秒周期
    set udg__Int0[3264] = 0
    call TimerStart(udg__Tim0[3264], 0.04, true, null)
    call EnableTrigger(gg_trg_Hero326_04_Effect_2)

    set caster = null
    set targetDummy = null
    set startDummy = null
    set owner = null
endfunction

