//===========================================================================
// 冰雹攻击主循环计时器
//===========================================================================
function Trig_1_0__________uFunc012T takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit cloud = LoadUnitHandle(ght_temp, id, 0xC303079D)
    local unit caster = LoadUnitHandle(ght_temp, id, 0x458B7DE9)
    local timer impactTimer
    local integer impactId
    local real cloudX
    local real cloudY
    local real randDist
    local real randAngRad
    local real impactX
    local real impactY
    local unit hailUnit

    if cloud == null or not IsUnitAliveBJ(cloud) or caster == null then
        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(ght_temp, id)
        call DestroyTimer(GetExpiredTimer())
        set cloud = null
        set caster = null
        return
    endif

    set cloudX = GetUnitX(cloud)
    set cloudY = GetUnitY(cloud)

    set randDist = GetRandomReal(0, 300.00)
    set randAngRad = GetRandomDirectionDeg() * bj_DEGTORAD
    set impactX = cloudX + randDist * Cos(randAngRad)
    set impactY = cloudY + randDist * Sin(randAngRad)

    if GetRandomInt(1, 100) <= 90 then
        set hailUnit = CreateUnit(GetOwningPlayer(caster), 'e042', impactX, impactY, bj_UNIT_FACING)
        if hailUnit != null then
            call UnitApplyTimedLife(hailUnit, 'BHwe', 0.40)
            call SetUnitFlyHeight(hailUnit, 600.00, 0.00)
            call SetUnitFlyHeight(hailUnit, 0.00, 1200.00)
        endif

        set impactTimer = CreateTimer()
        set impactId = GetHandleId(impactTimer)
        call SaveUnitHandle(ght_temp, impactId, 0x458B7DE9, caster)
        call SaveReal(ght_temp, impactId, 0x50525CFC, impactX)
        call SaveReal(ght_temp, impactId, 0x50525CFC + 1, impactY)
        call TimerStart(impactTimer, 0.50, false, function Trig_1_0__________uFunc012Func001Func001Func015T)
    else
        set hailUnit = CreateUnit(GetOwningPlayer(caster), 'e043', impactX, impactY, 270.00)
        if hailUnit != null then
            call UnitApplyTimedLife(hailUnit, 'BHwe', 1.00)
        endif

        set impactTimer = CreateTimer()
        set impactId = GetHandleId(impactTimer)
        call SaveUnitHandle(ght_temp, impactId, 0x458B7DE9, caster)
        call SaveReal(ght_temp, impactId, 0x50525CFC, impactX)
        call SaveReal(ght_temp, impactId, 0x50525CFC + 1, impactY)
        call TimerStart(impactTimer, 1.00, false, function Trig_1_0__________uFunc012Func001Func001Func006T)
    endif

    set impactTimer = null
    set hailUnit = null
    set cloud = null
    set caster = null
endfunction

//===========================================================================
// 技能主动作
//===========================================================================
function Trig_1_0__________uActions takes nothing returns nothing
    local timer trackTimer
    local timer damageTimer
    local timer hailTimer
    local integer trackId
    local integer damageId
    local integer hailId
    local integer ydl_localvar_step
    local integer triggerId
    local integer parentKey
    local unit caster
    local unit cloud
    local real targetX
    local real targetY

    set ydl_localvar_step = LoadInteger(ght_temp, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
    set ydl_localvar_step = ydl_localvar_step + 3
    set triggerId = GetHandleId(GetTriggeringTrigger())
    call SaveInteger(ght_temp, triggerId, 0xCFDE6C76, ydl_localvar_step)
    call SaveInteger(ght_temp, triggerId, 0xECE825E7, ydl_localvar_step)
    set parentKey = triggerId * ydl_localvar_step

    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set targetX = GetSpellTargetX()
    set targetY = GetSpellTargetY()

    set cloud = CreateUnit(GetOwningPlayer(caster), 'e041', targetX, targetY, bj_UNIT_FACING)
    if cloud != null then
        call SetUnitTimeScale(cloud, 0.50)
        call UnitApplyTimedLife(cloud, 'BHwe', 10.00)
        call UnitAddAbility(cloud, 'A0ZK')
    endif
    call SaveUnitHandle(ght_temp, parentKey, 0xC303079D, cloud)

    set trackTimer = CreateTimer()
    set trackId = GetHandleId(trackTimer)
    call SaveUnitHandle(ght_temp, trackId, 0x458B7DE9, caster)
    call SaveUnitHandle(ght_temp, trackId, 0xC303079D, cloud)
    call TimerStart(trackTimer, 0.05, true, function Trig_1_0__________uFunc008T)

    set damageTimer = CreateTimer()
    set damageId = GetHandleId(damageTimer)
    call SaveUnitHandle(ght_temp, damageId, 0x458B7DE9, caster)
    call SaveUnitHandle(ght_temp, damageId, 0xC303079D, cloud)
    call TimerStart(damageTimer, 0.10, true, function Trig_1_0__________uFunc010T)

    set hailTimer = CreateTimer()
    set hailId = GetHandleId(hailTimer)
    call SaveUnitHandle(ght_temp, hailId, 0x458B7DE9, caster)
    call SaveUnitHandle(ght_temp, hailId, 0xC303079D, cloud)
    call TimerStart(hailTimer, 0.10, true, function Trig_1_0__________uFunc012T)

    call FlushChildHashtable(ght_temp, parentKey)

    set trackTimer = null
    set damageTimer = null
    set hailTimer = null
    set caster = null
    set cloud = null
endfunction

//===========================================================================
// 触发器初始化
//===========================================================================
function InitTrig_1_0__________u takes nothing returns nothing
    if ght_temp == null then
        set ght_temp = InitHashtable()
    endif
    set cond_cloud_track = Condition(function Trig_1_0__________uFunc008Func001Func003003003)
    set cond_cloud_damage = Condition(function Trig_1_0__________uFunc010Func001Func003003003)
    set cond_hail_big = Condition(function Trig_1_0__________uFunc012Func001Func001Func006Func002003003)
    set cond_hail_small = Condition(function Trig_1_0__________uFunc012Func001Func001Func015Func001003003)

    set gg_trg_1_0__________u = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_1_0__________u, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_1_0__________u, Condition(function Trig_1_0__________uConditions))
    call TriggerAddAction(gg_trg_1_0__________u, function Trig_1_0__________uActions)
endfunction
//陆逊本专
// ========== 工具函数 ==========
function LuXun_FilterTarget takes nothing returns boolean
    return ((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false) and (IsUnitAliveBJ(GetFilterUnit()))) and ((IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LuXun_UnitArray[0]))) and (IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND)))
endfunction

function LuXun_LockTarget takes nothing returns nothing
    set LuXun_LockedTarget = GetEnumUnit()
endfunction

function LuXun_FilterHero takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO)
endfunction

function LuXun_ApplyShake takes nothing returns nothing
    call CameraSetEQNoiseForPlayer(GetOwningPlayer(GetEnumUnit()), 15.0)
endfunction

function LuXun_FilterDamage takes nothing returns boolean
    return (IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false) and (IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND)) and (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LuXun_UnitArray[1])))
endfunction

function LuXun_DealDamage takes nothing returns nothing
    call UnitDamageTargetBJ(LuXun_UnitArray[0], GetEnumUnit(), (I2R(GetHeroStatBJ(bj_HEROSTAT_INT, LuXun_UnitArray[0], true)) * 10.0), ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
    call j5baM8W(1.5, AddSpecialEffectTarget("Environment\\SmallBuildingFire\\SmallBuildingFire1.mdl", GetEnumUnit(), "origin"))
endfunction

function LuXun_FilterHeroClear takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO)
endfunction

function LuXun_ClearShake takes nothing returns nothing
    call CameraClearNoiseForPlayer(GetOwningPlayer(GetEnumUnit()))
endfunction

// 统一爆炸执行逻辑（提前引爆/自动引爆共用）
function LuXun_DoExplode takes nothing returns nothing
    local group g
    local location loc = GetUnitLoc(LuXun_UnitArray[1])

    // 屏幕震动
    set g = GetUnitsInRangeOfLocMatching(200000.0, loc, Condition(function LuXun_FilterHero))
    call ForGroupBJ(g, function LuXun_ApplyShake)
    call DestroyGroup(g)

    // 范围伤害
    set g = GetUnitsInRangeOfLocMatching(300.0, loc, Condition(function LuXun_FilterDamage))
    call ForGroupBJ(g, function LuXun_DealDamage)
    call DestroyGroup(g)

    // 爆炸特效
    call DestroyEffect(AddSpecialEffectLoc("war3mapimported\\newmassiveex.mdx", loc))
    call DestroyEffect(AddSpecialEffectLoc("war3mapimported\\flamebomb.mdx", loc))

    // 爆炸马甲
    call CreateNUnitsAtLoc(1, 'e03B', GetOwningPlayer(LuXun_UnitArray[0]), loc, GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(0.1, 'BTLF', GetLastCreatedUnit())
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.0)

    call CreateNUnitsAtLoc(1, 'e03C', GetOwningPlayer(LuXun_UnitArray[0]), loc, GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(0.1, 'BTLF', GetLastCreatedUnit())
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.0)

    call CreateNUnitsAtLoc(1, 'e03G', GetOwningPlayer(LuXun_UnitArray[0]), loc, GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(0.1, 'BTLF', GetLastCreatedUnit())

    call RemoveLocation(loc)
    set g = null
    set loc = null
endfunction

// 统一收尾清理（解除暂停、移除马甲、清震动）
function LuXun_CleanUp takes nothing returns nothing
    // 解除施法者暂停
    call PauseUnit(LuXun_UnitArray[0], false)
    call SetUnitTimeScalePercent(LuXun_UnitArray[0], 100.0)

    // 清除屏幕震动
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(200000.0, GetRectCenter(GetPlayableMapRect()), Condition(function LuXun_FilterHeroClear)), function LuXun_ClearShake)

    // 释放坐标
    call RemoveLocation(LuXun_LocArray[0])
    call RemoveLocation(LuXun_LocArray[1])
    call RemoveLocation(LuXun_LocArray[2])

    // 清理单位组
    if LuXun_TempGroup != null then
        call DestroyGroup(LuXun_TempGroup)
        set LuXun_TempGroup = null
    endif

    set LuXun_UnitArray[0] = null
    set LuXun_LockedTarget = null

    call TriggerSleepAction(1.0)
    call RemoveUnit(LuXun_UnitArray[1])
    call RemoveUnit(LuXun_UnitArray[2])
    set LuXun_UnitArray[1] = null
    set LuXun_UnitArray[2] = null
endfunction


// ========== 新增：探测球移动 + 自动引爆 ==========
function LuXun_MoveStep takes nothing returns nothing
    local real angle
    set LuXun_StepCount = LuXun_StepCount + 1

    if LuXun_StepCount <= 25 then
        // 探测球向目标点移动
        set angle = AngleBetweenPoints(LuXun_LocArray[1], LuXun_LocArray[0])
        call SetUnitPositionLocFacingBJ(LuXun_UnitArray[1], PolarProjectionBJ(LuXun_LocArray[1], 37.0, angle), angle)
        call RemoveLocation(LuXun_LocArray[1])
        set LuXun_LocArray[1] = GetUnitLoc(LuXun_UnitArray[1])

        // 视觉马甲跟随移动
        set angle = AngleBetweenPoints(LuXun_LocArray[2], LuXun_LocArray[0])
        call SetUnitPositionLocFacingBJ(LuXun_UnitArray[2], PolarProjectionBJ(LuXun_LocArray[2], 25.0, angle), angle)
        call RemoveLocation(LuXun_LocArray[2])
        set LuXun_LocArray[2] = GetUnitLoc(LuXun_UnitArray[2])

        // 第16步解除施法者暂停
        if LuXun_StepCount == 16 then
            call PauseUnit(LuXun_UnitArray[0], false)
        endif
    else
        // 第25步到达终点，自动引爆
        call PauseTimer(LuXun_MoveTimer)
        call PauseTimer(LuXun_DetectTimer)
        call DisableTrigger(LuXun_ProxTrigger)

        call LuXun_DoExplode()
        call LuXun_CleanUp()
    endif
endfunction


// ========== 阶段一：目标选择（已修正逻辑反转） ==========
function LuXun_DetectTarget takes nothing returns nothing
    local group g = GetUnitsInRangeOfLocMatching(200.0, GetUnitLoc(LuXun_UnitArray[1]), Condition(function LuXun_FilterTarget))
    set LuXun_TempGroup = GetRandomSubGroup(1, g)
    call DestroyGroup(g)

    // 修正：找到目标才锁定、开启高频检测
    if not IsUnitGroupEmptyBJ(LuXun_TempGroup) then
        call PauseTimer(LuXun_MoveTimer)
        call PauseTimer(LuXun_DetectTimer)
        call ForGroupBJ(LuXun_TempGroup, function LuXun_LockTarget)
        call EnableTrigger(LuXun_ProxTrigger)
    else
        // 没找到目标，销毁临时组继续飞行
        call DestroyGroup(LuXun_TempGroup)
        set LuXun_TempGroup = null
    endif

    set g = null
endfunction


// ========== 阶段二：高频距离检测 + 碰撞引爆 ==========
function LuXun_ProximityExplode takes nothing returns nothing
    // 目标消失则恢复正常飞行
    if LuXun_LockedTarget == null or not IsUnitAliveBJ(LuXun_LockedTarget) then
        call DisableTrigger(GetTriggeringTrigger())
        if LuXun_TempGroup != null then
            call DestroyGroup(LuXun_TempGroup)
            set LuXun_TempGroup = null
        endif
        set LuXun_LockedTarget = null
        call StartTimerBJ(LuXun_MoveTimer, true, 0.04)
        call StartTimerBJ(LuXun_DetectTimer, true, 0.01)
        return
    endif

    if DistanceBetweenPoints(GetUnitLoc(LuXun_UnitArray[1]), GetUnitLoc(LuXun_LockedTarget)) <= 200.0 then
        call DisableTrigger(GetTriggeringTrigger())
        call PauseTimer(LuXun_MoveTimer)
        call PauseTimer(LuXun_DetectTimer)

        call LuXun_DoExplode()
        call LuXun_CleanUp()
    endif
endfunction


// ========== 技能条件 & 主入口 ==========
function LuXun_SpellCondition takes nothing returns boolean
    return GetSpellAbilityId() == 'A0KO'
endfunction

function LuXun_SpellMain takes nothing returns nothing
    set LuXun_UnitArray[0] = GetTriggerUnit()
    set LuXun_LocArray[0] = GetSpellTargetLoc()

    call SetUnitTimeScalePercent(LuXun_UnitArray[0], 30.0)
    call PolledWait(0.01)
    //call PauseUnit(LuXun_UnitArray[0], true)
    set LuXun_StepCount = 0

    // 视觉马甲
    call CreateNUnitsAtLoc(1, 'e03N', GetOwningPlayer(LuXun_UnitArray[0]), PolarProjectionBJ(GetUnitLoc(LuXun_UnitArray[0]), 10.0, GetUnitFacing(LuXun_UnitArray[0])), GetUnitFacing(LuXun_UnitArray[0]))
    call UnitApplyTimedLifeBJ(3.0, 'BTLF', GetLastCreatedUnit())
    set LuXun_UnitArray[2] = GetLastCreatedUnit()
    set LuXun_LocArray[2] = GetUnitLoc(LuXun_UnitArray[2])

    // 探测球马甲
    call CreateNUnitsAtLoc(1, 'e03A', GetOwningPlayer(LuXun_UnitArray[0]), PolarProjectionBJ(GetUnitLoc(LuXun_UnitArray[0]), 50.0, GetUnitFacing(LuXun_UnitArray[0])), GetUnitFacing(LuXun_UnitArray[0]))
    call UnitApplyTimedLifeBJ(3.0, 'BTLF', GetLastCreatedUnit())
    set LuXun_UnitArray[1] = GetLastCreatedUnit()
    set LuXun_LocArray[1] = GetUnitLoc(LuXun_UnitArray[1])

    // 启动计时器
    call StartTimerBJ(LuXun_MoveTimer, true, 0.04)
    call StartTimerBJ(LuXun_DetectTimer, true, 0.01)
endfunction


// ========== 初始化模块 ==========
function LuXun_InitBase takes nothing returns nothing
    set LuXun_MoveTimer = CreateTimer()
    set LuXun_DetectTimer = CreateTimer()
    set LuXun_TempGroup = null
    set LuXun_LockedTarget = null
    set LuXun_StepCount = 0
endfunction

function LuXun_InitProxTrigger takes nothing returns nothing
    set LuXun_ProxTrigger = CreateTrigger()
    call DisableTrigger(LuXun_ProxTrigger)
    call TriggerRegisterTimerEventPeriodic(LuXun_ProxTrigger, 0.01)
    call TriggerAddAction(LuXun_ProxTrigger, function LuXun_ProximityExplode)
endfunction

function LuXun_InitDetectTrigger takes nothing returns nothing
    set LuXun_DetectTrigger = CreateTrigger()
    call TriggerRegisterTimerExpireEvent(LuXun_DetectTrigger, LuXun_DetectTimer)
    call TriggerAddAction(LuXun_DetectTrigger, function LuXun_DetectTarget)
endfunction

// 新增：移动计时器事件绑定
function LuXun_InitMoveTrigger takes nothing returns nothing
    set LuXun_MoveTrigger = CreateTrigger()
    call TriggerRegisterTimerExpireEvent(LuXun_MoveTrigger, LuXun_MoveTimer)
    call TriggerAddAction(LuXun_MoveTrigger, function LuXun_MoveStep)
endfunction

function LuXun_InitSpellTrigger takes nothing returns nothing
    set LuXun_SpellTrigger = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(LuXun_SpellTrigger, EVENT_PLAYER_UNIT_SPELL_EFFECT)
