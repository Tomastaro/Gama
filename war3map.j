            call SetUnitFlyHeight(caster, GetUnitFlyHeight(target), 0.00)
            
            set eff = AddSpecialEffectTarget("war3mapImported\\e556.mdx", target, "chest")
            if eff != null then
                call DestroyEffect(eff)
                set eff = null
            endif
            set eff = AddSpecialEffectTarget("war3mapImported\\az-blood-hit.mdx", target, "chest")
            if eff != null then
                call DestroyEffect(eff)
                set eff = null
            endif
            set eff = AddSpecialEffectTarget("Abilities\\Weapons\\Blood\\BloodImpact.mdl", target, "chest")
            if eff != null then
