// ==================== 恢复技能（死亡或结束时调用） ====================
// ==================== 技能恢复函数（带等级还原） ====================
// ==================== 技能恢复函数（带等级还原） ====================
function RestoreSkills takes integer playerId returns nothing
    local unit u = WuShuangUnit[playerId]
    local integer savedLevel
    
    if u != null then
        if GetUnitTypeId(u) != 0 then
            // 从哈希表读取保存的普通技能等级
            set savedLevel = LoadInteger(udg_HT_WuShuang, playerId, 0)
            // 移除无双技能
            if GetUnitAbilityLevel(u, SKILL_WUSHANG) > 0 then
                call UnitRemoveAbility(u, SKILL_WUSHANG)
            endif
            // 加回普通技能 + 还原等级，彻底杜绝等级丢失
            if GetUnitAbilityLevel(u, SKILL_NORMAL) == 0 then
                call UnitAddAbility(u, SKILL_NORMAL)
                call SetUnitAbilityLevel(u, SKILL_NORMAL, savedLevel)
            endif
        endif
        set WuShuangUnit[playerId] = null
    endif
    
    set isWuShuangActive[playerId] = false
    // 清空哈希表中的等级记录
    call RemoveSavedInteger(udg_HT_WuShuang, playerId, 0)
    set u = null
endfunction

// ==================== 计时器到期回调 ====================
function EndWuShuangByTimer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer playerId = 0
    
    loop
        exitwhen playerId > 11
        if WuShuangTimer[playerId] == t then
            exitwhen true
        endif
        set playerId = playerId + 1
    endloop
    
    if playerId <= 11 then
        call RestoreSkills(playerId)
        call DestroyTimer(t)
        set WuShuangTimer[playerId] = null
    endif
    
    set t = null
endfunction

// ==================== 单位死亡处理 ====================
function OnUnitDeath takes nothing returns nothing
    local unit deadUnit = GetDyingUnit()
    local integer playerId
    
    if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
        set deadUnit = null
        return
    endif
    
    set playerId = GetPlayerId(GetOwningPlayer(deadUnit))
    if playerId >= 0 and playerId <= 11 then
        if WuShuangUnit[playerId] == deadUnit and isWuShuangActive[playerId] then
            call RestoreSkills(playerId)
            if WuShuangTimer[playerId] != null then
                call DestroyTimer(WuShuangTimer[playerId])
                set WuShuangTimer[playerId] = null
            endif
        endif
    endif
    
    set deadUnit = null
endfunction

// ==================== 学习技能 → 解锁科技 ====================
function BRx takes nothing returns boolean
    return GetLearnedSkill() == SKILL_TRIGGER
endfunction

function cRx takes nothing returns nothing
    local unit u = GetTriggerUnit()
    if u == null then
        set u = null
        return
    endif
    call SetPlayerTechResearchedSwap(SKILL_UNLOCK_TECH, 1, GetOwningPlayer(u))
    set u = null
endfunction

// ==================== 开启无双条件 ====================
function KQx takes nothing returns boolean
    return GetSpellAbilityId() == SKILL_TRIGGER
endfunction

// ==================== 开启无双动作 ====================
function KSx takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p
    local integer playerId
    local integer lvl
    local real duration
    local unit oldUnit
    local integer normalLevel
    
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif
    
    set p = GetOwningPlayer(u)
    set playerId = GetPlayerId(p)
    set lvl = GetUnitAbilityLevel(u, SKILL_TRIGGER)
    
    // 已激活则先清理旧状态
    if isWuShuangActive[playerId] then
        set oldUnit = WuShuangUnit[playerId]
        if oldUnit != null and oldUnit != u then
            call RestoreSkills(playerId)
        endif
        if WuShuangTimer[playerId] != null then
            call DestroyTimer(WuShuangTimer[playerId])
            set WuShuangTimer[playerId] = null
        endif
    endif
    
    // 持续时长
    if lvl == 1 then
        set duration = 30.00
    elseif lvl == 2 then
        set duration = 40.00
    else
        set duration = 50.00
    endif
    
    // 保存普通技能等级 + 技能替换
    set normalLevel = GetUnitAbilityLevel(u, SKILL_NORMAL)
    if normalLevel > 0 then
        // 等级存入哈希表，不新增全局数组变量
        call SaveInteger(udg_HT_WuShuang, playerId, 0, normalLevel)
        call UnitRemoveAbility(u, SKILL_NORMAL)
    endif
    if GetUnitAbilityLevel(u, SKILL_WUSHANG) == 0 then
        call UnitAddAbility(u, SKILL_WUSHANG)
        // 可选：无双技能等级与触发技能同步
        // call SetUnitAbilityLevel(u, SKILL_WUSHANG, lvl)
    endif
    
    // 记录状态
    set WuShuangUnit[playerId] = u
    set isWuShuangActive[playerId] = true
    
    // 本地玩家提示
    if GetLocalPlayer() == p then
        call DisplayTextToPlayer(p, 0, 0, "|cff00ff00无双状态激活|r")
        call DisplayTextToPlayer(p, 0, 0, "|cffffff00持续时间：" + R2S(duration) + "秒|r")
    endif
    
    // 启动计时器
    set WuShuangTimer[playerId] = CreateTimer()
    call TimerStart(WuShuangTimer[playerId], duration, false, function EndWuShuangByTimer)
    
    set u = null
    set p = null
    set oldUnit = null
endfunction

// ==================== 初始化触发器 ====================
function InitTrig_WuShuang takes nothing returns nothing
    local integer i = 0
    // 哈希表初始化（替代新增数组，零编辑器改动）
    if udg_HT_WuShuang == null then
        set udg_HT_WuShuang = InitHashtable()
    endif
    
    loop
        exitwhen i >= 12
        set WuShuangUnit[i] = null
        set isWuShuangActive[i] = false
        set WuShuangTimer[i] = null
        set i = i + 1
    endloop
    
    set Exx = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(Exx, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(Exx, Condition(function BRx))
    call TriggerAddAction(Exx, function cRx)
    
    set KEx = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(KEx, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(KEx, Condition(function KQx))
    call TriggerAddAction(KEx, function KSx)
    
    set DeathTrigger = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(DeathTrigger, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(DeathTrigger, function OnUnitDeath)
endfunction



//-------------------------------------------天翔
//-------------------------------------------天翔
function sRxzhg takes nothing returns nothing
    local unit target = GetEnumUnit()
    local unit caster = LoadUnitHandle(udg_HT_A0WK, 0, 0)
    if caster != null and IsUnitEnemy(target, GetOwningPlayer(caster)) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
        call UnitDamageTargetBJ(caster, target, 3 * (GetHeroStr(caster, true) + GetHeroAgi(caster, true)), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL)
    endif
    set caster = null
    set target = null
endfunction

// ====================================
// 位移回调（每0.03秒）
// ====================================
function Charge_A0WK_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_A0WK, id, 1)
    local location startLoc = LoadLocationHandle(udg_HT_A0WK, id, 2)
    local location targetLoc = LoadLocationHandle(udg_HT_A0WK, id, 3)
    local real angle = LoadReal(udg_HT_A0WK, id, 4)
    local real totalDist = LoadReal(udg_HT_A0WK, id, 5)
    local real currentDist = LoadReal(udg_HT_A0WK, id, 6)
    local real step = totalDist / 25.0
    local location newLoc
    local group g

    // 异常兜底：单位无效直接清理终止
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        // 单位存活则清理附加技能
        if caster != null then
            call UnitRemoveAbility(caster, 'A0NR')
        endif
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_A0WK, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 到达终点
    if currentDist >= totalDist then
        call UnitRemoveAbility(caster, 'A0NR')
        call ResetUnitAnimation(caster)
        // 终点范围伤害
        set g = Xn(300.00, targetLoc)
        call SaveUnitHandle(udg_HT_A0WK, 0, 0, caster)
        call ForGroupBJ(g, function sRxzhg)
        call RemoveSavedHandle(udg_HT_A0WK, 0, 0)
        call DestroyGroup(g)
        // 树木破坏
        call xn(300.00, targetLoc, function NA)
        // 全量资源清理
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_A0WK, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_A0WK, id, 6, currentDist)

        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)
        call RemoveLocation(newLoc)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
    set g = null
endfunction

// ====================================
// 技能动作（施法瞬间创建马甲）
// ====================================
function A3xzz takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real totalDist
    local timer t
    local integer id
    local unit dummy

    // 入口兜底：施法者无效直接退出
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    
    // 目标点判空兜底，极端异常场景直接终止
    if targetLoc == null then
        call RemoveLocation(startLoc)
        set caster = null
        set startLoc = null
        return
    endif

    set angle = AngleBetweenPoints(startLoc, targetLoc)
    set totalDist = DistanceBetweenPoints(startLoc, targetLoc)

    // 距离过近直接终止
    if totalDist <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 施法状态设置
    call SetUnitAnimationWithRarity(caster, "Attack Throw", RARITY_RARE)
    call UnitAddAbility(caster, 'A0NR')

    // 目标点马甲（修复：创建判空，杜绝空指针崩溃）
    call CreateNUnitsAtLoc(1, 'e00R', GetOwningPlayer(caster), targetLoc, bj_UNIT_FACING)
    set dummy = bj_lastCreatedUnit
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        call IssueImmediateOrderById(dummy, 852127)
        set dummy = null
    endif

    // 创建独立计时器与实例数据
    set t = CreateTimer()
    set id = GetHandleId(t)
    call SaveUnitHandle(udg_HT_A0WK, id, 1, caster)
    call SaveLocationHandle(udg_HT_A0WK, id, 2, startLoc)
    call SaveLocationHandle(udg_HT_A0WK, id, 3, targetLoc)
    call SaveReal(udg_HT_A0WK, id, 4, angle)
    call SaveReal(udg_HT_A0WK, id, 5, totalDist)
    call SaveReal(udg_HT_A0WK, id, 6, 0.0)
    call TimerStart(t, 0.03, true, function Charge_A0WK_MoveCallback)

    set caster = null
    set startLoc = null
    set targetLoc = null
    set t = null
endfunction

