endfunction

// ★ 纯坐标牵引，零点泄漏
function Trig_B_Func002Func004Func004Axzg9 takes nothing returns nothing
    local unit u = GetEnumUnit()
    local real x = GetUnitX(u)
    local real y = GetUnitY(u)
    local real mx = GetUnitX(udg_danwei[5240])
    local real my = GetUnitY(udg_danwei[5240])
    local real tx = GetLocationX(udg_dian[93])
    local real ty = GetLocationY(udg_dian[93])
    local real angle = Atan2(ty - my, tx - mx)
    local real nx = x + 60.00 * Cos(angle)
    local real ny = y + 60.00 * Sin(angle)
    local location tempLoc = Location(x, y)

    call xn(192.00, tempLoc, function cBxz)
    call RemoveLocation(tempLoc)
    set tempLoc = null
    call SetUnitPosition(u, nx, ny)

    if udg_zhengshu[90] == 1 or udg_zhengshu[90] == 5 or udg_zhengshu[90] == 9 then
        if Cvt[3] != null then
        //牵引伤害
            call UnitDamageTargetBJ(udg_chufa11, u, (50 + 50 * GetUnitAbilityLevelSwapped('A0RS', Cvt[3]) + 60 + GetHeroStatBJ(bj_HEROSTAT_STR, Cvt[3], true) + udg_LubuAttack2) * 1.2, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
        endif
    endif
    call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", nx, ny))
    set u = null
endfunction

function Trig_B_Func002Func004Cxzg9 takes nothing returns boolean
    return udg_zhengshu[90] <= 12
endfunction

function Trig_B_Func002Func005Axzg9 takes nothing returns nothing
    set udg_danwei[90] = CreateUnitAtLoc(GetOwningPlayer(udg_chufa11), 'ewsp', udg_dian[90], 0)
    call ShowUnitHide(udg_danwei[90])
    call UnitApplyTimedLife(udg_danwei[90], 'BTLF', 5.0)
endfunction

function Trig_B_Func002Cxzg9 takes nothing returns boolean
    return udg_buer[90] == true
endfunction

// ★ 外层使用 udg_dian[90] 暂存中心点，用后即毁
function Trig_Bxzg9_Actions takes nothing returns nothing
    if Trig_B_Func002Cxzg9() then
        set udg_dian[90] = GetUnitLoc(udg_chufa11)
        call ForGroupBJ(udg_zu[90], function Trig_B_Func002Func005Axzg9)
        call RemoveLocation(udg_dian[90])
        set udg_dian[90] = null
        set udg_buer[90] = false
    else
        set udg_dian[90] = GetUnitLoc(udg_danwei[5240])
        set udg_zu[92] = GetUnitsInRangeOfLocMatching(800.00, udg_dian[90], Condition(function Trig_B_Func002Func002002003xzg9))
        call RemoveLocation(udg_dian[90])
        set udg_dian[90] = null
        if Trig_B_Func002Func004Cxzg9() then
            call ForGroupBJ(udg_zu[92], function Trig_B_Func002Func004Func004Axzg9)
            set udg_zhengshu[90] = udg_zhengshu[90] + 1
            call DestroyGroup(udg_zu[92])
        else
            call DisableTrigger(GetTriggeringTrigger())
            call DestroyGroup(udg_zu[90])
            call RemoveUnit(udg_danwei[5240])
            call RemoveLocation(udg_dian[93])
            set udg_dian[93] = null
        endif
    endif
    call StartTimerBJ(udg_jsq11, false, 0.06)
endfunction

function InitTrig_Bxzg9 takes nothing returns nothing
    if udg_jsq11 == null then
        set udg_jsq11 = CreateTimer()
    endif
    set gg_trg_Bxzg9 = CreateTrigger()
    call DisableTrigger(gg_trg_Bxzg9)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Bxzg9, udg_jsq11)
    call TriggerAddAction(gg_trg_Bxzg9, function Trig_Bxzg9_Actions)
endfunction

