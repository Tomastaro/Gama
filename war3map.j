//甘宁1
// 终点范围伤害 + 特效
function ChargeA0Z3_End takes unit caster, location targetLoc, real totalDist returns nothing
    local group g
    local unit u
    local real str = GetHeroStr(caster, true)          // 改为力量
    local real dmg = str * 3.0 + totalDist / 4.0

    call xn(300.00, targetLoc, function NA)
    set g = Xn(300.00, targetLoc)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call UnitDamageTarget(caster, u, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\CrimsonWake.mdl", u, "origin"))
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
endfunction

// ====================================
// 位移回调（每0.02秒）
// ====================================
function ChargeA0Z3_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_ChargeA0Z3, id, 1)
    local location startLoc = LoadLocationHandle(udg_HT_ChargeA0Z3, id, 2)
    local location targetLoc = LoadLocationHandle(udg_HT_ChargeA0Z3, id, 3)
    local real angle = LoadReal(udg_HT_ChargeA0Z3, id, 4)
    local real totalDist = LoadReal(udg_HT_ChargeA0Z3, id, 5)
    local real currentDist = LoadReal(udg_HT_ChargeA0Z3, id, 6)
    local real step = totalDist / 25.0
    local location newLoc

    if caster == null or not IsUnitAliveBJ(caster) then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_ChargeA0Z3, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    if currentDist >= totalDist then
        call ChargeA0Z3_End(caster, targetLoc, totalDist)
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_ChargeA0Z3, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_ChargeA0Z3, id, 6, currentDist)
        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)
        call RemoveLocation(newLoc)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 施法动作
// ====================================
function A3sx takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real totalDist
    local timer t
    local integer id
    local unit dummy

    if caster == null then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)
    set totalDist = DistanceBetweenPoints(startLoc, targetLoc)

    if totalDist <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    call SetUnitAnimationWithRarity(caster, "Attack Throw", RARITY_RARE)

    // 目标点马甲（保留原效果）
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'e00L', targetLoc, 0)
    call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
    call IssueImmediateOrderById(dummy, 852127)
    set dummy = null

    set t = CreateTimer()
    set id = GetHandleId(t)
    call SaveUnitHandle(udg_HT_ChargeA0Z3, id, 1, caster)
    call SaveLocationHandle(udg_HT_ChargeA0Z3, id, 2, startLoc)
    call SaveLocationHandle(udg_HT_ChargeA0Z3, id, 3, targetLoc)
    call SaveReal(udg_HT_ChargeA0Z3, id, 4, angle)
    call SaveReal(udg_HT_ChargeA0Z3, id, 5, totalDist)
    call SaveReal(udg_HT_ChargeA0Z3, id, 6, 0.0)
    call TimerStart(t, 0.02, true, function ChargeA0Z3_MoveCallback)

    set caster = null
    set startLoc = null
    set targetLoc = null
    set t = null
endfunction

