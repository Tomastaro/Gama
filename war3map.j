function xMtzsr8 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0MQ'
endfunction

// ====================================
// 初始化
// ====================================
function Init_LubuA08Q takes nothing returns nothing
    local trigger t

    // 主范围伤害触发器
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function xMtzsr8))
    call TriggerAddAction(t, function cMtzsr8)

    // 马甲嚎叫触发器（附加效果）
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Maxmaxzf_Cond))
    call TriggerAddAction(t, function maxmaxzf)

    set t = null
endfunction
//马超2
function R1xa2 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0MP'
endfunction
// 冲锋位移回调（每0.03秒）
// ====================================
function ChargeA0MP_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_ChargeA0MP, id, 1)
    local location startLoc = LoadLocationHandle(udg_HT_ChargeA0MP, id, 2)
    local location targetLoc = LoadLocationHandle(udg_HT_ChargeA0MP, id, 3)
    local real angle = LoadReal(udg_HT_ChargeA0MP, id, 4)
    local real totalDist = LoadReal(udg_HT_ChargeA0MP, id, 5)
    local real currentDist = LoadReal(udg_HT_ChargeA0MP, id, 6)
    local real step = totalDist / 25.0
    local location newLoc
    local location treeLoc
    local real x
    local real y
    local group g
    local unit u
    local unit stunner
    local integer lvl

    if caster == null or IsUnitAliveBJ(caster) == false then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_ChargeA0MP, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    if currentDist >= totalDist then
        call SetUnitAnimationWithRarity(caster, "Stand", RARITY_RARE)
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_ChargeA0MP, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_ChargeA0MP, id, 6, currentDist)

        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)

        set treeLoc = GetUnitLoc(caster)
        call xn(200.00, treeLoc, function NA1)
        call RemoveLocation(treeLoc)
        set treeLoc = null

        set lvl = GetUnitAbilityLevel(caster, 'A0MP')
        set x = GetLocationX(newLoc)
        set y = GetLocationY(newLoc)
        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, x, y, 200.0, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            if IsUnitEnemy(u, GetOwningPlayer(caster)) and IsUnitAliveBJ(u) then
                set stunner = CreateUnit(GetOwningPlayer(caster), 'h00M', x, y, 0.00)
                call UnitAddAbility(stunner, 'A0Q3')
                call SetUnitAbilityLevel(stunner, 'A0Q3', lvl)
                call IssueTargetOrder(stunner, "thunderbolt", u)
                call UnitApplyTimedLife(stunner, 'BTLF', 0.50)
                set stunner = null
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g = null

        call RemoveLocation(newLoc)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 主技能动作（冲锋 + 穿刺马甲）
// ====================================
function A0MP_SpellActions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local timer moveTimer
    local integer moveId
    local unit dummy1
    local unit dummy2

    if caster == null then
        set caster = null
        return
    endif

    set udg_hurt[3] = (57.0 + GetHeroAgi(caster, true) + udg_LubuAttack3) * 1.3

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)

    if DistanceBetweenPoints(startLoc, targetLoc) <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 马甲 h04F
    set dummy1 = CreateUnitAtLoc(GetOwningPlayer(caster), 'h04F', startLoc, angle)
    call UnitApplyTimedLife(dummy1, 'BTLF', 2.0)
    set dummy1 = null

    // 马甲 h04D 穿刺
    set dummy2 = CreateUnitAtLoc(GetOwningPlayer(caster), 'h04D', startLoc, angle)
    call UnitApplyTimedLife(dummy2, 'BTLF', 2.0)
    call IssuePointOrderLoc(dummy2, "impale", targetLoc)
    set dummy2 = null

    // 动画分支
    if UnitHasBuffBJ(caster, 'B01I') == false or GetUnitAbilityLevel(caster, 'A054') == 0 then
        call SetUnitAnimationWithRarity(caster, "Attack Throw", RARITY_RARE)
    else
        call SetUnitAnimationWithRarity(caster, "Attack Throw Slam", RARITY_RARE)
        call UnitAddAbility(caster, 'A0T6')
        call SetUnitAbilityLevel(caster, 'A0T6', GetUnitAbilityLevel(caster, 'A054'))
        call SetPlayerAbilityAvailableBJ(false, 'A0T6', GetOwningPlayer(caster))
    endif

    // 位移计时器
    set moveTimer = CreateTimer()
    set moveId = GetHandleId(moveTimer)
    call SaveUnitHandle(udg_HT_ChargeA0MP, moveId, 1, caster)
    call SaveLocationHandle(udg_HT_ChargeA0MP, moveId, 2, startLoc)
    call SaveLocationHandle(udg_HT_ChargeA0MP, moveId, 3, targetLoc)
    call SaveReal(udg_HT_ChargeA0MP, moveId, 4, angle)
    call SaveReal(udg_HT_ChargeA0MP, moveId, 5, 1000.0)
    call SaveReal(udg_HT_ChargeA0MP, moveId, 6, 0.0)
    call TimerStart(moveTimer, 0.03, true, function ChargeA0MP_MoveCallback)

    // 重要：startLoc 和 targetLoc 由计时器负责销毁，此处不 RemoveLocation

    set caster = null
    set moveTimer = null
endfunction

// ====================================
// 腐臭蜂群（完全独立，保留原版逻辑）
// ====================================
function xMmc takes nothing returns boolean
    return GetSpellAbilityId() == 'A0MP'
endfunction

function cMmc takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location loc1 = GetUnitLoc(caster)
    local location loc2 = GetSpellTargetLoc()
    local unit dummy

    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'h06R', loc1, AngleBetweenPoints(loc1, loc2))
    call SetUnitAbilityLevel(dummy, 'A1DY', GetUnitAbilityLevel(caster, 'A0MP'))
    call IssuePointOrderLoc(dummy, "carrionswarm", loc2)
    call UnitApplyTimedLife(dummy, 'BTLF', 2.0)

    call RemoveLocation(loc1)
    call RemoveLocation(loc2)
    set caster = null
    set loc1 = null
    set loc2 = null
    set dummy = null
endfunction

// ====================================
// 统一初始化
// ====================================
function Init_A0EP_FullSkill takes nothing returns nothing
    local trigger t

    if udg_HT_ChargeA0MP == null then
        set udg_HT_ChargeA0MP = InitHashtable()
    endif

    // 冲锋 + 穿刺
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function R1xa2))
    call TriggerAddAction(t, function A0MP_SpellActions)

    // 腐臭蜂群（独立触发器，保留原版完全相同的注册方式）
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function xMmc))
    call TriggerAddAction(t, function cMmc)

    set t = null
endfunction
//马超3
function TR takes nothing returns nothing
    local integer lvl      // 新增：用于保存A0MP的原始等级
    if GetSpellAbilityId() == 'A0L1' and jv[552] == null then
        set jv[552] = GetTriggerUnit()
        if GetUnitManaPercent(GetTriggerUnit()) >= 25 then
            set jc[133] = GetUnitLoc(GetTriggerUnit())
            call AddSpecialEffectLocBJ(jc[133], "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")
            call DestroyEffect(bj_lastCreatedEffect)
            // 保留等级后刷新技能
            set lvl = GetUnitAbilityLevel(GetTriggerUnit(), 'A0MP')
            call UnitRemoveAbility(GetTriggerUnit(), 'A0MP')
            call UnitAddAbility(GetTriggerUnit(), 'A0MP')
            call SetUnitAbilityLevel(GetTriggerUnit(), 'A0MP', lvl)
            call RemoveLocation(jc[133])
            set jc[133] = null
        endif
        call UnitAddAbility(jv[552], 'A0O7')
        call SetUnitAbilityLevelSwapped('A0O7', jv[552], GetUnitAbilityLevelSwapped('A0L1', jv[552]))
        call PolledWait(10.0)
        call UnitRemoveAbility(jv[552], 'A0O7')
        set jv[552] = null
    endif
endfunction

