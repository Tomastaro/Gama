function Trig_B_Func002Func004Func004Axzg5 takes nothing returns nothing
    local unit u = GetEnumUnit()
    local unit mover = udg_danwei[6100]
    local real mx
    local real my
    local real tx
    local real ty
    local real angle
    local real nx
    local real ny
    local effect fx

    if u == null or GetWidgetLife(u) <= 0.405 or mover == null then
        set u = null
        set mover = null
        return
    endif

    set mx = GetUnitX(mover)
    set my = GetUnitY(mover)
    set tx = GetUnitX(u)
    set ty = GetUnitY(u)
    set angle = Atan2(ty - my, tx - mx)
    set nx = tx + 8.00 * Cos(angle)
    set ny = ty + 8.00 * Sin(angle)

    call xn(192.0, udg_dian[171], function cBxz)
    call SetUnitPosition(u, nx, ny)

    if udg_zhengshu[170] == 1 or udg_zhengshu[170] == 4 or udg_zhengshu[170] == 7 or udg_zhengshu[170] == 10 or udg_zhengshu[170] == 13 or udg_zhengshu[170] == 16 or udg_zhengshu[170] == 19 or udg_zhengshu[170] == 22 or udg_zhengshu[170] == 25 then
        call UnitDamageTargetBJ(udg_chufa10, u, udg_hurt[5] * 1.2, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    endif

    set fx = AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", nx, ny)
    if fx != null then
        call DestroyEffect(fx)
        set fx = null
    endif

    set u = null
    set mover = null
endfunction

function Trig_B_Func002Func004Cxzg5 takes nothing returns boolean
    return udg_zhengshu[170] <= 25
endfunction

function Trig_B_Func002Func005Axzg5 takes nothing returns nothing
    local unit caster = udg_chufa10
    local unit dummy
    if caster == null then
        set caster = null
        return
    endif

    set udg_dian[170] = GetUnitLoc(caster)
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'ewsp', udg_dian[170], 0)
    set udg_danwei[170] = dummy
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        call ShowUnitHide(dummy)
        set dummy = null
    endif
    call RemoveLocation(udg_dian[170])
    set udg_dian[170] = null
    set caster = null
endfunction

function Trig_B_Func002Cxzg5 takes nothing returns boolean
    return udg_buer[170] == true
endfunction

// ==============================================
// 核心修复：周期枚举缓存Location，用完即销毁，零泄漏
// 其余逻辑100%和原版一致，确保伤害正常
// ==============================================
function Trig_Bxzg5_Actions takes nothing returns nothing
    local location moverLoc // 新增局部变量承接坐标
    if Trig_B_Func002Cxzg5() then
        call ForGroupBJ(udg_zu[170], function Trig_B_Func002Func005Axzg5)
        set udg_buer[170] = false
    else
        if udg_danwei[6100] != null then
            // 修复：先存局部变量，用完立刻销毁，彻底解决周期泄漏
            set moverLoc = GetUnitLoc(udg_danwei[6100])
            set udg_zu[172] = GetUnitsInRangeOfLocMatching(480.00, moverLoc, Condition(function Trig_B_Func002Func002002003xzg5))
            call RemoveLocation(moverLoc)
            set moverLoc = null

            if Trig_B_Func002Func004Cxzg5() then
                call ForGroupBJ(udg_zu[172], function Trig_B_Func002Func004Func004Axzg5)
                set udg_zhengshu[170] = udg_zhengshu[170] + 1
                call DestroyGroup(udg_zu[172])
            else
                call DisableTrigger(GetTriggeringTrigger())
                call DestroyGroup(udg_zu[170])
                call RemoveUnit(udg_danwei[6100])
                call RemoveLocation(udg_dian[173])
                set udg_dian[173] = null
                set udg_hurt[5] = 0
            endif
        endif
    endif
    call StartTimerBJ(udg_jsq10, false, 0.08)
endfunction

function InitTrig_Bxzg5 takes nothing returns nothing
    set gg_trg_Bxzg5 = CreateTrigger()
    call DisableTrigger(gg_trg_Bxzg5)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Bxzg5, udg_jsq10)
    call TriggerAddAction(gg_trg_Bxzg5, function Trig_Bxzg5_Actions)
endfunction

