//陨石
function Ba4 takes real qN, location qO, boolexpr fu returns group
    local group fs = CreateGroup()
    call GroupEnumUnitsInRangeOfLoc(fs, qO, qN, fu)
    if fu != null then
        call DestroyBoolExpr(fu)
    endif
    return fs
endfunction

// =====================================================
// 第一颗陨石
// =====================================================

function C9J takes nothing returns boolean
    return GetSpellAbilityId() == 'A0X8'
endfunction

function C9O takes nothing returns nothing
    local group g
    local unit u
    local location loc
    local location tempLoc
    local real dmg
    local unit dummy
    local unit caster

    // 施法音效
    call PlaySoundOnUnitBJ(EM, 100, GetTriggerUnit())
    set caster = GetTriggerUnit()

    // 目标点判空，杜绝空句柄崩溃
    set BDL[1] = GetSpellTargetLoc()
    if BDL[1] == null then
        set caster = null
        return
    endif
    set BDK[1] = caster
    set loc = BDL[1]

    // 第一颗陨石伤害：智力 x3
    set dmg = GetHeroInt(caster, true) * 3.0

    // 动画单位判空
    if BC5[2] != null and IsUnitAliveBJ(BC5[2]) then
        call SetUnitAnimation(BC5[2], "spell one")
    endif

    call TriggerSleepAction(1.0)

    // 施法者死亡异常分支：完整清理计时器、触发器与全局数据
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        if VJ != null then
            call PauseTimer(VJ)
        endif
        if BDM != null then
            call DisableTrigger(BDM)
        endif
        if BDL[1] != null then
            call RemoveLocation(BDL[1])
            set BDL[1] = null
        endif
        set BDK[1] = null
        set caster = null
        set loc = null
        set g = null
        set u = null
        set tempLoc = null
        set dummy = null
        return
    endif

    // 第一颗陨石落地音效
    call PlaySoundOnUnitBJ(GZ, 100, caster)

    call CreateNUnitsAtLoc(1, 'e05A', GetOwningPlayer(caster), loc, bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.2)
        set dummy = null
    endif

    call StartTimerBJ(VJ, false, 1.5)
    call EnableTrigger(BDM)

    // ---- 范围敌人（排除建筑） ----
    set g = CreateGroup()
    call GroupEnumUnitsInRangeOfLoc(g, loc, 500.0, null)
    set u = FirstOfGroup(g)
    loop
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if IsUnitAliveBJ(u) and IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            set tempLoc = GetUnitLoc(u)
            call CreateNUnitsAtLoc(1, 'e00O', GetOwningPlayer(caster), tempLoc, bj_UNIT_FACING)
            set dummy = GetLastCreatedUnit()
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
                call IssueTargetOrder(dummy, "thunderbolt", u)
                set dummy = null
            endif
            call UnitDamageTarget(caster, u, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            call RemoveLocation(tempLoc)
            set tempLoc = null
        endif
        set u = FirstOfGroup(g)
    endloop
    call DestroyGroup(g)
    set g = null

    set loc = null
    set u = null
    set dummy = null
    set caster = null
endfunction

function C9P takes nothing returns nothing
    set BDJ = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BDJ, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(BDJ, Condition(function C9J))
    call TriggerAddAction(BDJ, function C9O)
endfunction

// =====================================================
// 第二颗陨石
// =====================================================

function C9R takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'e05A'
endfunction

// 统一清理特效组：逐个销毁单位后再销毁组，同步清空全局数据
function C9S_ClearEffects takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local unit u

    call PauseTimer(t)
    if BDL_effectGroup != null then
        loop
            set u = FirstOfGroup(BDL_effectGroup)
            exitwhen u == null
            call GroupRemoveUnit(BDL_effectGroup, u)
            call RemoveUnit(u)
        endloop
        call DestroyGroup(BDL_effectGroup)
        set BDL_effectGroup = null
    endif

    // 特效播放完毕后统一清空全局坐标与施法者，避免时序竞争
    if BDL[1] != null then
        call RemoveLocation(BDL[1])
        set BDL[1] = null
    endif
    set BDK[1] = null

    call DestroyTimer(t)
    set t = null
    set u = null
endfunction

function C9S takes nothing returns nothing
    local integer i
    local real cx
    local real cy
    local real angle
    local real x
    local real y
    local unit dummy
    local unit u
    local timer clearTimer

    // 目标点与施法者双重判空
    if BDL[1] == null or BDK[1] == null or GetWidgetLife(BDK[1]) <= 0.405 then
        return
    endif

    // 环形爆炸音效
    call PlaySoundOnUnitBJ(Ge, 100, BDK[1])

    call CreateNUnitsAtLoc(1, 'e05F', GetOwningPlayer(BDK[1]), BDL[1], bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        set dummy = null
    endif

    // 新建组前强制清理旧组，杜绝覆盖泄漏
    if BDL_effectGroup != null then
        loop
            set u = FirstOfGroup(BDL_effectGroup)
            exitwhen u == null
            call GroupRemoveUnit(BDL_effectGroup, u)
            call RemoveUnit(u)
        endloop
        call DestroyGroup(BDL_effectGroup)
        set BDL_effectGroup = null
    endif

    // 新建清理组，所有特效统一纳入管理
    set BDL_effectGroup = CreateGroup()

    // 中心特效加入清理组，附加计时生命兜底
    call CreateNUnitsAtLoc(1, 'e05B', GetOwningPlayer(BDK[1]), BDL[1], bj_UNIT_FACING)
    set dummy = GetLastCreatedUnit()
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.5)
        call GroupAddUnit(BDL_effectGroup, dummy)
        set dummy = null
    endif

    // 环形特效全部加入清理组，原生坐标计算消除临时坐标开销
    set cx = GetLocationX(BDL[1])
    set cy = GetLocationY(BDL[1])
    set i = 1
    loop
        exitwhen i > 12
            set angle = 30.0 * I2R(i) * bj_DEGTORAD
            // 150半径
            set x = cx + Cos(angle) * 150.0
            set y = cy + Sin(angle) * 150.0
            set dummy = CreateUnit(GetOwningPlayer(BDK[1]), 'e05E', x, y, 0)
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 2.5)
                call GroupAddUnit(BDL_effectGroup, dummy)
                set dummy = null
            endif
            // 300半径
            set x = cx + Cos(angle) * 300.0
            set y = cy + Sin(angle) * 300.0
            set dummy = CreateUnit(GetOwningPlayer(BDK[1]), 'e05E', x, y, 0)
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 2.5)
                call GroupAddUnit(BDL_effectGroup, dummy)
                set dummy = null
            endif
            // 450半径
            set x = cx + Cos(angle) * 450.0
            set y = cy + Sin(angle) * 450.0
            set dummy = CreateUnit(GetOwningPlayer(BDK[1]), 'e05E', x, y, 0)
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 2.5)
                call GroupAddUnit(BDL_effectGroup, dummy)
                set dummy = null
            endif
        set i = i + 1
    endloop

    // 2秒后统一销毁所有特效，计时生命2.5秒作为兜底
    set clearTimer = CreateTimer()
    call TimerStart(clearTimer, 2.0, false, function C9S_ClearEffects)
    set clearTimer = null

    set u = null
    set dummy = null
endfunction

function C9T takes nothing returns nothing
    set BDN = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BDN, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(BDN, Condition(function C9R))
    call TriggerAddAction(BDN, function C9S)
endfunction

// ----- 第二颗陨石伤害过滤 -----
function C9V takes nothing returns boolean
    // 过滤函数增加施法者判空，杜绝空指针
    if BDK[1] == null then
        return false
    endif
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(GetFilterUnit()) and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(BDK[1]))
endfunction

function C9W takes nothing returns nothing
    local real dmg
    if BDK[1] == null or GetWidgetLife(BDK[1]) <= 0.405 then
        return
    endif
    set dmg = GetHeroInt(BDK[1], true) * 6.0
    call UnitDamageTarget(BDK[1], GetEnumUnit(), dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
endfunction

function C9d takes nothing returns nothing
    local group g
    call DisableTrigger(GetTriggeringTrigger())
    // 第二段伤害增加目标点与施法者双重判空
    if BDL[1] == null or BDK[1] == null or GetWidgetLife(BDK[1]) <= 0.405 then
        return
    endif

    // 第二颗陨石爆炸音效
    call PlaySoundOnUnitBJ(Gc, 100, BDK[1])

    set g = Ba4(500.0, BDL[1], Condition(function C9V))
    call ForGroup(g, function C9W)
    call DestroyGroup(g)
    set g = null
endfunction

function C9e takes nothing returns nothing
    if VJ == null then
        set VJ = CreateTimer()
    endif
    set BDM = CreateTrigger()
    call DisableTrigger(BDM)
    call TriggerRegisterTimerExpireEvent(BDM, VJ)
    call TriggerAddAction(BDM, function C9d)
endfunction

// =====================================================
// 主初始化
// =====================================================
function InitTrig_DoubleMeteor takes nothing returns nothing
    // 哈希表初始化兜底
    if TZ == null then
        set TZ = InitHashtable()
    endif

    // 防重复初始化
    if LoadInteger(TZ, 0, 91001) == 1 then
        return
    endif

    // 恢复音效变量初始化
    call Bcx()
    call C9P()
    call C9e()
    call C9T()
    
    call SaveInteger(TZ, 0, 91001, 1)
endfunction









//佩恩
function UnitIsShop takes unit u returns boolean
    local integer uid
    if u == null then
        return false
    endif
    set uid = GetUnitTypeId(u)
    if uid == 'n001' then
        return true
    endif
    if uid == 'n002' then
        return true
    endif
    return false
endfunction

function Bac takes unit RW returns nothing
    call UnitAddAbility(RW, 'Amrf')
    call UnitRemoveAbility(RW, 'Amrf')
endfunction

function DES takes nothing returns boolean
    return GetSpellAbilityId() == 'A0P6'
endfunction

// ========== 统一单位状态还原函数 ==========
function A0P6_RestoreUnit takes unit u returns nothing
    local integer uid = GetHandleId(u)
    if LoadInteger(TZ, uid, 2) != 1 then
        set uid = 0
        return
    endif
    call PauseUnit(u, false)
    call SetUnitPathing(u, true)
    call SetUnitInvulnerable(u, false)
    call SetUnitFlyHeight(u, GetUnitDefaultFlyHeight(u), 0.0)
    call GroupRemoveUnit(A0P6_grabbedGroup, u)
    call FlushChildHashtable(TZ, uid)
    set uid = 0
endfunction

// 统一清理函数：自带锁，只会执行一次
function A0P6_Cleanup takes nothing returns nothing
    local unit u

    if A0P6_isCleaned then
        return
    endif
    set A0P6_isCleaned = true

    // 1. 销毁计时器
    if A0P6_timer != null then
        call PauseTimer(A0P6_timer)
        call DestroyTimer(A0P6_timer)
        set A0P6_timer = null
    endif

    // 2. 恢复所有被抓取单位的状态
    if A0P6_grabbedGroup != null then
        loop
            set u = FirstOfGroup(A0P6_grabbedGroup)
            exitwhen u == null
            call A0P6_RestoreUnit(u)
        endloop
        call DestroyGroup(A0P6_grabbedGroup)
        set A0P6_grabbedGroup = null
    endif

    // 3. 销毁所有过程特效马甲
    if A0P6_effectGroup != null then
        loop
            set u = FirstOfGroup(A0P6_effectGroup)
            exitwhen u == null
            call GroupRemoveUnit(A0P6_effectGroup, u)
            call RemoveUnit(u)
        endloop
        call DestroyGroup(A0P6_effectGroup)
        set A0P6_effectGroup = null
    endif

    // 4. 销毁所有石块
    if A0P6_rockGroup != null then
        loop
            set u = FirstOfGroup(A0P6_rockGroup)
            exitwhen u == null
            call GroupRemoveUnit(A0P6_rockGroup, u)
            call RemoveUnit(u)
        endloop
        call DestroyGroup(A0P6_rockGroup)
        set A0P6_rockGroup = null
    endif

    // 销毁临时单位组
    if A0P6_tempRockGroup != null then
        call DestroyGroup(A0P6_tempRockGroup)
        set A0P6_tempRockGroup = null
    endif
    if A0P6_enumGroup != null then
        call DestroyGroup(A0P6_enumGroup)
        set A0P6_enumGroup = null
    endif

    // 5. 重置全局状态
    set A0P6_caster = null
    set A0P6_centerDummy = null
    set A0P6_transitionDummy = null
    set A0P6_phase = 0
    set A0P6_step = 0
    set A0P6_transitionCreated = false
endfunction

// ========== 主循环逻辑 ==========
function A0P6_Pull takes nothing returns nothing
    local unit caster = A0P6_caster
    local player p
    local unit u
    local unit rock
    local unit fxUnit
    local unit transitionDummy
    local real x
    local real y
    local real cx
    local real cy
    local real randX
    local real randY
    local real angle
    local real rockX
    local real rockY
    local real distSq
    local real moveAngle
    local real scale
    local real progress
    local real origX
    local real origY
    local real dmg
    local real ux
    local real uy
    local integer uid

    // 边界1：施法者无效/死亡，立即清理退出
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        call A0P6_Cleanup()
        set caster = null
        return
    endif

    // 边界2：中心马甲失效，立即清理退出
    if A0P6_centerDummy == null or GetWidgetLife(A0P6_centerDummy) <= 0.405 then
        call A0P6_Cleanup()
        set caster = null
        return
    endif

    set p = GetOwningPlayer(caster)
    set x = A0P6_centerX
    set y = A0P6_centerY

    // ---------- 阶段0：升高 ----------
    if A0P6_phase == 0 then
        set cx = GetUnitX(A0P6_centerDummy)
        set cy = GetUnitY(A0P6_centerDummy)
        // 平滑趋近目标点后叠加随机抖动
        set cx = cx + (x - cx) * 0.05
        set cy = cy + (y - cy) * 0.05
        set randX = cx + GetRandomReal(-15.0, 15.0)
        set randY = cy + GetRandomReal(-15.0, 15.0)
        // 原生坐标设置，无寻路开销
        call SetUnitX(A0P6_centerDummy, randX)
        call SetUnitY(A0P6_centerDummy, randY)

        if GetUnitFlyHeight(A0P6_centerDummy) < 650.0 then
            call SetUnitFlyHeight(A0P6_centerDummy, GetUnitFlyHeight(A0P6_centerDummy) + 65.0, 2800.0)
        endif

        if GetUnitFlyHeight(A0P6_centerDummy) >= 650.0 and not A0P6_transitionCreated then
            set transitionDummy = CreateUnit(p, 'e05I', x, y, 0)
            if transitionDummy != null then
                set A0P6_transitionDummy = transitionDummy
                call UnitApplyTimedLife(transitionDummy, 'BHwe', 5.0)
                call Bac(transitionDummy)
                call SetUnitFlyHeight(transitionDummy, 650.0, 0)
                call GroupAddUnit(A0P6_effectGroup, transitionDummy)
                set A0P6_transitionCreated = true
                set A0P6_phase = 1
                set A0P6_step = 0
                set transitionDummy = null
            else
                // 修复：过渡马甲创建失败，标记完成并进入阶段1，杜绝空转
                set A0P6_transitionCreated = true
                set A0P6_phase = 1
                set A0P6_step = 0
            endif
        endif
        set caster = null
        set p = null
        return
    endif

    // ---------- 阶段1：牵引 + 石块聚拢 ----------
    if A0P6_phase == 1 then
        set A0P6_step = A0P6_step + 1
        call GroupClear(A0P6_tempRockGroup)

        // 1. 创建新石块
        set angle = GetRandomReal(0.0, 360.0) * bj_DEGTORAD
        set rockX = x + Cos(angle) * 500.0
        set rockY = y + Sin(angle) * 500.0
        set rock = CreateUnit(p, 'e05J', rockX, rockY, 0)
        if rock != null then
            call SetUnitUserData(rock, 0)
            call GroupAddUnit(A0P6_rockGroup, rock)
            set rock = null
        endif

        // 2. 视觉马甲，短计时生命自动回收
        set fxUnit = CreateUnit(p, 'e05L', x, y, 0)
        if fxUnit != null then
            call SetUnitTimeScale(fxUnit, 10.0)
            call UnitApplyTimedLife(fxUnit, 'BHwe', 0.8)
            call GroupAddUnit(A0P6_effectGroup, fxUnit)
            set fxUnit = null
        endif

        // 3. 球体蓄力放大曲线
        if A0P6_transitionDummy != null and GetWidgetLife(A0P6_transitionDummy) > 0.405 then
            set progress = A0P6_step / 50.0
            set scale = 1.0 + progress * progress * 8.0
            if scale > 9.0 then
                set scale = 9.0
            endif
            call SetUnitScale(A0P6_transitionDummy, scale, scale, scale)
        endif

        // 4. 石块向中心聚拢
        set rock = FirstOfGroup(A0P6_rockGroup)
        loop
            exitwhen rock == null
            call GroupRemoveUnit(A0P6_rockGroup, rock)

            if GetUnitUserData(rock) == 0 then
                call SetUnitUserData(rock, 1)
                call Bac(rock) // 石块仅首次执行一次飞行解锁
                call GroupAddUnit(A0P6_tempRockGroup, rock)
            else
                set rockX = GetUnitX(rock)
                set rockY = GetUnitY(rock)
                set distSq = (rockX - x) * (rockX - x) + (rockY - y) * (rockY - y)

                if distSq <= 506.25 then
                    call RemoveUnit(rock)
                else
                    set moveAngle = Atan2(y - rockY, x - rockX)
                    // 原生坐标设置，平滑无卡顿
                    call SetUnitX(rock, rockX + Cos(moveAngle) * 15.0)
                    call SetUnitY(rock, rockY + Sin(moveAngle) * 15.0)
                    if GetUnitFlyHeight(rock) < 650.0 then
                        call SetUnitFlyHeight(rock, GetUnitFlyHeight(rock) + 12.0, 0)
                    endif
                    call GroupAddUnit(A0P6_tempRockGroup, rock)
                endif
            endif

            set rock = FirstOfGroup(A0P6_rockGroup)
        endloop

        loop
            set rock = FirstOfGroup(A0P6_tempRockGroup)
            exitwhen rock == null
            call GroupRemoveUnit(A0P6_tempRockGroup, rock)
            call GroupAddUnit(A0P6_rockGroup, rock)
        endloop

        // 5. 牵引敌人
        call GroupClear(A0P6_enumGroup)
        call GroupEnumUnitsInRange(A0P6_enumGroup, x, y, 500.0, null)
        loop
            set u = FirstOfGroup(A0P6_enumGroup)
            exitwhen u == null
            if GetWidgetLife(u) <= 0.405 then
                call A0P6_RestoreUnit(u)
            elseif IsUnitEnemy(u, p) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_MECHANICAL) and not UnitIsShop(u) then
                set uid = GetHandleId(u)
                if not HaveSavedInteger(TZ, uid, 2) then
                    // 仅首次抓取执行一次：状态设置 + 飞行解锁
                    call SaveReal(TZ, uid, 0, GetUnitX(u))
                    call SaveReal(TZ, uid, 1, GetUnitY(u))
                    call SaveInteger(TZ, uid, 2, 1)
                    call GroupAddUnit(A0P6_grabbedGroup, u)
                    call PauseUnit(u, true)
                    call SetUnitPathing(u, false)
                    call Bac(u)
                endif

                // 后续每帧仅更新坐标与高度，无重复状态操作
                set ux = GetUnitX(u)
                set uy = GetUnitY(u)
                // 原生坐标设置，牵引更平滑
                call SetUnitX(u, ux + (x - ux) * 0.15)
                call SetUnitY(u, uy + (y - uy) * 0.15)
                if GetUnitFlyHeight(u) < 650.0 then
                    call SetUnitFlyHeight(u, GetUnitFlyHeight(u) + 22.5, 5000.0)
                endif
            endif
            call GroupRemoveUnit(A0P6_enumGroup, u)
        endloop

        if A0P6_step >= 50 then
            set A0P6_phase = 2
        endif
        set caster = null
        set p = null
        return
    endif

    // ---------- 阶段2：爆发 ----------
    if A0P6_phase == 2 then
        set u = CreateUnit(p, 'e05M', x, y, 0)
        if u != null then
            call UnitApplyTimedLife(u, 'BHwe', 3.0)
            call SetUnitScale(u, 2.0, 2.0, 2.0)
            set u = null
        endif

        call GroupClear(A0P6_enumGroup)
        call GroupEnumUnitsInRange(A0P6_enumGroup, x, y, 500.0, null)
        loop
            set u = FirstOfGroup(A0P6_enumGroup)
            exitwhen u == null
            set uid = GetHandleId(u)

            if LoadInteger(TZ, uid, 2) == 1 and IsUnitEnemy(u, p) then
                // 先读取原始坐标，再恢复单位并清理哈希
                set origX = LoadReal(TZ, uid, 0)
                set origY = LoadReal(TZ, uid, 1)
                
                call A0P6_RestoreUnit(u)

                if GetWidgetLife(u) > 0.405 then
                    set dmg = 500.0 * GetUnitAbilityLevel(caster, 'A0P6')
                    call UnitDamageTargetBJ(caster, u, dmg, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                endif

                if GetWidgetLife(u) <= 0.405 and not IsUnitType(u, UNIT_TYPE_HERO) then
                    // 尸体归位用原生坐标设置
                    call SetUnitX(u, origX)
                    call SetUnitY(u, origY)
                endif
            endif
            call GroupRemoveUnit(A0P6_enumGroup, u)
        endloop

        call A0P6_Cleanup()
        set caster = null
        set p = null
        return
    endif

    set caster = null
    set p = null
endfunction

// ========== 施法入口 ==========
function DEY takes nothing returns nothing
    local unit centerDummy
    local location targetLoc
    local player p
    local unit caster

    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    if A0P6_timer != null then
        call A0P6_Cleanup()
    endif

    set A0P6_isCleaned = false
    set A0P6_caster = caster
    set targetLoc = GetSpellTargetLoc()
    set A0P6_centerX = GetLocationX(targetLoc)
    set A0P6_centerY = GetLocationY(targetLoc)
    call RemoveLocation(targetLoc)
    set targetLoc = null

    // ---------- 初始化各组 ----------
    set A0P6_step = 0
    set A0P6_phase = 0
    set A0P6_transitionCreated = false

    set A0P6_rockGroup = CreateGroup()
    set A0P6_tempRockGroup = CreateGroup()
    set A0P6_enumGroup = CreateGroup()
    set A0P6_grabbedGroup = CreateGroup()
    set A0P6_effectGroup = CreateGroup()

    // 创建中心马甲
    set p = GetOwningPlayer(A0P6_caster)
    set centerDummy = CreateUnit(p, 'e05G', A0P6_centerX, A0P6_centerY, 0)
    // 马甲创建失败直接终止
    if centerDummy == null then
        call A0P6_Cleanup()
        set p = null
        set caster = null
        return
    endif
    set A0P6_centerDummy = centerDummy
    call Bac(centerDummy)
    call SetUnitFlyHeight(centerDummy, 0, 0)
    call SetUnitTimeScale(centerDummy, 0.8)
    call GroupAddUnit(A0P6_effectGroup, centerDummy)
    set centerDummy = null

    set A0P6_timer = CreateTimer()
    call TimerStart(A0P6_timer, 0.05, true, function A0P6_Pull)

    set p = null
    set caster = null
endfunction

// ========== 初始化 ==========
function InitTrig_A0P6 takes nothing returns nothing
    local trigger trg
    if TZ == null then
        set TZ = InitHashtable()
    endif
    
    if LoadInteger(TZ, 0, 99001) == 1 then
        return
    endif

    set trg = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trg, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trg, Condition(function DES))
    call TriggerAddAction(trg, function DEY)
    set trg = null
    
    call SaveInteger(TZ, 0, 99001, 1)
endfunction


// ===================== 通用商店单位判断（全技能共用） =====================
//陆逊1

function xMtzy takes nothing returns boolean
    return GetSpellAbilityId() == 'A0N1'
endfunction

function cMtzy takes nothing returns nothing
    local unit caster
    local location startLoc
    local location targetLoc
    local unit dummy
    local real angle

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)

    // 火箭马甲：等级同步、生命周期、释放逻辑完全保留原版
    call CreateNUnitsAtLoc(1, 'e06C', GetOwningPlayer(caster), startLoc, angle)
    set dummy = bj_lastCreatedUnit
    if dummy != null then
        call SetUnitAbilityLevelSwapped('A0IF', dummy, GetUnitAbilityLevelSwapped('A0N1', caster))
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        call IssuePointOrderLocBJ(dummy, "clusterrockets", targetLoc)
        set dummy = null
    endif

    // 坐标用完即释放，无全局残留
    call RemoveLocation(startLoc)
    call RemoveLocation(targetLoc)
    set startLoc = null
    set targetLoc = null
    set caster = null
endfunction

function InitTrig_A02C takes nothing returns nothing
    // 新增：防重复初始化，避免触发器叠加泄漏
    if LoadInteger(TZ, 0, 98001) == 1 then
        return
    endif

    set mmtzy = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(mmtzy, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(mmtzy, Condition(function xMtzy))
    call TriggerAddAction(mmtzy, function cMtzy)

    call SaveInteger(TZ, 0, 98001, 1)
endfunction
//孙尚香
// ===================== 工具函数 =====================
function BaZ takes unit qU, unit Tt returns real
    return SquareRoot((GetUnitX(qU)-GetUnitX(Tt))*(GetUnitX(qU)-GetUnitX(Tt)) + (GetUnitY(qU)-GetUnitY(Tt))*(GetUnitY(qU)-GetUnitY(Tt)))
endfunction

// ===================== 第一段：主技能冲锋 =====================
function CkL takes nothing returns boolean
    return GetSpellAbilityId() == 'A0P7'
endfunction

function CkM takes nothing returns nothing
    local group fd
    local unit fe
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(TZ, tid, $64766007)
    local unit chargeDummy = LoadUnitHandle(TZ, tid, $1F0BA775)
    local unit burnDummy = LoadUnitHandle(TZ, tid, $8B8BE8C0)
    local integer level
    local real facing
    local real dx
    local real dy

    if chargeDummy != null and IsUnitAliveBJ(chargeDummy) == true then
        // 施法者失效提前安全终止
        if caster == null or GetWidgetLife(caster) < 0.405 then
            call PauseTimer(t)
            if burnDummy != null then
                call KillUnit(burnDummy)
            endif
            // 清理跨阶段哈希记录，避免二段读到无效句柄
            call RemoveSavedHandle(Sz, GetHandleId(caster), $7BCE901E)
            call FlushChildHashtable(TZ, tid)
            call DestroyTimer(t)
            set fd = null
            set fe = null
            set t = null
            set caster = null
            set chargeDummy = null
            set burnDummy = null
            return
        endif

        // 朝向单次读取复用，减少重复函数调用
        set facing = GetUnitFacing(chargeDummy)
        set dx = 15. * CosBJ(facing)
        set dy = 15. * SinBJ(facing)
        call SetUnitX(chargeDummy, GetUnitX(chargeDummy) + dx)
        call SetUnitY(chargeDummy, GetUnitY(chargeDummy) + dy)
        if burnDummy != null then
            call SetUnitX(burnDummy, GetUnitX(burnDummy) + dx)
            call SetUnitY(burnDummy, GetUnitY(burnDummy) + dy)
        endif

        // 技能等级单次读取复用，避免循环内重复调用
        set level = GetUnitAbilityLevel(caster, 'A0P7')

        set fd = CreateGroup()
        call GroupEnumUnitsInRange(fd, GetUnitX(chargeDummy), GetUnitY(chargeDummy), 200., null)
        loop
            set fe = FirstOfGroup(fd)
            exitwhen fe == null
            call GroupRemoveUnit(fd, fe)
            // 单位空值前置校验
            if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
                if level == 1 then
                    call UnitDamageTargetBJ(caster, fe, 11., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                elseif level == 2 then
                    call UnitDamageTargetBJ(caster, fe, 18., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                elseif level == 3 then
                    call UnitDamageTargetBJ(caster, fe, 25., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                elseif level == 4 then
                    if IsUnitType(fe, UNIT_TYPE_HERO) == true then
                        call UnitDamageTargetBJ(caster, fe, 31., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                    else
                        call UnitDamageTargetBJ(caster, fe, 36.6, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                    endif
                endif
            endif
        endloop
        call DestroyGroup(fd)
    else
        call PauseTimer(t)
        if burnDummy != null then
            call KillUnit(burnDummy)
        endif
        // 正常结束也清理跨阶段记录
        if caster != null then
            call RemoveSavedHandle(Sz, GetHandleId(caster), $7BCE901E)
        endif
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
    endif

    set fd = null
    set fe = null
    set t = null
    set caster = null
    set chargeDummy = null
    set burnDummy = null
endfunction

function CkN takes nothing returns nothing
    local integer fY
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(TZ, tid, $64766007)

    call PauseTimer(t)
    if caster != null then
        call UnitMakeAbilityPermanent(caster, false, 'A0P8')
        call UnitRemoveAbility(caster, 'A0P8')
        if GetUnitAbilityLevel(caster, 'A0PA') == 0 then
            set fY = 1
            loop
                exitwhen fY > 12
                call SetPlayerAbilityAvailable(ConvertedPlayer(fY), 'A0P7', true)
                set fY = fY + 1
            endloop
        endif
    endif

    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)
    set t = null
    set caster = null
endfunction

function CkO takes nothing returns nothing
    local integer fY
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(TZ, tid, $64766007)

    call PauseTimer(t)
    if caster != null then
        call UnitMakeAbilityPermanent(caster, false, 'A0PA')
        call UnitRemoveAbility(caster, 'A0PA')
    endif

    set fY = 1
    loop
        exitwhen fY > 12
        call SetPlayerAbilityAvailable(ConvertedPlayer(fY), 'A0P7', true)
        set fY = fY + 1
    endloop

    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)
    set t = null
    set caster = null
endfunction

function CkP takes nothing returns nothing
    local timer moveTimer
    local timer removeTimer
    local integer moveTimerId
    local integer removeTimerId
    local integer fY
    local unit caster
    local player p
    local location casterLoc
    local location targetLoc
    local real angle
    local unit chargeDummy
    local unit burnDummy

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif
    call PlaySoundOnUnitBJ(Jh, 100, caster)

    set p = GetOwningPlayer(caster)
    set casterLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(casterLoc, targetLoc)

    // 计算完角度直接释放坐标，不做冗余存储，杜绝悬空句柄
    call RemoveLocation(casterLoc)
    call RemoveLocation(targetLoc)
    set casterLoc = null
    set targetLoc = null

    // 主冲锋马甲创建判空
    set chargeDummy = CreateUnit(p, 'e0NX', GetUnitX(caster), GetUnitY(caster), angle)
    if chargeDummy != null then
        call UnitApplyTimedLife(chargeDummy, 'BHwe', 2.5)
    endif

    // 副灼烧马甲创建判空
    set burnDummy = CreateUnit(p, 'e0O2', GetUnitX(caster), GetUnitY(caster), angle)
    if burnDummy != null then
        call UnitApplyTimedLife(burnDummy, 'BHwe', 2.5)
        call SetUnitTimeScale(burnDummy, .5)
    endif

    // 记录一段马甲到 Sz，供二段使用
    call RemoveSavedHandle(Sz, GetHandleId(caster), $7BCE901E)
    if chargeDummy != null then
        call SaveUnitHandle(Sz, GetHandleId(caster), $7BCE901E, chargeDummy)
    endif

    // 启动移动与伤害计时器：直接用计时器ID作为主键，无整数溢出风险
    set moveTimer = CreateTimer()
    set moveTimerId = GetHandleId(moveTimer)
    call SaveUnitHandle(TZ, moveTimerId, $64766007, caster)
    call SaveUnitHandle(TZ, moveTimerId, $1F0BA775, chargeDummy)
    call SaveUnitHandle(TZ, moveTimerId, $8B8BE8C0, burnDummy)
    call TimerStart(moveTimer, .03, true, function CkM)

    // 禁用主技能（保留原版全局逻辑）
    set fY = 1
    loop
        exitwhen fY > 12
        call SetPlayerAbilityAvailable(ConvertedPlayer(fY), 'A0P7', false)
        set fY = fY + 1
    endloop

    // 添加二段技能
    call UnitAddAbility(caster, 'A0P8')
    call UnitMakeAbilityPermanent(caster, true, 'A0P8')

    // 3.5 秒后自动移除二段技能
    set removeTimer = CreateTimer()
    set removeTimerId = GetHandleId(removeTimer)
    call SaveUnitHandle(TZ, removeTimerId, $64766007, caster)
    call TimerStart(removeTimer, 3.5, false, function CkN)

    // 5 秒后强制恢复主技能
    set removeTimer = CreateTimer()
    set removeTimerId = GetHandleId(removeTimer)
    call SaveUnitHandle(TZ, removeTimerId, $64766007, caster)
    call TimerStart(removeTimer, 5., false, function CkO)

    // 音效播放
    if Jl != null then
        call PlaySoundOnUnitBJ(Jl, 100, caster)
    endif

    set moveTimer = null
    set removeTimer = null
    set caster = null
    set p = null
    set chargeDummy = null
    set burnDummy = null
endfunction

function CkQ takes nothing returns nothing
    set uW = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(uW, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(uW, Condition(function CkL))
    call TriggerAddAction(uW, function CkP)
endfunction

// ===================== 第二段：瞬移续冲 =====================
function CkS takes nothing returns boolean
    return GetSpellAbilityId() == 'A0P8'
endfunction

function CkT takes nothing returns nothing
    local group fd
    local unit fe
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(TZ, tid, $64766007)
    local unit burnDummy = LoadUnitHandle(TZ, tid, $8B8BE8C0)
    local unit trailDummy = LoadUnitHandle(TZ, tid, $A0E122B3)
    local integer level

    if burnDummy != null and IsUnitAliveBJ(burnDummy) == true then
        // 施法者失效提前终止
        if caster == null or GetWidgetLife(caster) < 0.405 then
            call PauseTimer(t)
            if trailDummy != null then
                call KillUnit(trailDummy)
            endif
            // 清理跨阶段哈希记录
            call RemoveSavedHandle(Sz, GetHandleId(caster), $91FAED3D)
            call FlushChildHashtable(TZ, tid)
            call DestroyTimer(t)
            set fd = null
            set fe = null
            set t = null
            set caster = null
            set burnDummy = null
            set trailDummy = null
            return
        endif

        // 技能等级单次读取复用
        set level = GetUnitAbilityLevel(caster, 'A0P7')

        set fd = CreateGroup()
        call GroupEnumUnitsInRange(fd, GetUnitX(burnDummy), GetUnitY(burnDummy), 180., null)
        loop
            set fe = FirstOfGroup(fd)
            exitwhen fe == null
            call GroupRemoveUnit(fd, fe)
            // 单位空值前置校验
            if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
                if level == 1 then
                    call UnitDamageTargetBJ(caster, fe, 5., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                elseif level == 2 then
                    call UnitDamageTargetBJ(caster, fe, 7., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                elseif level == 3 then
                    call UnitDamageTargetBJ(caster, fe, 9., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                elseif level == 4 then
                    call UnitDamageTargetBJ(caster, fe, 11., ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                endif
            endif
        endloop
        call DestroyGroup(fd)
    else
        call PauseTimer(t)
        if trailDummy != null then
            call KillUnit(trailDummy)
        endif
        // 正常结束清理跨阶段记录
        if caster != null then
            call RemoveSavedHandle(Sz, GetHandleId(caster), $91FAED3D)
        endif
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
    endif

    set fd = null
    set fe = null
    set t = null
    set caster = null
    set burnDummy = null
    set trailDummy = null
endfunction

function CkU takes nothing returns nothing
    local integer fY
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(TZ, tid, $64766007)

    call PauseTimer(t)
    if caster != null then
        call UnitMakeAbilityPermanent(caster, false, 'A0PA')
        call UnitRemoveAbility(caster, 'A0PA')
    endif

    set fY = 1
    loop
        exitwhen fY > 12
        call SetPlayerAbilityAvailable(ConvertedPlayer(fY), 'A0P7', true)
        set fY = fY + 1
    endloop

    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)
    set t = null
    set caster = null
endfunction

function CkV takes nothing returns nothing
    local timer damageTimer
    local timer removeTimer
    local integer damageTimerId
    local integer removeTimerId
    local unit caster
    local player p
    local unit chargeDummy
    local unit burnDummy
    local unit trailDummy
    local effect teleportFx

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set p = GetOwningPlayer(caster)
    // 读取一段马甲
    set chargeDummy = LoadUnitHandle(Sz, GetHandleId(caster), $7BCE901E)

    // 二段灼烧马甲创建判空
    set burnDummy = CreateUnit(p, 'e0NX', GetUnitX(caster), GetUnitY(caster), bj_UNIT_FACING)
    if burnDummy != null then
        call UnitApplyTimedLife(burnDummy, 'BHwe', 2.5)
        call SaveUnitHandle(Sz, GetHandleId(caster), $91FAED3D, burnDummy)
    endif

    // 二段拖尾马甲创建判空
    set trailDummy = CreateUnit(p, 'e0O2', GetUnitX(caster), GetUnitY(caster), bj_UNIT_FACING)
    if trailDummy != null then
        call UnitApplyTimedLife(trailDummy, 'BHwe', 2.5)
        call SetUnitTimeScale(trailDummy, .5)
    endif

    // 启动二段伤害计时器：直接用计时器ID作为主键
    set damageTimer = CreateTimer()
    set damageTimerId = GetHandleId(damageTimer)
    call SaveUnitHandle(TZ, damageTimerId, $64766007, caster)
    call SaveUnitHandle(TZ, damageTimerId, $8B8BE8C0, burnDummy)
    call SaveUnitHandle(TZ, damageTimerId, $A0E122B3, trailDummy)
    call TimerStart(damageTimer, .03, true, function CkT)

    // 瞬移判定
    if chargeDummy != null and IsUnitAliveBJ(chargeDummy) == true and BaZ(caster, chargeDummy) < 3000. and IsTerrainPathable(GetUnitX(chargeDummy), GetUnitY(chargeDummy), PATHING_TYPE_FLYABILITY) == false then
        call SetUnitX(caster, GetUnitX(chargeDummy))
        call SetUnitY(caster, GetUnitY(chargeDummy))
    endif

    // 瞬移特效判空再销毁，杜绝空句柄崩溃
    set teleportFx = AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", caster, "origin")
    if teleportFx != null then
        call DestroyEffect(teleportFx)
        set teleportFx = null
    endif

    // 清理一段马甲，移除二段技能，添加三段技能
    if chargeDummy != null then
        call KillUnit(chargeDummy)
    endif
    call RemoveSavedHandle(Sz, GetHandleId(caster), $7BCE901E)
    call UnitMakeAbilityPermanent(caster, false, 'A0P8')
    call UnitRemoveAbility(caster, 'A0P8')
    call UnitAddAbility(caster, 'A0PA')
    call UnitMakeAbilityPermanent(caster, true, 'A0PA')

    // 3.5 秒后移除三段技能
    set removeTimer = CreateTimer()
    set removeTimerId = GetHandleId(removeTimer)
    call SaveUnitHandle(TZ, removeTimerId, $64766007, caster)
    call TimerStart(removeTimer, 3.5, false, function CkU)

    set damageTimer = null
    set removeTimer = null
    set caster = null
    set p = null
    set chargeDummy = null
    set burnDummy = null
    set trailDummy = null
endfunction

function CkW takes nothing returns nothing
    set uX = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(uX, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(uX, Condition(function CkS))
    call TriggerAddAction(uX, function CkV)
endfunction

// ===================== 第三段：瞬移收尾 =====================
function CkY takes nothing returns boolean
    return GetSpellAbilityId() == 'A0PA'
endfunction

function CkZ takes nothing returns nothing
    local integer fY
    local unit caster
    local unit burnDummy
    local effect landFx

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    // 读取二段马甲
    set burnDummy = LoadUnitHandle(Sz, GetHandleId(caster), $91FAED3D)

    // 瞬移判定
    if burnDummy != null and IsUnitAliveBJ(burnDummy) == true and BaZ(caster, burnDummy) < 3000. then
        call SetUnitX(caster, GetUnitX(burnDummy))
        call SetUnitY(caster, GetUnitY(burnDummy))
    endif

    // 落地特效判空再销毁
    set landFx = AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", caster, "origin")
    if landFx != null then
        call DestroyEffect(landFx)
        set landFx = null
    endif

    // 销毁马甲与记录
    if burnDummy != null then
        call KillUnit(burnDummy)
    endif
    call RemoveSavedHandle(Sz, GetHandleId(caster), $91FAED3D)

    call UnitMakeAbilityPermanent(caster, false, 'A0PA')
    call UnitRemoveAbility(caster, 'A0PA')

    // 解锁主技能
    set fY = 1
    loop
        exitwhen fY > 12
        call SetPlayerAbilityAvailable(ConvertedPlayer(fY), 'A0P7', true)
        set fY = fY + 1
    endloop

    set caster = null
    set burnDummy = null
endfunction

function Cka takes nothing returns nothing
    set uY = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(uY, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(uY, Condition(function CkY))
    call TriggerAddAction(uY, function CkZ)
endfunction

// ===================== 统一初始化入口 =====================
function InitTrig_FireCharge takes nothing returns nothing
    // 确保哈希表初始化
    if TZ == null then
        set TZ = InitHashtable()
    endif
    if Sz == null then
        set Sz = InitHashtable()
    endif

    // 防重复初始化，避免触发器叠加泄漏
    if LoadInteger(TZ, 0, 97001) == 1 then
        return
    endif

    // 注册三段技能触发器
    call CkQ()  // 第一段 'A0P7'
    call CkW()  // 第二段 'A0P8'
    call Cka()  // 第三段 'A0PA'
    
    call SaveInteger(TZ, 0, 97001, 1)
endfunction
//孙尚香2
function ClM takes nothing returns boolean
    return GetSpellAbilityId() == 'A0P9'
endfunction

function ClN takes nothing returns nothing
    local unit u = GetEnumUnit()
    if u != null then
        call KillUnit(u)
    endif
    set u = null
endfunction

function ClO takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local group fd
    local unit fe
    local integer fn
    local unit caster
    local location center
    local group dummyGroup
    local integer level
    local real agi
    local real dmgBase
    local real dmgNonStruct
    local unit dummyUnit
    local effect fx1
    local effect fx2
    local effect fx3
    local location tempLoc1
    local location tempLoc2

    set caster = LoadUnitHandle(TZ, tid, StringHash("caster"))
    set center = LoadLocationHandle(TZ, tid, StringHash("center"))
    set dummyGroup = LoadGroupHandle(TZ, tid, StringHash("dummyGroup"))

    // 异常兜底：核心资源失效，提前安全清理终止
    if caster == null or center == null or dummyGroup == null then
        call PauseTimer(t)
        if center != null then
            call RemoveLocation(center)
        endif
        if dummyGroup != null then
            call ForGroupBJ(dummyGroup, function ClN)
            call GroupClear(dummyGroup)
            call DestroyGroup(dummyGroup)
        endif
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set center = null
        set dummyGroup = null
        return
    endif

    // 施法者存活校验，避免无效句柄操作
    if GetWidgetLife(caster) < 0.405 then
        call PauseTimer(t)
        call RemoveLocation(center)
        call ForGroupBJ(dummyGroup, function ClN)
        call GroupClear(dummyGroup)
        call DestroyGroup(dummyGroup)
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set center = null
        set dummyGroup = null
        return
    endif

    set level = GetUnitAbilityLevel(caster, 'A0P9')
    set agi = I2R(GetHeroAgi(caster, true))

    // 根据等级设置基础伤害
    if level == 1 then
        set dmgBase = 25.0
    elseif level == 2 then
        set dmgBase = 35.0
    else
        set dmgBase = 45.0
    endif

    // 非建筑伤害 = 基础 + 敏捷×0.3
    set dmgNonStruct = dmgBase + agi * 0.3

    if LoadInteger(TZ, tid, StringHash("step")) < 50 then
        call SaveInteger(TZ, tid, StringHash("step"), LoadInteger(TZ, tid, StringHash("step")) + 1)
        set fn = 1
        loop
            exitwhen fn > 3
                // 局部变量承接坐标，消除冗余哈希读写
                set tempLoc1 = PolarProjectionBJ(center, GetRandomReal(0., 400.), GetRandomDirectionDeg())
                set tempLoc2 = PolarProjectionBJ(center, GetRandomReal(0., 400.), GetRandomDirectionDeg())

                // 弹幕马甲创建判空
                set dummyUnit = CreateUnit(GetOwningPlayer(caster), 'e0NY', GetLocationX(tempLoc1), GetLocationY(tempLoc1), GetRandomDirectionDeg())
                if dummyUnit != null then
                    call UnitApplyTimedLife(dummyUnit, 'BHwe', 5.)
                    call SetUnitFlyHeight(dummyUnit, 0., 400.)
                    call GroupAddUnit(dummyGroup, dummyUnit)
                    set dummyUnit = null
                endif

                // 所有特效统一判空再销毁
                set fx1 = AddSpecialEffectLoc("Abilities\\Weapons\\GyroCopter\\GyroCopterMissile.mdl", tempLoc1)
                if fx1 != null then
                    call DestroyEffect(fx1)
                    set fx1 = null
                endif
                set fx2 = AddSpecialEffectLoc("Abilities\\Weapons\\BoatMissile\\BoatMissile.mdl", tempLoc1)
                if fx2 != null then
                    call DestroyEffect(fx2)
                    set fx2 = null
                endif
                set fx3 = AddSpecialEffectLoc("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", tempLoc2)
                if fx3 != null then
                    call DestroyEffect(fx3)
                    set fx3 = null
                endif

                call RemoveLocation(tempLoc1)
                call RemoveLocation(tempLoc2)
                set fn = fn + 1
        endloop

        set fd = CreateGroup()
        call GroupEnumUnitsInRange(fd, GetLocationX(center), GetLocationY(center), 400., null)
        loop
            set fe = FirstOfGroup(fd)
            exitwhen fe == null
            call GroupRemoveUnit(fd, fe)
            // 增加单位空值前置校验
            if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
                call UnitDamageTargetBJ(caster, fe, dmgNonStruct, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
            endif
        endloop
        call DestroyGroup(fd)
    else
        // 正常结束：完整释放所有资源
        call ForGroupBJ(dummyGroup, function ClN)
        call GroupClear(dummyGroup)
        call DestroyGroup(dummyGroup)
        call RemoveLocation(center)
        call PauseTimer(t)
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
    endif

    set fd = null
    set fe = null
    set caster = null
    set center = null
    set dummyGroup = null
    set dummyUnit = null
    set fx1 = null
    set fx2 = null
    set fx3 = null
    set tempLoc1 = null
    set tempLoc2 = null
    set t = null
endfunction

function ClP takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(TZ, tid, StringHash("caster"))

    call PauseTimer(t)
    // 施法者有效才播放音效，避免空指针崩溃
    if caster != null and GetWidgetLife(caster) > 0.405 then
        call PlaySoundOnUnitBJ(Ji, 100, caster)
    endif

    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)

    set t = null
    set caster = null
endfunction

function ClQ takes nothing returns nothing
    local integer fY
    local timer ff
    local integer fc
    local integer trigId
    local integer dataKey
    local integer mainTimerId
    local unit caster
    local location center
    local unit centerDummy
    local unit ringUnit
    local location ringLoc

    set trigId = GetHandleId(GetTriggeringTrigger())
    set fc = LoadInteger(TZ, trigId, StringHash("counter")) + 3
    call SaveInteger(TZ, trigId, StringHash("counter"), fc)
    call SaveInteger(TZ, trigId, StringHash("counterBackup"), fc)

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif
    call PlaySoundOnUnitBJ(Jh, 100, caster)

    set dataKey = trigId * fc
    set center = GetSpellTargetLoc()

    call SaveUnitHandle(TZ, dataKey, StringHash("caster"), caster)
    call SaveLocationHandle(TZ, dataKey, StringHash("center"), center)

    // 中心马甲创建判空
    set centerDummy = CreateUnit(GetOwningPlayer(caster), 'e07D', GetLocationX(center), GetLocationY(center), bj_UNIT_FACING)
    if centerDummy != null then
        call UnitApplyTimedLife(centerDummy, 'BHwe', 5.)
        call UnitAddAbility(centerDummy, 'A0P3')
        set centerDummy = null
    endif

    // 环形单位生成，改用局部坐标变量
    set fY = 1
    loop
        exitwhen fY > 36
            set ringLoc = PolarProjectionBJ(center, 400., 10. * I2R(fY))
            call CreateNUnitsAtLocFacingLocBJ(1, 'e0O0', GetOwningPlayer(caster), ringLoc, center)
            set ringUnit = GetLastCreatedUnit()
            if ringUnit != null then
                call UnitApplyTimedLife(ringUnit, 'BHwe', 5.)
                call SetUnitVertexColor(ringUnit, 255, 255, 255, 125)
                set ringUnit = null
            endif
            call RemoveLocation(ringLoc)
            set fY = fY + 1
    endloop
    set ringLoc = null

    // 主循环计时器
    set ff = CreateTimer()
    set mainTimerId = GetHandleId(ff)
    call SaveUnitHandle(TZ, mainTimerId, StringHash("caster"), caster)
    call SaveLocationHandle(TZ, mainTimerId, StringHash("center"), center)
    call SaveGroupHandle(TZ, mainTimerId, StringHash("dummyGroup"), CreateGroup())
    call SaveInteger(TZ, mainTimerId, StringHash("step"), 0)
    call TimerStart(ff, .1, true, function ClO)

    // 音效计时器
    set ff = CreateTimer()
    call SaveUnitHandle(TZ, GetHandleId(ff), StringHash("caster"), caster)
    call TimerStart(ff, 1., false, function ClP)

    call FlushChildHashtable(TZ, dataKey)

    set ff = null
    set caster = null
    set center = null
    set centerDummy = null
    set ringUnit = null
endfunction

function ClR takes nothing returns nothing
    set uh = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(uh, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(uh, Condition(function ClM))
    call TriggerAddAction(uh, function ClQ)
endfunction

// ===================== 初始化 =====================
function InitTrig_A0P9 takes nothing returns nothing
    if TZ == null then
        set TZ = InitHashtable()
    endif
    if Sz == null then
        set Sz = InitHashtable()
    endif

    // 防重复初始化，避免触发器叠加泄漏
    if LoadInteger(TZ, 0, 96001) == 1 then
        return
    endif

    call ClR()
    call SaveInteger(TZ, 0, 96001, 1)
endfunction
//孙尚香3
//==================== 条件判断 ====================
function R1xz takes nothing returns boolean
    return GetSpellAbilityId() == 'A0Z1'
endfunction

//==================== 技能移除回调（零阻塞）====================
function BA6_RemoveAbility takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT, id, 1)

    if caster != null and GetWidgetLife(caster) > 0.405 then
        call UnitRemoveAbility(caster, 'A07G')
    endif

    call PauseTimer(t)
    call FlushChildHashtable(udg_HT, id)
    call DestroyTimer(t)
    set t = null
    set caster = null
endfunction

//==================== 飞行移动帧逻辑 ====================
function BA6_Timer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT, id, 1)
    local location start = LoadLocationHandle(udg_HT, id, 2)
    local location target = LoadLocationHandle(udg_HT, id, 3)
    local real angle = LoadReal(udg_HT, id, 4)
    local real totalDist = LoadReal(udg_HT, id, 5)
    local real current = LoadReal(udg_HT, id, 6)
    local real step
    local location newLoc

    // 异常兜底：单位/坐标失效，释放资源后安全终止
    if caster == null or start == null or target == null then
        call PauseTimer(t)
        if start != null then
            call RemoveLocation(start)
        endif
        if target != null then
            call RemoveLocation(target)
        endif
        call FlushChildHashtable(udg_HT, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set start = null
        set target = null
        return
    endif

    // 施法者死亡提前终止，完整清理资源
    if GetWidgetLife(caster) < 0.405 then
        call PauseTimer(t)
        call RemoveLocation(start)
        call RemoveLocation(target)
        call FlushChildHashtable(udg_HT, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set start = null
        set target = null
        return
    endif

    set step = totalDist / 25.0

    // 精确对齐终点，防止过冲
    if current + step >= totalDist then
        call SetUnitPositionLoc(caster, target)
        call xn(500., target, function NA)
        call PauseTimer(t)
        call RemoveLocation(start)
        call RemoveLocation(target)
        call FlushChildHashtable(udg_HT, id)
        call DestroyTimer(t)
    else
        set current = current + step
        set newLoc = Ya(start, current, angle)
        call SetUnitPositionLoc(caster, newLoc)
        call RemoveLocation(newLoc)
        call SaveReal(udg_HT, id, 6, current)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set start = null
    set target = null
endfunction

//==================== 技能主逻辑 ====================
function A3xz takes nothing returns nothing
    local unit caster = GetSpellAbilityUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real totalDist
    local timer moveTimer
    local timer removeTimer
    local integer moveId
    local integer removeId
    local unit muff

    // 施法入口有效性兜底
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)
    set totalDist = DistanceBetweenPoints(startLoc, targetLoc)

    // 距离过近直接终止
    if totalDist <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    call SetUnitAnimationWithRarity(caster, "Throw", RARITY_RARE)
    call UnitAddAbility(caster, 'A07G')

    // 雷霆伤害马甲
    call CreateNUnitsAtLoc(1, 'e05N', GetOwningPlayer(caster), targetLoc, bj_UNIT_FACING)
    set muff = bj_lastCreatedUnit
    if muff != null then
        call SetUnitAbilityLevelSwapped('A0Z2', muff, GetUnitAbilityLevelSwapped('A0Z1', caster))
        call IssueImmediateOrderBJ(muff, "thunderclap")
        call UnitApplyTimedLife(muff, 'BTLF', 1.5)
        set muff = null
    endif

    // 特效装饰马甲
    call CreateNUnitsAtLoc(1, 'h097', GetOwningPlayer(caster), targetLoc, bj_UNIT_FACING)
    set muff = bj_lastCreatedUnit
    if muff != null then
        call SetUnitAnimation(muff, "birth")
        call UnitApplyTimedLife(muff, 'BTLF', 2.0)
        set muff = null
    endif

    // 启动位移计时器
    set moveTimer = CreateTimer()
    set moveId = GetHandleId(moveTimer)
    call SaveUnitHandle(udg_HT, moveId, 1, caster)
    call SaveLocationHandle(udg_HT, moveId, 2, startLoc)
    call SaveLocationHandle(udg_HT, moveId, 3, targetLoc)
    call SaveReal(udg_HT, moveId, 4, angle)
    call SaveReal(udg_HT, moveId, 5, totalDist)
    call SaveReal(udg_HT, moveId, 6, 0.0)
    call TimerStart(moveTimer, 0.03, true, function BA6_Timer)

    // 1.2秒后移除突进状态技能
    set removeTimer = CreateTimer()
    set removeId = GetHandleId(removeTimer)
    call SaveUnitHandle(udg_HT, removeId, 1, caster)
    call TimerStart(removeTimer, 1.2, false, function BA6_RemoveAbility)

    set caster = null
    set startLoc = null
    set targetLoc = null
    set moveTimer = null
    set removeTimer = null
    set muff = null
endfunction

//==================== 触发器初始化 ====================
function InitTrig_A0Z1 takes nothing returns nothing
    local trigger trg

    // 哈希表未初始化则自动创建
    if udg_HT == null then
        set udg_HT = InitHashtable()
    endif

    // 防重复初始化
    if LoadInteger(udg_HT, 0, 95001) == 1 then
        return
    endif

    set trg = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trg, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trg, Condition(function R1xz))
    call TriggerAddAction(trg, function A3xz)
    set trg = null

    call SaveInteger(udg_HT, 0, 95001, 1)
endfunction
//
// ===================== 学习技能触发条件 =====================
function Trig_A025_Learn_Conditions takes nothing returns boolean
    return GetLearnedSkill() == 'A025'
endfunction

// ===================== 学习技能触发动作（覆盖式更新） =====================
function Trig_A025_Learn_Actions takes nothing returns nothing
    local unit hero = GetTriggerUnit()
    local integer newLevel = GetLearnedSkillLevel()        // 当前技能等级（学习后）
    local integer oldLevel = LoadInteger(udg_HT_Attributes, GetHandleId(hero), 0)  // 已记录的旧等级

    // 先移除旧等级的属性加成
    call SetHeroStr(hero, GetHeroStr(hero, false) - oldLevel * 4, false)
    call SetHeroAgi(hero, GetHeroAgi(hero, false) - oldLevel * 2, false)

    // 再添加新等级的属性加成
    call SetHeroStr(hero, GetHeroStr(hero, false) + newLevel * 4, false)
    call SetHeroAgi(hero, GetHeroAgi(hero, false) + newLevel * 2, false)

    // 更新记录
    call SaveInteger(udg_HT_Attributes, GetHandleId(hero), 0, newLevel)

    set hero = null
endfunction

// ===================== 初始化触发器 =====================
function InitTrig_A025_AttributeBonus takes nothing returns nothing
    local trigger t = CreateTrigger()

    // 初始化哈希表（仅一次）
    if udg_HT_Attributes == null then
        set udg_HT_Attributes = InitHashtable()
    endif

    // 注册任意单位学习技能事件
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(t, Condition(function Trig_A025_Learn_Conditions))
    call TriggerAddAction(t, function Trig_A025_Learn_Actions)

    set t = null
endfunction
//徐庶
function IceEffect_Destroy takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local effect e = LoadEffectHandle(TZ, tid, 0)
    
    call PauseTimer(t)
    if e != null then
        call DestroyEffect(e)
    endif
    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)
    
    set t = null
    set e = null
endfunction

// ===================== 主技能条件 =====================
function DdI takes nothing returns boolean
    return GetSpellAbilityId() == 'A0M7'
endfunction

// ===================== 天气清理 =====================
function DdJ takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local rect r
    
    call PauseTimer(t)
    call EnableWeatherEffect(BKR, false)
    call RemoveWeatherEffect(BKR)
    
    set r = LoadRectHandle(TZ, tid, 0x937FC124)
    if r != null then
        call RemoveRect(r)
    endif
    
    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)
    
    set t = null
    set r = null
endfunction

// ===================== 地形刷新回调（高频，防止被覆盖） =====================
function DdW takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local location centerLoc = LoadLocationHandle(TZ, tid, 0x5E83114F)
    local location tempLoc
    local integer fY

    // 坐标失效直接安全终止
    if centerLoc == null then
        call PauseTimer(t)
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
        set t = null
        return
    endif

    set fY = 1
    loop
        exitwhen fY > 90
        set tempLoc = PolarProjectionBJ(centerLoc, 800., 4.0 * I2R(fY))
        call SetTerrainPathableBJ(tempLoc, PATHING_TYPE_WALKABILITY, false)
        call RemoveLocation(tempLoc)
        set fY = fY + 1
    endloop

    set tempLoc = null
    set centerLoc = null
    set t = null
endfunction

// ===================== 冰墙结束：恢复地形 =====================
function DdL takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local location centerLoc = LoadLocationHandle(TZ, tid, 0x5E83114F)
    local location tempLoc
    local integer fY

    call PauseTimer(t)

    if centerLoc != null then
        set fY = 1
        loop
            exitwhen fY > 90
            set tempLoc = PolarProjectionBJ(centerLoc, 800., 4.0 * I2R(fY))
            call SetTerrainPathableBJ(tempLoc, PATHING_TYPE_WALKABILITY, true)
            call RemoveLocation(tempLoc)
            set fY = fY + 1
        endloop
        call RemoveLocation(centerLoc)
    endif

    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)
    
    set tempLoc = null
    set centerLoc = null
    set t = null
endfunction
// ===================== 主技能扩散循环核心 =====================
function DdM takes nothing returns nothing
    local integer fY
    local group fd
    local unit fe
    local timer ff
    local integer tid
    local integer lvl
    local real dmg
    local unit caster
    local effect fx
    local location tempLoc
    local unit wallUnit
    local location centerLoc
    local integer stage

    set tid = GetHandleId(GetExpiredTimer())
    set caster = LoadUnitHandle(TZ, tid, 0xB6A6EBAA)
    set centerLoc = LoadLocationHandle(TZ, tid, 0x5E83114F)

    // 施法者或中心点失效提前安全终止
    if caster == null or not IsUnitAliveBJ(caster) or centerLoc == null then
        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(GetExpiredTimer())
        set caster = null
        set centerLoc = null
        return
    endif

    if LoadInteger(TZ, tid, 0xA7A4FEA4) < 4 then
        // 阶段自增，用局部变量承接方便判断
        set stage = LoadInteger(TZ, tid, 0xA7A4FEA4) + 1
        call SaveInteger(TZ, tid, 0xA7A4FEA4, stage)

        // ========== 优化：仅奇数阶段(1、3)生成扩散特效，偶数阶段跳过，伤害逻辑不变 ==========
        if ModuloInteger(stage, 2) == 1 then
            set fY = 1
            loop
                exitwhen fY > 18
                    set tempLoc = PolarProjectionBJ(centerLoc, 200. * I2R(stage), 20. * I2R(fY))
                    set fx = AddSpecialEffectLoc("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", tempLoc)
                    if fx != null then
                        call DestroyEffect(fx)
                        set fx = null
                    endif
                    call RemoveLocation(tempLoc)
                    set fY = fY + 1
            endloop
        endif

        set lvl = GetUnitAbilityLevel(caster, 'A0M7')
        if lvl == 1 then
            set dmg = 250.0
        elseif lvl == 2 then
            set dmg = 280.0
        elseif lvl == 3 then
            set dmg = 330.0
        else
            set dmg = 380.0
        endif

        // 范围伤害每阶段都执行，完全不做裁剪
        set fd = CreateGroup()
        call GroupEnumUnitsInRange(fd, GetLocationX(centerLoc), GetLocationY(centerLoc), 200. * I2R(stage), null)
        loop
            set fe = FirstOfGroup(fd)
            exitwhen fe == null
            call GroupRemoveUnit(fd, fe)
            if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
                call UnitDamageTarget(caster, fe, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            endif
        endloop
        call DestroyGroup(fd)
    else
        set lvl = GetUnitAbilityLevel(caster, 'A0M7')
        set fY = 1
        loop
            exitwhen fY > 24
                set tempLoc = PolarProjectionBJ(centerLoc, 800., 15. * I2R(fY))
                set wallUnit = CreateUnitAtLoc(GetOwningPlayer(caster), 'e0L2', tempLoc, 15. * I2R(fY))
                if wallUnit != null then
                    call SaveUnitHandle(TZ, tid, 0xD71487D4, wallUnit)
                    call SetUnitInvulnerable(wallUnit, true)
                    call UnitApplyTimedLife(wallUnit, 'BHwe', 5.)
                    set wallUnit = null
                endif
                call RemoveLocation(tempLoc)
                set fY = fY + 1
        endloop

        // 设置地形不可通行
        set fY = 1
        loop
            exitwhen fY > 90
                set tempLoc = PolarProjectionBJ(centerLoc, 800., 4.0 * I2R(fY))
                call SetTerrainPathableBJ(tempLoc, PATHING_TYPE_WALKABILITY, false)
                call RemoveLocation(tempLoc)
                set fY = fY + 1
        endloop

        // 最终爆发伤害
        set fd = CreateGroup()
        call GroupEnumUnitsInRange(fd, GetLocationX(centerLoc), GetLocationY(centerLoc), 800., null)
        loop
            set fe = FirstOfGroup(fd)
            exitwhen fe == null
            call GroupRemoveUnit(fd, fe)
            if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
                call UnitDamageTarget(caster, fe, GetHeroInt(caster, true) * lvl * 1.3, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            endif
        endloop
        call DestroyGroup(fd)

        // 冰场核心单位
        set wallUnit = CreateUnit(GetOwningPlayer(caster), 'e0K4', GetUnitX(caster), GetUnitY(caster), bj_UNIT_FACING)
        if wallUnit != null then
            call SaveUnitHandle(TZ, tid, 0x5713DB47, wallUnit)
            call UnitApplyTimedLife(wallUnit, 'BHwe', 60.)
            set BKS = wallUnit
            set wallUnit = null
        endif

        // 5秒后恢复地形
        set ff = CreateTimer()
        call SaveLocationHandle(TZ, GetHandleId(ff), 0x5E83114F, centerLoc)
        call TimerStart(ff, 5., false, function DdL)

        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(GetExpiredTimer())
    endif

    set fd = null
    set fe = null
    set ff = null
    set caster = null
    set fx = null
    set tempLoc = null
    set wallUnit = null
    set centerLoc = null
endfunction


// ===================== 主技能施法入口 =====================
function DdN takes nothing returns nothing
    local timer ff
    local integer fc
    local integer trigId
    local integer timerId
    local unit caster

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set trigId = GetHandleId(GetTriggeringTrigger())
    set fc = LoadInteger(TZ, trigId, 0xCFDE6C76) + 3
    call SaveInteger(TZ, trigId, 0xCFDE6C76, fc)
    call SaveInteger(TZ, trigId, 0xECE825E7, fc)
    call PlaySoundOnUnitBJ(I1, 100, caster)

    call SaveUnitHandle(TZ, trigId * fc, 0xB6A6EBAA, caster)
    call SaveLocationHandle(TZ, trigId * fc, 0x5E83114F, GetUnitLoc(caster))
    call SaveRectHandle(TZ, trigId * fc, 0x937FC124, RectFromCenterSizeBJ(LoadLocationHandle(TZ, trigId * fc, 0x5E83114F), 800., 800.))
    
    call AddWeatherEffectSaveLast(LoadRectHandle(TZ, trigId * fc, 0x937FC124), 'SNhs')
    set BKR = GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(BKR, true)
    set b4 = true

    set ff = CreateTimer()
    set timerId = GetHandleId(ff)
    call SaveRectHandle(TZ, timerId, 0x937FC124, LoadRectHandle(TZ, trigId * fc, 0x937FC124))
    call TimerStart(ff, 15., false, function DdJ)

    set ff = CreateTimer()
    set timerId = GetHandleId(ff)
    call SaveUnitHandle(TZ, timerId, 0xB6A6EBAA, LoadUnitHandle(TZ, trigId * fc, 0xB6A6EBAA))
    call SaveLocationHandle(TZ, timerId, 0x5E83114F, LoadLocationHandle(TZ, trigId * fc, 0x5E83114F))
    call SaveInteger(TZ, timerId, 0xA7A4FEA4, 0)
    call TimerStart(ff, 0.35, true, function DdM)

    call FlushChildHashtable(TZ, trigId * fc)
    set ff = null
    set caster = null
endfunction

// ===================== 主技能触发器初始化 =====================
function DdO takes nothing returns nothing
    set BKQ = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BKQ, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(BKQ, Condition(function DdI))
    call TriggerAddAction(BKQ, function DdN)
endfunction

// ===================== 二段技能条件 =====================
function DdQ takes nothing returns boolean
    return GetSpellAbilityId() == 'A0MH'
endfunction

// ===================== 二段冰弹生成 =====================
function DdR takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster
    local unit center
    local unit missile

    set caster = LoadUnitHandle(TZ, tid, 0xB6A6EBAA)
    set center = LoadUnitHandle(TZ, tid, 0xD71487D4)

    // 单位失效提前终止
    if caster == null or center == null then
        call PauseTimer(t)
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set center = null
        return
    endif

    if LoadInteger(TZ, tid, 0xBC0DCC19) < 2 then
        call SaveInteger(TZ, tid, 0xBC0DCC19, LoadInteger(TZ, tid, 0xBC0DCC19) + 1)
        set missile = CreateUnit(GetOwningPlayer(caster), 'e0L5', GetUnitX(center), GetUnitY(center), bj_UNIT_FACING)
        if missile != null then
            call SaveUnitHandle(TZ, tid, 0xDD6736F, missile)
            call UnitApplyTimedLife(missile, 'BHwe', 2.5)
            set missile = null
        endif
    else
        call PauseTimer(t)
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
    endif

    set caster = null
    set center = null
    set missile = null
    set t = null
endfunction

// ===================== 二段收尾伤害 =====================
function DdS takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local group fd
    local unit fe
    local unit caster = LoadUnitHandle(TZ, tid, 0xB6A6EBAA)
    local unit center = LoadUnitHandle(TZ, tid, 0xD71487D4)
    local integer lvl
    local real int
    local effect fx

    call PauseTimer(t)

    // 施法者与中心单位判空
    if caster == null or center == null or not IsUnitAliveBJ(caster) then
        call FlushChildHashtable(TZ, tid)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set center = null
        return
    endif

    set lvl = GetUnitAbilityLevel(caster, 'A0M7')
    set int = GetHeroInt(caster, true)

    set fd = CreateGroup()
    call GroupEnumUnitsInRange(fd, GetUnitX(center), GetUnitY(center), 800., null)
    loop
        set fe = FirstOfGroup(fd)
        exitwhen fe == null
        call GroupRemoveUnit(fd, fe)
        if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
            // 特效判空销毁
            set fx = AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", GetUnitX(fe), GetUnitY(fe))
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
            call UnitDamageTarget(caster, fe, int * lvl * 3.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
        endif
    endloop
    call DestroyGroup(fd)
    call FlushChildHashtable(TZ, tid)
    call DestroyTimer(t)

    set fd = null
    set fe = null
    set caster = null
    set center = null
    set fx = null
    set t = null
endfunction

// ===================== 二段技能施法入口 =====================
function DdT takes nothing returns nothing
    local timer ff
    local group fd
    local unit fe
    local effect iceFx
    local timer fxTimer
    local integer fc
    local integer trigId
    local integer timerId
    local unit caster
    local unit centerMissile
    local unit thunderMuff

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set trigId = GetHandleId(GetTriggeringTrigger())
    set fc = LoadInteger(TZ, trigId, 0xCFDE6C76) + 3
    call SaveInteger(TZ, trigId, 0xCFDE6C76, fc)
    call SaveInteger(TZ, trigId, 0xECE825E7, fc)
    call PlaySoundOnUnitBJ(I2, 100, caster)

    // 冰场核心不存在直接终止
    if BKS == null or not IsUnitAliveBJ(BKS) then
        set caster = null
        return
    endif

    // 中心冰弹创建判空
    set centerMissile = CreateUnit(GetOwningPlayer(caster), 'e0L5', GetUnitX(BKS), GetUnitY(BKS), bj_UNIT_FACING)
    if centerMissile == null then
        set caster = null
        return
    endif
    call UnitApplyTimedLife(centerMissile, 'BHwe', 2.5)

    call SaveUnitHandle(TZ, trigId * fc, 0xB6A6EBAA, caster)
    call SaveUnitHandle(TZ, trigId * fc, 0xD71487D4, centerMissile)

    set ff = CreateTimer()
    set timerId = GetHandleId(ff)
    call SaveUnitHandle(TZ, timerId, 0xB6A6EBAA, caster)
    call SaveUnitHandle(TZ, timerId, 0xD71487D4, centerMissile)
    call SaveInteger(TZ, timerId, 0xBC0DCC19, 0)
    call TimerStart(ff, 1., true, function DdR)

    set fd = CreateGroup()
    call GroupEnumUnitsInRange(fd, GetUnitX(centerMissile), GetUnitY(centerMissile), 800., null)
    loop
        set fe = FirstOfGroup(fd)
        exitwhen fe == null
        call GroupRemoveUnit(fd, fe)
        if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true and GetUnitTypeId(fe) != 'H04H' then
            // 闪电马甲创建判空 + 释放前目标校验
            if IsUnitAliveBJ(fe) then
                set thunderMuff = CreateUnit(GetOwningPlayer(caster), 'e0C0', GetUnitX(fe), GetUnitY(fe), bj_UNIT_FACING)
                if thunderMuff != null then
                    call SaveUnitHandle(TZ, trigId * fc, 0x2A30FF17, thunderMuff)
                    call UnitApplyTimedLife(thunderMuff, 'BHwe', 1.)
                    call UnitAddAbility(thunderMuff, 'A0N2')
                    call IssueTargetOrder(thunderMuff, "thunderbolt", fe)
                    set thunderMuff = null
                endif
            endif

            // 冰水晶特效判空，无效则不创建延迟销毁计时器
            set iceFx = AddSpecialEffectTarget("Doodads\\Icecrown\\Rocks\\Icecrown_Crystal\\Icecrown_Crystal2.mdl", fe, "origin")
            if iceFx != null then
                set fxTimer = CreateTimer()
                call SaveEffectHandle(TZ, GetHandleId(fxTimer), 0, iceFx)
                call TimerStart(fxTimer, 2.0, false, function IceEffect_Destroy)
                set fxTimer = null
            endif
            set iceFx = null
        endif
    endloop
    call DestroyGroup(fd)

    set ff = CreateTimer()
    set timerId = GetHandleId(ff)
    call SaveUnitHandle(TZ, timerId, 0xB6A6EBAA, caster)
    call SaveUnitHandle(TZ, timerId, 0xD71487D4, centerMissile)
    call TimerStart(ff, 1.9, false, function DdS)

    call FlushChildHashtable(TZ, trigId * fc)

    set ff = null
    set fd = null
    set fe = null
    set iceFx = null
    set fxTimer = null
    set caster = null
    set centerMissile = null
    set thunderMuff = null
endfunction

// ===================== 二段技能触发器初始化 =====================
function DdU takes nothing returns nothing
    set BKT = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BKT, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(BKT, Condition(function DdQ))
    call TriggerAddAction(BKT, function DdT)
endfunction

// ===================== 总初始化 =====================
function InitTrig_A0MG_System takes nothing returns nothing
    if TZ == null then
        set TZ = InitHashtable()
    endif
    // 防重复初始化，避免触发器叠加泄漏
    if LoadInteger(TZ, 0, 94001) == 1 then
        return
    endif
    call DdO()
    call DdU()
    call SaveInteger(TZ, 0, 94001, 1)
endfunction
//徐庶2
function Arrow_Move takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit arrow = LoadUnitHandle(TZ, id, 0)
    local real startX = LoadReal(TZ, id, 1)
    local real startY = LoadReal(TZ, id, 2)
    local real targetX = LoadReal(TZ, id, 3)
    local real targetY = LoadReal(TZ, id, 4)
    local integer step = LoadInteger(TZ, id, 5)
    local integer maxStep = LoadInteger(TZ, id, 6)
    local real progress
    local real curve
    local real x
    local real y
    local real height

    if arrow != null and step < maxStep and GetWidgetLife(arrow) > 0.405 then
        set step = step + 1
        call SaveInteger(TZ, id, 5, step)
        set progress = I2R(step) / I2R(maxStep)
        // 缓动曲线：前加速后减速
        if progress < 0.5 then
            set curve = 2.5 * progress * progress
        else
            set curve = 1.0 - (-2.0 * progress + 2.0) * (-2.0 * progress + 2.0) / 2.0
        endif
        set x = startX + (targetX - startX) * curve
        set y = startY + (targetY - startY) * curve
        call SetUnitX(arrow, x)
        call SetUnitY(arrow, y)
        // 抛物线高度：最高点约800
        set height = 800.0 * progress * (1.0 - progress)
        call SetUnitFlyHeight(arrow, height, 0.0)
    else
        if arrow != null then
            call RemoveUnit(arrow)
        endif
        call PauseTimer(t)
        call FlushChildHashtable(TZ, id)
        call DestroyTimer(t)
    endif
    set t = null
    set arrow = null
endfunction

function Arrow_Launch takes unit arrow, real targetX, real targetY returns nothing
    local timer t
    local integer id
    local real startX
    local real startY
    local integer maxStep

    // 入参兜底：箭矢无效直接返回
    if arrow == null then
        return
    endif

    set t = CreateTimer()
    set id = GetHandleId(t)
    set startX = GetUnitX(arrow)
    set startY = GetUnitY(arrow)
    set maxStep = 40   // 固定 40 步，每步 0.025 秒 = 1.0 秒飞行时间
    call SaveUnitHandle(TZ, id, 0, arrow)
    call SaveReal(TZ, id, 1, startX)
    call SaveReal(TZ, id, 2, startY)
    call SaveReal(TZ, id, 3, targetX)
    call SaveReal(TZ, id, 4, targetY)
    call SaveInteger(TZ, id, 5, 0)
    call SaveInteger(TZ, id, 6, maxStep)
    call TimerStart(t, 0.025, true, function Arrow_Move)
    set t = null
endfunction

function Dct takes nothing returns boolean
    return GetSpellAbilityId() == 'A0MD'
endfunction

function Dcu takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster
    local location startLoc
    local location targetLoc
    local real angle
    local real targetX
    local real targetY
    local location spawnLoc
    local unit arrow

    if LoadInteger(TZ, id, $BC0DCC19) < 15 then
        call SaveInteger(TZ, id, $BC0DCC19, LoadInteger(TZ, id, $BC0DCC19) + 1)
        
        set caster = LoadUnitHandle(TZ, id, $B6A6EBAA)
        set startLoc = LoadLocationHandle(TZ, id, $8D3C1FA0)
        set targetLoc = LoadLocationHandle(TZ, id, $CCB71FEE)
        
        // 极端场景兜底：施法者或坐标失效，提前安全终止
        if caster == null or startLoc == null or targetLoc == null then
            call PauseTimer(t)
            if startLoc != null then
                call RemoveLocation(startLoc)
            endif
            if targetLoc != null then
                call RemoveLocation(targetLoc)
            endif
            call FlushChildHashtable(TZ, id)
            call DestroyTimer(t)
            set t = null
            set caster = null
            set startLoc = null
            set targetLoc = null
            return
        endif

        set angle = LoadReal(TZ, id, $9966AD24)
        set targetX = GetLocationX(targetLoc)
        set targetY = GetLocationY(targetLoc)
        set spawnLoc = PolarProjectionBJ(startLoc, I2R(GetRandomInt(1, 300)), GetRandomDirectionDeg())
        set arrow = CreateUnitAtLoc(GetOwningPlayer(caster), 'e0L3', spawnLoc, angle)
        if arrow != null then
            call SetUnitFacing(arrow, angle)
            call UnitApplyTimedLife(arrow, 'BHwe', 1.5)
            call Bac(arrow)
            call SetUnitFlyHeight(arrow, 0.0, 0.0)
            call Arrow_Launch(arrow, targetX, targetY)
        endif
        call RemoveLocation(spawnLoc)
        set spawnLoc = null
        set arrow = null
        set caster = null
        set startLoc = null
        set targetLoc = null
    else
        // 箭矢阶段结束：销毁起始点坐标，目标点坐标保留给伤害阶段
        set startLoc = LoadLocationHandle(TZ, id, $8D3C1FA0)
        if startLoc != null then
            call RemoveLocation(startLoc)
        endif
        call PauseTimer(t)
        call FlushChildHashtable(TZ, id)
        call DestroyTimer(t)
        set startLoc = null
    endif
    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
    set spawnLoc = null
    set arrow = null
endfunction

function Dcv takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local group fd
    local unit fe
    local unit caster
    local integer lvl
    local real int
    local real baseDmg
    local real finalDmg
    local location targetLoc
    local location randLoc
    local effect fx
    local unit slowMuff

    if LoadInteger(TZ, id, $A7A4FEA4) < 15 then
        call SaveInteger(TZ, id, $A7A4FEA4, LoadInteger(TZ, id, $A7A4FEA4) + 1)
        
        set targetLoc = LoadLocationHandle(TZ, id, $CCB71FEE)
        // 坐标失效直接终止，避免空指针
        if targetLoc == null then
            call PauseTimer(t)
            call FlushChildHashtable(TZ, id)
            call DestroyTimer(t)
            set t = null
            set targetLoc = null
            return
        endif

        set caster = LoadUnitHandle(TZ, id, $B6A6EBAA)
        if caster == null or not IsUnitAliveBJ(caster) then
            set targetLoc = null
            set t = null
            return
        endif

        // 随机位置特效：增加判空，根治空句柄崩溃
        set randLoc = PolarProjectionBJ(targetLoc, I2R(GetRandomInt(1, 300)), GetRandomDirectionDeg())
        set fx = AddSpecialEffectLoc("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", randLoc)
        if fx != null then
            call DestroyEffect(fx)
            set fx = null
        endif
        call RemoveLocation(randLoc)
        set randLoc = null

        set lvl = GetUnitAbilityLevel(caster, 'A0MD')
        set int = GetHeroInt(caster, true)

        // 基础伤害
        if lvl == 1 then
            set baseDmg = 20.0
        elseif lvl == 2 then
            set baseDmg = 30.0
        elseif lvl == 3 then
            set baseDmg = 40.0
        else
            set baseDmg = 50.0
        endif

        // 最终伤害 = 基础 + 智力 × 0.4
        set finalDmg = baseDmg + int * 0.4

        set fd = CreateGroup()
        call GroupEnumUnitsInRange(fd, GetLocationX(targetLoc), GetLocationY(targetLoc), 400., null)
        loop
            set fe = FirstOfGroup(fd)
            exitwhen fe == null
            call GroupRemoveUnit(fd, fe)
            // 新增：单位空值前置校验
            if fe != null and IsUnitType(fe, UNIT_TYPE_STRUCTURE) == false and IsUnitAliveBJ(fe) == true and IsUnitEnemy(fe, GetOwningPlayer(caster)) == true then
                if UnitHasBuffBJ(fe, 'Bslo') == false then
                    // 减速马甲：释放前二次确认目标存活
                    if IsUnitAliveBJ(fe) then
                        set slowMuff = CreateUnit(GetOwningPlayer(caster), 'e0C0', GetUnitX(fe), GetUnitY(fe), bj_UNIT_FACING)
                        if slowMuff != null then
                            call UnitApplyTimedLife(slowMuff, 'BHwe', 1.)
                            call UnitAddAbility(slowMuff, 'A0MK')
                            call SetUnitAbilityLevel(slowMuff, 'A0MK', lvl)
                            call IssueTargetOrder(slowMuff, "slow", fe)
                            set slowMuff = null
                        endif
                    endif
                endif
                // 混沌通用伤害
                call UnitDamageTargetBJ(caster, fe, finalDmg, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
            endif
        endloop
        call DestroyGroup(fd)

        set targetLoc = null
        set caster = null
        set fd = null
        set fe = null
        set fx = null
        set slowMuff = null
    else
        // 伤害阶段结束：销毁目标点坐标，彻底释放资源
        set targetLoc = LoadLocationHandle(TZ, id, $CCB71FEE)
        if targetLoc != null then
            call RemoveLocation(targetLoc)
        endif
        call PauseTimer(t)
        call FlushChildHashtable(TZ, id)
        call DestroyTimer(t)
        set targetLoc = null
    endif
    set t = null
    set fd = null
    set fe = null
    set caster = null
    set targetLoc = null
    set randLoc = null
    set fx = null
    set slowMuff = null
endfunction

function Dcw takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local timer ff
    set ff = CreateTimer()
    call SaveUnitHandle(TZ, GetHandleId(ff), $B6A6EBAA, LoadUnitHandle(TZ, id, $B6A6EBAA))
    call SaveLocationHandle(TZ, GetHandleId(ff), $CCB71FEE, LoadLocationHandle(TZ, id, $CCB71FEE))
    call SaveInteger(TZ, GetHandleId(ff), $A7A4FEA4, 0)
    call TimerStart(ff, .1, true, function Dcv)
    
    call PauseTimer(t)
    call FlushChildHashtable(TZ, id)
    call DestroyTimer(t)
    
    set ff = null
    set t = null
endfunction

function Dcx takes nothing returns nothing
    local trigger trig = GetTriggeringTrigger()
    local integer trigId = GetHandleId(trig)
    local timer ff
    local integer fc = LoadInteger(TZ, trigId, $CFDE6C76)
    local integer dataKey
    local unit caster

    // 施法入口有效性兜底
    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set trig = null
        set caster = null
        return
    endif

    set fc = fc + 3
    call SaveInteger(TZ, trigId, $CFDE6C76, fc)
    call SaveInteger(TZ, trigId, $ECE825E7, fc)
    call PlaySoundOnUnitBJ(Iz, 100, caster)
    
    set dataKey = trigId * fc
    call SaveUnitHandle(TZ, dataKey, $B6A6EBAA, caster)
    call SaveLocationHandle(TZ, dataKey, $8D3C1FA0, GetUnitLoc(caster))
    call SaveLocationHandle(TZ, dataKey, $CCB71FEE, GetSpellTargetLoc())
    call SaveReal(TZ, dataKey, $9966AD24, AngleBetweenPoints(LoadLocationHandle(TZ, dataKey, $8D3C1FA0), LoadLocationHandle(TZ, dataKey, $CCB71FEE)))
    
    // 箭矢生成计时器
    set ff = CreateTimer()
    call SaveUnitHandle(TZ, GetHandleId(ff), $B6A6EBAA, LoadUnitHandle(TZ, dataKey, $B6A6EBAA))
    call SaveLocationHandle(TZ, GetHandleId(ff), $8D3C1FA0, LoadLocationHandle(TZ, dataKey, $8D3C1FA0))
    call SaveLocationHandle(TZ, GetHandleId(ff), $CCB71FEE, LoadLocationHandle(TZ, dataKey, $CCB71FEE))
    call SaveReal(TZ, GetHandleId(ff), $9966AD24, LoadReal(TZ, dataKey, $9966AD24))
    call SaveInteger(TZ, GetHandleId(ff), $BC0DCC19, 0)
    call TimerStart(ff, .1, true, function Dcu)
    
    // 伤害阶段延迟启动计时器
    set ff = CreateTimer()
    call SaveUnitHandle(TZ, GetHandleId(ff), $B6A6EBAA, LoadUnitHandle(TZ, dataKey, $B6A6EBAA))
    call SaveLocationHandle(TZ, GetHandleId(ff), $CCB71FEE, LoadLocationHandle(TZ, dataKey, $CCB71FEE))
    call SaveInteger(TZ, GetHandleId(ff), $A7A4FEA4, 0)
    call TimerStart(ff, .9, false, function Dcw)
    
    call FlushChildHashtable(TZ, dataKey)
    set ff = null
    set trig = null
    set caster = null
endfunction

function Dcy takes nothing returns nothing
    set BKK = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BKK, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(BKK, Condition(function Dct))
    call TriggerAddAction(BKK, function Dcx)
endfunction

// ===================== 初始化 =====================
function InitTrig_A0MD takes nothing returns nothing
    if TZ == null then
        set TZ = InitHashtable()
    endif
    // 防重复初始化标记，避免触发器叠加泄漏
    if LoadInteger(TZ, 0, 93001) == 1 then
        return
    endif
    call Dcy()
    call SaveInteger(TZ, 0, 93001, 1)
endfunction
//徐庶3
// ===================== 独立冰箭移动系统（函数名已加上技能后缀，杜绝冲突） =====================
function MoveArrow_A0ME takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit arrow = LoadUnitHandle(TZ, id, 0)
    local real startX = LoadReal(TZ, id, 1)
    local real startY = LoadReal(TZ, id, 2)
    local real targetX = LoadReal(TZ, id, 3)
    local real targetY = LoadReal(TZ, id, 4)
    local integer step = LoadInteger(TZ, id, 5)
    local integer maxStep = LoadInteger(TZ, id, 6)
    local real progress
    local real curve
    local real x
    local real y
    local real height

    if arrow != null and step < maxStep and GetWidgetLife(arrow) > 0.405 then
        set step = step + 1
        call SaveInteger(TZ, id, 5, step)
        set progress = I2R(step) / I2R(maxStep)
        if progress < 0.5 then
            set curve = 2.5 * progress * progress
        else
            set curve = 1.0 - (-2.0 * progress + 2.0) * (-2.0 * progress + 2.0) / 2.0
        endif
        set x = startX + (targetX - startX) * curve
        set y = startY + (targetY - startY) * curve
        call SetUnitX(arrow, x)
        call SetUnitY(arrow, y)
        set height = 200.0 * progress * (1.0 - progress)
        call SetUnitFlyHeight(arrow, height, 0.0)
    else
        if arrow != null then
            call RemoveUnit(arrow)
        endif
        call PauseTimer(t)
        call FlushChildHashtable(TZ, id)
        call DestroyTimer(t)
    endif
    set t = null
    set arrow = null
endfunction

function LaunchArrow_A0ME takes unit arrow, real targetX, real targetY, real duration returns nothing
    local timer t
    local integer id
    local real startX
    local real startY
    local integer maxStep

    // 入参兜底：箭矢无效直接返回，不执行后续逻辑
    if arrow == null then
        return
    endif

    set t = CreateTimer()
    set id = GetHandleId(t)
    set startX = GetUnitX(arrow)
    set startY = GetUnitY(arrow)
    set maxStep = R2I(duration / 0.025)
    if maxStep < 10 then
        set maxStep = 10
    endif
    call SaveUnitHandle(TZ, id, 0, arrow)
    call SaveReal(TZ, id, 1, startX)
    call SaveReal(TZ, id, 2, startY)
    call SaveReal(TZ, id, 3, targetX)
    call SaveReal(TZ, id, 4, targetY)
    call SaveInteger(TZ, id, 5, 0)
    call SaveInteger(TZ, id, 6, maxStep)
    call TimerStart(t, 0.025, true, function MoveArrow_A0ME)
    set t = null
endfunction

// ===================== A0ME 技能逻辑 =====================
function Dc0 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ME'
endfunction

function Dc1 takes nothing returns boolean
    local unit filterU = GetFilterUnit()

    // 极端场景兜底：筛选单位无效、施法者无效直接返回false
    if filterU == null or BKM[1] == null then
        set filterU = null
        return false
    endif

    return IsUnitType(filterU, UNIT_TYPE_STRUCTURE) == false and (IsUnitAliveBJ(filterU) == true and IsUnitEnemy(filterU, GetOwningPlayer(BKM[1])) == true)
endfunction

function Dc2 takes nothing returns nothing
    local unit target = GetEnumUnit()
    local unit muff

    // 施法者失效 + 目标无效 双重兜底
    if BKM[1] == null or not IsUnitAliveBJ(BKM[1]) or target == null then
        set target = null
        return
    endif

    // 闪电马甲逻辑完全保留原版
    call CreateNUnitsAtLocFacingLocBJ(1, 'e07D', GetOwningPlayer(BKM[1]), BKN[2], BKN[2])
    set muff = GetLastCreatedUnit()
    if muff != null then
        call UnitApplyTimedLife(muff, 'BHwe', 1.)
        call UnitAddAbility(muff, 'A0N2')
        call IssueTargetOrder(muff, "thunderbolt", target)
        set muff = null
    endif

    // 伤害数值完全保留原版
    if GetUnitAbilityLevel(BKM[1], 'A0ME') == 1 then
        call UnitDamageTargetBJ(BKM[1], target, 2. * I2R(GetHeroAgi(BKM[1], true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE)
    elseif GetUnitAbilityLevel(BKM[1], 'A0ME') == 2 then
        call UnitDamageTargetBJ(BKM[1], target, 4. * I2R(GetHeroAgi(BKM[1], true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE)
    elseif GetUnitAbilityLevel(BKM[1], 'A0ME') == 3 then
        call UnitDamageTargetBJ(BKM[1], target, 7. * I2R(GetHeroAgi(BKM[1], true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE)
    elseif GetUnitAbilityLevel(BKM[1], 'A0ME') == 4 then
        call UnitDamageTargetBJ(BKM[1], target, 10. * I2R(GetHeroAgi(BKM[1], true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE)
    endif

    set target = null
endfunction

function Dc3 takes nothing returns nothing
    local timer t = GetExpiredTimer()
    set BKM[1] = null
    set b4 = false
    call PauseTimer(t)
    call FlushChildHashtable(TZ, GetHandleId(t))
    call DestroyTimer(t)
    set t = null
endfunction

function Dc4 takes nothing returns nothing
    local group fd
    local unit fe
    local timer ff
    local timer t
    local effect fx

    set t = GetExpiredTimer()
    call PauseTimer(t)

    // 中心特效：仅增加判空，逻辑完全不变
    set fx = AddSpecialEffectLoc("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", BKN[2])
    if fx != null then
        call DestroyEffect(fx)
        set fx = null
    endif

    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 8
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set BKN[4] = PolarProjectionBJ(BKN[2], 200., 45. * I2R(GetForLoopIndexB()))
        // 环形特效：仅增加判空，位置、数量、类型完全不变
        set fx = AddSpecialEffectLoc("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", BKN[4])
        if fx != null then
            call DestroyEffect(fx)
            set fx = null
        endif
        call RemoveLocation(BKN[4])
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop

    set b0 = Ba4(350., BKN[2], Condition(function Dc1))
    call ForGroupBJ(b0, function Dc2)
    call GroupClear(b0)
    call DestroyGroup(b0)
    call RemoveLocation(BKN[1])
    call RemoveLocation(BKN[2])
    call RemoveLocation(BKN[3])

    set ff = CreateTimer()
    call TimerStart(ff, .5, false, function Dc3)
    set ff = null

    call FlushChildHashtable(TZ, GetHandleId(t))
    call DestroyTimer(t)

    set fd = null
    set fe = null
    set ff = null
    set fx = null
    set t = null
endfunction

function Dc5 takes nothing returns nothing
    local timer ff
    local unit arrow
    local real angle
    local real targetX
    local real targetY

    // 施法入口有效性兜底
    if GetTriggerUnit() == null then
        return
    endif

    set BKM[1] = GetTriggerUnit()
    set BKN[1] = GetUnitLoc(GetTriggerUnit())
    set BKN[2] = GetSpellTargetLoc()
    set BKN[3] = PolarProjectionBJ(BKN[1], 250., AngleBetweenPoints(BKN[2], BKN[1]))
    set angle = AngleBetweenPoints(BKN[1], BKN[2])
    set targetX = GetLocationX(BKN[2])
    set targetY = GetLocationY(BKN[2])

    set arrow = CreateUnitAtLoc(GetOwningPlayer(BKM[1]), 'e0L4', BKN[3], angle)
    call UnitApplyTimedLife(arrow, 'BHwe', 1.)
    call Bac(arrow)
    call SetUnitFlyHeight(arrow, 0.0, 0.0)
    call LaunchArrow_A0ME(arrow, targetX, targetY, 0.5)

    // 伤害延迟与飞行时间对齐，完全保留原版
    set ff = CreateTimer()
    call TimerStart(ff, 0.5, false, function Dc4)
    set ff = null
    set arrow = null
endfunction

function Dc6 takes nothing returns nothing
    set BKL = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BKL, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(BKL, Condition(function Dc0))
    call TriggerAddAction(BKL, function Dc5)
endfunction

// ===================== 初始化 =====================
function InitTrig_A0ME takes nothing returns nothing
    if TZ == null then
        set TZ = InitHashtable()
    endif
    if LoadInteger(TZ, 0, 92001) == 1 then
        return
    endif
    call Dc6()
    call SaveInteger(TZ, 0, 92001, 1)
endfunction
//徐庶护盾
// ===================== 攻击事件条件 =====================
function DdE takes nothing returns boolean
    local unit u = GetAttackedUnitBJ()
    local unit attacker

    if not IsUnitType(u, UNIT_TYPE_HERO) or not IsUnitAliveBJ(u) then
        set u = null
        return false
    endif

    set attacker = GetAttacker()
    if attacker == null then
        set u = null
        return false
    endif

    if IsUnitEnemy(attacker, GetOwningPlayer(u)) and GetUnitAbilityLevel(u, 'B032') > 0 and GetUnitAbilityLevel(u, 'A0Z6') > 0 then
        set u = null
        set attacker = null
        return true
    endif

    set u = null
    set attacker = null
    return false
endfunction

// ===================== 减速动作 =====================
function DdF takes nothing returns nothing
    local unit u = GetAttackedUnitBJ()
    local unit attacker = GetAttacker()
    local unit muff

    if u == null or attacker == null or not IsUnitAliveBJ(u) then
        set u = null
        set attacker = null
        return
    endif

    if GetRandomInt(1, 3) == 1 then
        // 对齐原版：马甲生成在攻击者脚下
        set muff = CreateUnit(GetOwningPlayer(u), 'e0C0', GetUnitX(attacker), GetUnitY(attacker), bj_UNIT_FACING)
        if muff != null then
            call UnitApplyTimedLife(muff, 'BHwe', 1.)
            call UnitAddAbility(muff, 'A0MI')
            call IssueTargetOrder(muff, "slow", attacker)
            set muff = null
        endif
    endif

    set u = null
    set attacker = null
endfunction

// ===================== 初始化 =====================
function InitTrig_A0MF takes nothing returns nothing
    local trigger t
    if TZ == null then
        set TZ = InitHashtable()
    endif

    // 防重复初始化标记，改用合法十进制子键，避免语法错误
    if LoadInteger(TZ, 0, 91001) == 1 then
        return
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(t, Condition(function DdE))
    call TriggerAddAction(t, function DdF)

    call SaveInteger(TZ, 0, 91001, 1)

    set t = null
endfunction
//专武
// ===================== 死亡完整清理动作 =====================
function DeathCleanUp takes nothing returns nothing
    local unit dying = GetTriggerUnit()
    if dying != null and dying == BCb[1] then
        call DisableTrigger(BCd)
        call DisableTrigger(DeathTrig)
        
        // 恢复目标单位状态
        if BCb[2] != null then
            call SetUnitFlyHeight(BCb[2], GetUnitDefaultFlyHeight(BCb[2]), 0.)
            call PauseUnitBJ(false, BCb[2])
        endif
        
        // 清理旋转马甲
        if BCb[3] != null then
            call RemoveUnit(BCb[3])
            set BCb[3] = null
        endif
        if BCb[4] != null then
            call RemoveUnit(BCb[4])
            set BCb[4] = null
        endif
        
        // 清空所有全局引用
        set BCb[1] = null
        set BCb[2] = null
        set BCc[1] = 0.
        
        call CameraClearNoiseForPlayer(GetOwningPlayer(dying))
    endif
    set dying = null
endfunction

// ===================== 旋转升空动作（完全还原原版逻辑，未做任何坐标改动）=====================
function C7O takes nothing returns nothing
    local location targetLoc
    local location newLoc
    local location m4Loc

    // 目标单位失效则立即停止周期回调
    if BCb[2] == null or GetWidgetLife(BCb[2]) < 0.405 then
        call DisableTrigger(BCd)
        return
    endif
    // 两个旋转马甲全部失效也停止回调
    if (BCb[3] == null or GetWidgetLife(BCb[3]) < 0.405) and (BCb[4] == null or GetWidgetLife(BCb[4]) < 0.405) then
        call DisableTrigger(BCd)
        return
    endif

    set BCc[1] = BCc[1] + 10.
    set targetLoc = GetUnitLoc(BCb[2])
    set newLoc = Location(GetUnitX(BCb[2]) + 90. * CosBJ(BCc[1]), GetUnitY(BCb[2]) + 90. * SinBJ(BCc[1]))
    set m4Loc = PolarProjectionBJ(newLoc, 180., GetUnitFacing(BCb[3]))

    // 单个马甲失效不影响整体，有效才执行位移与升空
    if BCb[3] != null and GetWidgetLife(BCb[3]) >= 0.405 then
        call SetUnitPositionLocFacingLocBJ(BCb[3], newLoc, targetLoc)
        call SetUnitFlyHeight(BCb[3], GetUnitFlyHeight(BCb[3]) + 30., 99999.)
    endif
    if BCb[4] != null and GetWidgetLife(BCb[4]) >= 0.405 then
        call SetUnitPositionLocFacingLocBJ(BCb[4], m4Loc, targetLoc)
        call SetUnitFlyHeight(BCb[4], GetUnitFlyHeight(BCb[4]) + 30., 99999.)
    endif
    call SetUnitFlyHeight(BCb[2], GetUnitFlyHeight(BCb[2]) + 30., 99999.)

    call RemoveLocation(m4Loc)
    call RemoveLocation(newLoc)
    call RemoveLocation(targetLoc)
    set targetLoc = null
    set newLoc = null
    set m4Loc = null
endfunction

// ===================== 创建旋转触发器 =====================
function C7P takes nothing returns nothing
    set BCd = CreateTrigger()
    call DisableTrigger(BCd)
    call TriggerRegisterTimerEventPeriodic(BCd, .05)
    call TriggerAddAction(BCd, function C7O)
endfunction

// ===================== 主技能条件 =====================
function C7K takes nothing returns boolean
    return GetSpellAbilityId() == 'A0XS'
endfunction

// ===================== 主技能动作（完全还原原版特效流程，仅加判空）=====================
function C7L takes nothing returns nothing
    local location targetLoc
    local rect r
    local rect rSmall
    local location randomLoc
    local location m1Loc
    local location m2Loc
    local effect fx

    set BCb[1] = GetTriggerUnit()
    set BCb[2] = GetSpellTargetUnit()

    // 目标无效直接终止
    if BCb[2] == null then
        set BCb[1] = null
        return
    endif

    call PauseUnitBJ(true, BCb[2])
    call UnitAddAbilityBJ('Amrf', BCb[2])
    call UnitRemoveAbilityBJ('Amrf', BCb[2])

    // 第一阶段特效（完全原版逻辑，仅加特效判空）
    set targetLoc = GetUnitLoc(BCb[2])
    set r = RectFromCenterSizeBJ(targetLoc, 500., 500.)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set randomLoc = GetRandomLocInRect(r)
        set fx = AddSpecialEffectLoc("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", randomLoc)
        // 仅增加判空，不改动任何特效逻辑
        if fx != null then
            call DestroyEffect(fx)
            set fx = null
        endif
        call RemoveLocation(randomLoc)
        set randomLoc = null
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call RemoveRect(r)
    set r = null

    // 创建旋转马甲（完全原版逻辑）
    set m1Loc = PolarProjectionBJ(targetLoc, 90., 0)
    set m2Loc = PolarProjectionBJ(targetLoc, 90., 180.)
    call CreateNUnitsAtLoc(1, 'h098', GetOwningPlayer(BCb[1]), m1Loc, 180.)
    set BCb[3] = GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h098', GetOwningPlayer(BCb[1]), m2Loc, 0.)
    set BCb[4] = GetLastCreatedUnit()
    call RemoveLocation(m1Loc)
    call RemoveLocation(m2Loc)
    set m1Loc = null
    set m2Loc = null

    // 马甲创建失败兜底
    if BCb[3] == null or BCb[4] == null then
        call PauseUnitBJ(false, BCb[2])
        call SetUnitFlyHeight(BCb[2], GetUnitDefaultFlyHeight(BCb[2]), 0.)
        call RemoveLocation(targetLoc)
        set targetLoc = null
        set BCb[1] = null
        set BCb[2] = null
        set BCb[3] = null
        set BCb[4] = null
        return
    endif

    set BCc[1] = 0.
    call EnableTrigger(BCd)
    call EnableTrigger(DeathTrig)

    call TriggerSleepAction(1.)
    
    // —— 等待后安全校验（不影响特效表现，仅防崩溃）——
    if BCb[1] == null or GetWidgetLife(BCb[1]) < 0.405 or BCb[2] == null or GetWidgetLife(BCb[2]) < 0.405 then
        call DisableTrigger(BCd)
        call DisableTrigger(DeathTrig)
        if BCb[2] != null then
            call PauseUnitBJ(false, BCb[2])
            call SetUnitFlyHeight(BCb[2], GetUnitDefaultFlyHeight(BCb[2]), 0.)
        endif
        if BCb[3] != null then
            call RemoveUnit(BCb[3])
            set BCb[3] = null
        endif
        if BCb[4] != null then
            call RemoveUnit(BCb[4])
            set BCb[4] = null
        endif
        set BCb[1] = null
        set BCb[2] = null
        call RemoveLocation(targetLoc)
        set targetLoc = null
        return
    endif

    call DisableTrigger(BCd)
    call DisableTrigger(DeathTrig)

    // 第二阶段特效（完全原版逻辑，仅加判空）
    set fx = AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", BCb[2], "chest")
    if fx != null then
        call DestroyEffect(fx)
        set fx = null
    endif
    set fx = AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", BCb[2], "overhead")
    if fx != null then
        call DestroyEffect(fx)
        set fx = null
    endif
    call CameraSetEQNoiseForPlayer(GetOwningPlayer(BCb[1]), 17.)

    call TriggerSleepAction(.5)
    
    // —— 二次等待后安全校验 ——
    if BCb[2] != null and GetWidgetLife(BCb[2]) > 0.405 and BCb[1] != null then
        // 原版伤害：智力 × 9，魔法伤害
        call UnitDamageTargetBJ(BCb[1], BCb[2], 9. * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, BCb[1], true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
    endif

    // 恢复飞行高度（完全原版逻辑）
    if BCb[3] != null then
        call SetUnitFlyHeight(BCb[3], 0., 2000.)
    endif
    if BCb[4] != null then
        call SetUnitFlyHeight(BCb[4], 0., 2000.)
    endif
    if BCb[2] != null then
        call SetUnitFlyHeight(BCb[2], GetUnitDefaultFlyHeight(BCb[2]), 2000.)
    endif

    // 第三阶段血腥爆发特效（完全原版逻辑，仅加判空）
    set r = RectFromCenterSizeBJ(targetLoc, 500., 500.)
    set rSmall = RectFromCenterSizeBJ(targetLoc, 180., 180.)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set randomLoc = GetRandomLocInRect(r)
            if BCb[2] != null then
                set fx = AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl", BCb[2], "chest")
                if fx != null then
                    call DestroyEffect(fx)
                    set fx = null
                endif
            endif
            set fx = AddSpecialEffectLoc("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", randomLoc)
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
            call RemoveLocation(randomLoc)
            set randomLoc = null

            set randomLoc = GetRandomLocInRect(r)
            set fx = AddSpecialEffectLoc("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", randomLoc)
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
            call RemoveLocation(randomLoc)
            set randomLoc = null

            // 180范围特效保持原版
            set randomLoc = GetRandomLocInRect(rSmall)
            set fx = AddSpecialEffectLoc("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", randomLoc)
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
            call RemoveLocation(randomLoc)
            set randomLoc = null

        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call RemoveRect(r)
    call RemoveRect(rSmall)
    set r = null
    set rSmall = null
    call RemoveLocation(targetLoc)
    set targetLoc = null

    // 收尾清理（完全原版逻辑）
    if BCb[3] != null then
        call RemoveUnit(BCb[3])
        set BCb[3] = null
    endif
    if BCb[4] != null then
        call RemoveUnit(BCb[4])
        set BCb[4] = null
    endif
    call CameraClearNoiseForPlayer(GetOwningPlayer(BCb[1]))
    if BCb[2] != null then
        call PauseUnitBJ(false, BCb[2])
    endif

    set BCb[1] = null
    set BCb[2] = null
    set fx = null
endfunction

// ===================== 事件注册 =====================
function C7M takes nothing returns nothing
    set BCa = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(BCa, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(BCa, Condition(function C7K))
    call TriggerAddAction(BCa, function C7L)
endfunction

// ===================== 初始化 =====================
function InitTrig_A03D takes nothing returns nothing
    // 防重复初始化，避免句柄泄漏
    if DeathTrig == null then
        set DeathTrig = CreateTrigger()
        call DisableTrigger(DeathTrig)
        call TriggerRegisterAnyUnitEventBJ(DeathTrig, EVENT_PLAYER_UNIT_DEATH)
        call TriggerAddAction(DeathTrig, function DeathCleanUp)
    endif

    if BCd == null then
        call C7P()
    endif

    if BCa == null then
        call C7M()
    endif
endfunction

//庞统
function PolarProjectionX takes real x, real dist, real angle returns real
    return x + dist * Cos(angle * bj_DEGTORAD)
endfunction

function PolarProjectionY takes real y, real dist, real angle returns real
    return y + dist * Sin(angle * bj_DEGTORAD)
endfunction

// ========== 回调工具函数 ==========
function Trig_tlwzzk_Func020A takes nothing returns nothing
    local unit u = GetEnumUnit()
    if u != null then
        call RemoveUnit(u)
    endif
    set u = null
endfunction

function Trig_tlwzzk2_Func014A takes nothing returns nothing
    local destructable d = GetEnumDestructable()
    if d != null then
        call KillDestructable(d)
    endif
    set d = null
endfunction

// 内层200码伤害回调（只打非建筑，系数0.8/1.0/1.2）
function Trig_tlwzzk2_Func015A takes nothing returns nothing
    local unit target = GetEnumUnit()
    local unit caster = udg_SFDW[91]
    local real coefficient
    local integer lvl

    // 极端场景兜底
    if caster == null or target == null then
        set target = null
        set caster = null
        return
    endif
    if GetUnitState(target, UNIT_STATE_LIFE) < 0.405 then
        set target = null
        set caster = null
        return
    endif

    set lvl = GetUnitAbilityLevel(caster, 'A0P1')
    if IsUnitEnemy(target, GetOwningPlayer(caster)) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
        if lvl == 1 then
            set coefficient = 0.8
        elseif lvl == 2 then
            set coefficient = 1.0
        else
            set coefficient = 1.2
        endif
        call UnitDamageTarget(caster, target, coefficient * I2R(GetHeroInt(caster, true)), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
    endif
    set target = null
    set caster = null
endfunction

// 外层350码伤害回调（非建筑系数0.8/1.0/1.2，建筑智力×0.2）
function Trig_tlwzzk2_Func017A takes nothing returns nothing
    local unit target = GetEnumUnit()
    local unit caster = udg_SFDW[91]
    local real damage
    local real coefficient
    local integer lvl

    // 极端场景兜底
    if caster == null or target == null then
        set target = null
        set caster = null
        return
    endif
    if GetUnitState(target, UNIT_STATE_LIFE) < 0.405 then
        set target = null
        set caster = null
        return
    endif

    set lvl = GetUnitAbilityLevel(caster, 'A0P1')
    if IsUnitEnemy(target, GetOwningPlayer(caster)) then
        if lvl == 1 then
            set coefficient = 0.8
        elseif lvl == 2 then
            set coefficient = 1.0
        else
            set coefficient = 1.2
        endif
        if IsUnitType(target, UNIT_TYPE_STRUCTURE) then
            set damage = 0.20 * I2R(GetHeroInt(caster, true))
        else
            set damage = coefficient * I2R(GetHeroInt(caster, true))
        endif
        call UnitDamageTarget(caster, target, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
    endif
    set target = null
    set caster = null
endfunction

// ========== 统一清理函数 ==========
function CleanUpAllEffect takes nothing returns nothing
    // 先停触发器，阻断后续回调
    call DisableTrigger(gg_trg_tlwzzk2)
    call DisableTrigger(DeathCleanTrig)

    // 清理全局特效
    if g_FX1 != null then
        call DestroyEffect(g_FX1)
        set g_FX1 = null
    endif
    if g_FX2 != null then
        call DestroyEffect(g_FX2)
        set g_FX2 = null
    endif

    // 清理中心马甲
    if udg_MB[91] != null then
        call RemoveUnit(udg_MB[91])
        set udg_MB[91] = null
    endif

    // 清理旋转马甲数组
    set udg_KLDW[5001] = null
    set udg_KLDW[5002] = null
    set udg_KLDW[5003] = null

    // 清理马甲单位组
    if udg_Group1[12] != null then
        call ForGroupBJ(udg_Group1[12], function Trig_tlwzzk_Func020A)
        call GroupClear(udg_Group1[12])
    endif

    // 清空施法者引用
    set udg_SFDW[91] = null
endfunction

// 死亡兜底
function CleanUpAll takes nothing returns nothing
    local unit dying = GetTriggerUnit()
    if dying != null and dying == udg_SFDW[91] then
        call CleanUpAllEffect()
    endif
    set dying = null
endfunction

function Trig_tlwzzk_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0P1'
endfunction

function Trig_tlwzzk_Actions takes nothing returns nothing
    local unit caster = GetSpellAbilityUnit()
    local real casterX
    local real casterY
    local real targetX
    local real targetY
    local real face
    local real dx
    local real dy
    local integer i
    local real angle
    local real px
    local real py
    local location tempLoc
    local player owner

    // 施法入口有效性校验
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    // 先清理上一次残留
    call CleanUpAllEffect()

    set owner = GetOwningPlayer(caster)
    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)

    set targetX = GetSpellTargetX()
    set targetY = GetSpellTargetY()
    set dx = targetX - casterX
    set dy = targetY - casterY

    if dx == 0 and dy == 0 then
        set face = GetUnitFacing(caster)
    else
        set face = bj_RADTODEG * Atan2(dy, dx)
    endif

    set udg_JD[91] = face
    set udg_SFDW[91] = caster

    set tempLoc = Location(casterX, casterY)
    call CreateNUnitsAtLoc(1, 'uktn', owner, tempLoc, face)
    call RemoveLocation(tempLoc)
    set tempLoc = null

    // 中心马甲创建失败兜底
    if bj_lastCreatedUnit == null then
        call CleanUpAllEffect()
        set caster = null
        set owner = null
        return
    endif
    set udg_MB[91] = bj_lastCreatedUnit

    set g_FX1 = AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl", udg_MB[91], "origin")
    set g_FX2 = AddSpecialEffectTarget("Abilities\\Spells\\Other\\Tornado\\Tornado_Target.mdl", udg_MB[91], "origin")

    set i = 1
    loop
        exitwhen i > 3
        set angle = 120.00 * I2R(i)
        set px = PolarProjectionX(casterX, 210.00, angle)
        set py = PolarProjectionY(casterY, 210.00, angle)

        set tempLoc = Location(px, py)
        call CreateNUnitsAtLoc(1, 'now4', owner, tempLoc, angle + 180.00)
        call RemoveLocation(tempLoc)
        set tempLoc = null

        // 马甲创建成功才赋值和入组
        if bj_lastCreatedUnit != null then
            set udg_KLDW[5000 + i] = bj_lastCreatedUnit
            call GroupAddUnit(udg_Group1[12], bj_lastCreatedUnit)
            set udg_JD[5000 + i] = angle
        endif

        set i = i + 1
    endloop

    call EnableTrigger(gg_trg_tlwzzk2)
    call EnableTrigger(DeathCleanTrig)

    call TriggerSleepAction(1.00)
    call CleanUpAllEffect()

    set caster = null
    set owner = null
endfunction

// ========== 周期旋转+持续伤害 ==========
function Trig_tlwzzk2_Actions takes nothing returns nothing
    local effect fx
    local real centerX
    local real centerY
    local real face
    local integer i
    local real angle
    local real px
    local real py
    local location centerLoc
    local location spawnLoc
    local unit missile
    local player owner

    if udg_MB[91] == null or udg_SFDW[91] == null or GetUnitState(udg_MB[91], UNIT_STATE_LIFE) < 0.405 then
        call CleanUpAllEffect()
        return
    endif

    set owner = GetOwningPlayer(udg_MB[91])
    set centerX = GetUnitX(udg_MB[91])
    set centerY = GetUnitY(udg_MB[91])
    set face = udg_JD[91]

    set i = 1
    loop
        exitwhen i > 3
        // 马甲已销毁则跳过
        if udg_KLDW[5000 + i] != null and IsUnitAliveBJ(udg_KLDW[5000 + i]) then
            set angle = udg_JD[5000 + i] + 25.00
            set udg_JD[5000 + i] = angle

            set px = PolarProjectionX(centerX, 210.00, angle)
            set py = PolarProjectionY(centerY, 210.00, angle)

            call SetUnitX(udg_KLDW[5000 + i], px)
            call SetUnitY(udg_KLDW[5000 + i], py)
            call SetUnitFacing(udg_KLDW[5000 + i], angle + 180.00)

            // 直接使用坐标API创建特效，移除冗余Location
            set fx = AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", px, py)
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
        endif

        set i = i + 1
    endloop

    // 中心马甲向前位移
    set centerX = PolarProjectionX(centerX, 50.00, face)
    set centerY = PolarProjectionY(centerY, 50.00, face)
    call SetUnitX(udg_MB[91], centerX)
    call SetUnitY(udg_MB[91], centerY)
    call SetUnitFacing(udg_MB[91], face)

    // 生成随机飞弹
    set px = centerX + GetRandomReal(-100.00, 100.00)
    set py = centerY + GetRandomReal(-100.00, 100.00)
    set spawnLoc = Location(px, py)
    call CreateNUnitsAtLoc(1, 'now5', owner, spawnLoc, GetRandomReal(0, 360))
    call RemoveLocation(spawnLoc)
    set spawnLoc = null

    set missile = bj_lastCreatedUnit
    if missile != null then
        call SetUnitVertexColorBJ(missile, 100, 100, 100, 25.00)
        call SetUnitFlyHeight(missile, GetRandomReal(20.00, 160.00), 100.00)

        set px = PolarProjectionX(GetUnitX(missile), 400.00, GetUnitFacing(missile))
        set py = PolarProjectionY(GetUnitY(missile), 400.00, GetUnitFacing(missile))
        call IssuePointOrder(missile, "move", px, py)
        call UnitApplyTimedLifeBJ(2.50, 'BTLF', missile)
    endif
    set missile = null

    // 范围破坏物 + 范围伤害
    set centerLoc = Location(centerX, centerY)

    set bj_wantDestroyGroup = true
    call EnumDestructablesInCircleBJ(200.00, centerLoc, function Trig_tlwzzk2_Func014A)

    set bj_wantDestroyGroup = true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(200.00, centerLoc), function Trig_tlwzzk2_Func015A)

    set bj_wantDestroyGroup = true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(350.00, centerLoc), function Trig_tlwzzk2_Func017A)

    call RemoveLocation(centerLoc)
    set centerLoc = null
    set owner = null
endfunction

// ========== 初始化函数 ==========
function InitTrig_A05A takes nothing returns nothing
    if udg_Group1[12] == null then
        set udg_Group1[12] = CreateGroup()
    endif

    // 周期触发器防重复创建
    if gg_trg_tlwzzk2 == null then
        set gg_trg_tlwzzk2 = CreateTrigger()
        call DisableTrigger(gg_trg_tlwzzk2)
        call TriggerRegisterTimerEventPeriodic(gg_trg_tlwzzk2, 0.04)
        call TriggerAddAction(gg_trg_tlwzzk2, function Trig_tlwzzk2_Actions)
    endif

    // 死亡兜底触发器防重复创建
    if DeathCleanTrig == null then
        set DeathCleanTrig = CreateTrigger()
        call DisableTrigger(DeathCleanTrig)
        call TriggerRegisterAnyUnitEventBJ(DeathCleanTrig, EVENT_PLAYER_UNIT_DEATH)
        call TriggerAddAction(DeathCleanTrig, function CleanUpAll)
    endif
endfunction

function InitTrig_tlwzzk takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_tlwzzk_Conditions))
    call TriggerAddAction(t, function Trig_tlwzzk_Actions)
    set t = null
endfunction
//亢龙有悔
function DelayedDestroyEffect takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local effect e = LoadEffectHandle(udg_SPELL_DATA, tid, 0)
    
    if e != null then
        call DestroyEffect(e)
    endif
    call PauseTimer(t)
    call FlushChildHashtable(udg_SPELL_DATA, tid)
    call DestroyTimer(t)
    
    set t = null
    set e = null
endfunction

function TimerDestroyEffect takes effect e, real duration returns nothing
    local timer t
    if e == null then
        return
    endif
    set t = CreateTimer()
    call SaveEffectHandle(udg_SPELL_DATA, GetHandleId(t), 0, e)
    call TimerStart(t, duration, false, function DelayedDestroyEffect)
    set t = null
endfunction

//===========================================================================
// 工具：判断是否为商店单位
//===========================================================================
function IsShopUnit_SSW takes unit u returns boolean
    local integer uid
    if u == null then
        return false
    endif
    set uid = GetUnitTypeId(u)
    if uid == 'n001' then
        return true
    endif
    if uid == 'n002' then
        return true
    endif
    return false
endfunction

// ==============================================
// 工具函数：强制重置英雄技能状态
// ==============================================
function ResetSpellState takes unit caster returns nothing
    local integer cid
    local unit markA
    local unit markB
    
    if caster == null then
        return
    endif
    
    set cid = GetHandleId(caster)
    set markA = LoadUnitHandle(udg_UNIT_FLAGS, cid, 100)
    set markB = LoadUnitHandle(udg_UNIT_FLAGS, cid, 101)
    
    if markA != null then
        call KillUnit(markA)
    endif
    if markB != null then
        call KillUnit(markB)
    endif
    
    call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 100)
    call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 101)
    
    call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0xD23EDB27)
    call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0xAF2823C1)
    call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0x3258B66A)
    call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0xDD926647)
    
    call PauseUnit(caster, false)
    call SetUnitTimeScale(caster, 1.00)
    call UnitRemoveAbility(caster, 'A0ZY')
    call SetPlayerAbilityAvailable(GetOwningPlayer(caster), 'A0ZA', true)
    
    set markA = null
    set markB = null
endfunction

// ==============================================
// 工具函数：单个马甲移动 + 范围伤害
// ==============================================
function ProcessMarker takes unit caster, unit marker, real cx, real cy, real baseAngle, boolean showFx returns nothing
    local real mx
    local real my
    local real facing
    local real newMx
    local real newMy
    local real targetA
    local real tarX
    local real tarY
    local real damage
    local group g
    local unit enemy
    local effect e

    if caster == null or marker == null or not IsUnitAliveBJ(marker) then
        return
    endif

    set mx = GetUnitX(marker)
    set my = GetUnitY(marker)
    set facing = GetUnitFacing(marker) * bj_DEGTORAD
    set newMx = mx + 30.00 * Cos(facing)
    set newMy = my + 30.00 * Sin(facing)
    set targetA = baseAngle * bj_DEGTORAD
    set tarX = cx + 420.00 * Cos(targetA)
    set tarY = cy + 420.00 * Sin(targetA)
    set damage = 0.4 * I2R(GetHeroAgi(caster, true))
    set g = CreateGroup()

    call SetUnitPosition(marker, newMx, newMy)
    call SetUnitFacing(marker, bj_RADTODEG * Atan2(tarY - newMy, tarX - newMx))
    
    // 优化：弹道拖尾隔帧创建，位移逻辑不变
    if showFx then
        set e = AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", newMx, newMy)
        if e != null then
            call DestroyEffect(e)
            set e = null
        endif
    endif

    call GroupEnumUnitsInRange(g, newMx, newMy, 200.00, null)
    loop
        set enemy = FirstOfGroup(g)
        exitwhen enemy == null
        call GroupRemoveUnit(g, enemy)
        
        if enemy != null and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, GetOwningPlayer(caster)) and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and not IsShopUnit_SSW(enemy) then
            call UnitDamageTarget(caster, enemy, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
            
            // 优化：命中特效精简为2个核心，保留打击反馈
            set e = AddSpecialEffectTarget("war3mapImported\\hit-blue1.mdx", enemy, "chest")
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif
            set e = AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", enemy, "chest")
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif
        endif
    endloop

    call DestroyGroup(g)
    set g = null
    set enemy = null
    set e = null
endfunction

// ==============================================
// 工具函数：中心向外拉扯敌人
// ==============================================
function PullEnemies takes unit caster, real cx, real cy returns nothing
    local group g = CreateGroup()
    local unit enemy
    local real ex
    local real ey
    local real angle
    local real newX
    local real newY

    call GroupEnumUnitsInRange(g, cx, cy, 390.00, null)
    loop
        set enemy = FirstOfGroup(g)
        exitwhen enemy == null
        call GroupRemoveUnit(g, enemy)
        
        if enemy != null and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, GetOwningPlayer(caster)) and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and not IsShopUnit_SSW(enemy) then
            set ex = GetUnitX(enemy)
            set ey = GetUnitY(enemy)
            set angle = Atan2(ey - cy, ex - cx)
            set newX = ex + 4.00 * Cos(angle)
            set newY = ey + 4.00 * Sin(angle)
            
            call SetUnitPosition(enemy, newX, newY)
        endif
    endloop

    call DestroyGroup(g)
    set g = null
    set enemy = null
endfunction

function GetSpiralMaxStage takes unit caster returns integer
    if GetUnitTypeId(caster) == 'Z00Y' then
        return 400
    endif
    return 250
endfunction

// ==============================================
// 工具函数：完整清理技能所有资源
// ==============================================
function CleanupSpell takes timer t returns nothing
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_SPELL_DATA, tid, 1)
    local unit markA = LoadUnitHandle(udg_SPELL_DATA, tid, 2)
    local unit markB = LoadUnitHandle(udg_SPELL_DATA, tid, 3)
    local player p
    local integer cid

    call PauseTimer(t)
    
    if caster != null then
        set p = GetOwningPlayer(caster)
        set cid = GetHandleId(caster)
        call SetPlayerAbilityAvailable(p, 'A0ZA', true)
        call UnitRemoveAbility(caster, 'A0ZY')
        call PauseUnit(caster, false)
        
        // 先判断再移除，修正逻辑顺序
        if LoadInteger(udg_UNIT_FLAGS, cid, 0x3258B66A) == 0 then
            call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 100)
            call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 101)
            
            if markA != null then
                call KillUnit(markA)
            endif
            if markB != null then
                call KillUnit(markB)
            endif
        endif
        
        call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0xD23EDB27)
        call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0xAF2823C1)
        call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0x3258B66A)
        call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0xDD926647)
    endif

    call FlushChildHashtable(udg_SPELL_DATA, tid)
    call DestroyTimer(t)

    set caster = null
    set markA = null
    set markB = null
    set p = null
endfunction

// ==============================================
// 主循环计时器回调
// ==============================================
function MainTimerCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_SPELL_DATA, tid, 1)
    local integer stage = LoadInteger(udg_SPELL_DATA, tid, 4)
    local integer angleIdx = LoadInteger(udg_SPELL_DATA, tid, 5)
    local real cx = LoadReal(udg_SPELL_DATA, tid, 6)
    local real cy = LoadReal(udg_SPELL_DATA, tid, 7)
    local unit markA = LoadUnitHandle(udg_SPELL_DATA, tid, 2)
    local unit markB = LoadUnitHandle(udg_SPELL_DATA, tid, 3)
    local player owner
    local unit eff
    local group g
    local unit enemy
    local real angleA
    local real angleB
    local integer cid
    local effect e
    local boolean showFx

    if caster == null or not IsUnitAliveBJ(caster) then
        call CleanupSpell(t)
        
        set t = null
        set caster = null
        set markA = null
        set markB = null
        set owner = null
        set eff = null
        set g = null
        set enemy = null
        set e = null
        return
    endif
    
    set owner = GetOwningPlayer(caster)
    set cid = GetHandleId(caster)
    // 优化：隔帧显示特效，用stage奇偶判断，位移逻辑全程执行
    set showFx = (ModuloInteger(stage, 2) == 0)
    
    if stage >= GetSpiralMaxStage(caster) or LoadInteger(udg_UNIT_FLAGS, cid, 0xDD926647) == 1 then
        call CleanupSpell(t)
        
        set t = null
        set caster = null
        set markA = null
        set markB = null
        set owner = null
        set eff = null
        set g = null
        set enemy = null
        set e = null
        return
    endif

    // 阶段6：第一波多层特效（完全保留，不做精简）
    if stage == 6 then
        set eff = CreateUnit(owner, 'e09Z', cx, cy, GetRandomReal(0, 360))
        if eff != null then
            set e = AddSpecialEffectTarget("war3mapImported\\ssw1.mdx", eff, "origin")
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif
            call SetUnitScale(eff, 0.80, 0.80, 0.80)
            call SetUnitAnimationByIndex(eff, 0)
            call KillUnit(eff)
        endif

        set eff = CreateUnit(owner, 'e09Z', cx, cy, GetRandomReal(0, 360))
        if eff != null then
            call UnitApplyTimedLife(eff, 'BHwe', 0.30)
            call SetUnitScale(eff, 1.20, 1.20, 1.20)
            call SetUnitAnimationByIndex(eff, 0)
            set e = AddSpecialEffectTarget("war3mapImported\\[Effect]135.mdx", eff, "origin")
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif
            call TimerDestroyEffect(AddSpecialEffectTarget("war3mapImported\\e487.mdx", eff, "origin"), 1.50)
        endif

        set eff = CreateUnit(owner, 'e06P', cx, cy, GetRandomReal(0, 360))
        if eff != null then
            call SetUnitVertexColor(eff, 255, 255, 255, 100)
            call SetUnitScale(eff, 2.00, 2.00, 2.00)
            call KillUnit(eff)
        endif

        set eff = CreateUnit(owner, 'e09Z', cx, cy, GetRandomReal(0, 360))
        if eff != null then
            call UnitApplyTimedLife(eff, 'BHwe', 0.20)
            call SetUnitFlyHeight(eff, 120.00, 0.00)
            call SetUnitVertexColor(eff, 0, 188, 255, 200)
            call SetUnitScale(eff, 3.20, 3.20, 3.20)
            call SetUnitAnimationByIndex(eff, 0)
            call TimerDestroyEffect(AddSpecialEffectTarget("war3mapImported\\arcanepowerstatechest.mdx", eff, "origin"), 1.50)
        endif
        
        set eff = null
        set e = null
    endif

    // 阶段12：白光爆发（完全保留）
    if stage == 12 then
        set eff = CreateUnit(owner, 'e06P', cx, cy, GetRandomReal(0, 360))
        if eff != null then
            call SetUnitVertexColor(eff, 255, 255, 255, 100)
            call SetUnitScale(eff, 2.50, 2.40, 2.40)
            call KillUnit(eff)
        endif
        set eff = null
    endif

    // 阶段16：技能高潮爆发（完全保留，不做精简）
    if stage == 16 then
        set e = AddSpecialEffect("war3mapImported\\explosion.mdx", cx, cy)
        if e != null then
            call DestroyEffect(e)
            set e = null
        endif

        set eff = CreateUnit(owner, 'e09Z', cx, cy, GetRandomReal(0, 360))
        if eff != null then
            call UnitApplyTimedLife(eff, 'BHwe', 0.30)
            call SetUnitScale(eff, 0.80, 0.80, 0.80)
            call SetUnitAnimationByIndex(eff, 0)
            set e = AddSpecialEffectTarget("war3mapImported\\frozenhowleff.mdx", eff, "origin")
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif
        endif

        set markA = CreateUnit(owner, 'e05P', cx + 10.00, cy, 0.00)
        set markB = CreateUnit(owner, 'e05P', cx - 10.00, cy, 270.00)
        if markA != null then
            call SetUnitTimeScale(markA, 0.00)
        endif
        if markB != null then
            call SetUnitTimeScale(markB, 0.00)
        endif
        
        call SaveUnitHandle(udg_SPELL_DATA, tid, 2, markA)
        call SaveUnitHandle(udg_SPELL_DATA, tid, 3, markB)
        call SaveUnitHandle(udg_UNIT_FLAGS, cid, 100, markA)
        call SaveUnitHandle(udg_UNIT_FLAGS, cid, 101, markB)

        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, cx, cy, 400.00, null)
        loop
            set enemy = FirstOfGroup(g)
            exitwhen enemy == null
            call GroupRemoveUnit(g, enemy)
            if enemy != null and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, owner) and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and not IsShopUnit_SSW(enemy) then
                call UnitDamageTarget(caster, enemy, 3.00 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                set e = AddSpecialEffectTarget("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl", enemy, "chest")
                if e != null then
                    call DestroyEffect(e)
                    set e = null
                endif
                set e = AddSpecialEffectTarget("Abilities\\Spells\\Orc\\LightningBolt\\LightningBoltMissile.mdl", enemy, "chest")
                if e != null then
                    call DestroyEffect(e)
                    set e = null
                endif
            endif
        endloop
        call DestroyGroup(g)
        set g = null
        set enemy = null

        call SetPlayerAbilityAvailable(owner, 'A0ZA', false)
        call UnitAddAbility(caster, 'A0ZY')
        call PauseUnit(caster, false)
        
        set e = null
    endif

    // 阶段>16：持续旋转伤害 + 拉扯（位移逻辑全帧，特效隔帧）
    if stage > 16 then
        set cx = GetUnitX(caster)
        set cy = GetUnitY(caster)

        set angleA = 30.00 + (5.00 * I2R(angleIdx))
        set angleB = 210.00 + (5.00 * I2R(angleIdx))

        if markA != null and IsUnitAliveBJ(markA) and LoadInteger(udg_UNIT_FLAGS, cid, 0xD23EDB27) == 0 then
            call ProcessMarker(caster, markA, cx, cy, angleA, showFx)
        endif
        if markB != null and IsUnitAliveBJ(markB) and LoadInteger(udg_UNIT_FLAGS, cid, 0xAF2823C1) == 0 then
            call ProcessMarker(caster, markB, cx, cy, angleB, showFx)
        endif

        if LoadInteger(udg_UNIT_FLAGS, cid, 0x3258B66A) == 0 then
            call PullEnemies(caster, cx, cy)
        endif

        set angleIdx = angleIdx + 1
        call SaveInteger(udg_SPELL_DATA, tid, 5, angleIdx)
    endif

    // 阶段计数自增
    if LoadInteger(udg_UNIT_FLAGS, cid, 0x3258B66A) == 0 then
        set stage = stage + 1
        call SaveInteger(udg_SPELL_DATA, tid, 4, stage)
    endif

    set t = null
    set caster = null
    set markA = null
    set markB = null
    set owner = null
    set eff = null
    set g = null
    set enemy = null
    set e = null
endfunction

// ==============================================
// 技能触发条件
// ==============================================
function Trig_ssw_fConditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ZA'
endfunction

// ==============================================
// 技能施法动作
// ==============================================
function Trig_ssw_fActions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player owner
    local real cx
    local real cy
    local timer mainTimer
    local unit startEff

    // 施法入口有效性校验
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    call ResetSpellState(caster)

    set owner = GetOwningPlayer(caster)
    set cx = GetUnitX(caster)
    set cy = GetUnitY(caster)

    call SetUnitAnimationByIndex(caster, 2)

    set startEff = CreateUnit(owner, 'e09Z', cx, cy, GetRandomReal(0, 360))
    if startEff != null then
        call UnitApplyTimedLife(startEff, 'BHwe', 0.30)
        call SetUnitVertexColor(startEff, 0, 188, 255, 255)
        call SetUnitScale(startEff, 1.55, 1.55, 1.50)
        call SetUnitAnimationByIndex(startEff, 0)
        call TimerDestroyEffect(AddSpecialEffectTarget("war3mapImported\\ssw2.mdx", startEff, "origin"), 2.00)
    endif

    set mainTimer = CreateTimer()
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(mainTimer), 1, caster)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 4, 0)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 5, 0)
    call SaveReal(udg_SPELL_DATA, GetHandleId(mainTimer), 6, cx)
    call SaveReal(udg_SPELL_DATA, GetHandleId(mainTimer), 7, cy)
    call TimerStart(mainTimer, 0.03, true, function MainTimerCallback)

    set caster = null
    set owner = null
    set startEff = null
    set mainTimer = null
endfunction

// ==============================================
// 触发器初始化
// ==============================================
function InitTrig_ssw_f takes nothing returns nothing
    local trigger t
    local integer trigId
    
    if udg_SPELL_DATA == null then
        set udg_SPELL_DATA = InitHashtable()
    endif
    if udg_UNIT_FLAGS == null then
        set udg_UNIT_FLAGS = InitHashtable()
    endif

    set trigId = LoadInteger(udg_SPELL_DATA, 0, 1)
    if trigId != 0 then
        return
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_ssw_fConditions))
    call TriggerAddAction(t, function Trig_ssw_fActions)
    
    call SaveInteger(udg_SPELL_DATA, 0, 1, GetHandleId(t))
    
    set t = null
endfunction

// ==============================================
// 二段技能：主循环计时器回调
// ==============================================
function S2_MainTimerCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_SPELL_DATA, tid, 1)
    local integer stage = LoadInteger(udg_SPELL_DATA, tid, 12)
    local integer idx48 = LoadInteger(udg_SPELL_DATA, tid, 13)
    local integer idx49 = LoadInteger(udg_SPELL_DATA, tid, 14)
    local integer light48 = LoadInteger(udg_SPELL_DATA, tid, 15)
    local integer light49 = LoadInteger(udg_SPELL_DATA, tid, 16)
    local real tarX = LoadReal(udg_SPELL_DATA, tid, 10)
    local real tarY = LoadReal(udg_SPELL_DATA, tid, 11)
    local unit mark48 = LoadUnitHandle(udg_SPELL_DATA, tid, 2)
    local unit mark49 = LoadUnitHandle(udg_SPELL_DATA, tid, 3)
    local player owner
    local integer cid
    local real mx
    local real my
    local real angle
    local real newX
    local real newY
    local real dist
    local real damage
    local group g
    local unit enemy
    local unit eff
    local real ex
    local real ey
    local real pushX
    local real pushY
    local real randX
    local real randY
    local effect e
    local boolean showTrail

    // 异常终止1：英雄无效
    if caster == null or not IsUnitAliveBJ(caster) then
        call PauseTimer(t)
        call FlushChildHashtable(udg_SPELL_DATA, tid)
        call DestroyTimer(t)
        
        set t = null
        set caster = null
        set mark48 = null
        set mark49 = null
        set owner = null
        set g = null
        set enemy = null
        set eff = null
        set e = null
        return
    endif

    // 异常终止2：超时强制收尾
    if (GetUnitTypeId(caster) == 'Z00Y' and stage >= 400) or (GetUnitTypeId(caster) != 'Z00Y' and stage >= 300) then
        set cid = GetHandleId(caster)
        
        if mark48 != null then
            call KillUnit(mark48)
        endif
        if mark49 != null then
            call KillUnit(mark49)
        endif
        
        call SaveInteger(udg_UNIT_FLAGS, cid, 0xDD926647, 1)
        call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 100)
        call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 101)
        
        call PauseTimer(t)
        call FlushChildHashtable(udg_SPELL_DATA, tid)
        call DestroyTimer(t)
        
        set t = null
        set caster = null
        set mark48 = null
        set mark49 = null
        set owner = null
        set g = null
        set enemy = null
        set eff = null
        set e = null
        return
    endif

    // 异常终止3：双马甲都死亡
    if (not IsUnitAliveBJ(mark48)) and (not IsUnitAliveBJ(mark49)) then
        set cid = GetHandleId(caster)
        call SaveInteger(udg_UNIT_FLAGS, cid, 0xDD926647, 1)
        call RemoveSavedInteger(udg_UNIT_FLAGS, cid, 0x3258B66A)
        call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 100)
        call RemoveSavedHandle(udg_UNIT_FLAGS, cid, 101)
        call PauseUnit(caster, false)
        call SetUnitTimeScale(caster, 1.00)
        
        call PauseTimer(t)
        call FlushChildHashtable(udg_SPELL_DATA, tid)
        call DestroyTimer(t)
        
        set t = null
        set caster = null
        set mark48 = null
        set mark49 = null
        set owner = null
        set g = null
        set enemy = null
        set eff = null
        set e = null
        return
    endif

    set stage = stage + 1
    call SaveInteger(udg_SPELL_DATA, tid, 12, stage)

    set owner = GetOwningPlayer(caster)
    set cid = GetHandleId(caster)
    set damage = 5.00 * I2R(GetHeroAgi(caster, true))
    // 优化：拖尾隔帧创建，位移逻辑全帧
    set showTrail = (ModuloInteger(stage, 2) == 0)

    if stage == 6 then
        call SetUnitTimeScale(caster, 1.00)
    endif

    if stage == 8 then
        call SaveInteger(udg_UNIT_FLAGS, cid, 0xD23EDB27, 1)
        if mark48 != null then
            call SetUnitFacing(mark48, GetUnitFacing(mark48) - 45.00)
        endif
    endif

    // 马甲48飞行逻辑（位移全帧，拖尾隔帧）
    if stage > 8 and IsUnitAliveBJ(mark48) then
        set mx = GetUnitX(mark48)
        set my = GetUnitY(mark48)
        set dist = SquareRoot((tarX - mx) * (tarX - mx) + (tarY - my) * (tarY - my))

        if dist <= 50.00 then
            set eff = CreateUnit(owner, 'e09Z', mx, my, GetRandomReal(0, 360))
            if eff != null then
                call SetUnitScale(eff, 3.00, 3.00, 3.00)
                call SetUnitBlendTime(eff, 0.00)
                call SetUnitAnimationByIndex(eff, 0)
                call KillUnit(eff)
                set e = AddSpecialEffectTarget("war3mapImported\\skyneutralbuildingexplosion.mdx", eff, "origin")
                if e != null then
                    call DestroyEffect(e)
                    set e = null
                endif
            endif
            set e = AddSpecialEffect("war3mapImported\\e407.mdx", mx, my)
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif

            set g = CreateGroup()
            call GroupEnumUnitsInRange(g, mx, my, 390.00, null)
            loop
                set enemy = FirstOfGroup(g)
                exitwhen enemy == null
                call GroupRemoveUnit(g, enemy)
                if enemy != null and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, owner) and not IsShopUnit_SSW(enemy) then
                    call UnitDamageTarget(caster, enemy, damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                endif
            endloop
            call DestroyGroup(g)
            call KillUnit(mark48)
        else
            if idx48 == 5 then
                set angle = Atan2(tarY - my, tarX - mx)
                set idx48 = 0
            else
                set idx48 = idx48 + 1
                set angle = GetUnitFacing(mark48) * bj_DEGTORAD
            endif
            set newX = mx + 40.00 * Cos(angle)
            set newY = my + 40.00 * Sin(angle)

            // 沿途敌人击退 + 命中特效（伤害全帧，特效保留核心）
            set g = CreateGroup()
            call GroupEnumUnitsInRange(g, newX, newY, 200.00, null)
            loop
                set enemy = FirstOfGroup(g)
                exitwhen enemy == null
                call GroupRemoveUnit(g, enemy)
                if enemy != null and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, owner) and not IsShopUnit_SSW(enemy) then
                    set ex = GetUnitX(enemy)
                    set ey = GetUnitY(enemy)
                    set pushX = newX + 5.00 * Cos(angle)
                    set pushY = newY + 5.00 * Sin(angle)
                    call SetUnitPosition(enemy, pushX, pushY)
                    set e = AddSpecialEffectTarget("war3mapImported\\e556.mdx", enemy, "chest")
                    if e != null then
                        call DestroyEffect(e)
                        set e = null
                    endif
                endif
            endloop
            call DestroyGroup(g)

            // 随机闪电特效（完全保留原频率）
            if light48 == 1 then
                set randX = newX + GetRandomReal(-100.00, 100.00)
                set randY = newY + GetRandomReal(-100.00, 100.00)
                set eff = CreateUnit(owner, 'e0A0', randX, randY, GetRandomReal(0, 360))
                if eff != null then
                    call SetUnitScale(eff, 0.70, 0.70, 0.70)
                    call SetUnitTimeScale(eff, 1.50)
                    call SetUnitAnimationByIndex(eff, 0)
                    call KillUnit(eff)
                endif
                call TimerDestroyEffect(AddSpecialEffect("war3mapImported\\Lightnings.mdx", randX, randY), 0.30)
                set e = AddSpecialEffect("war3mapImported\\e402.mdx", randX, randY)
                if e != null then
                    call DestroyEffect(e)
                    set e = null
                endif
                set light48 = 0
            else
                set light48 = light48 + 1
            endif

            // 更新马甲位置 + 隔帧创建拖尾（生命周期微调至0.12s，保证连贯无断档）
            call SetUnitPosition(mark48, newX, newY)
            call SetUnitFacing(mark48, bj_RADTODEG * Atan2(tarY - newY, tarX - newX))
            if showTrail then
                set eff = CreateUnit(owner, 'e05Y', newX, newY, GetUnitFacing(mark48) - 180.00)
                if eff != null then
                    call SetUnitTimeScale(eff, 1.80)
                    call UnitApplyTimedLife(eff, 'BHwe', 0.12)
                endif
            endif
        endif

        call SaveInteger(udg_SPELL_DATA, tid, 13, idx48)
        call SaveInteger(udg_SPELL_DATA, tid, 15, light48)
    endif

    // 马甲49飞行逻辑（位移全帧，拖尾隔帧）
    if stage == 16 then
        call SaveInteger(udg_UNIT_FLAGS, cid, 0xAF2823C1, 1)
        if mark49 != null then
            call SetUnitFacing(mark49, GetUnitFacing(mark49) + 60.00)
        endif
    endif

    if stage > 16 and IsUnitAliveBJ(mark49) then
        set mx = GetUnitX(mark49)
        set my = GetUnitY(mark49)
        set dist = SquareRoot((tarX - mx) * (tarX - mx) + (tarY - my) * (tarY - my))

        if dist <= 50.00 then
            set eff = CreateUnit(owner, 'e09Z', mx, my, GetRandomReal(0, 360))
            if eff != null then
                call SetUnitScale(eff, 3.00, 3.00, 3.00)
                call SetUnitBlendTime(eff, 0.00)
                call SetUnitAnimationByIndex(eff, 0)
                call KillUnit(eff)
                set e = AddSpecialEffectTarget("war3mapImported\\skyneutralbuildingexplosion.mdx", eff, "origin")
                if e != null then
                    call DestroyEffect(e)
                    set e = null
                endif
            endif
            set e = AddSpecialEffect("war3mapImported\\e407.mdx", mx, my)
            if e != null then
                call DestroyEffect(e)
                set e = null
            endif

            set g = CreateGroup()
            call GroupEnumUnitsInRange(g, mx, my, 390.00, null)
            loop
                set enemy = FirstOfGroup(g)
                exitwhen enemy == null
                call GroupRemoveUnit(g, enemy)
                if enemy != null and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, owner) and not IsShopUnit_SSW(enemy) then
                    call UnitDamageTarget(caster, enemy, damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                endif
            endloop
            call DestroyGroup(g)
            call KillUnit(mark49)
        else
            if idx49 == 10 then
                set angle = Atan2(tarY - my, tarX - mx)
                set idx49 = 0
            else
                set idx49 = idx49 + 1
                set angle = GetUnitFacing(mark49) * bj_DEGTORAD
            endif
            set newX = mx + 40.00 * Cos(angle)
            set newY = my + 40.00 * Sin(angle)

            // 沿途敌人击退 + 特效
            set g = CreateGroup()
            call GroupEnumUnitsInRange(g, newX, newY, 200.00, null)
            loop
                set enemy = FirstOfGroup(g)
                exitwhen enemy == null
                call GroupRemoveUnit(g, enemy)
                if enemy != null and not IsUnitType(enemy, UNIT_TYPE_STRUCTURE) and not IsUnitType(enemy, UNIT_TYPE_ANCIENT) and IsUnitAliveBJ(enemy) and IsUnitEnemy(enemy, owner) and not IsShopUnit_SSW(enemy) then
                    set ex = GetUnitX(enemy)
                    set ey = GetUnitY(enemy)
                    set pushX = newX + 5.00 * Cos(angle)
                    set pushY = newY + 5.00 * Sin(angle)
                    call SetUnitPosition(enemy, pushX, pushY)
                    set e = AddSpecialEffectTarget("war3mapImported\\e556.mdx", enemy, "chest")
                    if e != null then
                        call DestroyEffect(e)
                        set e = null
                    endif
                endif
            endloop
            call DestroyGroup(g)

            // 随机闪电特效
            if light49 == 1 then
                set randX = newX + GetRandomReal(-100.00, 100.00)
                set randY = newY + GetRandomReal(-100.00, 100.00)
                set eff = CreateUnit(owner, 'e0A0', randX, randY, GetRandomReal(0, 360))
                if eff != null then
                    call SetUnitScale(eff, 0.70, 0.70, 0.70)
                    call SetUnitTimeScale(eff, 1.50)
                    call SetUnitAnimationByIndex(eff, 0)
                    call KillUnit(eff)
                endif
                call TimerDestroyEffect(AddSpecialEffect("war3mapImported\\Lightnings.mdx", randX, randY), 0.30)
                set e = AddSpecialEffect("war3mapImported\\e402.mdx", randX, randY)
                if e != null then
                    call DestroyEffect(e)
                    set e = null
                endif
                set light49 = 0
            else
                set light49 = light49 + 1
            endif

            // 更新马甲位置 + 隔帧拖尾
            call SetUnitPosition(mark49, newX, newY)
            call SetUnitFacing(mark49, bj_RADTODEG * Atan2(tarY - newY, tarX - newX))
            if showTrail then
                set eff = CreateUnit(owner, 'e05Y', newX, newY, GetUnitFacing(mark49) - 180.00)
                if eff != null then
                    call SetUnitTimeScale(eff, 1.80)
                    call UnitApplyTimedLife(eff, 'BHwe', 0.12)
                endif
            endif
        endif

        call SaveInteger(udg_SPELL_DATA, tid, 14, idx49)
        call SaveInteger(udg_SPELL_DATA, tid, 16, light49)
    endif

    set t = null
    set caster = null
    set mark48 = null
    set mark49 = null
    set owner = null
    set eff = null
    set g = null
    set enemy = null
    set e = null
endfunction

// ==============================================
// 二段技能：延迟启动回调
// ==============================================
function S2_DelayStart takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_SPELL_DATA, tid, 1)
    local integer idx48 = LoadInteger(udg_SPELL_DATA, tid, 13)
    local integer idx49 = LoadInteger(udg_SPELL_DATA, tid, 14)
    local integer light48 = LoadInteger(udg_SPELL_DATA, tid, 15)
    local integer light49 = LoadInteger(udg_SPELL_DATA, tid, 16)
    local real tarX = LoadReal(udg_SPELL_DATA, tid, 10)
    local real tarY = LoadReal(udg_SPELL_DATA, tid, 11)
    local unit markA = LoadUnitHandle(udg_SPELL_DATA, tid, 2)
    local unit markB = LoadUnitHandle(udg_SPELL_DATA, tid, 3)
    local timer mainTimer

    call PauseTimer(t)

    if caster == null then
        call FlushChildHashtable(udg_SPELL_DATA, tid)
        call DestroyTimer(t)
        
        set t = null
        set caster = null
        set markA = null
        set markB = null
        set mainTimer = null
        return
    endif

    call SetUnitTimeScale(caster, 1.50)
    call SetUnitAnimationByIndex(caster, 2)

    set mainTimer = CreateTimer()
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(mainTimer), 1, caster)
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(mainTimer), 2, markA)
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(mainTimer), 3, markB)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 12, 0)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 13, idx48)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 14, idx49)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 15, light48)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(mainTimer), 16, light49)
    call SaveReal(udg_SPELL_DATA, GetHandleId(mainTimer), 10, tarX)
    call SaveReal(udg_SPELL_DATA, GetHandleId(mainTimer), 11, tarY)
    call TimerStart(mainTimer, 0.03, true, function S2_MainTimerCallback)

    call FlushChildHashtable(udg_SPELL_DATA, tid)
    call DestroyTimer(t)

    set t = null
    set caster = null
    set markA = null
    set markB = null
    set mainTimer = null
endfunction

// ==============================================
// 二段技能：触发条件
// ==============================================
function Trig_ssw_f2Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ZY'
endfunction

// ==============================================
// 二段技能：施法动作
// ==============================================
function Trig_ssw_f2Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player owner
    local integer cid
    local real tarX
    local real tarY
    local unit markA
    local unit markB
    local timer delayTimer

    // 施法入口有效性校验
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set owner = GetOwningPlayer(caster)
    set cid = GetHandleId(caster)
    set tarX = GetSpellTargetX()
    set tarY = GetSpellTargetY()
    set markA = LoadUnitHandle(udg_UNIT_FLAGS, cid, 100)
    set markB = LoadUnitHandle(udg_UNIT_FLAGS, cid, 101)

    call SaveInteger(udg_UNIT_FLAGS, cid, 0x3258B66A, 1)

    set delayTimer = CreateTimer()
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(delayTimer), 1, caster)
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(delayTimer), 2, markA)
    call SaveUnitHandle(udg_SPELL_DATA, GetHandleId(delayTimer), 3, markB)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(delayTimer), 13, 0)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(delayTimer), 14, 0)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(delayTimer), 15, 0)
    call SaveInteger(udg_SPELL_DATA, GetHandleId(delayTimer), 16, 0)
    call SaveReal(udg_SPELL_DATA, GetHandleId(delayTimer), 10, tarX)
    call SaveReal(udg_SPELL_DATA, GetHandleId(delayTimer), 11, tarY)
    call TimerStart(delayTimer, 0.20, false, function S2_DelayStart)

    set caster = null
    set owner = null
    set markA = null
    set markB = null
    set delayTimer = null
endfunction

// ==============================================
// 二段技能：触发器初始化
// ==============================================
function InitTrig_ssw_f2 takes nothing returns nothing
    local trigger t
    local integer trigId

    if udg_SPELL_DATA == null then
        set udg_SPELL_DATA = InitHashtable()
    endif

    set trigId = LoadInteger(udg_SPELL_DATA, 0, 2)
    if trigId != 0 then
        return
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Trig_ssw_f2Conditions))
    call TriggerAddAction(t, function Trig_ssw_f2Actions)
    
    call SaveInteger(udg_SPELL_DATA, 0, 2, GetHandleId(t))
    
    set t = null
endfunction
//夏侯渊
function CheckSkillAndItem takes nothing returns boolean
    return (GetSpellAbilityId() == 'A0ZZ') and (UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I01E'))
endfunction

//===========================================================================
// 停止螺旋效果回调（修复计时器竞态，防止旧回调覆盖新技能状态）
//===========================================================================
function StopSpiralEffect takes nothing returns nothing
    local timer t = GetExpiredTimer()
    
    // 竞态防护：仅当前计时器为全局有效计时器时，才清理全局状态
    // 避免旧计时器延迟回调误清空新创建的计时器
    if t == udg_SpiralStopTimer then
        if udg_SpiralTimerTrigger != null then
            call DisableTrigger(udg_SpiralTimerTrigger)
        endif
        set udg_SpiralCount = 0
        set udg_SpiralCaster = null
        set udg_SpiralStopTimer = null
    endif
    
    call PauseTimer(t)
    call DestroyTimer(t)
    set t = null
endfunction

//===========================================================================
// 启动螺旋效果（规范资源清理顺序，避免竞态）
//===========================================================================
function StartSpiralEffect takes nothing returns nothing
    // 先彻底清理上一轮的停止计时器，避免残留
    if udg_SpiralStopTimer != null then
        call PauseTimer(udg_SpiralStopTimer)
        call DestroyTimer(udg_SpiralStopTimer)
        set udg_SpiralStopTimer = null
    endif
    
    set udg_SpiralCount = 0
    set udg_SpiralCaster = GetTriggerUnit()
    
    if udg_SpiralTimerTrigger != null then
        call EnableTrigger(udg_SpiralTimerTrigger)
    endif
    
    set udg_SpiralStopTimer = CreateTimer()
    call TimerStart(udg_SpiralStopTimer, 1.80, false, function StopSpiralEffect)
endfunction

//===========================================================================
// 生成螺旋导弹（完善异常回收+空单位防护+全变量置空）
//===========================================================================
function SpawnSpiralMissile takes nothing returns nothing
    local unit caster = udg_SpiralCaster
    local player owner
    local real casterX
    local real casterY
    local real angle
    local real targetX
    local real targetY
    local unit missile

    // 异常终止：施法者失效时完整清理所有资源
    if caster == null or GetUnitTypeId(caster) == 0 or not IsUnitAliveBJ(caster) then
        if udg_SpiralTimerTrigger != null then
            call DisableTrigger(udg_SpiralTimerTrigger)
        endif
        set udg_SpiralCount = 0
        set udg_SpiralCaster = null
        
        if udg_SpiralStopTimer != null then
            call PauseTimer(udg_SpiralStopTimer)
            call DestroyTimer(udg_SpiralStopTimer)
            set udg_SpiralStopTimer = null
        endif
        
        set caster = null
        set owner = null
        set missile = null
        return
    endif

    set udg_SpiralCount = udg_SpiralCount + 1
    
    if udg_SpiralCount < 21 then
        set owner = GetOwningPlayer(caster)
        set casterX = GetUnitX(caster)
        set casterY = GetUnitY(caster)
        set angle = udg_SpiralCount * 18.00 * bj_DEGTORAD
        set targetX = casterX + 250.00 * Cos(angle)
        set targetY = casterY + 250.00 * Sin(angle)
        
        set missile = CreateUnit(owner, 'e00Q', casterX, casterY, 0.00)
        // 空单位防护：创建失败时跳过后续操作，避免脚本错误
        if missile != null then
            call UnitApplyTimedLife(missile, 'BHwe', 1.00)
            call IssuePointOrderById(missile, 852218, targetX, targetY)
        endif
    else
        set udg_SpiralCount = 0
    endif

    set caster = null
    set owner = null
    set missile = null
endfunction

//===========================================================================
// 触发器初始化（新增判空，杜绝重复初始化造成的触发器泄漏）
//===========================================================================
function InitTrig_SpiralSkill takes nothing returns nothing
    // 技能触发事件器：仅首次初始化创建，避免重复泄漏
    if udg_SkillEventTrigger == null then
        set udg_SkillEventTrigger = CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(udg_SkillEventTrigger, EVENT_PLAYER_UNIT_SPELL_EFFECT)
        call TriggerAddCondition(udg_SkillEventTrigger, Condition(function CheckSkillAndItem))
        call TriggerAddAction(udg_SkillEventTrigger, function StartSpiralEffect)
    endif

    // 导弹周期生成触发器：仅首次初始化创建
    if udg_SpiralTimerTrigger == null then
        set udg_SpiralTimerTrigger = CreateTrigger()
        call DisableTrigger(udg_SpiralTimerTrigger)
        call TriggerRegisterTimerEventPeriodic(udg_SpiralTimerTrigger, 0.03)
        call TriggerAddAction(udg_SpiralTimerTrigger, function SpawnSpiralMissile)
    endif
endfunction
//修罗

function Trig_jx_fConditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0V1'
endfunction

//===========================================================================
// 工具：眩晕结束回调
//===========================================================================
function Skill_StunEnd takes nothing returns nothing
    local timer t
    local integer id
    local unit target

    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set target = LoadUnitHandle(udg_JxFSkillHash, id, 1)

    if target != null then
        call PauseUnit(target, false)
    endif

    call PauseTimer(t)
    call FlushChildHashtable(udg_JxFSkillHash, id)
    call DestroyTimer(t)

    set t = null
    set target = null
endfunction

//===========================================================================
// 工具：清理技能实例
//===========================================================================
function Skill_CleanupInstance takes integer id returns nothing
    local unit caster
    local group targetGroup
    local unit missile
    local unit u

    set caster = LoadUnitHandle(udg_JxFSkillHash, id, 1)
    set targetGroup = LoadGroupHandle(udg_JxFSkillHash, id, 8)
    set missile = LoadUnitHandle(udg_JxFSkillHash, id, 9)

    if caster != null then
        call SetUnitTimeScale(caster, 1.00)
        call PauseUnit(caster, false)
    endif

    if targetGroup != null then
        loop
            set u = FirstOfGroup(targetGroup)
            exitwhen u == null
            call GroupRemoveUnit(targetGroup, u)
            if u != null then
                call PauseUnit(u, false)
            endif
        endloop
        call DestroyGroup(targetGroup)
    endif

    if missile != null then
        call KillUnit(missile)
    endif

    set caster = null
    set targetGroup = null
    set missile = null
    set u = null
endfunction

//===========================================================================
// 工具：判断是否为商店单位
//===========================================================================
function IsShopUnit takes unit u returns boolean
    local integer uid
    if u == null then
        return false
    endif
    set uid = GetUnitTypeId(u)
    if uid == 'n001' then
        return true
    endif
    if uid == 'n002' then
        return true
    endif
    return false
endfunction

//===========================================================================
// 阶段3：爆发持续循环
//===========================================================================
function Skill_ExplosionLoop takes nothing returns nothing
    local timer t
    local integer id
    local unit caster
    local integer count
    local integer effectTick
    local integer unitId
    local player owner
    local real facing
    local real casterX
    local real casterY
    local real targetX
    local real targetY
    local real uX
    local real uY
    local real dist
    local real ang
    local unit effectUnit
    local group g
    local unit u
    local group targetGroup
    local effect eff

    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set caster = LoadUnitHandle(udg_JxFSkillHash, id, 1)
    set count = LoadInteger(udg_JxFSkillHash, id, 6)
    set count = count + 1
    set effectTick = LoadInteger(udg_JxFSkillHash, id, 10)

    // 异常终止：完整清理
    if caster == null or not IsUnitAliveBJ(caster) or count > 100 then
        call Skill_CleanupInstance(id)
        call PauseTimer(t)
        call FlushChildHashtable(udg_JxFSkillHash, id)
        call DestroyTimer(t)

        set t = null
        set caster = null
        set effectUnit = null
        set g = null
        set u = null
        set targetGroup = null
        set eff = null
        return
    endif

    set owner = GetOwningPlayer(caster)
    set facing = GetUnitFacing(caster)
    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)

    call SaveInteger(udg_JxFSkillHash, id, 6, count)

    if count == 13 then
        call PlaySoundOnUnitBJ(gg_snd_jx_f, 100, caster)
    endif

    if count == 35 then
        set ang = facing * bj_DEGTORAD
        set targetX = casterX + 120.00 * Cos(ang)
        set targetY = casterY + 120.00 * Sin(ang)

        set effectUnit = CreateUnit(owner, 'e0A3', targetX, targetY, facing - 180.00)
        if effectUnit != null then
            call SetUnitScale(effectUnit, 1.00, 1.00, 1.00)
            call SetUnitTimeScale(effectUnit, 1.20)
            call SetUnitFlyHeight(effectUnit, 130.00, 0.00)
            call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
        endif

        set effectUnit = CreateUnit(owner, 'e03H', targetX, targetY, GetRandomDirectionDeg())
        if effectUnit != null then
            call SetUnitTimeScale(effectUnit, 0.80)
            call SetUnitScale(effectUnit, 2.80, 2.80, 2.80)
            call SetUnitVertexColor(effectUnit, 255, 255, 255, 255)
            call SetUnitFlyHeight(effectUnit, 120.00, 0.00)
            call KillUnit(effectUnit)
        endif

        set effectUnit = CreateUnit(owner, 'e09Z', targetX, targetY, facing)
        if effectUnit != null then
            call SetUnitBlendTime(effectUnit, 0.00)
            call SetUnitAnimationByIndex(effectUnit, R2I(40.00 * 0.69))
            set eff = AddSpecialEffectTarget("war3mapImported\\BBB.mdx", effectUnit, "origin")
            if eff != null then
                call DestroyEffect(eff)
                set eff = null
            endif
            call SetUnitScale(effectUnit, 1.20, 1.20, 1.20)
            call SetUnitFlyHeight(effectUnit, 145.00, 0.00)
            call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
        endif

        set effectUnit = CreateUnit(owner, 'e0A4', targetX, targetY, GetRandomDirectionDeg())
        if effectUnit != null then
            call SetUnitTimeScale(effectUnit, 1.20)
            call SetUnitAnimation(effectUnit, "Death")
            call UnitApplyTimedLife(effectUnit, 'BHwe', 0.48)
        endif

        set effectUnit = CreateUnit(owner, 'e09Z', targetX, targetY, facing)
        if effectUnit != null then
            call SetUnitBlendTime(effectUnit, 0.00)
            call SetUnitAnimationByIndex(effectUnit, R2I(140.00 * 0.69))
            set eff = AddSpecialEffectTarget("war3mapImported\\BBB.mdx", effectUnit, "origin")
            if eff != null then
                call DestroyEffect(eff)
                set eff = null
            endif
            call SetUnitScale(effectUnit, 1.20, 1.20, 1.20)
            call SetUnitFlyHeight(effectUnit, 145.00, 0.00)
            call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
        endif

        // 落地特效（已移除地形变形）
        set eff = AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", targetX, targetY)
        if eff != null then
            call DestroyEffect(eff)
            set eff = null
        endif

        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, targetX, targetY, 380.00, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            call GroupRemoveUnit(g, u)
            if u != null and IsUnitAliveBJ(u) and IsUnitEnemy(u, owner) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_ANCIENT) and not IsShopUnit(u) then
                set uX = GetUnitX(u)
                set uY = GetUnitY(u)

                set effectUnit = CreateUnit(owner, 'e07L', uX, uY, GetRandomDirectionDeg())
                if effectUnit != null then
                    call SetUnitScale(effectUnit, 1.30, 1.10, 1.10)
                    call SetUnitFlyHeight(effectUnit, GetUnitFlyHeight(u) + 120.00, 0.00)
                    call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
                endif

                set eff = AddSpecialEffectTarget("war3mapImported\\e556.mdx", u, "chest")
                if eff != null then
                    call DestroyEffect(eff)
                    set eff = null
                endif
                set eff = AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest")
                if eff != null then
                    call DestroyEffect(eff)
                    set eff = null
                endif
                set eff = AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdx", u, "chest")
                if eff != null then
                    call DestroyEffect(eff)
                    set eff = null
                endif

                call UnitDamageTargetBJ(caster, u, I2R(6 * GetHeroStr(caster, true)), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
            endif
        endloop
        call DestroyGroup(g)

        set effectUnit = LoadUnitHandle(udg_JxFSkillHash, id, 9)
        if effectUnit != null then
            call KillUnit(effectUnit)
        endif

        set targetGroup = LoadGroupHandle(udg_JxFSkillHash, id, 8)
        if targetGroup != null then
            call DestroyGroup(targetGroup)
        endif

        call SetUnitTimeScale(caster, 1.00)
        call PauseUnit(caster, false)

        call PauseTimer(t)
        call FlushChildHashtable(udg_JxFSkillHash, id)
        call DestroyTimer(t)
    else
        if count == 28 then
            set unitId = GetUnitTypeId(caster)
            call SetUnitTimeScale(caster, 1.40)
            if unitId == 'H005' then
                call SetUnitAnimation(caster, "Attack - 2")
            elseif unitId == 'N00Q' then
                call SetUnitAnimation(caster, "Attack Slam")
            elseif unitId == 'E01R' then
                call SetUnitAnimation(caster, "Attack - 3")
            elseif unitId == 'O003' or unitId == 'H02L' or unitId == 'N004' then
                call SetUnitAnimation(caster, "Attack Slam")
            else
                call SetUnitAnimation(caster, "spell throw")
            endif
        endif

        if count > 8 then
            set ang = facing * bj_DEGTORAD
            set targetX = casterX + 120.00 * Cos(ang)
            set targetY = casterY + 120.00 * Sin(ang)

            set effectUnit = LoadUnitHandle(udg_JxFSkillHash, id, 9)
            if effectUnit != null then
                call SetUnitX(effectUnit, targetX)
                call SetUnitY(effectUnit, targetY)
            endif

            if effectTick == 2 then
                call SaveInteger(udg_JxFSkillHash, id, 10, 0)
                set effectUnit = CreateUnit(owner, 'e06P', casterX, casterY, GetRandomDirectionDeg())
                if effectUnit != null then
                    call SetUnitTimeScale(effectUnit, 0.70)
                    call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
                endif

                set effectUnit = CreateUnit(owner, 'e03V', targetX, targetY, GetRandomDirectionDeg())
                if effectUnit != null then
                    call SetUnitScale(effectUnit, 1.05, 1.00, 1.00)
                    call SetUnitTimeScale(effectUnit, 1.30)
                    call SetUnitFlyHeight(effectUnit, 0.00, 0.00)
                    call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
                endif
            else
                call SaveInteger(udg_JxFSkillHash, id, 10, effectTick + 1)
            endif

            set g = CreateGroup()
            call GroupEnumUnitsInRange(g, targetX, targetY, 380.00, null)
            loop
                set u = FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)
                if u != null and IsUnitAliveBJ(u) and IsUnitEnemy(u, owner) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_ANCIENT) and not IsShopUnit(u) then
                    set uX = GetUnitX(u)
                    set uY = GetUnitY(u)
                    set dist = SquareRoot((targetX - uX) * (targetX - uX) + (targetY - uY) * (targetY - uY))
                    
                    if dist >= 45.00 then
                        set ang = Atan2(targetY - uY, targetX - uX)
                        call SetUnitX(u, uX + 45.00 * Cos(ang))
                        call SetUnitY(u, uY + 45.00 * Sin(ang))
                    endif
                endif
            endloop
            call DestroyGroup(g)
        else
            if count == 8 then
                set ang = facing * bj_DEGTORAD
                set targetX = casterX + 120.00 * Cos(ang)
                set targetY = casterY + 120.00 * Sin(ang)
                
                set effectUnit = CreateUnit(owner, 'e0A2', casterX, casterY, facing)
                if effectUnit != null then
                    call SetUnitTimeScale(effectUnit, 0.70)
                    call UnitApplyTimedLife(effectUnit, 'BHwe', 2.00)
                    call SaveUnitHandle(udg_JxFSkillHash, id, 9, effectUnit)
                endif
            else
                if count == 4 then
                    set unitId = GetUnitTypeId(caster)
                    call SetUnitTimeScale(caster, 1.30)
                    if unitId == 'H005' then
                        call SetUnitAnimation(caster, "Attack - 2")
                    elseif unitId == 'N00Q' then
                        call SetUnitAnimation(caster, "Attack 2")
                    elseif unitId == 'E01R' then
                        call SetUnitAnimation(caster, "Attack - 3")
                    elseif unitId == 'O003' or unitId == 'H02L' or unitId == 'N004' then
                        call SetUnitAnimation(caster, "Attack 2")
                    else
                        call SetUnitAnimation(caster, "Attack 2")
                    endif
                endif
            endif
        endif
    endif

    set t = null
    set caster = null
    set effectUnit = null
    set g = null
    set u = null
    set targetGroup = null
    set eff = null
endfunction

//===========================================================================
// 阶段2：突进循环
//===========================================================================
function Skill_ChargeLoop takes nothing returns nothing
    local timer t
    local integer id
    local unit caster
    local integer count
    local real remainDist
    local real speed
    local real angle
    local player owner
    local real casterX
    local real casterY
    local real angRad
    local real targetX
    local real targetY
    local real uX
    local real uY
    local real dist
    local unit effectUnit
    local group g
    local unit u
    local timer expTimer
    local integer expId
    local timer stunTimer
    local integer stunId
    local effect eff
    local group targetGroup

    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set caster = LoadUnitHandle(udg_JxFSkillHash, id, 1)
    set count = LoadInteger(udg_JxFSkillHash, id, 6)
    set count = count + 1
    set remainDist = LoadReal(udg_JxFSkillHash, id, 3)
    set speed = LoadReal(udg_JxFSkillHash, id, 5)
    set angle = LoadReal(udg_JxFSkillHash, id, 4)

    // 异常终止：完整清理
    if caster == null or not IsUnitAliveBJ(caster) or count > 200 then
        call Skill_CleanupInstance(id)
        call PauseTimer(t)
        call FlushChildHashtable(udg_JxFSkillHash, id)
        call DestroyTimer(t)

        set t = null
        set caster = null
        set effectUnit = null
        set g = null
        set u = null
        set expTimer = null
        set stunTimer = null
        set eff = null
        set targetGroup = null
        return
    endif

    set owner = GetOwningPlayer(caster)
    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)
    set angRad = angle * bj_DEGTORAD

    call SaveInteger(udg_JxFSkillHash, id, 6, count)

    if count >= 8 then
        if remainDist <= 100.00 then
            set effectUnit = CreateUnit(owner, 'e03V', casterX, casterY, GetRandomDirectionDeg())
            if effectUnit != null then
                call SetUnitScale(effectUnit, 1.40, 1.40, 1.40)
                call SetUnitTimeScale(effectUnit, 1.30)
                call SetUnitVertexColor(effectUnit, 120, 255, 255, 255)
                call SetUnitFlyHeight(effectUnit, 120.00, 0.00)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
            endif

            set effectUnit = CreateUnit(owner, 'e0A1', casterX, casterY, angle)
            if effectUnit != null then
                call SetUnitTimeScale(effectUnit, 1.50)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.30)
            endif

            set effectUnit = CreateUnit(owner, 'e09P', casterX, casterY, angle)
            if effectUnit != null then
                call SetUnitBlendTime(effectUnit, 0.00)
                call SetUnitScale(effectUnit, 0.90, 0.90, 0.90)
                call SetUnitVertexColor(effectUnit, 120, 255, 255, 255)
                call SetUnitFlyHeight(effectUnit, 130.00, 0.00)
                call SetUnitTimeScale(effectUnit, 1.10)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
            endif

            set effectUnit = CreateUnit(owner, 'e05U', casterX, casterY, GetRandomDirectionDeg())
            if effectUnit != null then
                call SetUnitScale(effectUnit, 2.00, 1.00, 1.00)
                call SetUnitTimeScale(effectUnit, 1.50)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
            endif

            set effectUnit = CreateUnit(owner, 'e09X', casterX, casterY, angle)
            if effectUnit != null then
                call SetUnitScale(effectUnit, 0.45, 0.45, 0.45)
                call SetUnitTimeScale(effectUnit, 1.25)
                call SetUnitVertexColor(effectUnit, 120, 255, 255, 255)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
            endif

            call PlaySoundOnUnitBJ(gg_snd_Hit_8, 100, caster)

            set g = CreateGroup()
            call GroupEnumUnitsInRange(g, casterX, casterY, 380.00, null)
            loop
                set u = FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)
                if u != null and IsUnitAliveBJ(u) and IsUnitEnemy(u, owner) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_ANCIENT) and not IsShopUnit(u) then
                    set targetGroup = LoadGroupHandle(udg_JxFSkillHash, id, 8)
                    if targetGroup != null then
                        call GroupAddUnit(targetGroup, u)
                    endif

                    call PauseUnit(u, true)
                    set stunTimer = CreateTimer()
                    set stunId = GetHandleId(stunTimer)
                    call SaveUnitHandle(udg_JxFSkillHash, stunId, 1, u)
                    call TimerStart(stunTimer, 1.00, false, function Skill_StunEnd)

                    set uX = GetUnitX(u)
                    set uY = GetUnitY(u)

                    set effectUnit = CreateUnit(owner, 'e09O', uX, uY, GetRandomDirectionDeg())
                    if effectUnit != null then
                        call SetUnitFlyHeight(effectUnit, GetUnitFlyHeight(u) + 120.00, 0.00)
                        call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
                    endif

                    set effectUnit = CreateUnit(owner, 'e07L', uX, uY, GetRandomDirectionDeg())
                    if effectUnit != null then
                        call SetUnitScale(effectUnit, 1.20, 1.10, 1.10)
                        call SetUnitFlyHeight(effectUnit, GetUnitFlyHeight(u) + 120.00, 0.00)
                        call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
                    endif

                    set eff = AddSpecialEffectTarget("war3mapImported\\e556.mdx", u, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    set eff = AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif
                    set eff = AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdx", u, "chest")
                    if eff != null then
                        call DestroyEffect(eff)
                        set eff = null
                    endif

                    call UnitDamageTargetBJ(caster, u, I2R(5 * GetHeroStr(caster, true)), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
                endif
            endloop
            call DestroyGroup(g)

            set expTimer = CreateTimer()
            set expId = GetHandleId(expTimer)
            call SaveUnitHandle(udg_JxFSkillHash, expId, 1, caster)
            call SaveInteger(udg_JxFSkillHash, expId, 6, count)
            call SaveInteger(udg_JxFSkillHash, expId, 10, 0)
            call SaveGroupHandle(udg_JxFSkillHash, expId, 8, LoadGroupHandle(udg_JxFSkillHash, id, 8))
            call SaveUnitHandle(udg_JxFSkillHash, expId, 9, LoadUnitHandle(udg_JxFSkillHash, id, 9))
            call TimerStart(expTimer, 0.05, true, function Skill_ExplosionLoop)

            call PauseTimer(t)
            call FlushChildHashtable(udg_JxFSkillHash, id)
            call DestroyTimer(t)
        else
            set remainDist = remainDist - speed
            call SaveReal(udg_JxFSkillHash, id, 3, remainDist)

            call SetUnitX(caster, casterX + speed * Cos(angRad))
            call SetUnitY(caster, casterY + speed * Sin(angRad))
        endif
    endif

    set t = null
    set caster = null
    set effectUnit = null
    set g = null
    set u = null
    set expTimer = null
    set stunTimer = null
    set eff = null
    set targetGroup = null
endfunction

//===========================================================================
// 阶段1：启动突进
//===========================================================================
function Skill_ChargeStart takes nothing returns nothing
    local timer t
    local integer id
    local unit caster
    local timer chargeTimer
    local integer chargeId
    local integer unitId

    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set caster = LoadUnitHandle(udg_JxFSkillHash, id, 1)

    if caster == null then
        call PauseTimer(t)
        call FlushChildHashtable(udg_JxFSkillHash, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set chargeTimer = null
        return
    endif

    set unitId = GetUnitTypeId(caster)

    call PauseUnit(caster, true)
    call SetUnitTimeScale(caster, 1.20)
    
    if unitId == 'H005' then
        call SetUnitAnimation(caster, "Attack - 2")
    elseif unitId == 'N00Q' then
        call SetUnitAnimation(caster, "Attack 1")
    elseif unitId == 'E01R' then
        call SetUnitAnimation(caster, "Attack - 3")
    elseif unitId == 'O003' or unitId == 'H02L' or unitId == 'N004' then
        call SetUnitAnimation(caster, "Attack")
    else
        call SetUnitAnimation(caster, "spell")
    endif

    set chargeTimer = CreateTimer()
    set chargeId = GetHandleId(chargeTimer)

    call SaveUnitHandle(udg_JxFSkillHash, chargeId, 1, caster)
    call SaveInteger(udg_JxFSkillHash, chargeId, 6, 0)
    call SaveReal(udg_JxFSkillHash, chargeId, 3, LoadReal(udg_JxFSkillHash, id, 3))
    call SaveReal(udg_JxFSkillHash, chargeId, 4, LoadReal(udg_JxFSkillHash, id, 4))
    call SaveReal(udg_JxFSkillHash, chargeId, 5, 80.00)
    call SaveGroupHandle(udg_JxFSkillHash, chargeId, 8, LoadGroupHandle(udg_JxFSkillHash, id, 8))
    call SaveUnitHandle(udg_JxFSkillHash, chargeId, 9, null)

    call TimerStart(chargeTimer, 0.03, true, function Skill_ChargeLoop)

    call PauseTimer(t)
    call FlushChildHashtable(udg_JxFSkillHash, id)
    call DestroyTimer(t)

    set t = null
    set caster = null
    set chargeTimer = null
endfunction

//===========================================================================
// 技能入口
//===========================================================================
function Trig_jx_fActions takes nothing returns nothing
    local unit caster
    local real casterX
    local real casterY
    local real targetX
    local real targetY
    local real distance
    local real angle
    local group targetGroup
    local timer startTimer
    local integer timerId
    local effect eff

    set caster = GetTriggerUnit()
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)

    set targetX = GetSpellTargetX()
    set targetY = GetSpellTargetY()

    set distance = SquareRoot((targetX - casterX) * (targetX - casterX) + (targetY - casterY) * (targetY - casterY))
    set angle = bj_RADTODEG * Atan2(targetY - casterY, targetX - casterX)
    set targetGroup = CreateGroup()

    call SetUnitFacing(caster, angle)
    call SetUnitTimeScale(caster, 1.80)

    set eff = AddSpecialEffectTarget("war3mapImported\\effect_blightsilence.mdx", caster, "right hand")
    if eff != null then
        call DestroyEffect(eff)
        set eff = null
    endif

    set startTimer = CreateTimer()
    set timerId = GetHandleId(startTimer)
    call SaveUnitHandle(udg_JxFSkillHash, timerId, 1, caster)
    call SaveReal(udg_JxFSkillHash, timerId, 3, distance)
    call SaveReal(udg_JxFSkillHash, timerId, 4, angle)
    call SaveGroupHandle(udg_JxFSkillHash, timerId, 8, targetGroup)
    call TimerStart(startTimer, 0.00, false, function Skill_ChargeStart)

    set caster = null
    set targetGroup = null
    set startTimer = null
    set eff = null
endfunction

//===========================================================================
// 初始化
//===========================================================================
function InitTrig_jx_f takes nothing returns nothing
    if udg_JxFSkillHash == null then
        set udg_JxFSkillHash = InitHashtable()
    endif
    set gg_trg_jx_f = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_jx_f, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_jx_f, Condition(function Trig_jx_fConditions))
    call TriggerAddAction(gg_trg_jx_f, function Trig_jx_fActions)
endfunction
//周泰
function CameraClear1 takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit u = LoadUnitHandle(ght_temp, id, 0xC303079D)
    
    if u != null and GetWidgetLife(u) > 0.405 and GetOwningPlayer(u) != null then
        call CameraClearNoiseForPlayer(GetOwningPlayer(u))
    endif
    
    call PauseTimer(t)
    call FlushChildHashtable(ght_temp, id)
    call DestroyTimer(t)
    set t = null
    set u = null
endfunction

function CameraClear2 takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit u = LoadUnitHandle(ght_temp, id, 0xC303079D)
    
    if u != null and GetWidgetLife(u) > 0.405 and GetOwningPlayer(u) != null then
        call CameraClearNoiseForPlayer(GetOwningPlayer(u))
    endif
    
    call PauseTimer(t)
    call FlushChildHashtable(ght_temp, id)
    call DestroyTimer(t)
    set t = null
    set u = null
endfunction

function AngleBetweenUnits takes unit u1, unit u2 returns real
    local real x1
    local real y1
    local real x2
    local real y2
    if u1 == null or u2 == null then
        return 0.00
    endif
    set x1 = GetUnitX(u1)
    set y1 = GetUnitY(u1)
    set x2 = GetUnitX(u2)
    set y2 = GetUnitY(u2)
    return bj_RADTODEG * Atan2(y2 - y1, x2 - x1)
endfunction

function UnitEnableFly takes unit u returns nothing
    if u != null then
        call UnitAddAbility(u, 'Arav')
        call UnitMakeAbilityPermanent(u, true, 'Arav')
    endif
endfunction

function UnitSlide takes nothing returns nothing
    local timer t
    local integer id
    local unit u
    local real ang
    local real speed
    local integer tick
    local real rad
    
    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set u = LoadUnitHandle(ght_temp, id, 1)
    set tick = LoadInteger(ght_temp, id, 4)
    
    if u == null or not IsUnitAliveBJ(u) or tick <= 0 then
        call PauseTimer(t)
        call FlushChildHashtable(ght_temp, id)
        call DestroyTimer(t)
        set t = null
        set u = null
        return
    endif
    
    set ang = LoadReal(ght_temp, id, 2)
    set speed = LoadReal(ght_temp, id, 3)
    set rad = ang * bj_DEGTORAD
    
    call SetUnitX(u, GetUnitX(u) + speed * Cos(rad))
    call SetUnitY(u, GetUnitY(u) + speed * Sin(rad))
    call SaveInteger(ght_temp, id, 4, tick - 1)
    
    set t = null
    set u = null
endfunction

function StartUnitSlide takes unit u, real angle, real dist, real duration returns nothing
    local timer t
    local integer id
    local integer totalTick
    local real speedPerTick
    
    if u == null then
        return
    endif
    
    set totalTick = R2I(duration / 0.03)
    set speedPerTick = dist / I2R(totalTick)
    set t = CreateTimer()
    set id = GetHandleId(t)
    
    call SaveUnitHandle(ght_temp, id, 1, u)
    call SaveReal(ght_temp, id, 2, angle)
    call SaveReal(ght_temp, id, 3, speedPerTick)
    call SaveInteger(ght_temp, id, 4, totalTick)
    call TimerStart(t, 0.03, true, function UnitSlide)
    
    set t = null
endfunction

function EffectFadeLoop takes nothing returns nothing
    local timer t
    local integer id
    local unit e
    local integer alpha
    local group g
    
    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set e = LoadUnitHandle(ght_temp, id, 0x2B0A6845)
    set alpha = LoadInteger(ght_temp, id, 0xDDBB49B1)
    
    if alpha <= 0 then
        if e != null and GetWidgetLife(e) > 0.405 then
            set g = LoadGroupHandle(ght_temp, id, 0x214C62CC)
            if g != null then
                call GroupRemoveUnit(g, e)
            endif
            call RemoveUnit(e)
        endif
        call PauseTimer(t)
        call FlushChildHashtable(ght_temp, id)
        call DestroyTimer(t)
    else
        set alpha = alpha - 10
        if e != null and GetWidgetLife(e) > 0.405 then
            call SetUnitVertexColor(e, 255, 255, 255, alpha)
        endif
        call SaveInteger(ght_temp, id, 0xDDBB49B1, alpha)
    endif
    
    set t = null
    set e = null
    set g = null
endfunction

function EffectFadeStart takes nothing returns nothing
    local timer t
    local timer fadeTimer
    local integer id
    local integer fadeId
    local unit effectUnit
    
    set t = GetExpiredTimer()
    set id = GetHandleId(t)
    set effectUnit = LoadUnitHandle(ght_temp, id, 0x2B0A6845)
    
    if effectUnit != null and GetWidgetLife(effectUnit) > 0.405 then
        call SetUnitTimeScale(effectUnit, 0.00)
    endif
    
    set fadeTimer = CreateTimer()
    set fadeId = GetHandleId(fadeTimer)
    
    call SaveInteger(ght_temp, fadeId, 0xDDBB49B1, 100)
    call SaveGroupHandle(ght_temp, fadeId, 0x214C62CC, LoadGroupHandle(ght_temp, id, 0x214C62CC))
    call SaveUnitHandle(ght_temp, fadeId, 0x2B0A6845, effectUnit)
    call TimerStart(fadeTimer, 0.03, true, function EffectFadeLoop)
    
    call PauseTimer(t)
    call FlushChildHashtable(ght_temp, id)
    call DestroyTimer(t)
    
    set t = null
    set fadeTimer = null
    set effectUnit = null
endfunction

function GroupExpandEffect takes nothing returns nothing
    local unit u = GetEnumUnit()
    local real x
    local real y
    local real angRad
    local real dist
    
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif
    
    set x = GetUnitX(u)
    set y = GetUnitY(u)
    set angRad = GetUnitFacing(u) * bj_DEGTORAD
    set dist = GetRandomReal(50.00, 55.00)
    
    call SetUnitPosition(u, x + dist * Cos(angRad), y + dist * Sin(angRad))
    
    set u = null
endfunction

function Trig_jx_rConditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0XF'
endfunction

function Trig_jx_rFunc004Func003Func009T takes nothing returns nothing
    local timer ydl_timer
    local integer ydul_i
    local group ydl_group
    local unit ydl_unit
    local integer id
    local unit caster
    local unit target
    local integer count
    local real tarX
    local real tarY
    local real randAng
    local real randDist
    local real offsetX
    local real offsetY
    local real slashAng
    local unit effectUnit
    local group effectGroup
    local effect eff
    
    set id = GetHandleId(GetExpiredTimer())
    set caster = LoadUnitHandle(ght_temp, id, 0xC303079D)
    set target = LoadUnitHandle(ght_temp, id, 0x2D5DEA42)
    
    if caster == null or not IsUnitAliveBJ(caster) or target == null or not IsUnitAliveBJ(target) then
        call PauseTimer(GetExpiredTimer())
        
        set effectGroup = LoadGroupHandle(ght_temp, id, 0x214C62CC)
        if effectGroup != null then
            loop
                set ydl_unit = FirstOfGroup(effectGroup)
                exitwhen ydl_unit == null
                call GroupRemoveUnit(effectGroup, ydl_unit)
                if ydl_unit != null then
                    call RemoveUnit(ydl_unit)
                endif
            endloop
            call DestroyGroup(effectGroup)
        endif
        
        if target != null then
            call GroupRemoveUnit(udg_FlyP2_Group, target)
            call SetUnitFlyHeight(target, 0.00, 0.00)
            call PauseUnit(target, false)
            call UnitRemoveAbility(target, 'Arav')
        endif
        if caster != null then
            call SetUnitFlyHeight(caster, 0.00, 0.00)
            call SetUnitTimeScale(caster, 1.00)
            call PauseUnit(caster, false)
            call UnitRemoveAbility(caster, 'Arav')
        endif
        set udg_m_unit[26] = null
        set udg_m_true[0] = false
        call FlushChildHashtable(ght_temp, id)
