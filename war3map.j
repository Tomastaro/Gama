// 伤害回调
function QBf2 takes nothing returns nothing
    local unit source = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local real targetX
    local real targetY
    local unit dummy
    local effect fx

    // 双端有效性校验
    if source == null or target == null or GetWidgetLife(source) <= 0.405 or GetWidgetLife(target) <= 0.405 then
        set source = null
        set target = null
        return
    endif

    // 用原生技能等级判断替代UnitHasBuffBJ，效率更高
    if GetUnitAbilityLevel(target, 'B05W') > 0 and GetEventDamage() > 1.00 and IsUnitEnemy(target, GetOwningPlayer(source)) then
        call DisableTrigger(Sof2)
        set targetX = GetUnitX(target)
        set targetY = GetUnitY(target)

        // 雷霆一击马甲
        set dummy = CreateUnit(GetOwningPlayer(source), 'e01V', targetX, targetY, bj_UNIT_FACING)
        if dummy != null then
            call SetUnitAbilityLevelSwapped('A0T9', dummy, 4)
            call IssueImmediateOrderBJ(dummy, "thunderclap")
            call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
            set dummy = null
        endif

        // 地面特效
        set fx = AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdl", targetX, targetY)
        if fx != null then
            call DestroyEffect(fx)
            set fx = null
        endif
    endif

    set source = null
    set target = null
endfunction

