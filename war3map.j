function STN_CheatLeftAction takes nothing returns nothing
call STN_CheatKey(1)
endfunction
function STN_CheatDownAction takes nothing returns nothing
call STN_CheatKey(2)
endfunction
function STN_CheatRightAction takes nothing returns nothing
call STN_CheatKey(3)
endfunction
function STN_CheatUpAction takes nothing returns nothing
call STN_CheatKey(4)
endfunction
function STN_CheatEscAction takes nothing returns nothing
call STN_CheatVisionOff(GetTriggerPlayer())
endfunction
function InitTrig_STN_Cheats takes nothing returns nothing
local integer i=0
set STN_CheatLeft=CreateTrigger()
set STN_CheatDown=CreateTrigger()
set STN_CheatRight=CreateTrigger()
set STN_CheatUp=CreateTrigger()
set STN_CheatEsc=CreateTrigger()
loop
exitwhen i>=12
call TriggerRegisterPlayerEvent(STN_CheatLeft,Player(i),EVENT_PLAYER_ARROW_LEFT_DOWN)
call TriggerRegisterPlayerEvent(STN_CheatDown,Player(i),EVENT_PLAYER_ARROW_DOWN_DOWN)
call TriggerRegisterPlayerEvent(STN_CheatRight,Player(i),EVENT_PLAYER_ARROW_RIGHT_DOWN)
call TriggerRegisterPlayerEvent(STN_CheatUp,Player(i),EVENT_PLAYER_ARROW_UP_DOWN)
call TriggerRegisterPlayerEvent(STN_CheatEsc,Player(i),EVENT_PLAYER_END_CINEMATIC)
set STN_CheatState[i]=0
set STN_CheatFogOn[i]=false
set i=i+1
endloop
call TriggerAddAction(STN_CheatLeft,function STN_CheatLeftAction)
call TriggerAddAction(STN_CheatDown,function STN_CheatDownAction)
call TriggerAddAction(STN_CheatRight,function STN_CheatRightAction)
call TriggerAddAction(STN_CheatUp,function STN_CheatUpAction)
call TriggerAddAction(STN_CheatEsc,function STN_CheatEscAction)
endfunction

