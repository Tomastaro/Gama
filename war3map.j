    set gg_trg_Hero326_04 = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Hero326_04, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Hero326_04, Condition(function Trig_Hero326_04_Conditions))
    call TriggerAddAction(gg_trg_Hero326_04, function Trig_Hero326_04_Actions)

    set udg___Skill[3264] = 'A0W2'
    set udg__Str0[3260] = "attack one"
    set udg__Str0[3261] = "attack two"
    set udg__Str0[3262] = "attack slam"
endfunction

