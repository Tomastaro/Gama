                call UnitDamageTarget(caster, target, 0.60 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
