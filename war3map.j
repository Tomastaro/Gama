            call SaveReal(ght_unit, GetHandleId(target), 0x96EA435A, 0.00)
            call PauseUnit(target, false)
            call UnitRemoveAbility(target, 'Arav')
            
            call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
            
