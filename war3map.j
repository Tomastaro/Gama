//西凉铁骑
function Trig_War_Crytt_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0HC' and jv[52] == null
endfunction

function Trig_War_Crytt_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer lvl_A0HN
    local integer lvl_A0HC
    local location loc
    
    set jv[52] = u
    if GetUnitManaPercent(u) >= 25 then
        set loc = GetUnitLoc(u)
        call AddSpecialEffectLocBJ(loc, "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")
        call DestroyEffect(bj_lastCreatedEffect)
        
        // 刷新 A0HN（仅当已拥有时）
        set lvl_A0HN = GetUnitAbilityLevelSwapped('A0HN', u)
        if lvl_A0HN > 0 then
            call UnitRemoveAbility(u, 'A0HN')
            call UnitAddAbility(u, 'A0HN')
            call SetUnitAbilityLevelSwapped('A0HN', u, lvl_A0HN)
        endif
        
        call RemoveLocation(loc)
        set loc = null
    endif
    
    // 直接添加隐藏被动 A0OR（不使用魔法书）
    set lvl_A0HC = GetUnitAbilityLevelSwapped('A0HC', u)
    call UnitAddAbility(u, 'A0OR')
    call SetUnitAbilityLevelSwapped('A0OR', u, lvl_A0HC)
    
    call PolledWait(10.0)
    call UnitRemoveAbility(u, 'A0OR')
    set jv[52] = null
    set u = null
endfunction

function InitTrig_War_Crytt takes nothing returns nothing
    set gg_trg_War_Crytt = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_War_Crytt, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_War_Crytt, Condition(function Trig_War_Crytt_Conditions))
    call TriggerAddAction(gg_trg_War_Crytt, function Trig_War_Crytt_Actions)
endfunction


