function CreateThunderDummy takes player owner, real x, real y returns nothing
    local unit dummy = CreateUnit(owner, 'e01B', x, y, bj_UNIT_FACING)
    call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
    call IssuePointOrder(dummy, "thunderclap", x, y)
    set dummy = null
endfunction

// =============================================
// 条件判断
// =============================================
function I0OOOI takes nothing returns boolean
    return GetSpellAbilityId() == 'A0E0'
endfunction

// =============================================
// 技能主逻辑
// =============================================
function I0OO0I takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player owner = GetOwningPlayer(caster)
    local location targetLoc = GetSpellTargetLoc()
    local real x = GetLocationX(targetLoc)
    local real y = GetLocationY(targetLoc)

    // 释放目标点（局部变量，无泄漏）
    call RemoveLocation(targetLoc)
    set targetLoc = null

    // 在13个偏移位置创建马甲，与原版完全一致
    call CreateThunderDummy(owner, x - 80, y - 80)
    call CreateThunderDummy(owner, x, y)
    call CreateThunderDummy(owner, x - 80, y + 80)
    call CreateThunderDummy(owner, x, y - 80)
    call CreateThunderDummy(owner, x, y + 80)
    call CreateThunderDummy(owner, x + 80, y + 80)
    call CreateThunderDummy(owner, x + 80, y - 80)
    call CreateThunderDummy(owner, x + 80, y)
    call CreateThunderDummy(owner, x - 80, y)
    call CreateThunderDummy(owner, x, y - 160)
    call CreateThunderDummy(owner, x - 160, y)
    call CreateThunderDummy(owner, x, y + 160)
    call CreateThunderDummy(owner, x + 160, y)

    set caster = null
    set owner = null
endfunction

