// ====================================
function Trig_A_Func007002003xs takes nothing returns boolean
    return (not IsUnitDeadBJ(GetFilterUnit())) and (IsUnitEnemy(GetFilterUnit(), udg_tempPlayer))
endfunction

// ====================================
// 位移目标过滤：存活、有Buff、敌人
// ====================================
function Trig_B_Func002Func002002003xs_filter takes nothing returns boolean
    return (IsUnitEnemy(GetFilterUnit(), udg_tempPlayer)) and (UnitHasBuffBJ(GetFilterUnit(), 'B03D'))
endfunction

// ====================================
// 计时器回调
// ====================================
function Trig_Bxs_TimerCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer timerId = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_ZhouYuPull, timerId, 1)
    local group enemies = LoadGroupHandle(udg_HT_ZhouYuPull, timerId, 2)
    local unit dummyCenter = LoadUnitHandle(udg_HT_ZhouYuPull, timerId, 3)
    local integer count = LoadInteger(udg_HT_ZhouYuPull, timerId, 4)
    local boolean isFirst = LoadBoolean(udg_HT_ZhouYuPull, timerId, 5)
    
    local location centerLoc
    local group pullTargets
    local unit u
    local location sourceLoc
    local location targetLoc
    local real angle
    local location newLoc

    // 防崩
    if caster == null or dummyCenter == null then
        call DestroyGroup(enemies)
        call RemoveUnit(dummyCenter)
        call FlushChildHashtable(udg_HT_ZhouYuPull, timerId)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set enemies = null
        set dummyCenter = null
        return
    endif

    if isFirst then
        call SaveBoolean(udg_HT_ZhouYuPull, timerId, 5, false)
    else
        set centerLoc = GetUnitLoc(dummyCenter)
        set udg_tempPlayer = GetOwningPlayer(caster)
        set pullTargets = GetUnitsInRangeOfLocMatching(800.00, centerLoc, Condition(function Trig_B_Func002Func002002003xs_filter))
        set udg_tempPlayer = null

        loop
            set u = FirstOfGroup(pullTargets)
            exitwhen u == null
            call GroupRemoveUnit(pullTargets, u)

            set sourceLoc = GetUnitLoc(dummyCenter)
            set targetLoc = GetUnitLoc(u)
            set angle = AngleBetweenPoints(targetLoc, sourceLoc)
            set newLoc = PolarProjectionBJ(targetLoc, 30.00, angle)

            call xn(192.00, targetLoc, function cBxz)
            call SetUnitPositionLoc(u, newLoc)
            call DestroyEffect(AddSpecialEffectLoc("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", targetLoc))

            call RemoveLocation(sourceLoc)
            call RemoveLocation(targetLoc)
            call RemoveLocation(newLoc)
            set sourceLoc = null
            set targetLoc = null
            set newLoc = null
        endloop

        call DestroyGroup(pullTargets)
        call RemoveLocation(centerLoc)
        set pullTargets = null
        set centerLoc = null
        
        set count = count + 1
        call SaveInteger(udg_HT_ZhouYuPull, timerId, 4, count)

        if count > 30 then
            call DestroyGroup(enemies)
            call RemoveUnit(dummyCenter)
            call FlushChildHashtable(udg_HT_ZhouYuPull, timerId)
            call DestroyTimer(t)
        endif
    endif

    set t = null
    set caster = null
    set enemies = null
    set dummyCenter = null
endfunction

// ====================================
// 技能施法动作
// ====================================
function Trig_Axs_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player owner
    local location casterLoc
    local group enemies
    local unit dummy
    local timer t
    local integer timerId

    if caster == null then
        return
    endif

    set owner = GetOwningPlayer(caster)
    set casterLoc = GetUnitLoc(caster)
    set udg_tempPlayer = owner
    set enemies = GetUnitsInRangeOfLocMatching(600.00, casterLoc, Condition(function Trig_A_Func007002003xs))
    set udg_tempPlayer = null

    if FirstOfGroup(enemies) == null then
        call DestroyGroup(enemies)
        call RemoveLocation(casterLoc)
        set caster = null
        set owner = null
        set casterLoc = null
        set enemies = null
        return
    endif

    if GetUnitAbilityLevel(caster, 'A0T9') == 4 then
        call DestroyEffect(AddSpecialEffectLoc("war3mapImported\\HolyAwakening6.mdl", casterLoc))
    endif

    set dummy = CreateUnitAtLoc(owner, 'ewsp', casterLoc, 0)
    call ShowUnitHide(dummy)

    set t = CreateTimer()
    set timerId = GetHandleId(t)

    call SaveUnitHandle(udg_HT_ZhouYuPull, timerId, 1, caster)
    call SaveGroupHandle(udg_HT_ZhouYuPull, timerId, 2, enemies)
    call SaveUnitHandle(udg_HT_ZhouYuPull, timerId, 3, dummy)
    call SaveInteger(udg_HT_ZhouYuPull, timerId, 4, 0)
    call SaveBoolean(udg_HT_ZhouYuPull, timerId, 5, true)

    call TimerStart(t, 0.06, true, function Trig_Bxs_TimerCallback)

    call RemoveLocation(casterLoc)
    set caster = null
    set owner = null
    set casterLoc = null
    set enemies = null
    set dummy = null
    set t = null
endfunction

