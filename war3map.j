//===========================================================================
// 学习 A0XZ 时 → 自动升级 A0RQ 等级
//===========================================================================
// ========== 学习技能条件 ==========
function BRx9 takes nothing returns boolean
    return GetLearnedSkill() == 'A0XZ'
endfunction

// ========== 学习技能等级同步 ==========
function cRx9 takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer mainLevel

    // 入口兜底：单位无效直接退出
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif

    set mainLevel = GetUnitAbilityLevel(u, 'A0XZ')
    // 等级合法才执行同步
    if mainLevel > 0 then
        call SetUnitAbilityLevel(u, 'A0RQ', mainLevel)
    endif

    set u = null
endfunction

// =======================================
// 释放技能刷新冷却：条件
// =======================================
function Trig_refresh_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0XZ'
endfunction

// =======================================
// 释放技能刷新冷却：动作
// =======================================
function Trig_refresh_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer mainLevel

    // 入口兜底：单位无效直接退出
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif

    set mainLevel = GetUnitAbilityLevel(u, 'A0XZ')
    // 等级合法才执行刷CD+等级同步
    if mainLevel > 0 then
        call UnitRemoveAbility(u, 'A0RQ')
        call UnitAddAbility(u, 'A0RQ')
        call SetUnitAbilityLevel(u, 'A0RQ', mainLevel)
    endif

    set u = null
endfunction

// =======================================
// 初始化全部触发器
// =======================================
function InitTrig_Refresh takes nothing returns nothing
    local trigger t1 = CreateTrigger()
    local trigger t2 = CreateTrigger()

    // 学习技能升级联动
    call TriggerRegisterAnyUnitEventBJ(t1, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(t1, Condition(function BRx9))
    call TriggerAddAction(t1, function cRx9)

    // 释放技能刷新冷却
    call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t2, Condition(function Trig_refresh_Conditions))
    call TriggerAddAction(t2, function Trig_refresh_Actions)

    set t1 = null
    set t2 = null
endfunction








