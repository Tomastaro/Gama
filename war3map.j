// 增益动作
function Trig_A0TE_Buff_Act takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location loc = GetUnitLoc(caster)

    call DestroyEffect(AddSpecialEffectLocBJ(loc, "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl"))
    call UnitAddAbility(caster, 'A0HS')
    call UnitAddAbility(caster, 'A1KT')
    call PolledWait(1.5)
    call UnitRemoveAbility(caster, 'A0HS')
    call UnitRemoveAbility(caster, 'A1KT')

    call RemoveLocation(loc)
    set caster = null
    set loc = null
endfunction

