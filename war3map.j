function ZY_DoDamage takes unit caster, real x, real y, real radius, real dmg returns nothing
    local group g = CreateGroup()
    local unit u
    call GroupEnumUnitsInRange(g, x, y, radius, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and GetUnitState(u, UNIT_STATE_LIFE) > 0.405 then
            call UnitDamageTarget(caster, u, dmg, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
endfunction

function ZY_SpellActions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location targetLoc = GetSpellTargetLoc()
    local real x = GetUnitX(caster)
    local real y = GetUnitY(caster)
    local real tx = GetLocationX(targetLoc)
    local real ty = GetLocationY(targetLoc)
    local real angle = Atan2(ty - y, tx - x)
    local real newX = x + 400.0 * Cos(angle)
    local real newY = y + 400.0 * Sin(angle)
    local real str = GetHeroStr(caster, true)
    local real dmg = str * 2.0

    // 移动英雄
    call SetUnitX(caster, newX)
    call SetUnitY(caster, newY)
    call SetUnitFacing(caster, angle * bj_RADTODEG)
    // 造成范围伤害
    call ZY_DoDamage(caster, newX, newY, 200.0, dmg)
    // 特效
    call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", newX, newY))

    call RemoveLocation(targetLoc)
    set targetLoc = null
    set caster = null
endfunction

