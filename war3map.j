            else
                call UnitDamageTarget(caster, target, 5.00 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
            endif
            
            call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster), 12.00)
            
            set ydl_timer = CreateTimer()
            call SaveUnitHandle(ght_temp, GetHandleId(ydl_timer), 0xC303079D, caster)
            call TimerStart(ydl_timer, 0.12, false, function CameraClear1)
            
            call SetUnitX(caster, tarX)
            call SetUnitY(caster, tarY)
            call SetUnitFlyHeight(caster, 0.00, 0.00)
            call UnitRemoveAbility(caster, 'Arav')
            call StartUnitSlide(caster, GetUnitFacing(caster) - 180.00, 150.00, 0.30)
            call SetUnitTimeScale(caster, 1.00)
            call PauseUnit(caster, false)
            
            call DestroyGroup(effectGroup)
