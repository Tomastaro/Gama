//关平1
// ========== 哈希表初始化 ==========
function InitHT_A0J7 takes nothing returns nothing
    if udg_HT_A0J7 == null then
        set udg_HT_A0J7 = InitHashtable()
    endif
endfunction

// ========== 计时器回调：1.5秒后移除Buff ==========
function RemoveBuff_A0J7 takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer hid = GetHandleId(t)
    local unit u = LoadUnitHandle(udg_HT_A0J7, hid, 0)
    
    if u != null and GetWidgetLife(u) > 0.405 then
        call UnitRemoveAbility(u, 'A0HS')
        call UnitRemoveAbility(u, 'A1KT')
    endif
    
    call FlushChildHashtable(udg_HT_A0J7, hid)
    call DestroyTimer(t)
    set u = null
    set t = null
endfunction

// ========== 主技能施法条件 ==========
function Trig_wxwzur_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0J7'
endfunction

// ========== 主技能施法动作 ==========
function Trig_wxwzur_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player p
    local integer lvl
    local real str
    local real damage
    local real castX
    local real castY
    local real faceAngle
    local real spawnX
    local real spawnY
    local unit dummy
    local group g
    local unit tarU

    // 入口兜底
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set p = GetOwningPlayer(caster)
    set lvl = GetUnitAbilityLevel(caster, 'A0J7')
    set str = GetHeroStatBJ(bj_HEROSTAT_STR, caster, true)
    set damage = str * 10.0 + I2R(lvl) * 100.0
    set castX = GetUnitX(caster)
    set castY = GetUnitY(caster)
    set faceAngle = GetUnitFacing(caster)
    // 原生三角函数计算生成点，消除Location中转
    set spawnX = castX + 220.0 * Cos(faceAngle * bj_DEGTORAD)
    set spawnY = castY + 220.0 * Sin(faceAngle * bj_DEGTORAD)

    // 创建召唤马甲
    set dummy = CreateUnit(p, 'e02P', spawnX, spawnY, bj_UNIT_FACING)
    if dummy == null then
        set caster = null
        set p = null
        return
    endif
    call UnitApplyTimedLife(dummy, 'BTLF', 5.0)
    call SetUnitAbilityLevelSwapped('A0LV', dummy, lvl)
    call SetUnitManaBJ(dummy, str * 2.0 + I2R(lvl) * 100.0)

    // 范围瞬间伤害
    set g = CreateGroup()
    call GroupEnumUnitsInRange(g, spawnX, spawnY, 250.0, null)
    loop
        set tarU = FirstOfGroup(g)
        exitwhen tarU == null
        call GroupRemoveUnit(g, tarU)
        if tarU != caster and IsUnitEnemy(tarU, p) and GetWidgetLife(tarU) > 0.405 then
            call UnitDamageTarget(caster, tarU, damage, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
        endif
    endloop
    call DestroyGroup(g)

    // 马甲释放技能
    call IssueImmediateOrder(dummy, "stomp")
    call IssuePointOrder(dummy, "deathanddecay", spawnX, spawnY)

    set caster = null
    set dummy = null
    set tarU = null
    set p = null
endfunction

// ========== 持续施法通道条件 ==========
function Trig_wxwzurh_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0J7'
endfunction

// ========== 持续施法通道动作 ==========
function Trig_wxwzurh_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local real casterX
    local real casterY
    local timer t
    local integer hid
    local effect fx

    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)

    // 原生特效创建销毁，不依赖BJ全局变量
    set fx = AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl", casterX, casterY)
    call DestroyEffect(fx)
    set fx = null

    call UnitAddAbility(caster, 'A0HS')
    call UnitAddAbility(caster, 'A1KT')

    // 计时器延时移除Buff
    set t = CreateTimer()
    set hid = GetHandleId(t)
    call SaveUnitHandle(udg_HT_A0J7, hid, 0, caster)
    call TimerStart(t, 1.5, false, function RemoveBuff_A0J7)

    set caster = null
    set t = null
endfunction

// ========== 触发器初始化 ==========
function InitTrig_wxwzur takes nothing returns nothing
    call InitHT_A0J7()
    set gg_trg_wxwzur = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_wxwzur, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_wxwzur, Condition(function Trig_wxwzur_Conditions))
    call TriggerAddAction(gg_trg_wxwzur, function Trig_wxwzur_Actions)
endfunction

function InitTrig_wxwzurh takes nothing returns nothing
    set gg_trg_wxwzurh = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_wxwzurh, EVENT_PLAYER_UNIT_SPELL_CHANNEL)
    call TriggerAddCondition(gg_trg_wxwzurh, Condition(function Trig_wxwzurh_Conditions))
    call TriggerAddAction(gg_trg_wxwzurh, function Trig_wxwzurh_Actions)
endfunction

function Ya takes location za,real Za,real vn returns location
return Location(GetLocationX(za)+Za*Cos(vn*bj_DEGTORAD),GetLocationY(za)+Za*Sin(vn*bj_DEGTORAD))
endfunction


//function xn takes real on,location rn,code in returns nothing
//local rect r
//if(on>=0)then
//set sa=GetLocationX(rn)
//set Sa=GetLocationY(rn)
//set bj_enumDestructableRadius=on*on
//set r=Rect(sa-on,Sa-on,sa+on,Sa-on)
//call EnumDestructablesInRect(r,filterEnumDestructablesInCircleBJ,in)
//call RemoveRect(r)
//set r=null
//endif
//endfunction

function xn takes real on, location rn, code in returns nothing
    local rect r
    if on >= 0 then
        set sa = GetLocationX(rn)
        set Sa = GetLocationY(rn)
        set bj_enumDestructableRadius = on * on
        // 修正：第四参数应为 Sa+on
        set r = Rect(sa-on, Sa-on, sa+on, Sa+on)
        call EnumDestructablesInRect(r, filterEnumDestructablesInCircleBJ, in)
        call RemoveRect(r)
        set r = null
    endif
endfunction


//关平大
// 初始化哈希表
// ====================================
// 哈希表初始化
// ====================================
// ========== 哈希表初始化 ==========
function InitHT_A0H5 takes nothing returns nothing
    if udg_HT_A0H5 == null then
        set udg_HT_A0H5 = InitHashtable()
    endif
endfunction

// ====================================
// 强制重置目标飞行高度（带权限解锁，100%生效）
// ====================================
function A0H5_ResetFlyHeight takes unit u returns nothing
    if u == null then
        return
    endif
    // 先解锁地面单位的高度权限，确保重置生效
    call UnitAddAbility(u, 'Amrf')
    call UnitRemoveAbility(u, 'Amrf')
    // 高速率落回地面，视觉上无突兀感
    call SetUnitFlyHeight(u, 0.00, 2400.00)
endfunction

// ====================================
// 统一终止技能：清理状态+恢复单位+禁用周期
// ====================================
function A0H5_ClearState takes nothing returns nothing
    // 恢复施法者状态
    if Cv1 != null and GetWidgetLife(Cv1) > 0.405 then
        call PauseUnit(Cv1, false)
        call UnitRemoveAbility(Cv1, 'A07G')
        call SetUnitInvulnerable(Cv1, false)
    endif
    // 目标：强制重置高度 + 解除暂停，全场景兜底
    if Cvc1 != null then
        call A0H5_ResetFlyHeight(Cvc1)
        if GetWidgetLife(Cvc1) > 0.405 then
            call PauseUnit(Cvc1, false)
        endif
    endif
    // 释放全局坐标
    if dv1 != null then
        call RemoveLocation(dv1)
        set dv1 = null
    endif
    if Dv1 != null then
        call RemoveLocation(Dv1)
        set Dv1 = null
    endif
    if jc[16] != null then
        call RemoveLocation(jc[16])
        set jc[16] = null
    endif
    // 清空全局标记
    set Cv1 = null
    set Cvc1 = null
    set cv1 = 0.0
    // 禁用周期触发器
    if tx1 != null then
        call DisableTrigger(tx1)
    endif
endfunction

// ====================================
// 延时落地回调
// ====================================
function A0H5_DelayDrop takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit u1 = LoadUnitHandle(udg_HT_A0H5, id, 0)
    local unit u2 = LoadUnitHandle(udg_HT_A0H5, id, 1)
    local real dmg = LoadReal(udg_HT_A0H5, id, 2)

    // 目标存活才打单体落地伤害
    if u1 != null and u2 != null and GetWidgetLife(u2) > 0.405 then
        call UnitDamageTargetBJ(u1, u2, dmg, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    endif

    // 统一清理（自动兜底高度重置）
    call A0H5_ClearState()

    call FlushChildHashtable(udg_HT_A0H5, id)
    call DestroyTimer(t)
    set t = null
    set u1 = null
    set u2 = null
endfunction

// ====================================
// 技能条件
// ====================================
function R1 takes nothing returns boolean
    local unit target = GetSpellTargetUnit()
    if target == null then
        return false
    endif
    return GetSpellAbilityId() == 'A0H5' and not IsUnitIllusionBJ(target)
endfunction

// ====================================
// 技能初始动作
// ====================================
function A3 takes nothing returns nothing
    local location locTarget
    local location locCaster
    local location polarLoc

    // 新施法前强制清理旧状态
    call A0H5_ClearState()

    set Cv1 = GetSpellAbilityUnit()
    set Cvc1 = GetSpellTargetUnit()
    set cv1 = 0.0

    // 入口兜底：施法者无效才不启动
    if Cv1 == null or GetWidgetLife(Cv1) <= 0.405 then
        call A0H5_ClearState()
        return
    endif

    if Cv1 != Cvc1 and Cvc1 != null then
        set locTarget = GetUnitLoc(Cvc1)
        set locCaster = GetUnitLoc(Cv1)
        set polarLoc = PolarProjectionBJ(locTarget, 140.00, AngleBetweenPoints(locTarget, locCaster))
        call SetUnitPositionLocFacingBJ(Cv1, polarLoc, GetUnitFacing(Cv1))
        call RemoveLocation(locTarget)
        call RemoveLocation(locCaster)
        call RemoveLocation(polarLoc)
    endif

    set dv1 = GetUnitLoc(Cv1)
    if Cvc1 != null then
        set Dv1 = GetUnitLoc(Cvc1)
    endif

    // 暂停单位 + 施法者无敌
    call PauseUnit(Cv1, true)
    call SetUnitInvulnerable(Cv1, true)
    if Cvc1 != null and GetWidgetLife(Cvc1) > 0.405 then
        call PauseUnit(Cvc1, true)
    endif

    call SetUnitAnimationWithRarity(Cv1, "Throw", RARITY_RARE)
    call UnitAddAbility(Cv1, 'A07G')
    call EnableTrigger(tx1)
endfunction

// ====================================
// 幻象击杀条件（修复逻辑优先级）
// ====================================
function RAsx takes nothing returns boolean
    local unit target = GetSpellTargetUnit()
    if target == null then
        return false
    endif
    return (GetSpellAbilityId() == 'A0NZ' or GetSpellAbilityId() == 'A0H5' or GetSpellAbilityId() == 'A0AL') and IsUnitIllusionBJ(target)
endfunction

function AAsx takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    if target != null and IsUnitIllusionBJ(target) then
        call KillUnit(target)
    endif
    set target = null
endfunction

// ====================================
// 树木破坏函数
// ====================================
function NA1 takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

// ====================================
// 位移周期回调
// ====================================
function BA1 takes nothing returns nothing
    local location yaLoc
    local unit dummy
    local timer delayTimer
    local integer delayId

    // 只有施法者死亡才终止，目标死亡不中断技能
    if Cv1 == null or GetWidgetLife(Cv1) <= 0.405 then
        call A0H5_ClearState()
        return
    endif

    if cv1 >= 990.0 then
        call SetUnitAnimationWithRarity(Cv1, "Attack Throw", RARITY_RARE)
        call DisableTrigger(GetTriggeringTrigger())
        // 砸地坐标：目标存活取目标位置，死亡取施法者当前位置
        if Cvc1 != null then
            set jc[16] = GetUnitLoc(Cvc1)
        else
            set jc[16] = GetUnitLoc(Cv1)
        endif

        // 砸地主马甲
        call CreateNUnitsAtLoc(1, 'h01h', GetOwningPlayer(Cv1), jc[16], bj_UNIT_FACING)
        set dummy = bj_lastCreatedUnit
        if dummy != null then
            call UnitApplyTimedLife(dummy, 'BTLF', 5.0)
            call SetUnitAbilityLevelSwapped('A0LU', dummy, GetUnitAbilityLevelSwapped('A0H5', Cv1))
            call SetUnitManaBJ(dummy, GetHeroStatBJ(bj_HEROSTAT_STR, Cv1, true)*5 + (GetUnitAbilityLevelSwapped('A0H5', Cv1)+1)*60)
            call IssueImmediateOrderById(dummy, 852127)
            set dummy = null
        endif

        // 目标存活才打单体砸地伤害
        if Cvc1 != null and GetWidgetLife(Cvc1) > 0.405 then
            call UnitDamageTargetBJ(Cv1, Cvc1, GetHeroStatBJ(bj_HEROSTAT_STR, Cv1, true)*5 + (GetUnitAbilityLevelSwapped('A0H5', Cv1)+1)*60, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
        endif

        // 连击马甲+击飞：目标存活才触发
        if Cv1 != Cvc1 and Cvc1 != null and GetWidgetLife(Cvc1) > 0.405 then
            // 提前解锁高度权限，确保击飞生效
            call A0H5_ResetFlyHeight(Cvc1)
            call SetUnitFlyHeight(Cvc1, 400.00, 1500.00)

            call CreateNUnitsAtLocFacingLocBJ(1, 'h03I', GetOwningPlayer(Cv1), jc[16], jc[16])
            set dummy = bj_lastCreatedUnit
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
                call IssueTargetOrderBJ(dummy, "attack", Cvc1)
                set dummy = null
            endif

            call CreateNUnitsAtLocFacingLocBJ(1, 'h03J', GetOwningPlayer(Cv1), jc[16], jc[16])
            set dummy = bj_lastCreatedUnit
            if dummy != null then
                call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
                call IssueTargetOrderBJ(dummy, "attack", Cvc1)
                set dummy = null
            endif
        endif

        // 延时落地计时器
        set delayTimer = CreateTimer()
        set delayId = GetHandleId(delayTimer)
        call SaveUnitHandle(udg_HT_A0H5, delayId, 0, Cv1)
        call SaveUnitHandle(udg_HT_A0H5, delayId, 1, Cvc1)
        call SaveReal(udg_HT_A0H5, delayId, 2, GetHeroStatBJ(bj_HEROSTAT_STR, Cv1, true)*5)
        call TimerStart(delayTimer, 1.4, false, function A0H5_DelayDrop)
        set delayTimer = null
    else
        set cv1 = cv1 + 33.0
        // 参考坐标：目标存活取目标位置，死亡取施法者位置
        if Cvc1 != null and GetWidgetLife(Cvc1) > 0.405 then
            set jc[16] = GetUnitLoc(Cvc1)
        else
            set jc[16] = GetUnitLoc(Cv1)
        endif

        set yaLoc = Ya(dv1, cv1, GetUnitFacing(Cv1))
        call SetUnitPositionLocFacingBJ(Cv1, yaLoc, GetUnitFacing(Cv1))
        call RemoveLocation(yaLoc)

        // 目标存活才同步拉拽目标
        if Cvc1 != null and GetWidgetLife(Cvc1) > 0.405 then
            set yaLoc = Ya(Dv1, cv1, GetUnitFacing(Cv1))
            call SetUnitPositionLocFacingBJ(Cvc1, yaLoc, GetUnitFacing(Cv1))
            call RemoveLocation(yaLoc)
        endif

        call xn(200., jc[16], function NA1)
        // 目标存活才播放命中特效+打持续伤害
        if Cvc1 != null and GetWidgetLife(Cvc1) > 0.405 then
            call AddSpecialEffectTargetUnitBJ("origin", Cvc1, "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
            call DestroyEffect(bj_lastCreatedEffect)
            if Cv1 != Cvc1 then
                call UnitDamageTargetBJ(Cv1, Cvc1, 2*(GetUnitAbilityLevel(Cv1, 'A0H5')+1), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
            endif
        endif

        // 释放本次循环坐标
        call RemoveLocation(jc[16])
        set jc[16] = null
    endif
endfunction

// ====================================
// 伤害事件（仅保留额外伤害逻辑，高度交由统一兜底）
// ====================================
function QBzxpy5 takes nothing returns nothing
    local location loc
    local integer sourceTypeId

    // 施法者或目标无效直接退出
    if Cv1 == null or Cvc1 == null or GetWidgetLife(Cv1) <= 0.405 or GetWidgetLife(Cvc1) <= 0.405 then
        return
    endif

    set sourceTypeId = GetUnitTypeId(GetEventDamageSource())

    if sourceTypeId == 'h03I' then
        set loc = GetUnitLoc(Cv1)
        call AddSpecialEffectLocBJ(loc, "war3mapImported\\firedragon4.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectTargetUnitBJ("origin", Cv1, "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call UnitDamageTargetBJ(Cv1, Cvc1, 60*(GetUnitAbilityLevel(Cv1, 'A0H5')+1), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
        call RemoveLocation(loc)
        set loc = null
    endif
endfunction

// ====================================
// 初始化
// ====================================
function InitTrig_A0H5 takes nothing returns nothing
    call InitHT_A0H5()

    set S1 = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(S1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(S1, Condition(function R1))
    call TriggerAddAction(S1, function A3)

    set tx1 = CreateTrigger()
    call DisableTrigger(tx1)
    call TriggerRegisterTimerEventPeriodic(tx1, 0.03)
    call TriggerAddAction(tx1, function BA1)

    set Sozxpy5 = CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(Sozxpy5)
    call TriggerAddAction(Sozxpy5, function QBzxpy5)
endfunction

// 技能奖励触发器
// ========== 学习技能条件 ==========
function NRxkg takes nothing returns boolean
    return GetLearnedSkill() == 'A999' or GetLearnedSkill() == 'A0JL'
endfunction

// ========== 学习技能加属性动作 ==========
function bRxkg takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer id
    local integer skillId
    local integer currentLevel
    local integer lastRecordedLevel

    // 入口兜底：单位无效直接退出
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif

    // 兜底：哈希表未初始化则补创建
    if udg_HT_LearnBonus == null then
        set udg_HT_LearnBonus = InitHashtable()
    endif

    set id = GetHandleId(u)
    set skillId = GetLearnedSkill()
    set currentLevel = GetUnitAbilityLevel(u, skillId)
    set lastRecordedLevel = LoadInteger(udg_HT_LearnBonus, id, skillId)

    // 只给新增的等级加属性，防止重置书刷属性
    if currentLevel > lastRecordedLevel then
        call ModifyHeroStat(0, u, 0, 6 * (currentLevel - lastRecordedLevel))
        call SaveInteger(udg_HT_LearnBonus, id, skillId, currentLevel)
    endif

    set u = null
endfunction

// ========== 触发器初始化 ==========
function InitTrig_LearnSkillBonus takes nothing returns nothing
    if udg_HT_LearnBonus == null then
        set udg_HT_LearnBonus = InitHashtable()
    endif

    set Vxxkg = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(Vxxkg, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(Vxxkg, Condition(function NRxkg))
    call TriggerAddAction(Vxxkg, function bRxkg)
endfunction

// 条件函数：检查学习的技能是否为A4RR
// ========== 学习技能条件 ==========
function NRxz2 takes nothing returns boolean
    return GetLearnedSkill() == 'A4RR'
endfunction

// ========== 学习技能联动动作 ==========
function bRxz2 takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer a4rrLevel

    // 入口兜底：单位无效直接退出
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif

    set a4rrLevel = GetUnitAbilityLevel(u, 'A4RR')
    // 等级合法才执行联动，避免无效操作
    if a4rrLevel > 0 then
        call UnitAddAbility(u, 'A4SR')
        call SetUnitAbilityLevel(u, 'A4SR', a4rrLevel)
    endif

    set u = null
endfunction

// ========== 触发器初始化 ==========
function InitTrig_LearnA4RR takes nothing returns nothing
    set Vxxz2 = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(Vxxz2, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(Vxxz2, Condition(function NRxz2))
    call TriggerAddAction(Vxxz2, function bRxz2)
endfunction



//长版赵云冲锋
// ========== 技能施法条件 ==========
function RAt takes nothing returns boolean
    return GetSpellAbilityId() == 'A0RP'
endfunction

// ====================================
// 统一清理冲锋状态（全路径兜底）
// ====================================
function ClearChargeState takes nothing returns nothing
    // 单位存活才恢复状态，单位失效则只清资源
    if Cvt[1] != null and GetWidgetLife(Cvt[1]) > 0.405 then
        call SetUnitInvulnerable(Cvt[1], false)
        call UnitRemoveAbility(Cvt[1], 'A0NR')
        call ResetUnitAnimation(Cvt[1])
    endif
    // 释放全局坐标，杜绝泄漏
    if dvt[1] != null then
        call RemoveLocation(dvt[1])
        set dvt[1] = null
    endif
    if Dvt[1] != null then
        call RemoveLocation(Dvt[1])
        set Dvt[1] = null
    endif
    // 清空标记
    set Cvt[1] = null
    set cvt[1] = 0.0
    // 禁用周期触发器
    if txt != null then
        call DisableTrigger(txt)
    endif
endfunction

// ========== 主技能施法动作 ==========
function AAt takes nothing returns nothing
    local location startLoc
    local location targetLoc
    local unit dummy

    // 防重复施放
    if Cvt[1] != null then
        return
    endif

    set Cvt[1] = GetSpellAbilityUnit()
    // 入口兜底：施法者无效直接退出
    if Cvt[1] == null or GetWidgetLife(Cvt[1]) <= 0.405 then
        call ClearChargeState()
        return
    endif

    set dvt[1] = GetUnitLoc(Cvt[1])
    set Dvt[1] = GetSpellTargetLoc()
    set fvt[1] = AngleBetweenPoints(dvt[1], Dvt[1])
    set Fvt[1] = DistanceBetweenPoints(dvt[1], Dvt[1])

    // 距离过近直接终止
    if Fvt[1] <= 1.0 then
        call UnitRemoveAbility(Cvt[1], 'A0NR')
        call ClearChargeState()
        return
    endif

    // 施法状态设置
    call SetUnitAnimationWithRarity(Cvt[1], "Attack Throw", RARITY_RARE)
    call SetUnitInvulnerable(Cvt[1], true)
    call UnitAddAbility(Cvt[1], 'A0NR')

    // 蝗虫群马甲（修复：创建判空，避免空指针崩溃）
    call CreateNUnitsAtLoc(1, 'h040', GetOwningPlayer(Cvt[1]), dvt[1], bj_UNIT_FACING)
    set dummy = bj_lastCreatedUnit
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        if GetUnitAbilityLevel(Cvt[1], 'A0SK') == 0 then
            call SetUnitAbilityLevel(dummy, 'A0RR', GetUnitAbilityLevel(Cvt[1], 'A0RP'))
        else
            call SetUnitAbilityLevel(dummy, 'A0RR', 4 + GetUnitAbilityLevel(Cvt[1], 'A0RP'))
        endif
        call IssuePointOrderLoc(dummy, "carrionswarm", Dvt[1])
        set dummy = null
    endif

    set cvt[1] = 0.0
    call EnableTrigger(txt)
endfunction

// ========== 冲锋周期回调 ==========
function BAt takes nothing returns nothing
    local location loc
    local location moveLoc

    // 异常兜底：施法者无效立刻终止清理
    if Cvt[1] == null or GetWidgetLife(Cvt[1]) <= 0.405 then
        call ClearChargeState()
        return
    endif

    if cvt[1] >= 500 + 150 * GetUnitAbilityLevel(Cvt[1], 'A0RP') then
        call SetUnitAnimationWithRarity(Cvt[1], "Stand", RARITY_RARE)
        // 正常结束：统一清理状态
        call ClearChargeState()
    else
        set cvt[1] = cvt[1] + 45

        // 破坏树木（修复：缓存坐标+用完销毁）
        set loc = GetUnitLoc(Cvt[1])
        call xn(200., loc, function NA)
        call RemoveLocation(loc)
        set loc = null

        // 位移（修复：缓存坐标+用完销毁，彻底解决周期泄漏）
        set moveLoc = Ya(dvt[1], cvt[1], fvt[1])
        call SetUnitPositionLocFacingBJ(Cvt[1], moveLoc, fvt[1])
        call RemoveLocation(moveLoc)
        set moveLoc = null
    endif
endfunction

// ========== 初始化 ==========
function InitTrig_A0RP_Skill takes nothing returns nothing
    set Sxt = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(Sxt, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(Sxt, Condition(function RAt))
    call TriggerAddAction(Sxt, function AAt)

    set txt = CreateTrigger()
    call DisableTrigger(txt)
    call TriggerRegisterTimerEvent(txt, 0.03, true)
    call TriggerAddAction(txt, function BAt)
endfunction

//赵云成长
// ========== 哈希表初始化 ==========
function InitHT_AttackBonus takes nothing returns nothing
    if udg_HT_AttackBonus == null then
        set udg_HT_AttackBonus = InitHashtable()
    endif
endfunction

// ========== Z00Y 攻击条件 ==========
function BNxzf2 takes nothing returns boolean
    local unit attacker = GetAttacker()
    local unit target = GetAttackedUnitBJ()
    if attacker == null or target == null then
        set attacker = null
        set target = null
        return false
    endif
    set attacker = null
    set target = null
    return GetUnitTypeId(GetAttacker()) == 'Z00Y' and GetHeroStatBJ(bj_HEROSTAT_AGI, GetAttacker(), false) < 130 and not IsUnitIllusionBJ(GetAttacker()) and IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker()))
endfunction

// ========== Z00Y 攻击动作 ==========
function FNxzf2 takes nothing returns nothing
    local unit u = GetAttacker()
    local integer uid
    local integer stack
    local integer skillLevel

    if u == null then
        set u = null
        return
    endif

    set uid = GetHandleId(u)
    set skillLevel = GetUnitAbilityLevelSwapped('A0RN', u)
    // 读取该单位独立的计数
    set stack = LoadInteger(udg_HT_AttackBonus, uid, 0)

    if stack >= 173 then
        call ModifyHeroStat(0, u, 0, 1)
        call ModifyHeroStat(1, u, 0, 2)
        call SaveInteger(udg_HT_AttackBonus, uid, 0, 0)
    else
        // 公式简化：等级+2，对应1级+3、2级+4、3级+5、4级+6
        if skillLevel >= 1 and skillLevel <= 4 then
            set stack = stack + skillLevel + 2
            call SaveInteger(udg_HT_AttackBonus, uid, 0, stack)
        endif
    endif

    set u = null
endfunction

// ========== E00M 攻击条件 ==========
function BNxzf takes nothing returns boolean
    local unit attacker = GetAttacker()
    local unit target = GetAttackedUnitBJ()
    if attacker == null or target == null then
        set attacker = null
        set target = null
        return false
    endif
    set attacker = null
    set target = null
    return GetUnitTypeId(GetAttacker()) == 'E00M' and GetHeroStatBJ(bj_HEROSTAT_AGI, GetAttacker(), false) < 130 and not IsUnitIllusionBJ(GetAttacker()) and IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker()))
endfunction

// ========== E00M 攻击动作 ==========
function FNxzf takes nothing returns nothing
    local unit u = GetAttacker()
    local integer uid
    local integer stack
    local integer skillLevel

    if u == null then
        set u = null
        return
    endif

    set uid = GetHandleId(u)
    set skillLevel = GetUnitAbilityLevelSwapped('A0JB', u)
    // 读取该单位独立的计数
    set stack = LoadInteger(udg_HT_AttackBonus, uid, 1)

    if stack >= 173 then
        call ModifyHeroStat(0, u, 0, 1)
        call ModifyHeroStat(1, u, 0, 2)
        call SaveInteger(udg_HT_AttackBonus, uid, 1, 0)
    else
        // 公式简化：等级+2
        if skillLevel >= 1 and skillLevel <= 4 then
            set stack = stack + skillLevel + 2
            call SaveInteger(udg_HT_AttackBonus, uid, 1, stack)
        endif
    endif

    set u = null
endfunction

// ========== 初始化 ==========
function InitTrig_Skill_Z00Y takes nothing returns nothing
    call InitHT_AttackBonus()

    set aoxzf = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(aoxzf, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(aoxzf, Condition(function BNxzf))
    call TriggerAddAction(aoxzf, function FNxzf)

    set aoxzf2 = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(aoxzf2, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(aoxzf2, Condition(function BNxzf2))
    call TriggerAddAction(aoxzf2, function FNxzf2)
endfunction

// ========== 技能施法条件 ==========
function RAt2 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0RQ'
endfunction

// ====================================
// 位移回调（每0.03秒）
// ====================================
function Charge_A0RQ_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_A0RQ, id, 1)
    local real startX = LoadReal(udg_HT_A0RQ, id, 2)
    local real startY = LoadReal(udg_HT_A0RQ, id, 3)
    local real targetX = LoadReal(udg_HT_A0RQ, id, 4)
    local real targetY = LoadReal(udg_HT_A0RQ, id, 5)
    local real angle = LoadReal(udg_HT_A0RQ, id, 6)
    local real totalDist = LoadReal(udg_HT_A0RQ, id, 7)
    local real currentDist = LoadReal(udg_HT_A0RQ, id, 8)
    local real step = totalDist / 25.0
    local location startLoc
    local location targetLoc
    local location newLoc

    // 重建坐标对象（用于后续函数调用）
    set startLoc = Location(startX, startY)
    set targetLoc = Location(targetX, targetY)

    // 异常兜底：单位无效直接清理终止
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        if caster != null then
            call UnitRemoveAbility(caster, 'A0NR')
        endif
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_A0RQ, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 到达终点
    if currentDist >= totalDist then
        call UnitRemoveAbility(caster, 'A0NR')
        call SetUnitAnimationWithRarity(caster, "Stand", RARITY_RARE)
        // 终点范围破坏树木
        call xn(350.00, targetLoc, function NA)
        // 全量资源清理
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_A0RQ, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_A0RQ, id, 8, currentDist)

        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)
        call RemoveLocation(newLoc)
        set newLoc = null

        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 技能主动作
// ====================================
function AAt2 takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real totalDist
    local timer t
    local integer id
    local unit dummy

    // 入口兜底：施法者无效直接退出
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    
    // 目标点判空兜底，极端异常场景直接终止
    if targetLoc == null then
        call RemoveLocation(startLoc)
        set caster = null
        set startLoc = null
        return
    endif

    set angle = AngleBetweenPoints(startLoc, targetLoc)
    set totalDist = DistanceBetweenPoints(startLoc, targetLoc)

    // 距离过近直接终止
    if totalDist <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 施法状态设置
    call SetUnitAnimationWithRarity(caster, "Spell Throw", RARITY_RARE)
    call UnitAddAbility(caster, 'A0NR')

    // 目标点马甲（创建判空，杜绝空指针崩溃）
    call CreateNUnitsAtLoc(1, 'e035', GetOwningPlayer(caster), targetLoc, bj_UNIT_FACING)
    set dummy = bj_lastCreatedUnit
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        call SetUnitAbilityLevelSwapped('A1DQ', dummy, GetUnitAbilityLevelSwapped('A0RQ', caster))
        call IssueImmediateOrderById(dummy, 852127)
        set dummy = null
    endif

    // 创建独立计时器，拆解坐标存入哈希表
    set t = CreateTimer()
    set id = GetHandleId(t)
    call SaveUnitHandle(udg_HT_A0RQ, id, 1, caster)
    call SaveReal(udg_HT_A0RQ, id, 2, GetLocationX(startLoc))
    call SaveReal(udg_HT_A0RQ, id, 3, GetLocationY(startLoc))
    call SaveReal(udg_HT_A0RQ, id, 4, GetLocationX(targetLoc))
    call SaveReal(udg_HT_A0RQ, id, 5, GetLocationY(targetLoc))
    call SaveReal(udg_HT_A0RQ, id, 6, angle)
    call SaveReal(udg_HT_A0RQ, id, 7, totalDist)
    call SaveReal(udg_HT_A0RQ, id, 8, 0.0)
    call TimerStart(t, 0.03, true, function Charge_A0RQ_MoveCallback)

    // 释放原始坐标，哈希表只存实数
    call RemoveLocation(startLoc)
    call RemoveLocation(targetLoc)

    set caster = null
    set startLoc = null
    set targetLoc = null
    set t = null
endfunction

// ====================================
// 初始化
// ====================================
function InitTrig_A0RQ takes nothing returns nothing
    local trigger trig
    if udg_HT_A0RQ == null then
        set udg_HT_A0RQ = InitHashtable()
    endif
    set trig = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trig, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trig, Condition(function RAt2))
    call TriggerAddAction(trig, function AAt2)
    set trig = null
endfunction




// ================================
// A0J9 残血保命被动
// ================================
// ========== 受伤事件动作 ==========
function Trig_hurtless1Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local real lifePercent
    local real threshold
    local real currentLife
    local real eventDamage

    // 入口兜底：单位无效直接退出
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return
    endif
    // 快速失败：无对应技能直接退出
    if GetUnitAbilityLevel(u, 'A0J9') <= 0 then
        set u = null
        return
    endif

    // 获取伤害与状态
    set eventDamage = GetEventDamage()
    set lifePercent = GetUnitLifePercent(u)
    set threshold = 10.0 + 20.0 * GetUnitAbilityLevel(u, 'A0J9')

    // 条件：伤害有效 + 非幻象 + 血量低于阈值
    if eventDamage > 1.00 and not IsUnitIllusionBJ(u) and lifePercent <= threshold then
        set currentLife = GetUnitState(u, UNIT_STATE_LIFE)
        // 按比例回复生命（原逻辑完整保留）
        if eventDamage < currentLife then
            call SetUnitState(u, UNIT_STATE_LIFE, currentLife + eventDamage * (100.0 - lifePercent) * 0.0065)
        endif
    endif

    set u = null
endfunction

// ========== 初始化 ==========
function InitTrig_hurtless1 takes nothing returns nothing
    local trigger t = CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(t)
    call TriggerAddAction(t, function Trig_hurtless1Actions)
    set t = null
endfunction


