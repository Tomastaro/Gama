// 死亡事件前置条件
function O0I0O0O takes nothing returns boolean
    return IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO)
endfunction

function O0I0OIO takes nothing returns boolean
    return GetPlayerSlotState(GetOwningPlayer(GetDyingUnit())) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(GetOwningPlayer(GetDyingUnit())) == MAP_CONTROL_USER
endfunction

function O0I0O1O takes nothing returns boolean
    return GetBooleanAnd(O0I0O0O(), O0I0OIO())
endfunction

function O0I0OOO takes nothing returns boolean
    return GetOwningPlayer(GetKillingUnit()) != Player(0) and GetOwningPlayer(GetKillingUnit()) != Player(4) and GetOwningPlayer(GetKillingUnit()) != Player(8)
endfunction

// 三方阵营统一判定函数
function GetPlayerTeamId takes player p returns integer
    local integer pid = GetPlayerId(p)
    if pid <= 3 then
        return 1
    elseif pid <= 7 then
        return 2
    else
        return 3
    endif
endfunction
// ====================================
// 新版助攻系统核心（脚本B机制：一对一计时器 + 区域注册）
// ====================================

// 空计时器回调（仅作占位，计时器到期自动失效）
function AST_EmptyTimerCallback takes nothing returns nothing
endfunction

// 受伤事件回调：刷新对应「受害者-攻击者」配对的助攻计时器
function AST_DamageCb takes nothing returns boolean
    local unit attacker = GetEventDamageSource()
    local unit victim = GetTriggerUnit()
    local unit realAttacker
    local player attackerP
    local player victimP
    local integer attackerPid
    local integer victimPid
    local integer timerIdx

    if attacker == null or victim == null then
        set attacker = null
        set victim = null
        return false
    endif

    // 马甲伤害溯源：非英雄单位归属到同玩家主英雄
    if IsUnitType(attacker, UNIT_TYPE_HERO) then
        set realAttacker = attacker
    else
        set realAttacker = PlayerHero[GetPlayerId(GetOwningPlayer(attacker))]
    endif

    // 溯源结果无效则直接退出
    if realAttacker == null then
        set attacker = null
        set victim = null
        return false
    endif

    set attackerP = GetOwningPlayer(realAttacker)
    set victimP = GetOwningPlayer(victim)
    set attackerPid = GetPlayerId(attackerP)
    set victimPid = GetPlayerId(victimP)

    // 仅敌方、伤害>0.5时刷新计时器（6秒有效期）
    if IsUnitEnemy(victim, attackerP) and GetEventDamage() > 0.5 then
        set timerIdx = victimPid * 12 + attackerPid + 1
        call TimerStart(AssistTimer[timerIdx], 6.0, false, function AST_EmptyTimerCallback)
    endif

    set attacker = null
    set victim = null
    set realAttacker = null
    set attackerP = null
    set victimP = null
    return false
endfunction

// 英雄注册：为单个英雄绑定专属受伤触发器
function AST_RegHero takes unit u returns boolean
    local player p
    local integer pid
    local trigger trg

    if u == null then
        return false
    endif

    set p = GetOwningPlayer(u)
    set pid = GetPlayerId(p)

    // 仅英雄单位、未注册过才执行注册
    if IsUnitType(u, UNIT_TYPE_HERO) and HeroReg[pid] == false then
        set HeroReg[pid] = true
        set PlayerHero[pid] = u

        set trg = CreateTrigger()
        call TriggerRegisterUnitEvent(trg, u, EVENT_UNIT_DAMAGED)
        call TriggerAddCondition(trg, Condition(function AST_DamageCb))
        set trg = null
    endif

    set u = null
    set p = null
    return false
endfunction

// 区域进入事件回调
function AST_EnterCb takes nothing returns boolean
    call AST_RegHero(GetEnteringUnit())
    return false
endfunction

// 初始化区域注册事件（三方阵营区域均生效）
function AST_InitEnter takes nothing returns nothing
    set EnterTrigger = CreateTrigger()
    call TriggerRegisterEnterRectSimple(EnterTrigger, ZoneA)
    call TriggerRegisterEnterRectSimple(EnterTrigger, ZoneB)
    call TriggerRegisterEnterRectSimple(EnterTrigger, ZoneC)
    call TriggerAddCondition(EnterTrigger, Condition(function AST_EnterCb))
endfunction

// 助攻结算（完全保留原规则：同阵营判定、金币公式、三连奖励、公告格式）
function Assist_OnKill takes unit victim, unit killer returns nothing
    local integer victimPid
    local integer killerPid
    local integer killerTeam
    local integer assistGold
    local string assistNames = ""
    local integer i
    local integer timerIdx
    local integer arrayIdx
    local player assistPlayer
    local string heroName

    if victim == null or killer == null then
        return
    endif

    set victimPid = GetPlayerId(GetOwningPlayer(victim))
    set killerPid = GetPlayerId(GetOwningPlayer(killer))
    set killerTeam = GetPlayerTeamId(GetOwningPlayer(killer))
    set assistGold = (100 + GetUnitLevel(victim) * 20) / 3

    // 遍历所有玩家，判定有效助攻
    set i = 0
    loop
        exitwhen i >= 12
        if i != killerPid then
            set timerIdx = victimPid * 12 + i + 1
            // 计时器剩余时间>0即为有效助攻
            if TimerGetRemaining(AssistTimer[timerIdx]) > 0 then
                set assistPlayer = Player(i)
                // 仅同阵营结算
                if GetPlayerTeamId(assistPlayer) == killerTeam then
                    set arrayIdx = i + 1
                    // 发放助攻金币
                    call SetPlayerState(assistPlayer, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(assistPlayer, PLAYER_STATE_RESOURCE_GOLD) + assistGold)
                    // 累计总助攻数
                    set udg_AssistCount[arrayIdx] = udg_AssistCount[arrayIdx] + 1
                    // 连续助攻计数，满3次清零并奖励1个人头
                    set udg_AssistStreak[arrayIdx] = udg_AssistStreak[arrayIdx] + 1
                    if udg_AssistStreak[arrayIdx] >= 3 then
                        set udg_AssistStreak[arrayIdx] = 0
                        set OOOI0[arrayIdx] = OOOI0[arrayIdx] + 1
                    endif

                    // 拼接助攻公告（玩家名(英雄名)格式，与原版完全一致）
                    set heroName = GetUnitName(PlayerHero[i])
                    if assistNames == "" then
                        set assistNames = GetPlayerName(assistPlayer) + "(" + heroName + ")"
                    else
                        set assistNames = assistNames + "/" + GetPlayerName(assistPlayer) + "(" + heroName + ")"
                    endif
                endif
            endif
        endif
        set i = i + 1
    endloop

    // 全服广播助攻公告
    if assistNames != "" then
        call DisplayTextToForce(bj_FORCE_ALL_PLAYERS, "|cffffcc00助攻: " + assistNames + "|r")
    endif

    set victim = null
    set killer = null
    set assistPlayer = null
endfunction



// ====================================
// 死亡事件主逻辑（原样保留）
// ====================================
function O0I00OO takes nothing returns nothing
    local unit victim
    local unit killer

    if O0I0O1O() then
        set victim = GetDyingUnit()
        set killer = GetKillingUnit()

        call SetPlayerStateBJ(GetOwningPlayer(victim), PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(GetOwningPlayer(victim), PLAYER_STATE_RESOURCE_GOLD) - (100 + GetUnitLevel(victim) * 20))
        set OO10[1 + GetPlayerId(GetOwningPlayer(killer))] = OO10[1 + GetPlayerId(GetOwningPlayer(killer))] + 1
        set O0O0[1 + GetPlayerId(GetOwningPlayer(victim))] = O0O0[1 + GetPlayerId(GetOwningPlayer(victim))] + 1

        if O0I0OOO() then
            call DisplayTextToForce(bj_FORCE_ALL_PLAYERS, GetPlayerName(GetOwningPlayer(victim)) + "|cffFF4040的|r" + GetUnitName(victim) + "|cffFF4040被|r" + aQ[1 + GetPlayerId(GetOwningPlayer(killer))] + GetPlayerName(GetOwningPlayer(killer)) + "|r|cffFF4040的|r" + GetUnitName(killer) + "|cffFF4040击败了|r|cffFF4040,损失黄金|r" + I2S(100 + GetUnitLevel(victim) * 20) + "|cffFF4040两!|r")
            set OOOI0[GetConvertedPlayerId(GetOwningPlayer(killer))] = OOOI0[GetConvertedPlayerId(GetOwningPlayer(killer))] + 1
        else
            call DisplayTextToForce(bj_FORCE_ALL_PLAYERS, GetPlayerName(GetOwningPlayer(victim)) + "|cff00EE76的|r" + GetUnitName(victim) + "|cff00EE76被|r" + aQ[1 + GetPlayerId(GetOwningPlayer(killer))] + GetPlayerName(GetOwningPlayer(killer)) + "|r|cff00EE76的|r" + GetUnitName(killer) + "|cff00EE76击败了|r|cff00EE76,损失黄金|r" + I2S(100 + GetUnitLevel(victim) * 20) + "|cff00EE76两!|r")
        endif

        call Assist_OnKill(victim, killer)

        set victim = null
        set killer = null
    endif
endfunction

function O0I000O takes nothing returns nothing
    set OI0O0O = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(OI0O0O, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(OI0O0O, function O0I00OO)
endfunction


// ====================================
// 初始化函数（原样保留）
// ====================================
function InitTrig_AssistSystem takes nothing returns nothing
    local integer i

    // 1. 初始化英雄注册标记与英雄单位数组
    set i = 0
    loop
        exitwhen i >= 12
        set HeroReg[i] = false
        set PlayerHero[i] = null
        set i = i + 1
    endloop

    // 2. 预创建全部助攻计时器（12×12=144个，运行时仅启停不销毁）
    set i = 1
    loop
        exitwhen i > 144
        set AssistTimer[i] = CreateTimer()
        set i = i + 1
    endloop

    // 3. 注册区域进入事件（英雄进入区域自动绑定助攻监听）
    call AST_InitEnter()
endfunction


function STN_CheatGold takes player p returns nothing
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)+10000)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)+50)
endfunction
function STN_CheatVision takes player p returns nothing
local integer id=GetPlayerId(p)
if STN_CheatFog[id]!=null then
call FogModifierStop(STN_CheatFog[id])
call DestroyFogModifier(STN_CheatFog[id])
set STN_CheatFog[id]=null
endif
set STN_CheatFog[id]=CreateFogModifierRect(p,FOG_OF_WAR_VISIBLE,bj_mapInitialPlayableArea,false,false)
call FogModifierStart(STN_CheatFog[id])
set STN_CheatFogOn[id]=true
endfunction
function STN_CheatVisionOff takes player p returns nothing
local integer id=GetPlayerId(p)
if STN_CheatFog[id]!=null then
call FogModifierStop(STN_CheatFog[id])
call DestroyFogModifier(STN_CheatFog[id])
set STN_CheatFog[id]=null
endif
set STN_CheatFogOn[id]=false
set STN_CheatState[id]=0
endfunction
function STN_CheatLevel takes player p returns nothing
local unit u=O101O[GetPlayerId(p)]
if u!=null and IsUnitType(u,UNIT_TYPE_HERO) then
call SetHeroLevelBJ(u,GetHeroLevel(u)+1,false)
endif
set u=null
endfunction
function STN_CheatSpeed takes player p returns nothing
local unit u=O101O[GetPlayerId(p)]
if u!=null then
call SetUnitMoveSpeed(u,GetUnitMoveSpeed(u)+30.)
endif
set u=null
endfunction
function STN_CheatMerit takes player p returns nothing
local integer id=1+GetPlayerId(p)
set I100O[id]=I100O[id]+10
endfunction
function STN_CheatStats takes player p returns nothing
local unit u=O101O[GetPlayerId(p)]
if u!=null and IsUnitType(u,UNIT_TYPE_HERO) then
call ModifyHeroStat(bj_HEROSTAT_STR,u,bj_MODIFYMETHOD_ADD,20)
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,20)
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,20)
endif
set u=null
endfunction
function STN_CheatCooldown takes player p returns nothing
local unit u=O101O[GetPlayerId(p)]
if u!=null then
call UnitResetCooldown(u)
endif
set u=null
endfunction
function STN_CheatApply takes player p,integer c returns boolean
local integer id=GetPlayerId(p)
if c==3 and STN_CheatState[id]==6 then
call STN_CheatGold(p)
set STN_CheatState[id]=0
return true
endif
if c==1 and STN_CheatState[id]==8 then
call STN_CheatVision(p)
set STN_CheatState[id]=0
return true
endif
if c==4 and STN_CheatState[id]==15 then
call STN_CheatLevel(p)
set STN_CheatState[id]=0
return true
endif
if c==2 and STN_CheatState[id]==16 then
call STN_CheatSpeed(p)
set STN_CheatState[id]=0
return true
endif
if c==3 and STN_CheatState[id]==17 then
call STN_CheatMerit(p)
set STN_CheatState[id]=0
return true
endif
if c==1 and STN_CheatState[id]==19 then
call STN_CheatStats(p)
set STN_CheatState[id]=0
return true
endif
if c==3 and STN_CheatState[id]==21 then
call STN_CheatCooldown(p)
set STN_CheatState[id]=0
return true
endif
return false
endfunction
function STN_CheatKey takes integer k returns nothing
local player p=GetTriggerPlayer()
local integer id=GetPlayerId(p)
local integer s0=STN_CheatState[id]
if STN_CheatApply(p,k) then
set p=null
return
