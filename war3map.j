//司马星落
// ========== 技能施法条件 ==========
function xMmc8 takes nothing returns boolean
    return GetSpellAbilityId() == 'A041'
endfunction

// ========== 马甲施放火焰风暴 ==========
function cMmc8 takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local real casterX
    local real casterY
    local real targetX
    local real targetY
    local real faceAngle
    local unit dummy

    // 前置兜底：施法者无效直接退出
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    // 原生坐标获取，无需Location中转
    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)
    set targetX = GetSpellTargetX()
    set targetY = GetSpellTargetY()
    set faceAngle = Atan2(targetY - casterY, targetX - casterX) * bj_RADTODEG

    // 创建马甲 + 创建判空，杜绝空指针崩溃
    set dummy = CreateUnit(GetOwningPlayer(caster), 'h046', targetX, targetY, faceAngle)
    if dummy != null then
        call SetUnitAbilityLevel(dummy, 'A0QF', GetUnitAbilityLevel(caster, 'A041'))
        call UnitApplyTimedLife(dummy, 'BTLF', 8.0)
        call IssuePointOrder(dummy, "flamestrike", targetX, targetY)
        set dummy = null
    endif

    set caster = null
endfunction

