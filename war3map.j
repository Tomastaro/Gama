function Trig_A_Func007002003xzg9 takes nothing returns boolean
    return IsUnitDeadBJ(GetFilterUnit()) == false and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_chufa11)) == true
endfunction

function Trig_Axzg9_Actions takes nothing returns nothing
    set udg_chufa11 = GetTriggerUnit()
    set udg_dian[90] = GetUnitLoc(udg_chufa11)
    set udg_dian[93] = GetSpellTargetLoc()
    set udg_danwei[5240] = CreateUnitAtLoc(GetOwningPlayer(udg_chufa11), 'ewsp', udg_dian[90], 0)
    call ShowUnitHide(udg_danwei[5240])
    call UnitApplyTimedLife(udg_danwei[5240], 'BTLF', 6.0)
    set udg_zu[90] = GetUnitsInRangeOfLocMatching(240.00, udg_dian[90], Condition(function Trig_A_Func007002003xzg9))
    call RemoveLocation(udg_dian[90])
    set udg_dian[90] = null
    set udg_buer[90] = true
    set udg_buer[91] = true
    set udg_zhengshu[90] = 0

    if udg_feijiang != null and Cvt[3] != null then
        // 第二段伤害系数 4
        call UnitDamageTargetBJ(udg_chufa11, udg_feijiang, (50 + 50 * GetUnitAbilityLevelSwapped('A0RS', Cvt[3]) + 60 + GetHeroStatBJ(bj_HEROSTAT_STR, Cvt[3], true) + udg_LubuAttack2) * 4, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    endif

    call StartTimerBJ(udg_jsq11, false, 0.06)
    call EnableTrigger(gg_trg_Bxzg9)
endfunction

