                call SetUnitScale(effectUnit, 1.30, 1.30, 1.30)
                call SetUnitTimeScale(effectUnit, 1.20)
                call UnitApplyTimedLife(effectUnit, 'BHwe', 0.40)
                call SaveUnitHandle(ght_temp, id, 0xB215FA06, effectUnit)
            endif
            
