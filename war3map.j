function OOO000 takes nothing returns nothing
local integer i=0
call DisableTrigger(GetTriggeringTrigger())
call I101IO(GetLocalPlayer(),"|CFFFFFF00开始检测|r")
call I1IIIO()
loop
exitwhen i==12
if I1010O(Player(i))then
call I1I01O(Player(i))
endif
set i=i+1
endloop
call TriggerSleepAction(2)
set i=0
loop
exitwhen i==12
if I1010O(Player(i))then
call I101IO(GetLocalPlayer(),GetPlayerName(Player(i))+" 延时 "+R2S(O11O[i]))
if IsPlayerInForce(Player(i),O1OO)then
set OI1O[GetPlayerId(Player(i))+1]=Player(i)
call BJDebugMsg("玩家 |cff00FFFF"+I2S(GetPlayerId(Player(i))+1)+"  |cffFFFFFF玩家名字 |cff00FFFF"+GetPlayerName(Player(i))+" |cffFFFFFF正在作弊!")
call SetTerrainFogExBJ(0,1000.,1560.,.5,100.,100.,100.)
endif
endif
set i=i+1
endloop
call EnableTrigger(I10I0)
endfunction

