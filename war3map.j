//马超冲锋
// 条件
function R1x takes nothing returns boolean
    return GetSpellAbilityId() == 'A0HN'
endfunction

// ====================================
// 震荡波动作（局部变量版，零泄漏）
// ====================================
function cMmc4 takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location loc1
    local location loc2
    local unit dummy
    if caster == null then
        return
    endif
    set loc1 = GetUnitLoc(caster)
    set loc2 = GetSpellTargetLoc()
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'h041', loc1, AngleBetweenPoints(loc1, loc2))
    call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
    call IssuePointOrderLoc(dummy, "shockwave", loc2)
    call RemoveLocation(loc1)
    call RemoveLocation(loc2)
    set loc1 = null
    set loc2 = null
    set dummy = null
    set caster = null
endfunction

// ====================================
// 周期回调（每0.03秒）
// ====================================
function MaChao_MoveCallback takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_MaChao, id, 1)
    local location startLoc = LoadLocationHandle(udg_HT_MaChao, id, 2)
    local location targetLoc = LoadLocationHandle(udg_HT_MaChao, id, 3)
    local real angle = LoadReal(udg_HT_MaChao, id, 4)
    local real chargeDist = LoadReal(udg_HT_MaChao, id, 5)   // 固定1200距离
    local real currentDist = LoadReal(udg_HT_MaChao, id, 6)
    local real step = chargeDist / 30.0
    local location newLoc
    local location treeLoc
    local real dx
    local real dy
    local group g
    local unit u
    local unit dummyStun
    local unit dummyBuff
    local location p
    local real x
    local real y

    // 防崩
    if caster == null or IsUnitAliveBJ(caster) == false then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_MaChao, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    // 终点判定
    if currentDist >= chargeDist then
        call SetUnitAnimationWithRarity(caster, "Stand", RARITY_RARE)
        call SetUnitInvulnerable(caster, false)
        call UnitRemoveAbility(caster, 'A0H8')
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_MaChao, id)
        call DestroyTimer(t)
    else
        set currentDist = currentDist + step
        call SaveReal(udg_HT_MaChao, id, 6, currentDist)

        set newLoc = Ya(startLoc, currentDist, angle)
        call SetUnitPositionLocFacingBJ(caster, newLoc, angle)

        // 沿途伤害、击退、眩晕
        set dx = 40 * Cos(angle * bj_DEGTORAD)
        set dy = 40 * Sin(angle * bj_DEGTORAD)
        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, GetUnitX(caster), GetUnitY(caster), 200.0, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            if IsUnitEnemy(u, GetOwningPlayer(caster)) and GetWidgetLife(u) > 0.405 and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                call UnitDamageTarget(caster, u, udg_hurt[3], true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                call SetUnitX(u, GetUnitX(u) + dx)
                call SetUnitY(u, GetUnitY(u) + dy)

                set dummyStun = CreateUnit(GetOwningPlayer(caster), 'h04F', GetUnitX(u), GetUnitY(u), 0)
                call UnitAddAbility(dummyStun, 'A0Q4')
                call IssueTargetOrder(dummyStun, "thunderbolt", u)
                call UnitApplyTimedLife(dummyStun, 'BTLF', 1.0)
                set dummyStun = null

                set dummyBuff = CreateUnit(GetOwningPlayer(caster), 'h02T', GetUnitX(u), GetUnitY(u), 0)
                call UnitAddAbility(dummyBuff, 'A0H1')
                set p = GetUnitLoc(u)
                call IssuePointOrderLoc(dummyBuff, "impale", p)
                call RemoveLocation(p)   // 修复原版泄漏
                call UnitApplyTimedLife(dummyBuff, 'BTLF', 1.0)
                set dummyBuff = null
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g = null
        set u = null

        // 破坏树木
        set treeLoc = GetUnitLoc(caster)
        call EnumDestructablesInCircleBJ(200., treeLoc, function NA1)
        call RemoveLocation(treeLoc)
        set treeLoc = null

        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", caster, "origin"))
        call RemoveLocation(newLoc)
        set newLoc = null
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 施法动作
// ====================================
function A3x takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local real angle
    local real totalDist = 1200.0
    local timer t
    local integer id
    local unit dummy

    if caster == null then
        return
    endif

    // 伤害基数（与原版一致）
    set udg_hurt[3] = ((GetHeroStatBJ(bj_HEROSTAT_STR, caster, false) - 30) * 20 + GetUnitMoveSpeed(caster) + GetUnitAbilityLevel(caster, 'A0HC') * 50) * 0.15

    set startLoc = GetUnitLoc(caster)
    set targetLoc = GetSpellTargetLoc()
    set angle = AngleBetweenPoints(startLoc, targetLoc)

    if DistanceBetweenPoints(startLoc, targetLoc) <= 1.0 then
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        set caster = null
        return
    endif

    // 穿刺马甲
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'h04F', startLoc, angle)
    set imp_u[4] = dummy
    call UnitApplyTimedLife(dummy, 'BTLF', 3.0)

    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'h02T', startLoc, angle)
    call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
    call IssuePointOrderLoc(dummy, "impale", targetLoc)

    // 英雄状态
    call SetUnitAnimationWithRarity(caster, "Attack Throw", RARITY_RARE)
    call SetUnitInvulnerable(caster, true)
    call UnitAddAbility(caster, 'A0H8')

    // 启动独立计时器
    set t = CreateTimer()
    set id = GetHandleId(t)
    call SaveUnitHandle(udg_HT_MaChao, id, 1, caster)
    call SaveLocationHandle(udg_HT_MaChao, id, 2, startLoc)
    call SaveLocationHandle(udg_HT_MaChao, id, 3, targetLoc)
    call SaveReal(udg_HT_MaChao, id, 4, angle)
    call SaveReal(udg_HT_MaChao, id, 5, totalDist)
    call SaveReal(udg_HT_MaChao, id, 6, 0.0)
    call TimerStart(t, 0.03, true, function MaChao_MoveCallback)

    set caster = null
    set startLoc = null
    set targetLoc = null
    set t = null
endfunction

// ====================================
// 震荡波条件
// ====================================
function xMmc4 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0HN'
endfunction

// ====================================
// 初始化
// ====================================
function InitTrig_MaChaoChongZhuang takes nothing returns nothing
    local trigger trig

    // 哈希表初始化
    if udg_HT_MaChao == null then
        set udg_HT_MaChao = InitHashtable()
    endif

    // 冲锋主技能
    set trig = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trig, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trig, Condition(function R1x))
    call TriggerAddAction(trig, function A3x)

    // 震荡波（独立触发，无冲突）
    set trig = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(trig, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(trig, Condition(function xMmc4))
    call TriggerAddAction(trig, function cMmc4)

    set trig = null
endfunction



//===========================================================================
// 威震列枪 (WEIZHENLIE)
// 当马超('N00Q')攻击带有B04X Buff的目标，且自身A0N6技能等级为2时，
// 在目标身后召唤马甲施放战争践踏和恐怖嚎叫，并刷新目标身上的A0UZ技能。
//===========================================================================

function QBzxpy1_OnDamage takes nothing returns nothing
    local unit source = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local location sourceLoc
    local location targetLoc
    local real facing
    local real angle
    local real knockbackDist = 30.0
    local real radius = 250.0
    local real x
    local real y
    local group g
    local unit u
    local location uLoc
    local real origX
    local real origY
    local location tempLoc1
    local location baseLoc

    if source == null or target == null then
        return
    endif

    // 新增条件：当来源为 N00Q 或 U00Q，拥有 A0T6 技能，目标有 B04X 时，移除 A0T6
    if (GetUnitTypeId(source) == 'N00Q' or GetUnitTypeId(source) == 'U00Q') and GetUnitAbilityLevelSwapped('A0T6', source) > 0 and UnitHasBuffBJ(target, 'B04X') == true then
        call UnitRemoveAbility(source, 'A0T6')
    endif

    // 原威震列枪效果（仅对 N00Q 生效）
    if GetUnitTypeId(source) == 'N00Q' and UnitHasBuffBJ(target, 'B04X') == true then
        call UnitRemoveAbility(jv[615], 'A0UZ')
        set jv[615] = target
        call UnitAddAbility(jv[615], 'A0UZ')
        
        set sourceLoc = GetUnitLoc(source)
        set origX = GetUnitX(target)
        set origY = GetUnitY(target)
        
        // 只在主目标原位置播放一次特效
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", origX, origY))
        
        set g = CreateGroup()
        set targetLoc = GetUnitLoc(target)
        call GroupEnumUnitsInRangeOfLoc(g, targetLoc, radius, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            if IsUnitEnemy(u, GetOwningPlayer(source)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and GetWidgetLife(u) > 0.405 then
                set uLoc = GetUnitLoc(u)
                set angle = Atan2(GetLocationY(uLoc) - GetLocationY(sourceLoc), GetLocationX(uLoc) - GetLocationX(sourceLoc))
                set x = GetUnitX(u) + knockbackDist * Cos(angle)
                set y = GetUnitY(u) + Sin(angle)
                call SetUnitX(u, x)
                call SetUnitY(u, y)
                call RemoveLocation(uLoc)
                set uLoc = null
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g = null
        call RemoveLocation(targetLoc)
        set targetLoc = null
        call RemoveLocation(sourceLoc)
        set sourceLoc = null
        
        set facing = GetUnitFacing(source)
        // 第一个马甲：修复匿名location泄漏
        set baseLoc = Location(origX, origY)
        set tempLoc1 = PolarProjectionBJ(baseLoc, -50, facing)
        call CreateNUnitsAtLoc(1, 'e00D', GetOwningPlayer(source), tempLoc1, facing)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        call SetUnitAbilityLevelSwapped('A0NY', bj_lastCreatedUnit, 2)
        call IssueImmediateOrderBJ(bj_lastCreatedUnit, "stomp")
        call RemoveLocation(tempLoc1)
        call RemoveLocation(baseLoc)
        set tempLoc1 = null
        set baseLoc = null
        
        // 第二个马甲：修复匿名location泄漏
        set baseLoc = Location(origX, origY)
        set tempLoc1 = PolarProjectionBJ(baseLoc, -50, facing)
        call CreateNUnitsAtLoc(1, 'e02T', GetOwningPlayer(source), tempLoc1, facing)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        call SetUnitAbilityLevelSwapped('A0NM', bj_lastCreatedUnit, GetUnitAbilityLevelSwapped('A0HL', source))
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "howlofterror")
        call RemoveLocation(tempLoc1)
        call RemoveLocation(baseLoc)
        set tempLoc1 = null
        set baseLoc = null
    endif
    
    set source = null
    set target = null
endfunction

function QBzxpy1_RegisterEnteringUnit takes nothing returns nothing
    local unit u = GetTriggerUnit()
    if u != null then
        call TriggerRegisterUnitEvent(gg_trg_WEIZHENLIE, u, EVENT_UNIT_DAMAGED)
    endif
    set u = null
endfunction

function QBzxpy1_InitAnyUnitDamage takes nothing returns nothing
    local group g = CreateGroup()
    local unit u
    local trigger enterTrig = CreateTrigger()
    
    call GroupEnumUnitsInRect(g, bj_mapInitialPlayableArea, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if u != null then
            call TriggerRegisterUnitEvent(gg_trg_WEIZHENLIE, u, EVENT_UNIT_DAMAGED)
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
    
    call TriggerRegisterEnterRectSimple(enterTrig, bj_mapInitialPlayableArea)
    call TriggerAddAction(enterTrig, function QBzxpy1_RegisterEnteringUnit)
    set enterTrig = null
endfunction

function InitTrig_WEIZHENLIE takes nothing returns nothing
    set gg_trg_WEIZHENLIE = CreateTrigger()
    call TriggerAddAction(gg_trg_WEIZHENLIE, function QBzxpy1_OnDamage)
    call QBzxpy1_InitAnyUnitDamage()
endfunction


