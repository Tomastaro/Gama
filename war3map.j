    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(t, Condition(function Learn_A00O_Cond))
    call TriggerAddAction(t, function Learn_A00O_Act)
    set t = null
endfunction
