//张合2
// 筛选条件：敌方英雄 + 有指定Buff
// ========== 单位筛选过滤函数 ==========
function Trig_thundermoveFunc02 takes nothing returns boolean
    local unit u = GetFilterUnit()
    local boolean result
    
    // 前置有效性校验
    if u == null or GetWidgetLife(u) <= 0.405 then
        set u = null
        return false
    endif
    
    // 非英雄/是施法者本人，直接排除
    if not IsUnitType(u, UNIT_TYPE_HERO) or u == udg_ThunderCaster then
        set u = null
        return false
    endif
    
    // 修复：恢复标准Buff检测，确保状态判断准确生效
    set result = UnitHasBuffBJ(u, 'B05H') or UnitHasBuffBJ(u, 'B05G') or UnitHasBuffBJ(u, 'B05E') or UnitHasBuffBJ(u, 'B05F')
    set u = null
    return result
endfunction

// ========== 技能施法主逻辑 ==========
function Trig_thundermoveActions takes nothing returns nothing
    local unit caster
    local real casterX
    local real casterY
    local real targetX
    local real targetY
    local group g
    local unit target
    local boolexpr filter

    set caster = GetTriggerUnit()
    set target = null

    // 入口兜底
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set casterX = GetUnitX(caster)
    set casterY = GetUnitY(caster)
    set targetX = GetSpellTargetX()
    set targetY = GetSpellTargetY()
    set g = CreateGroup()
    set filter = Filter(function Trig_thundermoveFunc02)
    
    set udg_ThunderCaster = caster
    
    // 枚举范围内单位
    call GroupEnumUnitsInRange(g, casterX, casterY, 3000.0, filter)
    // 枚举完成后销毁过滤表达式，同步执行无风险
    call DestroyBoolExpr(filter)
    set filter = null
    
    set target = GroupPickRandomUnit(g)
    
    // 目标有效才执行传送
    if target != null and GetWidgetLife(target) > 0.405 then
        call SetUnitPosition(target, targetX, targetY)
    endif
    
    // 资源清理
    call DestroyGroup(g)
    set udg_ThunderCaster = null
    
    set g = null
    set caster = null
    set target = null
endfunction

// ========== 技能施法条件 ==========
function Trig_thundermoveConditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0GP'
endfunction

// ========== 触发器初始化 ==========
function Init_A0BI takes nothing returns nothing
    set gg_trg_thundermove = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_thundermove, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_thundermove, Condition(function Trig_thundermoveConditions))
    call TriggerAddAction(gg_trg_thundermove, function Trig_thundermoveActions)
endfunction

//张合3
// ========== 攻击触发条件 ==========
function BN takes nothing returns boolean
    local unit atk = GetAttacker()
    local unit def = GetTriggerUnit()
    local boolean result

    // 双端有效性校验
    if atk == null or GetWidgetLife(atk) <= 0.405 or def == null or GetWidgetLife(def) <= 0.405 then
        set atk = null
        set def = null
        return false
    endif

    // 优先判断单位类型，快速拦截无效调用
    if GetUnitTypeId(atk) != 'E019' then
        set atk = null
        set def = null
        return false
    endif

    // 完整条件：基础敏捷低于150 + 非幻象 + 敌方目标
    set result = GetHeroAgi(atk, false) < 150 and not IsUnitIllusionBJ(atk) and IsUnitEnemy(def, GetOwningPlayer(atk))
    
    set atk = null
    set def = null
    return result
endfunction

// ========== 单位死亡清理：清除哈希表数据，避免句柄复用异常 ==========
function A0G4_DeathCond takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'E019'
endfunction

function A0G4_DeathAct takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer id = GetHandleId(u)
    call FlushChildHashtable(udg_HT_AgilStack, id)
    set u = null
endfunction

// ========== 层数叠加主逻辑 ==========
function FN takes nothing returns nothing
    local unit atk = GetAttacker()
    local integer id
    local integer lv
    local integer stack
    local integer add = 0

    if atk == null or GetWidgetLife(atk) <= 0.405 then
        set atk = null
        return
    endif

    set id = GetHandleId(atk)
    set lv = GetUnitAbilityLevel(atk, 'A0G4')
    
    // 技能等级为0直接退出
    if lv <= 0 then
        set atk = null
        return
    endif

    set stack = LoadInteger(udg_HT_AgilStack, id, 0)

    // 层数上限判断（逻辑完全保留，未做偏差修正）
    if stack > 173 then
        // 修复：原生函数永久增加3点敏捷，替代参数错位的ModifyHeroStat
        call SetHeroAgi(atk, GetHeroAgi(atk, false) + 3, true)
        call SaveInteger(udg_HT_AgilStack, id, 0, 0)
        set atk = null
        return
    endif

    // 按技能等级确定叠加量
    if lv == 1 then
        set add = 3
    elseif lv == 2 then
        set add = 4
    elseif lv == 3 then
        set add = 5
    elseif lv == 4 then
        set add = 6
    endif

    call SaveInteger(udg_HT_AgilStack, id, 0, stack + add)
    set atk = null
endfunction

// ========== 触发器初始化 ==========
function Init_A0G4 takes nothing returns nothing
    local trigger t
    if udg_HT_AgilStack == null then
        set udg_HT_AgilStack = InitHashtable()
    endif

    // 攻击叠加层数触发器
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(t, Condition(function BN))
    call TriggerAddAction(t, function FN)

    // 单位死亡清理触发器
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(t, Condition(function A0G4_DeathCond))
    call TriggerAddAction(t, function A0G4_DeathAct)

    set t = null
endfunction
//司马大招
// ====================================
// 火阵技能 A0VL
// ====================================
function Trig_firezhen1Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0VL'
endfunction
function Trig_firezhen1Actions takes nothing returns nothing
    local unit target
    local unit caster
    local real targetX
    local real targetY
    local integer lvl
    local integer i
    local real angle
    local real posX
    local real posY
    local real faceAngle
    local unit coreDummy
    local unit stunDummy
    local unit swordDummy
    local player casterOwner

    set target = GetSpellTargetUnit()
    set caster = GetTriggerUnit()

    // 入口兜底
    if target == null or GetWidgetLife(target) <= 0.405 then
        set target = null
        set caster = null
        return
    endif

    set casterOwner = GetOwningPlayer(caster)
    set targetX = GetUnitX(target)
    set targetY = GetUnitY(target)
    set lvl = GetUnitAbilityLevel(caster, 'A0VL')

    set firezhen[1] = target
    set firezhen[3] = caster

    // ==============================================
    // 修复1：新施法前清理旧核心马甲，避免无主残留
    // ==============================================
    if firezhen[2] != null and GetWidgetLife(firezhen[2]) > 0.405 then
        call RemoveUnit(firezhen[2])
        set firezhen[2] = null
    endif

    // 核心马甲
    set coreDummy = CreateUnit(casterOwner, 'h00J', targetX, targetY, bj_UNIT_FACING)
    if coreDummy == null then
        set target = null
        set caster = null
        return
    endif
    call SetWidgetLife(coreDummy, 2.0 + I2R(lvl) * 2.0)
    // ==============================================
    // 修复2：添加15秒兜底限时生命，杜绝永久堆积
    // ==============================================
    call UnitApplyTimedLife(coreDummy, 'BTLF', 15.0)
    set firezhen[2] = coreDummy
    set coreDummy = null

    // 眩晕马甲
    set stunDummy = CreateUnit(casterOwner, 'e023', targetX, targetY, bj_UNIT_FACING)
    if stunDummy != null then
        call UnitAddAbility(stunDummy, 'A03G')
        call SetUnitAbilityLevel(stunDummy, 'A03G', lvl)
        call IssueImmediateOrder(stunDummy, "stomp")
        call UnitApplyTimedLife(stunDummy, 'BTLF', 3.0)
        set stunDummy = null
    endif

    // 12把飞剑
    set i = 1
    loop
        exitwhen i > 12
        set angle = I2R(30 * i) * bj_DEGTORAD
        set posX = targetX + 500.0 * Cos(angle)
        set posY = targetY + 500.0 * Sin(angle)
        set faceAngle = Atan2(targetY - posY, targetX - posX) * bj_RADTODEG
        
        set swordDummy = CreateUnit(casterOwner, 'h00N', posX, posY, faceAngle)
        if swordDummy != null then
            call SetUnitAbilityLevel(swordDummy, 'A0PJ', i)
            call SetWidgetLife(swordDummy, 1.0 + I2R(lvl) * 2.0)
            call IssueTargetOrder(swordDummy, "attack", target)
            call UnitApplyTimedLife(swordDummy, 'BTLF', 10.0)
            set swordDummy = null
        endif
        
        set i = i + 1
    endloop

    set target = null
    set caster = null
    set casterOwner = null
endfunction


// 范围反伤条件
function Trig_firezhen2Conditions takes nothing returns boolean
    local unit core = firezhen[2]
    local unit triggerUnit = GetTriggerUnit()
    local real x1
    local real y1
    local real x2
    local real y2
    local real dx
    local real dy

    // 优先判空
    if core == null or GetWidgetLife(core) <= 0.405 then
        set core = null
        set triggerUnit = null
        return false
    endif

    set x1 = GetUnitX(triggerUnit)
    set y1 = GetUnitY(triggerUnit)
    set x2 = GetUnitX(core)
    set y2 = GetUnitY(core)
    set dx = x1 - x2
    set dy = y1 - y2

    set core = null
    set triggerUnit = null
    return (dx*dx + dy*dy <= 250000.0) and IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(firezhen[2])) and GetEventDamage() >= 10.00 and GetEventDamageSource() != firezhen[2]
endfunction

function Trig_firezhen2Actions takes nothing returns nothing
    local unit target = GetTriggerUnit()
    local unit source = firezhen[2]
    local effect fx

    if source != null and GetWidgetLife(source) > 0.405 and target != null and GetWidgetLife(target) > 0.405 then
        call UnitDamageTargetBJ(source, target, GetEventDamage() * 0.40, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
        set fx = AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl", target, "origin")
        if fx != null then
            call DestroyEffect(fx)
            set fx = null
        endif
    endif

    set target = null
    set source = null
endfunction

// 飞剑伤害条件
function Trig_firezhen3Conditions takes nothing returns boolean
    return GetUnitTypeId(GetEventDamageSource()) == 'h00N'
endfunction

function Trig_firezhen3Actions takes nothing returns nothing
    local unit dummy = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local unit hero = firezhen[3]
    local real damage = 0.0
    local effect fx

    if dummy != null and GetWidgetLife(dummy) > 0.405 and target != null and GetWidgetLife(target) > 0.405 then
        if hero != null and GetWidgetLife(hero) > 0.405 then
            set damage = I2R(GetHeroInt(hero, true)) * 0.5
            call UnitDamageTargetBJ(hero, target, damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
            set fx = AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl", target, "origin")
            if fx != null then
                call DestroyEffect(fx)
                set fx = null
            endif
        endif
        call UnitRemoveAbility(dummy, 'A0PJ')
    endif

    set dummy = null
    set target = null
    set hero = null
endfunction

