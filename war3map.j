    set t = null
endfunction

//张合1
function kNx takes nothing returns boolean
    return GetSpellAbilityId() == 'A0TB'
endfunction

function KNx takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    local unit caster = GetTriggerUnit()
    local real tx
    local real ty
    local real cx
    local real cy
    local real angle
    local real nx
    local real ny

    // 入口兜底：单位无效直接终止
    if target == null or GetWidgetLife(target) <= 0.405 or caster == null or GetWidgetLife(caster) <= 0.405 then
        set target = null
        set caster = null
        return
    endif

    set jv[75] = target
    set jv[76] = caster

    // 纯坐标计算替代所有location，彻底根治点泄漏
    set tx = GetUnitX(target)
    set ty = GetUnitY(target)
    set cx = GetUnitX(caster)
    set cy = GetUnitY(caster)
    // 等价于 AngleBetweenPoints(目标点, 施法者点)
    set angle = Atan2(cy - ty, cx - tx)
    // 等价于 PolarProjectionBJ(目标点, 100, 角度)
    set nx = tx + 100.00 * Cos(angle)
    set ny = ty + 100.00 * Sin(angle)
    
    // 传送施法者到目标旁，保持原朝向，与原版效果完全一致
    call SetUnitPosition(caster, nx, ny)

    call PauseUnit(caster, true)
    call PauseUnit(target, true)
    call SetUnitTimeScalePercent(caster, 350.)
    call EnableTrigger(Xox)

    set target = null
    set caster = null
endfunction

function lNx takes nothing returns nothing
    local real dx
    local real dy
    local effect fx

    // 单位异常兜底（原版逻辑完全保留）
    if jv[75] == null or jv[76] == null or IsUnitDeadBJ(jv[75]) or IsUnitDeadBJ(jv[76]) then
        call DisableTrigger(Xox)
        if jv[76] != null then
            call PauseUnit(jv[76], false)
            call SetUnitTimeScalePercent(jv[76], 100.0)
        endif
        if jv[75] != null then
            call PauseUnit(jv[75], false)
        endif
        set jv[75] = null
        set jv[76] = null
        set bmhit[20] = 0
        return
    endif

    call SetUnitAnimation(jv[76], "attack")
    
    // 特效创建判空，避免资源异常崩溃
    set fx = AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", jv[75], "origin")
    if fx != null then
        call DestroyEffect(fx)
        set fx = null
    endif

    call UnitDamageTargetBJ(jv[76], jv[75], GetHeroStatBJ(1, jv[76], true) * 1.0, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    call SetUnitState(jv[75], UNIT_STATE_MANA, GetUnitState(jv[75], UNIT_STATE_MANA) - GetHeroStatBJ(2, jv[76], true) * 1.0)
    set bmhit[20] = bmhit[20] + 1

    set dx = GetUnitX(jv[75]) - GetUnitX(jv[76])
    set dy = GetUnitY(jv[75]) - GetUnitY(jv[76])
    if bmhit[20] >= 11 or dx*dx + dy*dy > 240.0*240.0 then
        call DisableTrigger(Xox)
        call SetUnitAnimation(jv[76], "attack slam")
        
        // 终结特效创建判空
        set fx = AddSpecialEffectTarget("war3mapImported\\CrimsonWake.mdl", jv[75], "origin")
        if fx != null then
            call DestroyEffect(fx)
            set fx = null
        endif

        call UnitDamageTargetBJ(jv[76], jv[75], GetHeroStatBJ(1, jv[76], true) * 2.0, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
        call SetUnitState(jv[75], UNIT_STATE_MANA, GetUnitState(jv[75], UNIT_STATE_MANA) - GetHeroStatBJ(2, jv[76], true) * 2.0)

        call PauseUnit(jv[76], false)
        call PauseUnit(jv[75], false)
        call SetUnitTimeScalePercent(jv[76], 100.0)
        set jv[75] = null
        set jv[76] = null
        set bmhit[20] = 0
        call PolledWait(0.2)
    endif
endfunction

// 初始化完全保留原版逻辑
function Init_Eox takes nothing returns nothing
    set Eox = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(Eox, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(Eox, Condition(function kNx))
    call TriggerAddAction(Eox, function KNx)

    set Xox = CreateTrigger()
    call DisableTrigger(Xox)
    call TriggerRegisterTimerEventPeriodic(Xox, 0.2)
    call TriggerAddAction(Xox, function lNx)
endfunction
