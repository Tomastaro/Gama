            if GetUnitAbilityLevel(caster, 'A0XF') == 1 then
                call UnitDamageTarget(caster, target, 15.00, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                call UnitDamageTarget(caster, target, 0.50 * I2R(GetHeroAgi(caster, true)), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
            else
