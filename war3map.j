// ===================== 清理函数（移除魔法书，恢复按钮） =====================
function LubuCharge_Clear takes unit u returns nothing
    local integer uid = GetHandleId(u)

    if u != null and LoadInteger(udg_HT_LubuCharge, uid, 10) == 1 then
        call UnitRemoveBuffBJ('B024', u)
        call UnitRemoveAbility(u, 'A0V4')
        call UnitRemoveAbility(u, 'A0M9')
        call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0V4', true)
        call SaveInteger(udg_HT_LubuCharge, uid, 10, 0)
    endif
endfunction

// ===================== 计时器到期回调 =====================
function LubuCharge_End takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer tid = GetHandleId(t)
    local unit u = LoadUnitHandle(udg_HT_LubuCharge, tid, 0)

    if u != null and GetWidgetLife(u) > 0.405 then
        call LubuCharge_Clear(u)
    endif

    call FlushChildHashtable(udg_HT_LubuCharge, tid)
    call DestroyTimer(t)
    set t = null
    set u = null
endfunction

// ===================== 英雄死亡回调 =====================
function LubuCharge_Death takes nothing returns nothing
    local unit u = GetTriggerUnit()
    if IsUnitType(u, UNIT_TYPE_HERO) then
        call LubuCharge_Clear(u)
    endif
    set u = null
endfunction

// ===================== 施法主逻辑 =====================
function cMqxz2 takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer uid
    local real baseSpeed
    local real extraDuration
    local real duration
    local timer t
    local integer tid

    if u == null then
        return
    endif

    set uid = GetHandleId(u)

    // 单位级互斥
    if LoadInteger(udg_HT_LubuCharge, uid, 10) == 1 then
        set u = null
        return
    endif
    call SaveInteger(udg_HT_LubuCharge, uid, 10, 1)

    // 读取当前基础移速（先移除可能残留的加速技能，避免读到异常值）
    call UnitRemoveAbility(u, 'A0M9')
    set baseSpeed = GetUnitMoveSpeed(u)

    // ★ 恢复你要求的动态持续时间公式：技能等级 + 2.0 + (移速 - 400) / 30
    set extraDuration = (baseSpeed - 400.0) / 30.0
    if extraDuration < 0.0 then
        set extraDuration = 0.0
    endif
    set duration = GetUnitAbilityLevel(u, 'A0RX') + 2.0 + extraDuration

    // 添加魔法书和Buff（移速不再由脚本修改，完全交给魔法书）
    call UnitAddAbility(u, 'A0M9')
    call UnitAddAbility(u, 'A0V4')
    call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0V4', false)

    // 启动计时器
    set t = CreateTimer()
    set tid = GetHandleId(t)
    call SaveUnitHandle(udg_HT_LubuCharge, tid, 0, u)
    call TimerStart(t, duration, false, function LubuCharge_End)

    set u = null
    set t = null
endfunction

// ===================== 初始化 =====================
function InitTrig_LubuCharge takes nothing returns nothing
    local trigger Vxxsz2 = CreateTrigger()
    local trigger mmqxz2 = CreateTrigger()
    local trigger deathTrig = CreateTrigger()

    if udg_HT_LubuCharge == null then
        set udg_HT_LubuCharge = InitHashtable()
    endif

    call TriggerRegisterAnyUnitEventBJ(Vxxsz2, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(Vxxsz2, Condition(function NRxsz2))
    call TriggerAddAction(Vxxsz2, function bRxsz2)

    call TriggerRegisterAnyUnitEventBJ(mmqxz2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(mmqxz2, Condition(function xMqxz2))
    call TriggerAddAction(mmqxz2, function cMqxz2)

    call TriggerRegisterAnyUnitEventBJ(deathTrig, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(deathTrig, function LubuCharge_Death)

    set Vxxsz2 = null
    set mmqxz2 = null
    set deathTrig = null
endfunction
// 计算两点间角度（返回角度）
function GetAngleBetweenUnits takes unit u1, unit u2 returns real
    local real dx = GetUnitX(u2) - GetUnitX(u1)
    local real dy = GetUnitY(u2) - GetUnitY(u1)
    return bj_RADTODEG * Atan2(dy, dx)
endfunction

// 标准化角度到0-360
function NormalizeAngle takes real angle returns real
    set angle = ModuloReal(angle, 360.0)
    if angle < 0.0 then
        set angle = angle + 360.0
    endif
    return angle
endfunction

// 计算两个角度的最小差（0-180）
function GetAngleDifference takes real angle1, real angle2 returns real
    local real diff = RAbsBJ(angle1 - angle2)
    if diff > 180.0 then
        set diff = 360.0 - diff
    endif
    return diff
endfunction

function pBx takes nothing returns nothing
    local unit atk = GetAttacker()
    local unit target = GetAttackedUnitBJ()
    
    if atk == null or target == null then
        return
    endif
    
    if GetUnitTypeId(atk) == 'Z00G' and GetUnitAbilityLevelSwapped('A0SA', atk) > 0 and IsUnitEnemy(target, GetOwningPlayer(atk)) then
        if GetAngleDifference(GetAngleBetweenUnits(target, atk), GetUnitFacing(target)) < 45.00 then
            call SetUnitAbilityLevelSwapped('A0KV', atk, 1 + GetUnitAbilityLevelSwapped('A0SA', atk))
        else
            call SetUnitAbilityLevelSwapped('A0KV', atk, 1)
        endif
    endif
    
    set atk = null
    set target = null
endfunction

function InitTrig_SideAtkCheck takes nothing returns nothing
    set sox = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(sox, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddAction(sox, function pBx)
endfunction


//鬼杀狙
// ================================
// 技能 A0RV 连击系统（稳定版）
// ================================
function xMtzf takes nothing returns boolean
    return GetSpellAbilityId() == 'A0RV'
endfunction

function cMtzf takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local unit target = GetSpellTargetUnit()
    local location tempLoc
    local unit dummy

    if u == null or target == null then
        set u = null
        set target = null
        return
    endif

    if GetUnitAbilityLevel(u, 'A0SQ') == 1 then
        set jv[809] = u
        set jv[339] = target
        set jc[349] = GetUnitLoc(target)

        call PauseUnit(u, true)
        call SetUnitAnimation(u, "Spell Slam")
        call UnitDamageTarget(u, target, (60 + GetHeroStr(u, true) + udg_LubuAttack2) * (GetUnitAbilityLevel(u, 'A0RV') * 0.1 + 0.1), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
        
        if impx != null then
            call SetUnitAbilityLevel(impx, 'A0Q4', 5)
            call IssueTargetOrder(impx, "thunderbolt", target)
        endif
        
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target, "origin"))

        set dummy = CreateUnitAtLoc(GetOwningPlayer(u), 'h04Q', jc[349], bj_UNIT_FACING)
        call UnitApplyTimedLife(dummy, 'BTLF', 3.0)
        call IssueImmediateOrder(dummy, "stomp")
        set dummy = null

        call UnitAddAbility(target, 'Amrf')
        call UnitRemoveAbility(target, 'Amrf')
        call SetUnitFlyHeight(target, 240.00, 1800.00)
        call TriggerSleepAction(0.15)
        call SetUnitFlyHeight(target, 320.00, 400.00)
        call TriggerSleepAction(0.15)
        call SetUnitFlyHeight(target, 200.00, 400.00)
        call TriggerSleepAction(0.4)
        call SetUnitFlyHeight(target, 0.00, 2000.00)

        call UnitRemoveAbility(u, 'A0SQ')
        call PauseUnit(u, false)

        if GetUnitAbilityLevel(u, 'A0SN') == 0 then
            call AddUnitAnimationProperties(u, "alternate", false)
        endif

        call RemoveLocation(jc[349])
        set jc[349] = null
        set jv[809] = null
        set jv[339] = null
    else
        set jv[809] = u
        set jc[106] = GetUnitLoc(u)

        set dummy = CreateUnitAtLoc(GetOwningPlayer(u), 'h04O', jc[106], GetUnitFacing(u))
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        call SetUnitAbilityLevel(dummy, 'A0RW', GetUnitAbilityLevel(u, 'A0RV'))
        call IssueTargetOrder(dummy, "thunderbolt", target)
        set dummy = null

        call RemoveLocation(jc[106])
        set jc[106] = null
        call TriggerSleepAction(0.2)

        if GetUnitAbilityLevel(u, 'A0SN') == 1 then
            call AddUnitAnimationProperties(u, "alternate", true)
        endif
    endif

    set u = null
    set target = null
endfunction

function xMtzf2 takes nothing returns boolean
    return GetSpellAbilityId() == 'A0RV'
endfunction

function cMtzf2 takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local unit target = GetSpellTargetUnit()
    local location l1
    local location l2

    if u == null or target == null then
        set u = null
        set target = null
        return
