function O01I1I takes nothing returns boolean
    local unit u=GetFilterUnit()
    local boolean b1=IsUnitAliveBJ(u)==true
    local boolean b2=IsUnitEnemy(u,GetOwningPlayer(OO0IO[OO00O]))==true
    local boolean b3=UnitHasBuffBJ(u,'Bvul')==false
    local boolean b4=IsUnitType(u,UNIT_TYPE_MECHANICAL)==false
    local boolean b5=IsUnitType(u,UNIT_TYPE_STRUCTURE)==false
    local boolean b6=UnitHasBuffBJ(u,'BHds')==false
    local boolean b7=UnitHasBuffBJ(u,'B035')==false
    set u=null
    return b1 and b2 and b3 and b4 and b5 and b6 and b7
endfunction

function O011OI takes nothing returns nothing
    local unit u=GetEnumUnit()
    if u==null then
        return
    endif
    // ✅ 完全保留你原来的参数，手感一模一样
    set O0OIO=OO0IO[OO00O]
    set O0O1O=u
    set O00OO=Atan2(GetUnitY(u)-GetUnitY(O0OIO),GetUnitX(u)-GetUnitX(O0OIO))
    set O000O=450.00
    set O00IO=1000.00
    set O001O=true
    set O0IOO=true
    
//call UnitDamageTarget(OO0IO[OO00O],u,I2R(GetHeroStatBJ(bj_HEROSTAT_STR,OO0IO[OO00O],true))*15.,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
//    call UnitDamageTarget(OO0IO[OO00O],GetEnumUnit(),450.00,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
    call UnitDamageTarget(OO0IO[OO00O],GetEnumUnit(),450.00 + I2R(GetHeroStatBJ(bj_HEROSTAT_STR, OO0IO[OO00O], true)) * 1.00,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
    call GroupAddUnit(OOI1O[OO00O],u)
    call TriggerExecute(I101I)
    
    set u=null
endfunction

function O0110I takes nothing returns nothing
    local location tempLoc
    set OO00O=II0IOO()
    // ✅ 修了空转计时器的BUG，单位没了直接回收
    if OO0IO[OO00O]==null then
        call II001O(OO00O)
        return
    endif

    if OO01O[OO00O]==1 then
        call PauseUnit(OO0IO[OO00O],true)
        call SetUnitAnimationByIndex(OO0IO[OO00O],6)
        call SetUnitTimeScale(OO0IO[OO00O],2.00)
        set OO01O[OO00O]=2
    elseif OO01O[OO00O]==2 and GetUnitState(OO0IO[OO00O],UNIT_STATE_LIFE)>0.34 then
        set OO10O[OO00O]=GetUnitX(OO0IO[OO00O])+OOI0O[OO00O]*Cos(OOIIO[OO00O])
        set OO1IO[OO00O]=GetUnitY(OO0IO[OO00O])+OOI0O[OO00O]*Sin(OOIIO[OO00O])
        
        if OOIOO[OO00O]>0.00 and not IsTerrainPathable(OO10O[OO00O],OO1IO[OO00O],PATHING_TYPE_WALKABILITY) then
            call SetUnitX(OO0IO[OO00O],OO10O[OO00O])
            call SetUnitY(OO0IO[OO00O],OO1IO[OO00O])
            
            set OO1OO[OO00O]=OO1OO[OO00O]+1
            if OO1OO[OO00O]==1 then
                // ✅ 修了原来的XY坐标写错的BUG，现在用正确的X+Y
                if IsTerrainPathable(OO10O[OO00O],OO1IO[OO00O],PATHING_TYPE_FLOATABILITY) then
                    call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",OO10O[OO00O],OO1IO[OO00O]))
                else
                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl",OO10O[OO00O],OO1IO[OO00O]))
                endif
            endif
            
            if OO1OO[OO00O]==2 then
                set OO1OO[OO00O]=0
            endif
            
            // ✅ 修了位置泄漏，用完就删点
            set tempLoc = GetUnitLoc(OO0IO[OO00O])
            call EnumDestructablesInCircleBJ(150.00,tempLoc,function O01III)
            call RemoveLocation(tempLoc)
            
            set tempLoc = GetUnitLoc(OO0IO[OO00O])
            call ForGroupBJ(GetUnitsInRangeOfLocMatching(220.00,tempLoc,Condition(function O01I1I)),function O011OI)
            call RemoveLocation(tempLoc)
            set tempLoc = null
        else
            set OO01O[OO00O]=0
        endif
        
        set OOIOO[OO00O]=OOIOO[OO00O]-OOI0O[OO00O]
    else
        call PauseUnit(OO0IO[OO00O],false)
        call SetUnitTimeScale(OO0IO[OO00O],1.00)
        call SetUnitAnimation(OO0IO[OO00O],"stand")
        
        set OO0IO[OO00O]=null
        call GroupClear(OOI1O[OO00O])
        call DestroyGroup(OOI1O[OO00O])
        call II001O(OO00O)
    endif
    set tempLoc=null
endfunction

