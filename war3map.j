function Init_A012_Skill takes nothing returns nothing
    local trigger t
    if udg_HT_ChargeA0Z3 == null then
        set udg_HT_ChargeA0Z3 = InitHashtable()
    endif
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function R1sx))
    call TriggerAddAction(t, function A3sx)
    set t = null
endfunction
//甘宁天赋
function Trig_A0TE_Main_Cond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0TE'
endfunction

// 主技能：范围伤害（力量×7）
function Trig_A0TE_Main_Act takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player p = GetOwningPlayer(caster)
    local real str = GetHeroStr(caster, true)
    local real damage = 7.0 * str
    local group g = CreateGroup()
    local unit u
    local location loc = GetUnitLoc(caster)

    call GroupEnumUnitsInRangeOfLoc(g, loc, 350.0, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if u != caster and IsUnitEnemy(u, p) and GetUnitState(u, UNIT_STATE_LIFE) > 0 then
            call UnitDamageTarget(caster, u, damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\CrimsonWake.mdl", u, "origin"))
        endif
    endloop
    call DestroyGroup(g)
    call RemoveLocation(loc)

    set caster = null
    set p = null
    set g = null
    set u = null
    set loc = null
endfunction

