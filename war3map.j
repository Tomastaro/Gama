//助攻这里开始
function O0IOIOO takes nothing returns nothing
    // ★ 列数从 7 改为 8
    call CreateMultiboardBJ(8, 14, "|cff00B2ee三国无双|r|cffee00eeR'|r")
    set I0IO = GetLastCreatedMultiboard()

    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopBIndex = 1
        set bj_forLoopBIndexEnd = 14
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call MultiboardSetItemStyleBJ(bj_lastCreatedMultiboard, bj_forLoopAIndex, bj_forLoopBIndex, true, false)
            call MultiboardSetItemWidthBJ(bj_lastCreatedMultiboard, bj_forLoopAIndex, bj_forLoopBIndex, 3.50)
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop

    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 14
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call MultiboardSetItemWidthBJ(bj_lastCreatedMultiboard, 1, bj_forLoopAIndex, 5.00)
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop

    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 2, 1, "TRIGSTR_45")
    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 3, 1, "TRIGSTR_46")
    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 4, 1, "TRIGSTR_47")
    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 5, 1, "TRIGSTR_48")
    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 6, 1, "TRIGSTR_59")
    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 7, 1, "助攻")       // ★ 新增加助攻表头
    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 8, 1, "TRIGSTR_49")  // ★ 原第7列移到第8列

    call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 1, 14, "|cFF5830E0游戏进行时间：")

    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 1, (bj_forLoopAIndex + 1), GetPlayerName(Player(-1 + bj_forLoopAIndex)))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 2, (bj_forLoopAIndex + 1), I2S(OOOI0[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 3, (bj_forLoopAIndex + 1), I2S(OO10[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 4, (bj_forLoopAIndex + 1), I2S(O0O0[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 5, (bj_forLoopAIndex + 1), I2S(I100O[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 6, (bj_forLoopAIndex + 1), I2S(R2I(TimerGetRemaining(OOI0[bj_forLoopAIndex]))))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 7, (bj_forLoopAIndex + 1), I2S(udg_AssistCount[bj_forLoopAIndex]))  // ★ 助攻数据
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 8, (bj_forLoopAIndex + 1), "|")                                   // ★ 原第7列占位符移到第8列
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop

    call MultiboardSetItemValueColor(MultiboardGetItem(I0IO, 1, 0), 255, 0, 0, 0)
    call MultiboardSetItemValueColor(MultiboardGetItem(I0IO, 5, 0), 255, 255, 0, 0)
    call MultiboardSetItemValueColor(MultiboardGetItem(I0IO, 9, 0), 153, 153, 153, 0)
    call MultiboardMinimize(bj_lastCreatedMultiboard, true)
endfunction
function O0IOI0O takes nothing returns nothing
set OIO1IO=CreateTrigger()
call TriggerRegisterTimerEventSingle(OIO1IO,0.00)
call TriggerAddAction(OIO1IO,function O0IOIOO)
endfunction
function O0IOIIO takes nothing returns boolean
if(not(IIOO>=60))then
return false
endif
return true
endfunction
function O0IOI1O takes nothing returns boolean
if(not(I01O>=60))then
return false
endif
return true
endfunction
function O0IO1OO takes nothing returns nothing
    set I01O = (I01O + 1)
    if O0IOI1O() then
        set I01O = 0
        set IIOO = (IIOO + 1)
        if O0IOIIO() then
            set IIOO = 0
            set II0O = (II0O + 1)
        endif
    endif

    call MultiboardSetItemValueBJ(I0IO, 3, 14, (I2S(II0O) + (":" + (I2S(IIOO) + (":" + I2S(I01O))))))
    call MultiboardSetTitleText(I0IO, ("|cff00B2ee三国无双|r|cffee00eeR'|r" + (" 赛时:  " + (I2S(II0O) + ("时" + (I2S(IIOO)) + ("分" + (I2S(I01O) + "秒")))))))

    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 2, (bj_forLoopAIndex + 1), I2S(OOOI0[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 3, (bj_forLoopAIndex + 1), I2S(OO10[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 4, (bj_forLoopAIndex + 1), I2S(O0O0[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 5, (bj_forLoopAIndex + 1), I2S(I100O[bj_forLoopAIndex]))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 6, (bj_forLoopAIndex + 1), I2S(R2I(TimerGetRemaining(OOI0[bj_forLoopAIndex]))))
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 7, (bj_forLoopAIndex + 1), I2S(udg_AssistCount[bj_forLoopAIndex]))  // ★ 助攻数据
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 8, (bj_forLoopAIndex + 1), "|")                                   // ★ 原第7列占位符移到第8列
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop

    set bj_forLoopBIndex = 2
    set bj_forLoopBIndexEnd = 7
    loop
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, bj_forLoopBIndex, 2, "--")
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, bj_forLoopBIndex, 6, "--")
        call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, bj_forLoopBIndex, 10, "--")
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction
