//郭嘉2
// ====================================
// 水龙技能：周期性范围打击
// 依赖全局哈希表：udg_HT_WaterDragon
// ====================================

// ========== 技能施法条件 ==========
function WaterDragon_Condition takes nothing returns boolean
    return GetSpellAbilityId() == 'A0NK'
endfunction

// ========== 周期伤害回调 ==========
function WaterDragon_Periodic takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_WaterDragon, id, 0)
    local integer count = LoadInteger(udg_HT_WaterDragon, id, 1) + 1
    local integer maxCount = LoadInteger(udg_HT_WaterDragon, id, 2)
    local unit dummy
    local real x
    local real y
    local effect fx
    local player casterOwner

    // 异常兜底：施法者无效/濒死，立刻清理所有资源
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        call PauseTimer(t)
        call FlushChildHashtable(udg_HT_WaterDragon, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        return
    endif

    set casterOwner = GetOwningPlayer(caster)
    call SaveInteger(udg_HT_WaterDragon, id, 1, count)

    set x = GetUnitX(caster)
    set y = GetUnitY(caster)

    // 范围技能马甲
    set dummy = CreateUnit(casterOwner, 'e05H', x, y, 0)
    if dummy != null then
        call SetUnitAbilityLevel(dummy, 'A0Y1', count)
        call SetUnitState(dummy, UNIT_STATE_MANA, 99999)
        call IssueImmediateOrderById(dummy, 852127)
        call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
        set dummy = null
    endif

    // 地面打击特效
    set fx = AddSpecialEffect("war3mapImported\\IceStomp.mdx", x, y)
    if fx != null then
        call DestroyEffect(fx)
        set fx = null
    endif

    // 持续次数耗尽，清理资源
    if count >= maxCount then
        call PauseTimer(t)
        call FlushChildHashtable(udg_HT_WaterDragon, id)
        call DestroyTimer(t)
    endif

    set t = null
    set caster = null
    set casterOwner = null
    set dummy = null
    set fx = null
endfunction

// ========== 技能启动入口 ==========
function WaterDragon_Start takes unit caster returns nothing
    local timer t
    local integer id
    local integer lv
    local integer maxCount

    // 前置校验：施法者无效直接退出，不创建任何资源
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set t = CreateTimer()
    set id = GetHandleId(t)
    set lv = GetUnitAbilityLevel(caster, 'A0NK')
    set maxCount = lv + 2

    call SaveUnitHandle(udg_HT_WaterDragon, id, 0, caster)
    call SaveInteger(udg_HT_WaterDragon, id, 1, 0)
    call SaveInteger(udg_HT_WaterDragon, id, 2, maxCount)

    call TimerStart(t, 1.0, true, function WaterDragon_Periodic)

    set t = null
    set caster = null
endfunction

// ========== 施法触发动作 ==========
function WaterDragon_Action takes nothing returns nothing
    call WaterDragon_Start(GetTriggerUnit())
endfunction

// ========== 触发器初始化 ==========
function InitTrig_WaterDragon takes nothing returns nothing
    local trigger t

    if udg_HT_WaterDragon == null then
        set udg_HT_WaterDragon = InitHashtable()
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function WaterDragon_Condition))
    call TriggerAddAction(t, function WaterDragon_Action)
    set t = null
endfunction
//郭嘉大
// ========== 技能条件：判断是否为目标技能 ==========
function xMtzuf takes nothing returns boolean
    return GetSpellAbilityId() == 'A0X5'
endfunction

// ========== 伤害周期回调 ==========
function BlizzardDamageTick takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_GameHash, id, 0)
    local real damagePerTick = LoadReal(udg_GameHash, id, 1)
    local real totalDuration = LoadReal(udg_GameHash, id, 2)
    local real interval = LoadReal(udg_GameHash, id, 3)
    local real elapsed = LoadReal(udg_GameHash, id, 4) + interval
    local real x = LoadReal(udg_GameHash, id, 5)
    local real y = LoadReal(udg_GameHash, id, 6)
    local group g
    local unit u
    local player casterOwner

    // 前置兜底：施法者无效/死亡，立刻清理终止
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        call PauseTimer(t)
        call FlushChildHashtable(udg_GameHash, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        return
    endif

    set casterOwner = GetOwningPlayer(caster)
    set g = CreateGroup()

    // 更新已持续时间
    call SaveReal(udg_GameHash, id, 4, elapsed)

    // 原生坐标枚举范围内单位，无需Location
    call GroupEnumUnitsInRange(g, x, y, 600.0, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        // 目标判定：敌方、非建筑、存活
        if IsUnitEnemy(u, casterOwner) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and GetWidgetLife(u) > 0.405 then
            call UnitDamageTarget(caster, u, damagePerTick, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
        endif
    endloop

    call DestroyGroup(g)

    // 持续时间结束：清理所有资源
    if elapsed >= totalDuration then
        call PauseTimer(t)
        call FlushChildHashtable(udg_GameHash, id)
        call DestroyTimer(t)
    endif

    set t = null
    set caster = null
    set g = null
    set u = null
    set casterOwner = null
endfunction

// ========== 技能施法主逻辑 ==========
function cMtzuf takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local player owner
    local unit dummy1
    local unit dummy2
    local unit dummyFx
    local integer lv
    local real int
    local real damagePerTick
    local real duration
    local real interval = 0.5
    local timer t
    local integer timerId
    local real castX
    local real castY

    // 前置校验：施法者无效直接退出
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    set owner = GetOwningPlayer(caster)
    set lv = GetUnitAbilityLevel(caster, 'A0X5')
    set int = GetHeroInt(caster, true)
    set damagePerTick = int * 2.3 * lv
    set duration = lv + 2.0

    // 原生坐标获取，无需Location
    set castX = GetUnitX(caster)
    set castY = GetUnitY(caster)

    // 计时器与参数存储
    set t = CreateTimer()
    set timerId = GetHandleId(t)
    call SaveUnitHandle(udg_GameHash, timerId, 0, caster)
    call SaveReal(udg_GameHash, timerId, 1, damagePerTick)
    call SaveReal(udg_GameHash, timerId, 2, duration)
    call SaveReal(udg_GameHash, timerId, 3, interval)
    call SaveReal(udg_GameHash, timerId, 4, 0)
    call SaveReal(udg_GameHash, timerId, 5, castX)
    call SaveReal(udg_GameHash, timerId, 6, castY)

    // 暴风雪马甲
    set dummy1 = CreateUnit(owner, 'h02W', castX, castY, bj_UNIT_FACING)
    if dummy1 != null then
        call SetUnitAbilityLevel(dummy1, 'A0W3', lv)
        call IssuePointOrder(dummy1, "blizzard", castX, castY)
        call UnitApplyTimedLife(dummy1, 'BTLF', duration)
        set dummy1 = null
    endif

    // 震击马甲
    set dummy2 = CreateUnit(owner, 'h02W', castX, castY, bj_UNIT_FACING)
    if dummy2 != null then
        call SetUnitAbilityLevel(dummy2, 'A0PE', lv)
        call IssueImmediateOrder(dummy2, "stomp")
        call UnitApplyTimedLife(dummy2, 'BTLF', 1.0)
        set dummy2 = null
    endif

    // 特效马甲
    set dummyFx = CreateUnit(owner, 'e0K3', castX, castY, bj_UNIT_FACING)
    if dummyFx != null then
        call UnitApplyTimedLife(dummyFx, 'BTLF', duration)
        set dummyFx = null
    endif

    // 启动周期伤害计时器
    call TimerStart(t, interval, true, function BlizzardDamageTick)

    set caster = null
    set owner = null
    set t = null
endfunction

// ========== 触发器初始化 ==========
function InitTrig_A09L takes nothing returns nothing
    local trigger t
    if udg_GameHash == null then
        set udg_GameHash = InitHashtable()
    endif
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function xMtzuf))
    call TriggerAddAction(t, function cMtzuf)
    set t = null
endfunction
//陆地

function InitHT_Land takes nothing returns nothing
    if udg_HT_Land == null then
        set udg_HT_Land = InitHashtable()
    endif
endfunction

function SetHero_Land takes unit u returns nothing
    call SaveUnitHandle(udg_HT_Land, 3340, 0, u)
endfunction
function GetHero_Land takes nothing returns unit
    return LoadUnitHandle(udg_HT_Land, 3340, 0)
endfunction

function SetMercenary_Land takes unit u returns nothing
    call SaveUnitHandle(udg_HT_Land, 3341, 0, u)
endfunction
function GetMercenary_Land takes nothing returns unit
    return LoadUnitHandle(udg_HT_Land, 3341, 0)
endfunction

function SetBuffId_Land takes integer id returns nothing
    call SaveInteger(udg_HT_Land, 3070, 0, id)
endfunction
function GetBuffId_Land takes nothing returns integer
    return LoadInteger(udg_HT_Land, 3070, 0)
endfunction

// ========== 核心维护主循环（0.5秒） ==========
function MaintainActions_Land takes nothing returns nothing
    local unit hero
    local unit merc
    local location loc
    local boolean keep

    set hero = GetHero_Land()
    set keep = false

    if hero == null or not IsUnitAliveBJ(hero) then
        set merc = GetMercenary_Land()
        if merc != null and IsUnitAliveBJ(merc) then
            call KillUnit(merc)
            call SetMercenary_Land(null)
        endif
        set hero = null
        set merc = null
        return
    endif

    set loc = GetUnitLoc(hero)
    set keep = (IsTerrainPathableBJ(loc, PATHING_TYPE_FLOATABILITY) == true) or (UnitHasBuffBJ(hero, GetBuffId_Land()) == true)
    
    if keep then
        if GetUnitAbilityLevel(hero, 'A0X3') == 0 then
            call UnitAddAbility(hero, 'A0X3')
        endif
    else
        if GetUnitAbilityLevel(hero, 'A0X3') > 0 then
            call UnitRemoveAbility(hero, 'A0X3')
        endif
    endif
    
    set merc = GetMercenary_Land()
    if keep then
        if merc == null or not IsUnitAliveBJ(merc) then
            set merc = CreateUnitAtLoc(GetOwningPlayer(hero), 'n034', loc, 0.00)
            if merc != null then
                call ShowUnitHide(merc)
                call SetMercenary_Land(merc)
            endif
        endif
    else
        if merc != null then
            if IsUnitAliveBJ(merc) then
                call KillUnit(merc)
            endif
            call SetMercenary_Land(null)
        endif
    endif
    
    call RemoveLocation(loc)
    set hero = null
    set merc = null
    set loc = null
endfunction

// ========== 启动维护计时器 ==========
function StartMaintainTimer_Land takes nothing returns nothing
    local timer t
    set t = CreateTimer()
    call TimerStart(t, 0.50, true, function MaintainActions_Land)
    set t = null
endfunction

// ========== 匹配到英雄后的统一初始化 + 全资源清理 ==========
function OnHeroMatched_Land takes unit u returns nothing
    local timer timeoutTimer
    local trigger listenTrg
    local rect r

    if udg_SystemActive_Land == true then
        return
    endif

    call SetHero_Land(u)
    call SetBuffId_Land('B06H')
    set udg_SystemActive_Land = true
    call StartMaintainTimer_Land()

    // 销毁监听触发器
    set listenTrg = LoadTriggerHandle(udg_HT_Land, 3342, 0)
    if listenTrg != null then
        call DestroyTrigger(listenTrg)
        call SaveTriggerHandle(udg_HT_Land, 3342, 0, null)
    endif

    // 清理三个矩形区域（3344,3345,3346）
    set r = LoadRectHandle(udg_HT_Land, 3344, 0)
    if r != null then
        call RemoveRect(r)
        call SaveRectHandle(udg_HT_Land, 3344, 0, null)
    endif
    set r = LoadRectHandle(udg_HT_Land, 3345, 0)
    if r != null then
        call RemoveRect(r)
        call SaveRectHandle(udg_HT_Land, 3345, 0, null)
    endif
    set r = LoadRectHandle(udg_HT_Land, 3346, 0)
    if r != null then
        call RemoveRect(r)
        call SaveRectHandle(udg_HT_Land, 3346, 0, null)
    endif

    // 销毁超时计时器
    set timeoutTimer = LoadTimerHandle(udg_HT_Land, 3343, 0)
    if timeoutTimer != null then
        call PauseTimer(timeoutTimer)
        call DestroyTimer(timeoutTimer)
        call SaveTimerHandle(udg_HT_Land, 3343, 0, null)
    endif

    set timeoutTimer = null
    set listenTrg = null
    set r = null
endfunction

// ========== 事件监听：英雄进入区域匹配 ==========
function HeroFind_Cond takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'U000'
endfunction

function HeroFind_Act takes nothing returns nothing
    local unit u
    set u = GetTriggerUnit()
    call OnHeroMatched_Land(u)
    set u = null
endfunction

// ========== 监听超时自毁回调（10分钟） ==========
function HeroListenTimeout_Land takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local trigger trg
    local rect r

    if udg_SystemActive_Land == false then
        set trg = LoadTriggerHandle(udg_HT_Land, 3342, 0)
        if trg != null then
            call DestroyTrigger(trg)
            call SaveTriggerHandle(udg_HT_Land, 3342, 0, null)
        endif

        set r = LoadRectHandle(udg_HT_Land, 3344, 0)
        if r != null then
            call RemoveRect(r)
            call SaveRectHandle(udg_HT_Land, 3344, 0, null)
        endif
        set r = LoadRectHandle(udg_HT_Land, 3345, 0)
        if r != null then
            call RemoveRect(r)
            call SaveRectHandle(udg_HT_Land, 3345, 0, null)
        endif
        set r = LoadRectHandle(udg_HT_Land, 3346, 0)
        if r != null then
            call RemoveRect(r)
            call SaveRectHandle(udg_HT_Land, 3346, 0, null)
        endif
    endif

    call SaveTimerHandle(udg_HT_Land, 3343, 0, null)
    call DestroyTimer(t)
    set t = null
    set trg = null
    set r = null
endfunction

// ========== 启动时扫描：三个区域内的已有英雄 ==========
function ScanExistingHero_Land takes nothing returns nothing
    local group g = CreateGroup()
    local unit u
    local rect scanRect
    local integer i = 1

    loop
        exitwhen i > 3
        // 区域1（蜀国）
        if i == 1 then
            set scanRect = Rect(-7360, -4032, -5856, -2528)
        // 区域2（魏国）
        elseif i == 2 then
            set scanRect = Rect(1728, 4352, 3712, 5824)
        // 区域3（吴国）
        else
            set scanRect = Rect(6592, -8160, 8160, -6816)
        endif

        call GroupClear(g)
        call GroupEnumUnitsInRect(g, scanRect, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            if GetUnitTypeId(u) == 'U000' and IsUnitAliveBJ(u) then
                call OnHeroMatched_Land(u)
                exitwhen udg_SystemActive_Land == true
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call RemoveRect(scanRect)
        exitwhen udg_SystemActive_Land == true
        set i = i + 1
    endloop

    call DestroyGroup(g)
    set g = null
    set u = null
    set scanRect = null
endfunction

// ========== 注册三个区域进入事件监听 ==========
function StartHeroListen_Land takes nothing returns nothing
    local trigger trg = CreateTrigger()
    local timer timeoutTimer
    local rect r1
    local rect r2
    local rect r3

    // 创建三个矩形，坐标必须与扫描函数中一致
    set r1 = Rect(-7360, -4032, -5856, -2528)    // 区域1
    set r2 = Rect(1728, 4352, 3712, 5824)              // 区域2（替换）
    set r3 = Rect(6592, -8160, 8160, -6816)    // 区域3（替换）

    call SaveRectHandle(udg_HT_Land, 3344, 0, r1)
    call SaveRectHandle(udg_HT_Land, 3345, 0, r2)
    call SaveRectHandle(udg_HT_Land, 3346, 0, r3)

    call TriggerRegisterEnterRectSimple(trg, r1)
    call TriggerRegisterEnterRectSimple(trg, r2)
    call TriggerRegisterEnterRectSimple(trg, r3)
    call TriggerAddCondition(trg, Condition(function HeroFind_Cond))
    call TriggerAddAction(trg, function HeroFind_Act)

    call SaveTriggerHandle(udg_HT_Land, 3342, 0, trg)

    set timeoutTimer = CreateTimer()
    call SaveTimerHandle(udg_HT_Land, 3343, 0, timeoutTimer)
    call TimerStart(timeoutTimer, 600.0, false, function HeroListenTimeout_Land)

    set trg = null
    set timeoutTimer = null
    set r1 = null
    set r2 = null
    set r3 = null
endfunction

// ========== 系统总入口 ==========
function StartSystem_Land takes nothing returns nothing
    if udg_SystemActive_Land == true then
        return
    endif

    call InitHT_Land()
    set udg_ScanRetry_Land = 0

    call ScanExistingHero_Land()
    if udg_SystemActive_Land == false then
        call StartHeroListen_Land()
    endif
endfunction
//郭嘉1
function WolfWave_Periodic takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_HT_WolfWave, id, 0)
    local location startLoc = LoadLocationHandle(udg_HT_WolfWave, id, 1)
    local location targetLoc = LoadLocationHandle(udg_HT_WolfWave, id, 2)
    local integer count = LoadInteger(udg_HT_WolfWave, id, 3)
    local integer lv = LoadInteger(udg_HT_WolfWave, id, 4)
    local real extraDmg = LoadReal(udg_HT_WolfWave, id, 5)
    local unit dummy
    local real sx
    local real sy
    local real angle
    local real spawnX
    local real spawnY
    local group g
    local unit u

    // 异常兜底：施法者或坐标无效，先释放资源再安全终止
    if caster == null or GetWidgetLife(caster) <= 0.405 or startLoc == null or targetLoc == null then
        call PauseTimer(t)
        if startLoc != null then
            call RemoveLocation(startLoc)
        endif
        if targetLoc != null then
            call RemoveLocation(targetLoc)
        endif
        call FlushChildHashtable(udg_HT_WolfWave, id)
        call DestroyTimer(t)
        set t = null
        set caster = null
        set startLoc = null
        set targetLoc = null
        return
    endif

    if count < 8 then
        set count = count + 1
        call SaveInteger(udg_HT_WolfWave, id, 3, count)

        // 优化：原生坐标计算，消除PolarProjectionBJ的临时location开销
        set sx = GetLocationX(startLoc)
        set sy = GetLocationY(startLoc)
        set angle = Atan2(GetLocationY(targetLoc) - sy, GetLocationX(targetLoc) - sx)
        set spawnX = sx + Cos(angle) * 160.0 * I2R(count)
        set spawnY = sy + Sin(angle) * 160.0 * I2R(count)

        // 狼波马甲创建判空
        set dummy = CreateUnit(GetOwningPlayer(caster), 'e05C', spawnX, spawnY, 0)
        if dummy != null then
            call SetUnitAbilityLevel(dummy, 'A0X1', lv)
            call IssueImmediateOrder(dummy, "stomp")
            call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
            set dummy = null
        endif

        // 附加额外伤害
        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, spawnX, spawnY, 300.0, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null
            if IsUnitAliveBJ(u) and IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                call UnitDamageTarget(caster, u, extraDmg, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g = null
    else
        // 结束：暂停 → 释放资源 → 清空哈希表 → 销毁计时器
        call PauseTimer(t)
        call RemoveLocation(startLoc)
        call RemoveLocation(targetLoc)
        call FlushChildHashtable(udg_HT_WolfWave, id)
        call DestroyTimer(t)
    endif

    set t = null
    set caster = null
    set startLoc = null
    set targetLoc = null
endfunction

// ====================================
// 技能条件
// ====================================
function WolfWave_Cond takes nothing returns boolean
    return GetSpellAbilityId() == 'A0X4'
endfunction

// ====================================
// 狼波推进 + 震荡波 主动作
// ====================================
function WolfWave_Act takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local location startLoc
    local location targetLoc
    local integer lv
    local real int
    local timer t
    local integer id
    local unit dummy

    // 入口有效性校验
    if caster == null or GetWidgetLife(caster) <= 0.405 then
        set caster = null
        return
    endif

    // 修复1：目标点判空，杜绝空句柄崩溃
    set targetLoc = GetSpellTargetLoc()
    if targetLoc == null then
        set caster = null
        return
    endif

    set startLoc = GetUnitLoc(caster)
    set lv = GetUnitAbilityLevel(caster, 'A0X4')
    set int = GetHeroInt(caster, true)

    // 初始化哈希表
    if udg_HT_WolfWave == null then
        set udg_HT_WolfWave = InitHashtable()
    endif

    set udg_hurt[4] = int * 1.0

    // ---- 狼波推进 ----
    set t = CreateTimer()
    set id = GetHandleId(t)
    call SaveUnitHandle(udg_HT_WolfWave, id, 0, caster)
    call SaveLocationHandle(udg_HT_WolfWave, id, 1, startLoc)
    call SaveLocationHandle(udg_HT_WolfWave, id, 2, targetLoc)
    // 注意：原版初始count=1，全程共生成7波；若需8波请改为 0
    call SaveInteger(udg_HT_WolfWave, id, 3, 1)
    call SaveInteger(udg_HT_WolfWave, id, 4, lv)
    call SaveReal(udg_HT_WolfWave, id, 5, udg_hurt[4])
    call TimerStart(t, 0.10, true, function WolfWave_Periodic)

    // ---- 震荡波马甲1 ----
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'e02U', startLoc, GetUnitFacing(caster))
    if dummy != null then
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        set dummy = null
    endif

    // ---- 震荡波马甲2 ----
    set dummy = CreateUnitAtLoc(GetOwningPlayer(caster), 'e05K', startLoc, GetUnitFacing(caster))
    if dummy != null then
        call SetUnitAbilityLevel(dummy, 'A0X2', lv)
        call IssuePointOrderLoc(dummy, "shockwave", targetLoc)
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        set dummy = null
    endif

    set caster = null
    set startLoc = null
    set targetLoc = null
    set t = null
endfunction

// ====================================
// 初始化
// ====================================
function Init_WolfWaveSystem takes nothing returns nothing
    local trigger t
    // 防重复初始化，避免触发器叠加泄漏
    if udg_HT_WolfWave != null and LoadInteger(udg_HT_WolfWave, 0, 92001) == 1 then
        return
    endif

    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function WolfWave_Cond))
    call TriggerAddAction(t, function WolfWave_Act)
    set t = null

    if udg_HT_WolfWave == null then
        set udg_HT_WolfWave = InitHashtable()
    endif
    call SaveInteger(udg_HT_WolfWave, 0, 92001, 1)
endfunction

