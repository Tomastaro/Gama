//马超4
function Trig_ma1Conditions takes nothing returns boolean
    return GetLearnedSkill() == 'A0L2' and not IsUnitIllusionBJ(GetTriggerUnit())
endfunction

function Trig_ma1Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    if u != null and jv[310] == null then
        set jv[310] = u
        call EnableTrigger(gg_trg_ma2)
    endif
    set u = null
endfunction

function Trig_ma2Actions takes nothing returns nothing
    local unit u = jv[310]
    if u != null and IsUnitAliveBJ(u) then
        if GetUnitManaPercent(u) < 25.0 then
            call UnitRemoveAbility(u, 'A0LN')
        else
            call UnitAddAbility(u, 'A0LN')
        endif
    else
        call DisableTrigger(gg_trg_ma2)
        set jv[310] = null
    endif
    set u = null
endfunction

function pBxhx takes nothing returns nothing
    local unit source = GetEventDamageSource()
    local unit target = GetTriggerUnit()
    local location loc
    local unit dummy
    local integer lvl
    if source != null and target != null then
        if GetUnitManaPercent(source) >= 25.0 and GetEventDamage() > 1.0 and GetUnitAbilityLevel(source, 'A0L2') > 0 and GetUnitAbilityLevel(source, 'A0N6') == 1 then
            set loc = GetUnitLoc(target)
            if UnitHasBuffBJ(target, 'B06N') == false then
                set udg_sunder[1] = 1
            elseif udg_sunder[1] <= GetUnitAbilityLevel(source, 'A0L2') then
                set udg_sunder[1] = udg_sunder[1] + 1
            else
                set udg_sunder[1] = GetUnitAbilityLevel(source, 'A0L2') + 1
            endif
            set dummy = CreateUnitAtLoc(GetOwningPlayer(source), 'h03B', loc, 0)
            call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
            call SetUnitAbilityLevel(dummy, 'A6DW', udg_sunder[1])
            call IssueTargetOrder(dummy, "attack", target)
            call RemoveLocation(loc)
            set dummy = null
            set loc = null
        endif
    endif
    set source = null
    set target = null
endfunction

function InitMaChaodazhao takes nothing returns nothing
    set gg_trg_ma1 = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ma1, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_ma1, Condition(function Trig_ma1Conditions))
    call TriggerAddAction(gg_trg_ma1, function Trig_ma1Actions)

    set gg_trg_ma2 = CreateTrigger()
    call DisableTrigger(gg_trg_ma2)   // 初始禁用
    call TriggerRegisterTimerEventPeriodic(gg_trg_ma2, 0.5)
    call TriggerAddAction(gg_trg_ma2, function Trig_ma2Actions)

    set soxhx = CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(soxhx)
    call TriggerAddAction(soxhx, function pBxhx)
endfunction

