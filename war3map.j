function O0100I takes nothing returns nothing
    if O0O1O!=null and O000O>0.00 then
        // ✅ 完全保留你原来的参数，手感一模一样
        set OIO0O=II0I0O(OIOOO,true,I10II)
        set OO0IO[OIO0O]=O0OIO
        set O0IIO[OIO0O]=O0O1O
        set OOIIO[OIO0O]=O00OO
        set OOI0O[OIO0O]=O000O*OIOOO
        set O0I1O[OIO0O]=O00IO*(OIOOO*OIOOO)
        set O01OO[OIO0O]=O001O
        set O010O[OIO0O]=O0IOO
        set OOI1O[OIO0O]=CreateGroup()
        set OO1OO[OIO0O]=0
    endif
    set O0OIO=null
    set O0O1O=null
    set O00OO=0.00
    set O000O=0.00
    set O00IO=0.00
    set O001O=false
    set O0IOO=false
endfunction

